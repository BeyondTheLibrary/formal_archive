/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

Background group theory used by Section 10: the simplicity of the alternating group.
-/
import Mathlib.GroupTheory.GroupAction.Iwasawa
import Mathlib.GroupTheory.GroupAction.SubMulAction.Combination
import Mathlib.GroupTheory.SpecificGroups.Alternating.KleinFour

/-!
# Simplicity of `A(Ω)` for `|Ω| ≥ 5`

The paper uses this throughout Section 10 as common knowledge, without a citation, so it
is not an `axiom`: it is proved here.  Mathlib has only
`alternatingGroup.isSimpleGroup_five` (the case `|Ω| = 5`).

## The proof

We use Mathlib's Iwasawa criterion `MulAction.IwasawaStructure.isSimpleGroup`: a
nontrivial perfect group with a faithful quasi-primitive action carrying an *Iwasawa
structure* (a family of abelian subgroups `T x`, indexed by the points `x` of the action,
with `T (g • x) = (T x)^g`, generating the group) is simple.

Two Iwasawa structures are needed, because Mathlib's primitivity of `A(Ω)` on the
`m`-subsets of `Ω` (`Set.powersetCard.isPreprimitive_alternatingGroup`) requires
`3 ≤ m < |Ω|` and `|Ω| ≠ 2m`:

* `m = 3`, with `T s = A(s) ≅ A₃` cyclic of order `3`.  This covers all `|Ω| ≥ 5` except
  `|Ω| = 6`.
* `m = 4`, with `T s = [A(s), A(s)] ≅ V₄` the Klein four group.  This covers `|Ω| = 6`
  (indeed all `|Ω| ≥ 5` except `|Ω| = 8`).

Both families are generated by the canonical subgroups attached to a subset, so the
conjugation law is Mathlib's `alternatingGroup.conj_smul_range_ofSubtype`; the generation
statements are `alternatingGroup.closure_isThreeCycles_eq_top` (3-cycles generate) and
`alternatingGroup.closure_cycleType_eq_two_two_eq_top` (products of two disjoint
transpositions generate).
-/

namespace Babai

open Equiv Equiv.Perm MulAction Subgroup

section Commutative

/-- A group of order `3` is commutative. -/
theorem isMulCommutative_of_card_eq_three {G : Type*} [Group G] (h : Nat.card G = 3) :
    IsMulCommutative G := by
  haveI : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  haveI := isCyclic_of_prime_card (p := 3) h
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := G)
  refine isMulCommutative_iff.2 fun a b => ?_
  obtain ⟨m, rfl⟩ := hg a
  obtain ⟨n, rfl⟩ := hg b
  rw [← zpow_add, ← zpow_add, add_comm]

/-- The image of a commutative group under a group homomorphism is commutative. -/
theorem isMulCommutative_range {G H : Type*} [Group G] [Group H] (f : G →* H)
    [IsMulCommutative G] : IsMulCommutative f.range := by
  refine isMulCommutative_iff.2 ?_
  rintro ⟨_, a, rfl⟩ ⟨_, b, rfl⟩
  apply Subtype.ext
  simp only [Subgroup.coe_mul, ← map_mul]
  exact congrArg f (isMulCommutative_iff.1 ‹IsMulCommutative G› a b)

/-- The image of a commutative group under `Subgroup.map` is commutative. -/
theorem isMulCommutative_map {G H : Type*} [Group G] [Group H] (f : G →* H) (K : Subgroup G)
    [IsMulCommutative K] : IsMulCommutative (K.map f) := by
  refine isMulCommutative_iff.2 fun a b => ?_
  obtain ⟨a, rfl⟩ := f.subgroupMap_surjective K a
  obtain ⟨b, rfl⟩ := f.subgroupMap_surjective K b
  rw [← map_mul, ← map_mul]
  exact congrArg _ (isMulCommutative_iff.1 ‹IsMulCommutative K› a b)

end Commutative

section Alt

variable {Ω : Type*} [Fintype Ω] [DecidableEq Ω]

/-- `A(s) ≤ A(Ω)`: the even permutations of `Ω` supported inside the finite set `s`. -/
def altOn (s : Finset Ω) : Subgroup (alternatingGroup Ω) :=
  (alternatingGroup.ofSubtype s).range

theorem mem_altOn {s : Finset Ω} {g : alternatingGroup Ω} :
    g ∈ altOn s ↔ (g : Perm Ω).support ⊆ s :=
  alternatingGroup.mem_range_ofSubtype_iff s g

open scoped Pointwise in
theorem conj_altOn (s : Finset Ω) (g : alternatingGroup Ω) :
    MulAut.conj g • altOn s = altOn (g • s) :=
  alternatingGroup.conj_smul_range_ofSubtype s g

/-- `A(s)` is commutative when `|s| = 3` (it is cyclic of order `3`). -/
theorem isMulCommutative_altOn_three {s : Finset Ω} (hs : s.card = 3) :
    IsMulCommutative (altOn s) := by
  have hcard : Nat.card (s : Type _) = 3 := by
    simpa [Nat.card_eq_fintype_card] using hs
  haveI : Nontrivial (s : Type _) := by
    rw [← Finite.one_lt_card_iff_nontrivial, hcard]; norm_num
  have : Nat.card (alternatingGroup (s : Type _)) = 3 := by
    rw [nat_card_alternatingGroup, hcard]
    rfl
  haveI := isMulCommutative_of_card_eq_three this
  exact isMulCommutative_range _

/-- `[A(s), A(s)]` is commutative when `|s| = 4`: it is the Klein four group. -/
theorem isMulCommutative_commutator_altOn_four {s : Finset Ω} (hs : s.card = 4) :
    IsMulCommutative (⁅altOn s, altOn s⁆ : Subgroup (alternatingGroup Ω)) := by
  have hcard : Nat.card (s : Type _) = 4 := by
    simpa [Nat.card_eq_fintype_card] using hs
  have hkey : (⁅altOn s, altOn s⁆ : Subgroup (alternatingGroup Ω))
      = (alternatingGroup.kleinFour (s : Type _)).map (alternatingGroup.ofSubtype s) := by
    rw [alternatingGroup.kleinFour_eq_commutator hcard, commutator_def,
      Subgroup.map_commutator, altOn, ← MonoidHom.range_eq_map]
  haveI : IsKleinFour (alternatingGroup.kleinFour (s : Type _)) :=
    alternatingGroup.kleinFour_isKleinFour hcard
  haveI := IsKleinFour.isMulCommutative (G := alternatingGroup.kleinFour (s : Type _))
  rw [hkey]
  exact isMulCommutative_map _ _

end Alt

section Iwasawa

variable {Ω : Type*} [Fintype Ω] [DecidableEq Ω]

open scoped Pointwise

/-- The Iwasawa structure on the `3`-subsets of `Ω`: `T s = A(s)`, cyclic of order `3`. -/
def iwasawaThree :
    IwasawaStructure (alternatingGroup Ω) (Set.powersetCard Ω 3) where
  T s := altOn (s : Finset Ω)
  is_comm s := isMulCommutative_altOn_three s.prop
  is_conj g s := by
    have h : ((g • s : Set.powersetCard Ω 3) : Finset Ω) = g • (s : Finset Ω) :=
      Set.powersetCard.coe_smul
    rw [h, ← conj_altOn]
  is_generator := by
    rw [eq_top_iff, ← alternatingGroup.closure_isThreeCycles_eq_top, Subgroup.closure_le]
    rintro g (hg : (g : Perm Ω).IsThreeCycle)
    have hcard : (g : Perm Ω).support.card = 3 := hg.card_support
    refine le_iSup (fun s : Set.powersetCard Ω 3 => altOn (s : Finset Ω))
      (⟨(g : Perm Ω).support, hcard⟩ : Set.powersetCard Ω 3) ?_
    show g ∈ altOn (g : Perm Ω).support
    exact mem_altOn.2 (Finset.Subset.refl _)

/-- The Iwasawa structure on the `4`-subsets of `Ω`: `T s = [A(s), A(s)] ≅ V₄`. -/
def iwasawaFour (h5 : 5 ≤ Fintype.card Ω) :
    IwasawaStructure (alternatingGroup Ω) (Set.powersetCard Ω 4) where
  T s := ⁅altOn (s : Finset Ω), altOn (s : Finset Ω)⁆
  is_comm s := isMulCommutative_commutator_altOn_four s.prop
  is_conj g s := by
    have h : ((g • s : Set.powersetCard Ω 4) : Finset Ω) = g • (s : Finset Ω) :=
      Set.powersetCard.coe_smul
    rw [h, ← conj_altOn]
    simp only [Subgroup.pointwise_smul_def, Subgroup.map_commutator]
  is_generator := by
    have h5' : 5 ≤ Nat.card Ω := by rwa [Nat.card_eq_fintype_card]
    rw [eq_top_iff, ← alternatingGroup.closure_cycleType_eq_two_two_eq_top h5',
      Subgroup.closure_le]
    rintro g (hg : (g : Perm Ω).cycleType = {2, 2})
    have hcard : (g : Perm Ω).support.card = 4 := by
      rw [← Equiv.Perm.sum_cycleType, hg]; rfl
    refine le_iSup
      (fun s : Set.powersetCard Ω 4 => ⁅altOn (s : Finset Ω), altOn (s : Finset Ω)⁆)
      (⟨(g : Perm Ω).support, hcard⟩ : Set.powersetCard Ω 4) ?_
    -- `g` lies in the Klein four group of `A(supp g)`.
    set s : Finset Ω := (g : Perm Ω).support with hs
    show g ∈ ⁅altOn s, altOn s⁆
    have hcards : Nat.card (s : Type _) = 4 := by
      simpa [Nat.card_eq_fintype_card] using hcard
    have hkey : (⁅altOn s, altOn s⁆ : Subgroup (alternatingGroup Ω))
        = (alternatingGroup.kleinFour (s : Type _)).map (alternatingGroup.ofSubtype s) := by
      rw [alternatingGroup.kleinFour_eq_commutator hcards, _root_.commutator_def,
        Subgroup.map_commutator, altOn, ← MonoidHom.range_eq_map]
    rw [hkey]
    obtain ⟨g', hg'⟩ : g ∈ altOn s := mem_altOn.2 (Finset.Subset.refl _)
    refine ⟨g', ?_, hg'⟩
    apply Subgroup.subset_closure
    show ((g' : Perm (s : Type _))).cycleType = {2, 2}
    have hof : (Equiv.Perm.ofSubtype (g' : Perm (s : Type _))) = (g : Perm Ω) := by
      have := congrArg (fun x : alternatingGroup Ω => (x : Perm Ω)) hg'
      simpa [alternatingGroup.ofSubtype] using this
    have hct := Equiv.Perm.cycleType_ofSubtype (g := (g' : Perm (s : Type _)))
    rw [hof, hg] at hct
    convert hct.symm using 2

end Iwasawa

section Simple

variable {Ω : Type*} [Fintype Ω] [DecidableEq Ω]

/-- Background.  `A(Ω)` is simple for `|Ω| ≥ 5`.

The paper uses this throughout Sec. 10 (for instance "`N` is a maximal normal subgroup" in
the proof of Lemma 10.1.1 applied with `S = A_k`, and "the epimorphism `K → A_k` factors"
in Lemma 10.3.1).  Mathlib proves it only for `|Ω| = 5`. -/
theorem isSimpleGroup_alternatingGroup (h5 : 5 ≤ Fintype.card Ω) :
    IsSimpleGroup (alternatingGroup Ω) := by
  have h5' : 5 ≤ Nat.card Ω := by rwa [Nat.card_eq_fintype_card]
  haveI : Nontrivial (alternatingGroup Ω) :=
    alternatingGroup.nontrivial_of_three_le_card (by omega)
  have hperf : commutator (alternatingGroup Ω) = ⊤ :=
    commutator_alternatingGroup_eq_top h5
  by_cases h6 : Fintype.card Ω = 6
  · -- use the Klein four structure on `4`-subsets
    haveI : IsPreprimitive (alternatingGroup Ω) (Set.powersetCard Ω 4) :=
      Set.powersetCard.isPreprimitive_alternatingGroup (by norm_num)
        (by rw [Nat.card_eq_fintype_card, h6]; norm_num)
        (by rw [Nat.card_eq_fintype_card, h6]; norm_num)
    haveI : FaithfulSMul (alternatingGroup Ω) (Set.powersetCard Ω 4) :=
      Set.powersetCard.faithfulSMul (by norm_num)
        (by rw [ENat.card_eq_coe_natCard, Nat.card_eq_fintype_card, h6]; norm_num)
    exact IwasawaStructure.isSimpleGroup hperf (iwasawaFour h5) inferInstance
  · haveI : IsPreprimitive (alternatingGroup Ω) (Set.powersetCard Ω 3) :=
      Set.powersetCard.isPreprimitive_alternatingGroup le_rfl
        (by rw [Nat.card_eq_fintype_card]; omega)
        (by rw [Nat.card_eq_fintype_card]; omega)
    haveI : FaithfulSMul (alternatingGroup Ω) (Set.powersetCard Ω 3) :=
      Set.powersetCard.faithfulSMul (by norm_num)
        (by rw [ENat.card_eq_coe_natCard, Nat.card_eq_fintype_card]
            exact_mod_cast by omega)
    exact IwasawaStructure.isSimpleGroup hperf iwasawaThree inferInstance

end Simple

end Babai
