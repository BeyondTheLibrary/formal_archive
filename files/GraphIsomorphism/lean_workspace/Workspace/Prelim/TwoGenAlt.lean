/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

Textbook background used in Section 12: the alternating group on `k ≥ 3` letters is
generated by two elements.
-/
import Mathlib.GroupTheory.SpecificGroups.Alternating
import Mathlib.GroupTheory.Perm.Fin

/-!
# Two generators of the alternating group

The paper uses, in the proof of Corollary 12.0.6 ("Apply Prop. 12.0.5 to `H := A(Γ)` with
`S` a pair of generators of `H`"), that `A(Γ)` is generated by two elements.  It gives no
citation, so this is a theorem here, not an axiom.

The witnesses are the classical ones, written with `Fin.cycleRange`:

* `k` **even**: `s = (0 1 … k−2)`, which fixes `x = k−1` and is even because `k − 2` is
  even, together with the 3-cycle `c = (x 0 1)`;
* `k` **odd**: `s = (0 1 … k−3)`, which fixes `x = k−1` and `y = k−2` and is even because
  `k − 3` is even, together with the 3-cycle `c = (x y 0)`.

In both cases the conjugates `s^n c s^{-n}` and one composition rule for 3-cycles through
the common point `x` give every 3-cycle `(x a b)`, and those generate the alternating
group.
-/

namespace Babai

open Equiv Equiv.Perm Subgroup

variable {α : Type*} [DecidableEq α]

/-! ### The 3-cycle `a → b → c → a` as a product of two transpositions -/

/-- The permutation `a ↦ b ↦ c ↦ a`, written as `(a b)(b c)`. -/
def thr (a b c : α) : Equiv.Perm α := Equiv.swap a b * Equiv.swap b c

theorem thr_apply (a b c z : α) :
    thr a b c z = Equiv.swap a b (Equiv.swap b c z) := rfl

theorem thr_rotate {a b c : α} (hab : a ≠ b) (hbc : b ≠ c) (hac : a ≠ c) :
    thr a b c = thr b c a := by
  ext z
  simp only [thr_apply, Equiv.swap_apply_def]
  split_ifs <;> simp_all

theorem thr_inv {a b c : α} (hab : a ≠ b) (hbc : b ≠ c) (hac : a ≠ c) :
    (thr a b c)⁻¹ = thr a c b := by
  ext z
  rw [Equiv.Perm.inv_def]
  simp only [thr_apply, Equiv.symm_apply_eq, Equiv.swap_apply_def]
  split_ifs <;> simp_all

/-- `(x b c)(x a b) = (x a c)`: the composition rule for 3-cycles through `x`. -/
theorem thr_comp {x a b c : α} (hxa : x ≠ a) (hxb : x ≠ b) (hxc : x ≠ c)
    (hab : a ≠ b) (hbc : b ≠ c) (hac : a ≠ c) :
    thr x b c * thr x a b = thr x a c := by
  ext z
  simp only [Equiv.Perm.mul_apply, thr_apply, Equiv.swap_apply_def]
  split_ifs <;> simp_all

/-- `(x a b)(x b c) = (a b c)`: a 3-cycle missing `x` as a product of two through `x`. -/
theorem thr_mul {x a b c : α} (hxa : x ≠ a) (hxb : x ≠ b) (hxc : x ≠ c)
    (hab : a ≠ b) (hbc : b ≠ c) (hac : a ≠ c) :
    thr x a b * thr x b c = thr a b c := by
  ext z
  simp only [Equiv.Perm.mul_apply, thr_apply, Equiv.swap_apply_def]
  split_ifs <;> simp_all

/-- Conjugation carries `(a b c)` to `(a^g b^g c^g)`. -/
theorem thr_conj (g : Equiv.Perm α) (a b c : α) :
    g * thr a b c * g⁻¹ = thr (g a) (g b) (g c) := by
  rw [thr, thr, Equiv.swap_apply_apply, Equiv.swap_apply_apply]
  group

theorem sign_thr [Fintype α] {a b c : α} (hab : a ≠ b) (hbc : b ≠ c) :
    Equiv.Perm.sign (thr a b c) = 1 := by
  rw [thr, map_mul, Equiv.Perm.sign_swap hab, Equiv.Perm.sign_swap hbc]
  simp

theorem thr_mem_alternatingGroup [Fintype α] {a b c : α} (hab : a ≠ b) (hbc : b ≠ c) :
    thr a b c ∈ alternatingGroup α :=
  Equiv.Perm.mem_alternatingGroup.2 (sign_thr hab hbc)

/-! ### From the 3-cycles through one point to the whole alternating group -/

/-- If a subgroup `H` contains every 3-cycle `(x a b)` through a fixed point `x`, then it
contains the whole alternating group: every 3-cycle is either of that shape (up to the
rotation `(a b c) = (b c a)`) or a product `(x a b)(x b c)` of two of them. -/
theorem alternating_le_of_forall_thr [Fintype α] {H : Subgroup (Equiv.Perm α)} (x : α)
    (h : ∀ a b : α, a ≠ x → b ≠ x → a ≠ b → thr x a b ∈ H) :
    alternatingGroup α ≤ H := by
  classical
  rw [← Equiv.Perm.closure_three_cycles_eq_alternating, Subgroup.closure_le]
  rintro g (hg : g.IsThreeCycle)
  obtain ⟨a, ha⟩ : ∃ a, a ∈ g.support := by
    have hcard := hg.card_support
    exact Finset.card_pos.1 (by omega)
  have hgeq : g = thr a (g a) (g (g a)) :=
    hg.eq_swap_mul_swap_iff_mem_support.2 ha
  have hnodup : ([a, g a, g (g a)] : List α).Nodup :=
    hg.nodup_iff_mem_support.2 ha
  have hd : a ≠ g a ∧ a ≠ g (g a) ∧ g a ≠ g (g a) := by
    simpa [List.nodup_cons, not_or, and_assoc] using hnodup
  obtain ⟨hab, hac, hbc⟩ := hd
  set b := g a with hb
  set c := g (g a) with hc
  rw [hgeq]
  by_cases hxa : a = x
  · subst hxa
    exact h b c (fun hh => hab hh.symm) (fun hh => hac hh.symm) hbc
  by_cases hxb : b = x
  · subst hxb
    rw [thr_rotate hab hbc (fun hh => hac hh)]
    exact h c a (fun hh => hbc hh.symm) hxa hac.symm
  by_cases hxc : c = x
  · subst hxc
    rw [thr_rotate hab hbc hac, thr_rotate hbc hac.symm hab.symm]
    exact h a b hxa hxb hab
  · rw [← thr_mul (x := x) (Ne.symm hxa) (Ne.symm hxb) (Ne.symm hxc) hab hbc hac]
    exact mul_mem (h a b hxa hxb hab) (h b c hxb hxc hbc)

/-! ### The witnesses in `Fin k` -/

namespace TwoGen

/-- `(0 1 … d)^n` moves `m` to `m + n`, as long as `m + n ≤ d`. -/
theorem cycleRange_pow_mk {k d : ℕ} (hdk : d < k) (m n : ℕ) (h : m + n ≤ d) :
    ((Fin.cycleRange (⟨d, hdk⟩ : Fin k)) ^ n) ⟨m, by omega⟩ = ⟨m + n, by omega⟩ := by
  induction n with
  | zero => simp
  | succ n ih =>
      have h' : m + n ≤ d := by omega
      rw [pow_succ', Equiv.Perm.mul_apply, ih h']
      have hlt : (⟨m + n, by omega⟩ : Fin k) < (⟨d, hdk⟩ : Fin k) := Fin.mk_lt_mk.2 (by omega)
      refine Fin.ext ?_
      rw [Fin.coe_cycleRange_of_lt hlt]
      simp
      omega

/-- `(0 1 … d)` fixes every point beyond `d`. -/
theorem cycleRange_pow_of_gt {k : ℕ} {j z : Fin k} (h : j < z) (n : ℕ) :
    ((Fin.cycleRange j) ^ n) z = z := by
  induction n with
  | zero => simp
  | succ n ih => rw [pow_succ', Equiv.Perm.mul_apply, ih, Fin.cycleRange_of_gt h]

/-! #### `k` even: one fixed point and the consecutive 3-cycles through it -/

/-- If `H` contains the 3-cycles `(x a b)` for all *consecutive* pairs `a, b` below `d`,
where `x` is the point `d + 1`, then `H` contains the whole alternating group: the
composition rule `(x b c)(x a b) = (x a c)` chains the consecutive ones together. -/
theorem alternating_le_even {d : ℕ} {H : Subgroup (Equiv.Perm (Fin (d + 2)))}
    (x : Fin (d + 2)) (hx : (x : ℕ) = d + 1)
    (hstep : ∀ a b : Fin (d + 2), (b : ℕ) = (a : ℕ) + 1 → (b : ℕ) ≤ d → thr x a b ∈ H) :
    alternatingGroup (Fin (d + 2)) ≤ H := by
  classical
  set a₀ : Fin (d + 2) := ⟨0, by omega⟩ with ha₀
  have ha0v : (a₀ : ℕ) = 0 := rfl
  have hchain : ∀ m : ℕ, 1 ≤ m → m ≤ d → ∀ b : Fin (d + 2), (b : ℕ) = m →
      thr x a₀ b ∈ H := by
    intro m
    induction m with
    | zero => intro h; omega
    | succ m ih =>
      intro _ hmd b hb
      rcases Nat.eq_zero_or_pos m with rfl | hmpos
      · exact hstep a₀ b (by rw [hb, ha0v]) (by omega)
      · have hm2 : m < d + 2 := by omega
        have h1 := ih hmpos (by omega) ⟨m, hm2⟩ rfl
        have h2 := hstep ⟨m, hm2⟩ b (by rw [hb]) (by omega)
        rw [← thr_comp (x := x) (a := a₀) (b := (⟨m, hm2⟩ : Fin (d + 2))) (c := b)
          (Fin.ne_of_val_ne (by simp only [hx, ha0v, hb, Fin.val_mk]; omega))
          (Fin.ne_of_val_ne (by simp only [hx, ha0v, hb, Fin.val_mk]; omega))
          (Fin.ne_of_val_ne (by simp only [hx, ha0v, hb, Fin.val_mk]; omega))
          (Fin.ne_of_val_ne (by simp only [hx, ha0v, hb, Fin.val_mk]; omega))
          (Fin.ne_of_val_ne (by simp only [hx, ha0v, hb, Fin.val_mk]; omega))
          (Fin.ne_of_val_ne (by simp only [hx, ha0v, hb, Fin.val_mk]; omega))]
        exact mul_mem h2 h1
  refine alternating_le_of_forall_thr x ?_
  intro a b ha hb hab
  have hav : (a : ℕ) ≤ d := by
    have h : (a : ℕ) ≠ (x : ℕ) := fun h => ha (Fin.val_injective h)
    have := a.isLt
    omega
  have hbv : (b : ℕ) ≤ d := by
    have h : (b : ℕ) ≠ (x : ℕ) := fun h => hb (Fin.val_injective h)
    have := b.isLt
    omega
  have habv : (a : ℕ) ≠ (b : ℕ) := fun h => hab (Fin.val_injective h)
  have key : ∀ z : Fin (d + 2), (z : ℕ) ≤ d → 1 ≤ (z : ℕ) → thr x a₀ z ∈ H :=
    fun z hz1 hz2 => hchain (z : ℕ) hz2 hz1 z rfl
  rcases Nat.eq_zero_or_pos (a : ℕ) with ha0 | hapos
  · have hae : a = a₀ := Fin.val_injective (by rw [ha0, ha0v])
    rw [hae]
    exact key b hbv (by omega)
  rcases Nat.eq_zero_or_pos (b : ℕ) with hb0 | hbpos
  · have hbe : b = a₀ := Fin.val_injective (by rw [hb0, ha0v])
    rw [hbe, ← thr_inv (a := x) (b := a₀) (c := a)
      (Fin.ne_of_val_ne (by rw [hx, ha0v]; omega))
      (Fin.ne_of_val_ne (by rw [ha0v]; omega))
      (Fin.ne_of_val_ne (by rw [hx]; omega))]
    exact inv_mem (key a hav hapos)
  · have hcomp := thr_comp (x := x) (a := a₀) (b := a) (c := b)
      (Fin.ne_of_val_ne (by rw [hx, ha0v]; omega))
      (Fin.ne_of_val_ne (by rw [hx]; omega))
      (Fin.ne_of_val_ne (by rw [hx]; omega))
      (Fin.ne_of_val_ne (by rw [ha0v]; omega))
      hab
      (Fin.ne_of_val_ne (by rw [ha0v]; omega))
    rw [eq_mul_inv_of_mul_eq hcomp]
    exact mul_mem (key b hbv hbpos) (inv_mem (key a hav hapos))

/-! #### `k` odd: two fixed points -/

/-- If `H` contains the 3-cycles `(x y b)` for the two top points `x = d + 2`, `y = d + 1`
and all `b ≤ d`, then `H` contains the whole alternating group. -/
theorem alternating_le_odd {d : ℕ} {H : Subgroup (Equiv.Perm (Fin (d + 3)))}
    (x y : Fin (d + 3)) (hx : (x : ℕ) = d + 2) (hy : (y : ℕ) = d + 1)
    (hbase : ∀ b : Fin (d + 3), (b : ℕ) ≤ d → thr x y b ∈ H) :
    alternatingGroup (Fin (d + 3)) ≤ H := by
  classical
  refine alternating_le_of_forall_thr x ?_
  intro a b ha hb hab
  have hav : (a : ℕ) ≤ d + 1 := by
    have h : (a : ℕ) ≠ (x : ℕ) := fun h => ha (Fin.val_injective h)
    have := a.isLt
    omega
  have hbv : (b : ℕ) ≤ d + 1 := by
    have h : (b : ℕ) ≠ (x : ℕ) := fun h => hb (Fin.val_injective h)
    have := b.isLt
    omega
  have habv : (a : ℕ) ≠ (b : ℕ) := fun h => hab (Fin.val_injective h)
  by_cases hay : (a : ℕ) = d + 1
  · have hae : a = y := Fin.val_injective (by rw [hay, hy])
    rw [hae]
    exact hbase b (by omega)
  by_cases hby : (b : ℕ) = d + 1
  · have hbe : b = y := Fin.val_injective (by rw [hby, hy])
    rw [hbe, ← thr_inv (a := x) (b := y) (c := a)
      (Fin.ne_of_val_ne (by rw [hx, hy]; omega))
      (Fin.ne_of_val_ne (by rw [hy]; omega))
      (Fin.ne_of_val_ne (by rw [hx]; omega))]
    exact inv_mem (hbase a (by omega))
  · have hcomp := thr_comp (x := x) (a := y) (b := a) (c := b)
      (Fin.ne_of_val_ne (by rw [hx, hy]; omega))
      (Fin.ne_of_val_ne (by rw [hx]; omega))
      (Fin.ne_of_val_ne (by rw [hx]; omega))
      (Fin.ne_of_val_ne (by rw [hy]; omega))
      hab
      (Fin.ne_of_val_ne (by rw [hy]; omega))
    rw [eq_mul_inv_of_mul_eq hcomp]
    exact mul_mem (hbase b (by omega)) (inv_mem (hbase a (by omega)))

/-! #### The two generators -/

/-- A conjugate of a 3-cycle of `H` by a power of an element of `H` is in `H`. -/
theorem mem_closure_conj {α : Type*} [DecidableEq α] {H : Subgroup (Equiv.Perm α)}
    {s : Equiv.Perm α} (hs : s ∈ H) {a b e : α} (h : thr a b e ∈ H) (n : ℕ) :
    thr ((s ^ n) a) ((s ^ n) b) ((s ^ n) e) ∈ H := by
  rw [← thr_conj]
  exact mul_mem (mul_mem (pow_mem hs n) h) (inv_mem (pow_mem hs n))

/-- `k = d + 2` even: the cycle `s = (0 1 … d)`, which fixes `x = d + 1` and is even
because `d` is, together with the 3-cycle `(x 0 1)`, generate `A_k`. -/
theorem two_generated_even {d : ℕ} (hd : 1 ≤ d) (hdeven : Even d) :
    Subgroup.closure ({thr (⟨d + 1, by omega⟩ : Fin (d + 2)) ⟨0, by omega⟩ ⟨1, by omega⟩,
        Fin.cycleRange (⟨d, by omega⟩ : Fin (d + 2))} : Set (Equiv.Perm (Fin (d + 2))))
      = alternatingGroup (Fin (d + 2)) := by
  classical
  have hdk : d < d + 2 := by omega
  have hjx : (⟨d, hdk⟩ : Fin (d + 2)) < ⟨d + 1, by omega⟩ := Fin.mk_lt_mk.2 (by omega)
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact thr_mem_alternatingGroup (Fin.ne_of_val_ne (by simp))
        (Fin.ne_of_val_ne (by simp))
    · rw [SetLike.mem_coe, Equiv.Perm.mem_alternatingGroup, Fin.sign_cycleRange]
      simpa using hdeven.neg_one_pow
  · refine alternating_le_even (⟨d + 1, by omega⟩ : Fin (d + 2)) rfl ?_
    intro a b hba hbd
    have hsH : Fin.cycleRange (⟨d, hdk⟩ : Fin (d + 2)) ∈
        Subgroup.closure ({thr (⟨d + 1, by omega⟩ : Fin (d + 2)) ⟨0, by omega⟩ ⟨1, by omega⟩,
          Fin.cycleRange (⟨d, hdk⟩ : Fin (d + 2))} : Set (Equiv.Perm (Fin (d + 2)))) :=
      Subgroup.subset_closure (by simp)
    have hcH : thr (⟨d + 1, by omega⟩ : Fin (d + 2)) ⟨0, by omega⟩ ⟨1, by omega⟩ ∈
        Subgroup.closure ({thr (⟨d + 1, by omega⟩ : Fin (d + 2)) ⟨0, by omega⟩ ⟨1, by omega⟩,
          Fin.cycleRange (⟨d, hdk⟩ : Fin (d + 2))} : Set (Equiv.Perm (Fin (d + 2)))) :=
      Subgroup.subset_closure (by simp)
    have hav : (a : ℕ) + 1 ≤ d := by omega
    have h1 := mem_closure_conj hsH hcH (a : ℕ)
    rw [cycleRange_pow_of_gt hjx, cycleRange_pow_mk hdk 0 (a : ℕ) (by omega),
      cycleRange_pow_mk hdk 1 (a : ℕ) (by omega)] at h1
    rw [show (⟨0 + (a : ℕ), by omega⟩ : Fin (d + 2)) = a from Fin.val_injective (by simp),
      show (⟨1 + (a : ℕ), by omega⟩ : Fin (d + 2)) = b from
        Fin.val_injective (by simp [hba]; omega)] at h1
    exact h1

/-- `k = d + 3` odd: the cycle `s = (0 1 … d)`, which fixes both `x = d + 2` and
`y = d + 1` and is even because `d` is, together with the 3-cycle `(x y 0)`, generate
`A_k`. -/
theorem two_generated_odd {d : ℕ} (hdeven : Even d) :
    Subgroup.closure ({thr (⟨d + 2, by omega⟩ : Fin (d + 3)) ⟨d + 1, by omega⟩ ⟨0, by omega⟩,
        Fin.cycleRange (⟨d, by omega⟩ : Fin (d + 3))} : Set (Equiv.Perm (Fin (d + 3))))
      = alternatingGroup (Fin (d + 3)) := by
  classical
  have hdk : d < d + 3 := by omega
  have hjx : (⟨d, hdk⟩ : Fin (d + 3)) < ⟨d + 2, by omega⟩ := Fin.mk_lt_mk.2 (by omega)
  have hjy : (⟨d, hdk⟩ : Fin (d + 3)) < ⟨d + 1, by omega⟩ := Fin.mk_lt_mk.2 (by omega)
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact thr_mem_alternatingGroup (Fin.ne_of_val_ne (by simp))
        (Fin.ne_of_val_ne (by simp))
    · rw [SetLike.mem_coe, Equiv.Perm.mem_alternatingGroup, Fin.sign_cycleRange]
      simpa using hdeven.neg_one_pow
  · refine alternating_le_odd (⟨d + 2, by omega⟩ : Fin (d + 3))
      (⟨d + 1, by omega⟩ : Fin (d + 3)) rfl rfl ?_
    intro b hbd
    have hsH : Fin.cycleRange (⟨d, hdk⟩ : Fin (d + 3)) ∈
        Subgroup.closure ({thr (⟨d + 2, by omega⟩ : Fin (d + 3)) ⟨d + 1, by omega⟩
            ⟨0, by omega⟩,
          Fin.cycleRange (⟨d, hdk⟩ : Fin (d + 3))} : Set (Equiv.Perm (Fin (d + 3)))) :=
      Subgroup.subset_closure (by simp)
    have hcH : thr (⟨d + 2, by omega⟩ : Fin (d + 3)) ⟨d + 1, by omega⟩ ⟨0, by omega⟩ ∈
        Subgroup.closure ({thr (⟨d + 2, by omega⟩ : Fin (d + 3)) ⟨d + 1, by omega⟩
            ⟨0, by omega⟩,
          Fin.cycleRange (⟨d, hdk⟩ : Fin (d + 3))} : Set (Equiv.Perm (Fin (d + 3)))) :=
      Subgroup.subset_closure (by simp)
    have h1 := mem_closure_conj hsH hcH (b : ℕ)
    rw [cycleRange_pow_of_gt hjx, cycleRange_pow_of_gt hjy,
      cycleRange_pow_mk hdk 0 (b : ℕ) (by omega)] at h1
    rw [show (⟨0 + (b : ℕ), by omega⟩ : Fin (d + 3)) = b from Fin.val_injective (by simp)] at h1
    exact h1

end TwoGen

/-- **The alternating group on `k ≥ 3` letters is generated by two elements.**

Used in the proof of Corollary 12.0.6 ("Apply Prop. 12.0.5 to `H := A(Γ)` with `S` a pair
of generators of `H`"), where it is what makes the number of instances `|S| + 1 = 3`.  The
paper uses it as common knowledge and gives no citation, so it is a theorem here, not an
axiom.

The witnesses are the classical ones: a 3-cycle together with a cycle chosen even
according to the parity of `k` (see the module docstring). -/
theorem alternatingGroup_two_generated (k : ℕ) (hk : 3 ≤ k) :
    ∃ a b : Equiv.Perm (Fin k),
      Subgroup.closure ({a, b} : Set (Equiv.Perm (Fin k))) = alternatingGroup (Fin k) := by
  rcases Nat.even_or_odd k with hpar | hpar
  · obtain ⟨d, rfl⟩ : ∃ d, k = d + 2 := ⟨k - 2, by omega⟩
    have h2 : (d + 2) % 2 = 0 := Nat.even_iff.1 hpar
    exact ⟨_, _, TwoGen.two_generated_even (by omega) (Nat.even_iff.2 (by omega))⟩
  · obtain ⟨d, rfl⟩ : ∃ d, k = d + 3 := ⟨k - 3, by omega⟩
    have h2 : (d + 3) % 2 = 1 := Nat.odd_iff.1 hpar
    exact ⟨_, _, TwoGen.two_generated_odd (Nat.even_iff.2 (by omega))⟩

end Babai
