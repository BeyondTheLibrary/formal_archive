/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

Section 13.1: the call accounting of Theorem 13.1.3 (`≤ t!n²` String Isomorphism
instances on domains of size `≤ n/t`).
-/
import Workspace.LocalCertificates.Correctness

/-!
# §13.1 The String Isomorphism instances generated by Procedure LocalCertificates

> The while loop is executed at most `n` times (because `W` strictly increases in each
> round; we exit on line 02 when the window stops growing), so the dominant component of
> the complexity is in recomputing `H(W)`.  We have reduced this to `≤ t!` instances of
> string `N`-isomorphism on the window `W_new`.
>
> By Cor. 10.3.7 ("Affected Orbit Lemma"), each orbit of `N` in `W_new` has length
> `≤ n/t`.
>
> We conclude that strong Luks reduction reduces the recomputation of `H(W)` to `≤ n·t!`
> instances of String Isomorphism on windows of size `≤ n/t`, justifying the stated
> complexity estimate.

An instance is modelled as a triple (group, window, pair of strings) — `Babai.SIInstance`.
One round of Procedure Recompute `H(W)` generates, for each of the `≤ t!` elements
`σ̄ ∈ H(W_old)^T` (line 04c) and each orbit of `N` in `W_new` (the strong Luks reduction of
line 04e), one instance with group the coset `Nσ`, window that orbit, and strings `x, x`.

The two bounds of Theorem 13.1.3 are `Babai.card_allInstances_le` (`≤ t!n²` instances) and
`Babai.instance_window_le` (windows of size `≤ n/t`, stated as `t·|window| ≤ n`).
-/

namespace Babai

open MulAction Equiv Equiv.Perm
open scoped Pointwise
open scoped Classical

variable {Ω Γ Λ : Type*} [Fintype Ω] [DecidableEq Ω] [Fintype Γ] [DecidableEq Γ]
  {G : Subgroup (Equiv.Perm Ω)}

variable (ϕ : G →* Equiv.Perm Γ) (x : Ω → Λ) (T : Set Γ)

/-- The instances generated by one execution of Procedure Recompute `H(W)`: for each
`σ̄ ∈ H(W_old)^T` (line 04c) and each orbit of `N` inside `W_new`, one instance of String
Isomorphism with group `Nσ`, window that orbit, and strings `x`, `x` (line 04e). -/
noncomputable def recomputeInstances (s : Stage ϕ x T)
    (lift : imgOn ϕ T s.le → Equiv.Perm Ω)
    (_hlift : ∀ sb, ∃ h : lift sb ∈ s.H,
      psiOn ϕ T s.le ⟨lift sb, h⟩ = (sb : Equiv.Perm T)) : Finset (SIInstance Ω Λ) :=
  Finset.image
    (fun p : imgOn ϕ T s.le × Ω =>
      ⟨lift p.1 • (kerN s : Set (Equiv.Perm Ω)), orbit (kerN s) p.2, x, x⟩)
    (Finset.univ ×ˢ s.aff.toFinset)

/-- All the String Isomorphism instances that Procedure LocalCertificates solves: those of
the `haltIndex` executions of Procedure Recompute `H(W)` on line 04. -/
noncomputable def allInstances
    (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω)
    (hlift : ∀ (i : ℕ) (sb : imgOn ϕ T (stages ϕ x T i).le),
      ∃ h : lift i sb ∈ (stages ϕ x T i).H,
        psiOn ϕ T (stages ϕ x T i).le ⟨lift i sb, h⟩ = (sb : Equiv.Perm T)) :
    Finset (SIInstance Ω Λ) :=
  (Finset.range (haltIndex ϕ x T)).biUnion fun i =>
    recomputeInstances ϕ x T (stages ϕ x T i) (lift i) (hlift i)

variable {ϕ x T}

/-! ### The number of instances -/

/-- "We have reduced this to `≤ t!` instances of string `N`-isomorphism": the group
`H(W_old)^T` is a subgroup of `S(T)`, so it has at most `t!` elements. -/
theorem card_imgOn_le_factorial {L : Subgroup (Equiv.Perm Ω)} (hL : L ≤ bigGT ϕ T) :
    Nat.card (imgOn ϕ T hL) ≤ Nat.factorial T.ncard := by
  have h1 : Nat.card (imgOn ϕ T hL) ≤ Nat.card (Equiv.Perm T) :=
    Nat.card_le_card_of_injective (fun g => (g : Equiv.Perm T)) Subtype.val_injective
  have h2 : Nat.card (Equiv.Perm T) = Nat.factorial (Fintype.card (T : Set Γ)) := by
    rw [Nat.card_eq_fintype_card, Fintype.card_perm]
  have h3 : Fintype.card (T : Set Γ) = T.ncard := by
    rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq]
  rw [h2, h3] at h1
  exact h1

/-- One execution of Procedure Recompute `H(W)` generates at most `t!·n` instances. -/
theorem card_recomputeInstances_le (s : Stage ϕ x T)
    (lift : imgOn ϕ T s.le → Equiv.Perm Ω)
    (hlift : ∀ sb, ∃ h : lift sb ∈ s.H,
      psiOn ϕ T s.le ⟨lift sb, h⟩ = (sb : Equiv.Perm T)) :
    (recomputeInstances ϕ x T s lift hlift).card ≤ Nat.factorial T.ncard * Nat.card Ω := by
  refine le_trans (Finset.card_image_le) ?_
  rw [Finset.card_product]
  have h1 : (Finset.univ : Finset (imgOn ϕ T s.le)).card ≤ Nat.factorial T.ncard := by
    rw [Finset.card_univ, ← Nat.card_eq_fintype_card]
    exact card_imgOn_le_factorial s.le
  have h2 : s.aff.toFinset.card ≤ Nat.card Ω := by
    rw [Nat.card_eq_fintype_card]
    exact Finset.card_le_univ _
  exact Nat.mul_le_mul h1 h2

/-- "The while loop is executed at most `n` times (because `W` strictly increases in each
round)." -/
theorem haltIndex_le_card : haltIndex ϕ x T ≤ Nat.card Ω := by
  have h := le_ncard_stages_W (ϕ := ϕ) (x := x) (T := T) (haltIndex ϕ x T)
    fun j hj => loopCond_of_lt_haltIndex ϕ x T hj
  have hle : (stages ϕ x T (haltIndex ϕ x T)).W.ncard ≤ Nat.card Ω := by
    have := Set.ncard_le_ncard (Set.subset_univ (stages ϕ x T (haltIndex ϕ x T)).W)
      (Set.toFinite _)
    rwa [Set.ncard_univ] at this
  omega

/-- **Theorem 13.1.3**, the number of calls.

> By making `≤ t!n²` calls to String Isomorphism problems … -/
theorem card_allInstances_le
    (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω)
    (hlift : ∀ (i : ℕ) (sb : imgOn ϕ T (stages ϕ x T i).le),
      ∃ h : lift i sb ∈ (stages ϕ x T i).H,
        psiOn ϕ T (stages ϕ x T i).le ⟨lift i sb, h⟩ = (sb : Equiv.Perm T)) :
    (allInstances ϕ x T lift hlift).card ≤ Nat.factorial T.ncard * (Nat.card Ω) ^ 2 := by
  refine le_trans (Finset.card_biUnion_le) ?_
  refine le_trans (Finset.sum_le_sum (fun i _ =>
    card_recomputeInstances_le (stages ϕ x T i) (lift i) (hlift i))) ?_
  rw [Finset.sum_const, Finset.card_range, smul_eq_mul, pow_two, ← mul_assoc,
    mul_comm (haltIndex ϕ x T), mul_assoc]
  exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ haltIndex_le_card)

/-! ### The size of the domains -/

/-- The orbits of `N` (as a subgroup of `S(Ω)`) and of `ker(ψ̄_T)` (as a subgroup of
`H(W_old)`) are the same subsets of `Ω`. -/
theorem orbit_kerN (s : Stage ϕ x T) (u : Ω) :
    (orbit (kerN s) u : Set Ω) = (orbit (psiOn ϕ T s.le).ker u : Set Ω) := by
  ext v
  constructor
  · rintro ⟨⟨σ, hσ⟩, rfl⟩
    obtain ⟨hmem, hker⟩ := (mem_kerN s).1 hσ
    exact ⟨⟨⟨σ, hmem⟩, hker⟩, rfl⟩
  · rintro ⟨⟨⟨σ, hmem⟩, hker⟩, rfl⟩
    exact ⟨⟨σ, (mem_kerN s).2 ⟨hmem, hker⟩⟩, rfl⟩

/-- **Theorem 13.1.3**, the size of the domains, via Corollary 10.3.7.

> By Cor. 10.3.7 ("Affected Orbit Lemma"), each orbit of `N` in `W_new` has length
> `≤ n/t`.

Stated multiplicatively (`t · |orbit| ≤ n`), as in `Babai.corollary_10_3_7`.  The
hypothesis is the loop condition of line 02, which holds while the loop runs: `H(W_old)`
induces a giant on `T`. -/
theorem orbit_kerN_card_le (s : Stage ϕ x T) (hgiant : alternatingGroup T ≤ imgOn ϕ T s.le)
    (h5 : 5 ≤ T.ncard) {u : Ω} (hu : u ∈ s.aff) :
    T.ncard * (orbit (kerN s) u : Set Ω).ncard ≤ Nat.card Ω := by
  have hcard : Nat.card T = T.ncard := Nat.card_coe_set_eq T
  -- all points of the orbit of `u` in `H(W_old)` are affected (`Aff` is invariant)
  have haff : ∀ z ∈ orbit s.H u, AffectedIn (psiOn ϕ T s.le) z := by
    intro z hz
    exact affectedIn_of_mem_orbit _ hz hu
  have h := corollary_10_3_7_gen (psiOn ϕ T s.le) hgiant (by rw [hcard]; omega) u haff u
    (mem_orbit_self u)
  rw [hcard] at h
  -- `|orbit_H(u)| ≤ n`
  have horb : Nat.card (orbit s.H u) ≤ Nat.card Ω :=
    Nat.card_le_card_of_injective (fun v => (v : Ω)) Subtype.val_injective
  have hrw : (orbit (kerN s) u : Set Ω).ncard = Nat.card (orbit (psiOn ϕ T s.le).ker u) := by
    rw [orbit_kerN s u, Nat.card_coe_set_eq]
  rw [hrw]
  omega

/-- **Theorem 13.1.3**, the size of the domains, for the instances actually generated:
every instance of `Babai.allInstances` has a window of size `≤ n/t`. -/
theorem instance_window_le (h5 : 5 ≤ T.ncard)
    (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω)
    (hlift : ∀ (i : ℕ) (sb : imgOn ϕ T (stages ϕ x T i).le),
      ∃ h : lift i sb ∈ (stages ϕ x T i).H,
        psiOn ϕ T (stages ϕ x T i).le ⟨lift i sb, h⟩ = (sb : Equiv.Perm T))
    {I : SIInstance Ω Λ} (hI : I ∈ allInstances ϕ x T lift hlift) :
    T.ncard * I.Δ.ncard ≤ Nat.card Ω := by
  rw [allInstances, Finset.mem_biUnion] at hI
  obtain ⟨i, hi, hI⟩ := hI
  rw [recomputeInstances, Finset.mem_image] at hI
  obtain ⟨⟨sb, u⟩, hmem, rfl⟩ := hI
  rw [Finset.mem_product] at hmem
  have hu : u ∈ (stages ϕ x T i).aff := by
    have := hmem.2
    rwa [Set.mem_toFinset] at this
  have hgiant := (loopCond_of_lt_haltIndex ϕ x T (Finset.mem_range.1 hi)).1
  exact orbit_kerN_card_le (stages ϕ x T i) hgiant h5 hu

/-! ### Procedure LocalCertificates as a named reduction

The bounds above are bounds on `Babai.allInstances`, the set of String Isomorphism
instances that Procedure LocalCertificates solves.  To make Theorem 13.1.3's cost clause a
statement about *the procedure* and not about an existentially quantified reduction (see
the corrected paper, for why `∃ R, …` carries no information), the procedure is
named as a reduction in the shared model of `Workspace/Luks/Instances.lean`.

The value of the reduction is *assembled from the answers*: each round of Procedure
Recompute `H(W)` unites, over the `≤ t!` cosets `Nσ` of Eq. (69), the intersection over the
orbits of `N` in `W_new` of the answers returned for those orbits
(`Babai.run_recomputeReduction`, which is Eq. (69) plus `Babai.recompute_eq`), and the
while loop intersects each round's group with the previous one
(`H(W_new) = Aut^{W_new}_{H(W_old)}(x) ≤ H(W_old)`).  A group read off the answers is only
a *set* of permutations, so the procedure turns it into a group by
`Babai.groupOf S = ⟨S⟩ ⊓ G_T`, which is `S` itself whenever `S` is a subgroup of `G_T`
(`Babai.groupOf_coe`); the window of the next round and the two certificates are then
read off `Babai.groupOf` of the assembled set (`Babai.affOf`, `Babai.certKOf`,
`Babai.certMOf`).  The *running times* are covered inside the RAM proof of Theorem 1.1.1
(`Algo.theorem_1_1_1`) and not stated as a separate RAM theorem; see the corrected paper.
-/

/-- Ask the instances `Is` in turn and intersect the answers with the group `K`: the strong
Luks reduction of line 04e, whose value is a function of the answers. -/
def interAnswers (K : Set (Equiv.Perm Ω)) :
    List (SIInstance Ω Λ) → SIReduction Ω Λ (Set (Equiv.Perm Ω))
  | [] => .done K
  | I :: rest => .call I (fun a => (interAnswers K rest).bind (fun b => .done (a ∩ b)))

@[simp] theorem calls_interAnswers (K : Set (Equiv.Perm Ω)) (Is : List (SIInstance Ω Λ)) :
    (interAnswers K Is).calls = Is := by
  induction Is with
  | nil => rfl
  | cons I rest ih => simp [interAnswers, ih]

theorem run_interAnswers (K : Set (Equiv.Perm Ω)) (Is : List (SIInstance Ω Λ)) :
    (interAnswers K Is).run = K ∩ ⋂ I ∈ Is, I.answer := by
  induction Is with
  | nil => simp [interAnswers]
  | cons I rest ih =>
      simp only [interAnswers, SIReduction.run_call, SIReduction.run_bind, ih,
        SIReduction.run_done]
      ext τ
      simp only [Set.mem_inter_iff, Set.mem_iInter, List.mem_cons]
      constructor
      · rintro ⟨hI, hK, h⟩
        exact ⟨hK, by rintro J (rfl | hJ); exacts [hI, h J hJ]⟩
      · rintro ⟨hK, h⟩
        exact ⟨h I (Or.inl rfl), hK, fun J hJ => h J (Or.inr hJ)⟩

/-- Run the reductions of `L` in turn and unite their values: the union of Eq. (69), whose
value is a function of the answers. -/
def unionAnswers :
    List (SIReduction Ω Λ (Set (Equiv.Perm Ω))) → SIReduction Ω Λ (Set (Equiv.Perm Ω))
  | [] => .done ∅
  | R :: rest => R.bind (fun a => (unionAnswers rest).bind (fun b => .done (a ∪ b)))

@[simp] theorem calls_unionAnswers (L : List (SIReduction Ω Λ (Set (Equiv.Perm Ω)))) :
    (unionAnswers L).calls = L.flatMap SIReduction.calls := by
  induction L with
  | nil => rfl
  | cons R rest ih => simp [unionAnswers, ih]

theorem run_unionAnswers (L : List (SIReduction Ω Λ (Set (Equiv.Perm Ω)))) :
    (unionAnswers L).run = ⋃ R ∈ L, R.run := by
  induction L with
  | nil => simp [unionAnswers]
  | cons R rest ih =>
      simp only [unionAnswers, SIReduction.run_bind, ih, SIReduction.run_done]
      ext τ
      simp only [Set.mem_union, Set.mem_iUnion, List.mem_cons, exists_prop]
      constructor
      · rintro (h | ⟨S, hS, h⟩)
        · exact ⟨R, Or.inl rfl, h⟩
        · exact ⟨S, Or.inr hS, h⟩
      · rintro ⟨S, (rfl | hS), h⟩
        · exact Or.inl h
        · exact Or.inr ⟨S, hS, h⟩

/-! #### One round: Procedure Recompute `H(W)` as a reduction -/

/-- The orbits of `N` meet the new window `W_new = Aff(H(W_old), ψ_T)` in full: `W_new` is
`H(W_old)`-invariant and `N ≤ H(W_old)`. -/
theorem orbit_kerN_subset_aff (s : Stage ϕ x T) {u : Ω} (hu : u ∈ s.aff) :
    (orbit (kerN s) u : Set Ω) ⊆ s.aff := by
  rintro v ⟨g, rfl⟩
  exact ((isInvariant_iff_mem _ _).1 s.isInvariant_aff (g : Equiv.Perm Ω)
    (kerN_le s g.2) u).1 hu

/-- The strong Luks reduction of line 04e is *correct*: the window automorphisms of `x` on
`W_new` inside a coset `Nσ` are cut out by the answers on the orbits of `N` separately,
because `W_new` is a union of orbits of `N` (`Babai.orbit_kerN_subset_aff`). -/
theorem inter_orbit_wIso (s : Stage ϕ x T) (K : Set (Equiv.Perm Ω)) :
    (K ∩ ⋂ u ∈ s.aff, wIso (orbit (kerN s) u : Set Ω) K x x) = wAut s.aff K x := by
  ext τ
  simp only [Set.mem_inter_iff, Set.mem_iInter, wAut, wIso, Set.mem_sep_iff]
  constructor
  · rintro ⟨hK, h⟩
    exact ⟨hK, fun v hv => (h v hv).2 v (mem_orbit_self v)⟩
  · rintro ⟨hK, h⟩
    exact ⟨hK, fun u hu => ⟨hK, fun v hv => h v (orbit_kerN_subset_aff s hu hv)⟩⟩

/-- The instances of one round, for one coset `Nσ` of Eq. (69): one per orbit of `N` in
`W_new`. -/
noncomputable def roundInstances (s : Stage ϕ x T) (K : Set (Equiv.Perm Ω)) :
    List (SIInstance Ω Λ) :=
  s.aff.toFinset.toList.map fun u => ⟨K, (orbit (kerN s) u : Set Ω), x, x⟩

theorem mem_roundInstances_iff (s : Stage ϕ x T) (K : Set (Equiv.Perm Ω))
    {I : SIInstance Ω Λ} :
    I ∈ roundInstances (Λ := Λ) (x := x) s K ↔
      ∃ u ∈ s.aff, I = ⟨K, (orbit (kerN s) u : Set Ω), x, x⟩ := by
  rw [roundInstances, List.mem_map]
  constructor
  · rintro ⟨u, hu, rfl⟩; exact ⟨u, by simpa using hu, rfl⟩
  · rintro ⟨u, hu, rfl⟩; exact ⟨u, by simpa using hu, rfl⟩

theorem iInter_answer_roundInstances (s : Stage ϕ x T) (K : Set (Equiv.Perm Ω)) :
    (⋂ I ∈ roundInstances (Λ := Λ) (x := x) s K, I.answer)
      = ⋂ u ∈ s.aff, wIso (orbit (kerN s) u : Set Ω) K x x := by
  ext τ
  constructor
  · intro h
    refine Set.mem_iInter₂.2 fun u hu => ?_
    exact Set.mem_iInter₂.1 h _ ((mem_roundInstances_iff s K).2 ⟨u, hu, rfl⟩)
  · intro h
    refine Set.mem_iInter₂.2 ?_
    rintro I hI
    obtain ⟨u, hu, rfl⟩ := (mem_roundInstances_iff s K).1 hI
    exact Set.mem_iInter₂.1 h u hu

/-- The instances of one round, grouped by the coset `Nσ` of Eq. (69) they belong to. -/
noncomputable def roundLists (s : Stage ϕ x T) (lift : imgOn ϕ T s.le → Equiv.Perm Ω) :
    List (List (SIInstance Ω Λ)) :=
  (Finset.univ : Finset (imgOn ϕ T s.le)).toList.map fun sb =>
    roundInstances (Λ := Λ) (x := x) s ((lift sb) • (kerN s : Set (Equiv.Perm Ω)))

/-- Procedure Recompute `H(W)` (lines 04a–04h) as a reduction: for each `σ̄ ∈ H(W_old)^T`
(line 04c) run the strong Luks reduction over the orbits of `N` in `W_new` (line 04e), and
unite the results, as in Eq. (69). -/
noncomputable def recomputeReduction (s : Stage ϕ x T)
    (lift : imgOn ϕ T s.le → Equiv.Perm Ω) : SIReduction Ω Λ (Set (Equiv.Perm Ω)) :=
  unionAnswers ((Finset.univ : Finset (imgOn ϕ T s.le)).toList.map fun sb =>
    interAnswers ((lift sb) • (kerN s : Set (Equiv.Perm Ω)))
      (roundInstances (Λ := Λ) (x := x) s ((lift sb) • (kerN s : Set (Equiv.Perm Ω)))))

/-- The value of one round is `H(W_new)`, computed from the answers: this is Eq. (69)
(`Babai.eq_69`), the correctness of the strong Luks reduction
(`Babai.inter_orbit_wIso`) and `Babai.recompute_eq`. -/
theorem run_recomputeReduction (s : Stage ϕ x T) (lift : imgOn ϕ T s.le → Equiv.Perm Ω)
    (hlift : ∀ sb, ∃ h : lift sb ∈ s.H,
      psiOn ϕ T s.le ⟨lift sb, h⟩ = (sb : Equiv.Perm T)) :
    (recomputeReduction (Λ := Λ) (x := x) s lift).run = (s.step.H : Set (Equiv.Perm Ω)) := by
  rw [← recompute_eq s lift hlift, recomputeReduction, run_unionAnswers]
  have key : ∀ sb : imgOn ϕ T s.le,
      (interAnswers ((lift sb) • (kerN s : Set (Equiv.Perm Ω)))
        (roundInstances (Λ := Λ) (x := x) s ((lift sb) • (kerN s : Set (Equiv.Perm Ω))))).run
        = wAut s.aff ((lift sb) • (kerN s : Set (Equiv.Perm Ω))) x := by
    intro sb
    rw [run_interAnswers, iInter_answer_roundInstances, inter_orbit_wIso]
  ext τ
  constructor
  · intro h
    obtain ⟨R, hR, hτ⟩ := Set.mem_iUnion₂.1 h
    obtain ⟨sb, -, rfl⟩ := List.mem_map.1 hR
    rw [key sb] at hτ
    exact Set.mem_iUnion.2 ⟨sb, hτ⟩
  · intro h
    obtain ⟨sb, hsb⟩ := Set.mem_iUnion.1 h
    refine Set.mem_iUnion₂.2 ⟨_, List.mem_map_of_mem (Finset.mem_toList.2 (Finset.mem_univ sb)),
      ?_⟩
    rw [key sb]
    exact hsb

theorem calls_recomputeReduction (s : Stage ϕ x T) (lift : imgOn ϕ T s.le → Equiv.Perm Ω) :
    (recomputeReduction (Λ := Λ) (x := x) s lift).calls
      = List.flatMap id (roundLists (Λ := Λ) (x := x) s lift) := by
  rw [recomputeReduction, calls_unionAnswers, roundLists, List.flatMap_map, List.flatMap_map]
  simp only [Function.comp_def, calls_interAnswers, id_eq]

theorem length_calls_recomputeReduction (s : Stage ϕ x T)
    (lift : imgOn ϕ T s.le → Equiv.Perm Ω) :
    (recomputeReduction (Λ := Λ) (x := x) s lift).calls.length
      ≤ Nat.factorial T.ncard * Nat.card Ω := by
  rw [calls_recomputeReduction, List.length_flatMap]
  have hb : ∀ k ∈ (roundLists (Λ := Λ) (x := x) s lift).map (List.length ∘ id),
      k ≤ Nat.card Ω := by
    intro k hk
    obtain ⟨l, hl, rfl⟩ := List.mem_map.1 hk
    obtain ⟨sb, -, rfl⟩ := List.mem_map.1 hl
    simp only [Function.comp_apply, id_eq, roundInstances, List.length_map,
      Finset.length_toList]
    rw [Nat.card_eq_fintype_card]
    exact Finset.card_le_univ _
  refine le_trans (List.sum_le_card_nsmul _ _ hb) ?_
  simp only [List.length_map, roundLists, Finset.length_toList, Finset.card_univ, smul_eq_mul]
  exact Nat.mul_le_mul_right _ (by
    rw [← Nat.card_eq_fintype_card]; exact card_imgOn_le_factorial s.le)

theorem mem_calls_recomputeReduction (s : Stage ϕ x T)
    (lift : imgOn ϕ T s.le → Equiv.Perm Ω) {I : SIInstance Ω Λ}
    (hI : I ∈ (recomputeReduction (Λ := Λ) (x := x) s lift).calls) :
    ∃ u ∈ s.aff, I.Δ = (orbit (kerN s) u : Set Ω) := by
  rw [calls_recomputeReduction, List.mem_flatMap] at hI
  obtain ⟨l, hl, hIl⟩ := hI
  rw [roundLists, List.mem_map] at hl
  obtain ⟨sb, -, rfl⟩ := hl
  obtain ⟨u, hu, rfl⟩ := (mem_roundInstances_iff s _).1 hIl
  exact ⟨u, hu, rfl⟩

/-! #### Reading a group off the answers -/

variable (ϕ T)

/-- The group the procedure attaches to a set `S` of permutations read off the answers:
`⟨S⟩ ⊓ G_T`.  It is `S` itself whenever `S` is (the carrier of) a subgroup of `G_T`, and
it always satisfies the loop invariant `H ≤ G_T`, so the procedure can apply `ψ_T` to
it. -/
def groupOf (S : Set (Equiv.Perm Ω)) : Subgroup (Equiv.Perm Ω) :=
  Subgroup.closure S ⊓ bigGT ϕ T

theorem groupOf_le (S : Set (Equiv.Perm Ω)) : groupOf ϕ T S ≤ bigGT ϕ T := inf_le_right

theorem groupOf_coe {K : Subgroup (Equiv.Perm Ω)} (hK : K ≤ bigGT ϕ T) :
    groupOf ϕ T (K : Set (Equiv.Perm Ω)) = K := by
  rw [groupOf, Subgroup.closure_eq, inf_eq_left]
  exact hK

variable {ϕ T}

theorem affectedIn_congr {H₁ H₂ : Subgroup (Equiv.Perm Ω)} (h : H₁ = H₂)
    (h₁ : H₁ ≤ bigGT ϕ T) (h₂ : H₂ ≤ bigGT ϕ T) (u : Ω) :
    AffectedIn (psiOn ϕ T h₁) u ↔ AffectedIn (psiOn ϕ T h₂) u := by
  subst h; rfl

theorem imgOn_congr {H₁ H₂ : Subgroup (Equiv.Perm Ω)} (h : H₁ = H₂)
    (h₁ : H₁ ≤ bigGT ϕ T) (h₂ : H₂ ≤ bigGT ϕ T) :
    imgOn ϕ T h₁ = imgOn ϕ T h₂ := by
  subst h; rfl

variable (ϕ T)

/-- Line 03 applied to a group read off the answers: the new window. -/
def affOf (S : Set (Equiv.Perm Ω)) : Set Ω :=
  {u | AffectedIn (psiOn ϕ T (groupOf_le ϕ T S)) u}

/-- Line 08 applied to a group read off the answers: `K(T) = H(W)_(W̄)`. -/
def certKOf (W : Set Ω) (S : Set (Equiv.Perm Ω)) : Subgroup (Equiv.Perm Ω) :=
  pointwiseStabilizer (groupOf ϕ T S) Wᶜ

/-- Line 10 applied to a group read off the answers: `M(T) = H(W)^T`. -/
def certMOf (S : Set (Equiv.Perm Ω)) : Subgroup (Equiv.Perm T) :=
  imgOn ϕ T (groupOf_le ϕ T S)

variable {ϕ T}

theorem affOf_coe (s : Stage ϕ x T) : affOf ϕ T (s.H : Set (Equiv.Perm Ω)) = s.aff := by
  ext u
  exact affectedIn_congr (groupOf_coe ϕ T s.le) _ _ u

theorem certKOf_coe (s : Stage ϕ x T) (W : Set Ω) :
    certKOf ϕ T W (s.H : Set (Equiv.Perm Ω)) = pointwiseStabilizer s.H Wᶜ := by
  rw [certKOf, groupOf_coe ϕ T s.le]

theorem certMOf_coe (s : Stage ϕ x T) :
    certMOf ϕ T (s.H : Set (Equiv.Perm Ω)) = imgOn ϕ T s.le :=
  imgOn_congr (groupOf_coe ϕ T s.le) _ _

/-! #### The while loop as a reduction -/

variable (ϕ x T)

/-- The first `i` rounds of the while loop (lines 02–05) as a reduction: it carries the
pair `(W, H(W))`, recomputing `H(W_new)` from the answers of round `i` and intersecting it
with the group carried from the previous round
(`H(W_new) = Aut^{W_new}_{H(W_old)}(x) ≤ H(W_old)`). -/
noncomputable def loopReduction
    (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω) :
    ℕ → SIReduction Ω Λ (Set Ω × Set (Equiv.Perm Ω))
  | 0 => .done (∅, (bigGT ϕ T : Set (Equiv.Perm Ω)))
  | (i + 1) => (loopReduction lift i).bind fun p =>
      (recomputeReduction (Λ := Λ) (x := x) (stages ϕ x T i) (lift i)).bind fun cur =>
        .done (affOf ϕ T p.2, p.2 ∩ cur)

variable {ϕ x T}

/-- The value carried after `i` rounds is the pair `(W, H(W))` of stage `i`, and it is
computed from the answers to the calls of the first `i` rounds. -/
theorem run_loopReduction (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω)
    (hlift : ∀ (i : ℕ) (sb : imgOn ϕ T (stages ϕ x T i).le),
      ∃ h : lift i sb ∈ (stages ϕ x T i).H,
        psiOn ϕ T (stages ϕ x T i).le ⟨lift i sb, h⟩ = (sb : Equiv.Perm T)) (i : ℕ) :
    (loopReduction ϕ x T lift i (Λ := Λ)).run
      = ((stages ϕ x T i).W, ((stages ϕ x T i).H : Set (Equiv.Perm Ω))) := by
  induction i with
  | zero => rfl
  | succ i ih =>
      rw [loopReduction, SIReduction.run_bind, ih, SIReduction.run_bind,
        run_recomputeReduction (stages ϕ x T i) (lift i) (hlift i), SIReduction.run_done]
      refine Prod.ext ?_ ?_
      · exact affOf_coe (stages ϕ x T i)
      · simp only
        rw [Set.inter_eq_self_of_subset_right]
        · rfl
        · exact fun σ hσ => (stages ϕ x T i).step_H_le hσ

theorem calls_loopReduction (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω)
    (hlift : ∀ (i : ℕ) (sb : imgOn ϕ T (stages ϕ x T i).le),
      ∃ h : lift i sb ∈ (stages ϕ x T i).H,
        psiOn ϕ T (stages ϕ x T i).le ⟨lift i sb, h⟩ = (sb : Equiv.Perm T)) (i : ℕ) :
    (loopReduction ϕ x T lift (i + 1) (Λ := Λ)).calls
      = (loopReduction ϕ x T lift i (Λ := Λ)).calls
        ++ (recomputeReduction (Λ := Λ) (x := x) (stages ϕ x T i) (lift i)).calls := by
  rw [loopReduction, SIReduction.calls_bind, SIReduction.calls_bind]
  simp

theorem length_calls_loopReduction
    (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω)
    (hlift : ∀ (i : ℕ) (sb : imgOn ϕ T (stages ϕ x T i).le),
      ∃ h : lift i sb ∈ (stages ϕ x T i).H,
        psiOn ϕ T (stages ϕ x T i).le ⟨lift i sb, h⟩ = (sb : Equiv.Perm T)) (i : ℕ) :
    (loopReduction ϕ x T lift i (Λ := Λ)).calls.length
      ≤ i * (Nat.factorial T.ncard * Nat.card Ω) := by
  induction i with
  | zero => simp [loopReduction]
  | succ i ih =>
      rw [calls_loopReduction lift hlift i, List.length_append]
      have := length_calls_recomputeReduction (Λ := Λ) (x := x) (stages ϕ x T i) (lift i)
      have : (loopReduction ϕ x T lift i (Λ := Λ)).calls.length
          + (recomputeReduction (Λ := Λ) (x := x) (stages ϕ x T i) (lift i)).calls.length
          ≤ i * (Nat.factorial T.ncard * Nat.card Ω)
            + Nat.factorial T.ncard * Nat.card Ω := Nat.add_le_add ih this
      calc (loopReduction ϕ x T lift i (Λ := Λ)).calls.length
            + (recomputeReduction (Λ := Λ) (x := x) (stages ϕ x T i) (lift i)).calls.length
          ≤ i * (Nat.factorial T.ncard * Nat.card Ω)
            + Nat.factorial T.ncard * Nat.card Ω := this
        _ = (i + 1) * (Nat.factorial T.ncard * Nat.card Ω) := by ring

theorem mem_calls_loopReduction
    (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω)
    (hlift : ∀ (i : ℕ) (sb : imgOn ϕ T (stages ϕ x T i).le),
      ∃ h : lift i sb ∈ (stages ϕ x T i).H,
        psiOn ϕ T (stages ϕ x T i).le ⟨lift i sb, h⟩ = (sb : Equiv.Perm T)) :
    ∀ (i : ℕ) {I : SIInstance Ω Λ}, I ∈ (loopReduction ϕ x T lift i (Λ := Λ)).calls →
      ∃ j < i, ∃ u ∈ (stages ϕ x T j).aff,
        I.Δ = (orbit (kerN (stages ϕ x T j)) u : Set Ω) := by
  intro i
  induction i with
  | zero => intro I hI; simp [loopReduction] at hI
  | succ i ih =>
      intro I hI
      rw [calls_loopReduction lift hlift i, List.mem_append] at hI
      rcases hI with hI | hI
      · obtain ⟨j, hj, hu⟩ := ih hI
        exact ⟨j, by omega, hu⟩
      · obtain ⟨u, hu, hΔ⟩ :=
          mem_calls_recomputeReduction (stages ϕ x T i) (lift i) hI
        exact ⟨i, by omega, u, hu, hΔ⟩

/-! #### Procedure LocalCertificates as a reduction -/

variable (ϕ x T)

/-- Procedure LocalCertificates as a reduction in the model of §11.1: it runs the while
loop (lines 02–05), and returns the triple `(W(T), K(T), M(T))` of lines 06, 08 and 10,
computed from the group that the answers have produced. -/
noncomputable def localCertReduction
    (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω) :
    SIReduction Ω Λ (Set Ω × Subgroup (Equiv.Perm Ω) × Subgroup (Equiv.Perm T)) :=
  (loopReduction ϕ x T lift (haltIndex ϕ x T) (Λ := Λ)).bind fun p =>
    .done (p.1, certKOf ϕ T p.1 p.2, certMOf ϕ T p.2)

variable {ϕ x T}

/-- The value of the reduction is the triple of outputs of lines 06, 08, 10 — and it is
obtained from the answers to the calls, through `Babai.run_loopReduction`. -/
theorem run_localCertReduction
    (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω)
    (hlift : ∀ (i : ℕ) (sb : imgOn ϕ T (stages ϕ x T i).le),
      ∃ h : lift i sb ∈ (stages ϕ x T i).H,
        psiOn ϕ T (stages ϕ x T i).le ⟨lift i sb, h⟩ = (sb : Equiv.Perm T)) :
    (localCertReduction ϕ x T lift (Λ := Λ)).run
      = (windowOut ϕ x T, certK ϕ x T, certM ϕ x T) := by
  rw [localCertReduction, SIReduction.run_bind, run_loopReduction lift hlift,
    SIReduction.run_done]
  refine Prod.ext rfl (Prod.ext ?_ ?_)
  · exact certKOf_coe (outStage ϕ x T) (windowOut ϕ x T)
  · exact certMOf_coe (outStage ϕ x T)

/-- **Theorem 13.1.3**, the cost clause, as a statement about Procedure LocalCertificates:

> By making `≤ t!n²` calls to String Isomorphism problems on domains of size `≤ n/t` … -/
theorem theorem_13_1_3_calls (h5 : 5 ≤ T.ncard)
    (lift : ∀ i : ℕ, imgOn ϕ T (stages ϕ x T i).le → Equiv.Perm Ω)
    (hlift : ∀ (i : ℕ) (sb : imgOn ϕ T (stages ϕ x T i).le),
      ∃ h : lift i sb ∈ (stages ϕ x T i).H,
        psiOn ϕ T (stages ϕ x T i).le ⟨lift i sb, h⟩ = (sb : Equiv.Perm T)) :
    (localCertReduction ϕ x T lift (Λ := Λ)).calls.length
        ≤ Nat.factorial T.ncard * (Nat.card Ω) ^ 2 ∧
      (∀ I ∈ (localCertReduction ϕ x T lift (Λ := Λ)).calls,
        T.ncard * I.Δ.ncard ≤ Nat.card Ω) ∧
      (localCertReduction ϕ x T lift (Λ := Λ)).run
        = (windowOut ϕ x T, certK ϕ x T, certM ϕ x T) := by
  have hcalls : (localCertReduction ϕ x T lift (Λ := Λ)).calls
      = (loopReduction ϕ x T lift (haltIndex ϕ x T) (Λ := Λ)).calls := by
    rw [localCertReduction, SIReduction.calls_bind]
    simp
  refine ⟨?_, ?_, run_localCertReduction lift hlift⟩
  · rw [hcalls]
    refine le_trans (length_calls_loopReduction lift hlift _) ?_
    rw [pow_two, ← mul_assoc, mul_comm (haltIndex ϕ x T), mul_assoc]
    exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ haltIndex_le_card)
  · intro I hI
    rw [hcalls] at hI
    obtain ⟨j, hj, u, hu, hΔ⟩ := mem_calls_loopReduction lift hlift _ hI
    rw [hΔ]
    exact orbit_kerN_card_le (stages ϕ x T j)
      (loopCond_of_lt_haltIndex ϕ x T hj).1 h5 hu

/-! ### Procedure LocalCertificates with the selection of line 04d made

`Babai.localCertReduction` takes the selection of line 04d — a preimage `σ ∈ H(W_old)` of
each `σ̄ ∈ H(W_old)^T` — as a parameter.  The selection always exists, because `H(W)^T` is
by definition the image of `H(W)`, so the round can be written with no parameter left.
`Babai.localCertRound` is that round; this is the routine the aggregation of §13.2 runs for
each string and each test set. -/

section Round

variable {Ω Γ Λ : Type*} [Fintype Ω] [DecidableEq Ω] [Fintype Γ] [DecidableEq Γ]
  {G : Subgroup (Equiv.Perm Ω)} {ϕ : G →* Equiv.Perm Γ} {x : Ω → Λ} {T : Set Γ}

/-- `H(W)^T` is the image of `ψ̄_T` (`Babai.imgOn_eq_range`). -/
theorem coe_mem_range_psiOn (s : Stage ϕ x T) (sb : imgOn ϕ T s.le) :
    (sb : Equiv.Perm T) ∈ (psiOn ϕ T s.le).range := sb.2

/-- Line 04d: **a preimage of `σ̄` in `H(W_old)`**.  Every element of `H(W)^T` has one,
because that group is the image of `ψ̄_T`. -/
noncomputable def certLiftSub (s : Stage ϕ x T) (sb : imgOn ϕ T s.le) : s.H :=
  (MonoidHom.mem_range.1 (coe_mem_range_psiOn s sb)).choose

theorem psiOn_certLiftSub (s : Stage ϕ x T) (sb : imgOn ϕ T s.le) :
    psiOn ϕ T s.le (certLiftSub s sb) = (sb : Equiv.Perm T) :=
  (MonoidHom.mem_range.1 (coe_mem_range_psiOn s sb)).choose_spec

/-- Line 04d, read inside `S(Ω)`: the selection `Babai.localCertReduction` asks for. -/
noncomputable def certLift (s : Stage ϕ x T) (sb : imgOn ϕ T s.le) : Equiv.Perm Ω :=
  (certLiftSub s sb : Equiv.Perm Ω)

theorem certLift_spec (s : Stage ϕ x T) (sb : imgOn ϕ T s.le) :
    ∃ h : certLift s sb ∈ s.H,
      psiOn ϕ T s.le ⟨certLift s sb, h⟩ = (sb : Equiv.Perm T) :=
  ⟨(certLiftSub s sb).2, psiOn_certLiftSub s sb⟩

variable (ϕ x T)

/-- §13.1, **Procedure LocalCertificates as a round of the recursion**: the reduction of
`Babai.localCertReduction` with the selection of line 04d made once and for all
(`Babai.certLift`). -/
noncomputable def localCertRound :
    SIReduction Ω Λ (Set Ω × Subgroup (Equiv.Perm Ω) × Subgroup (Equiv.Perm T)) :=
  localCertReduction ϕ x T (fun i => certLift (stages ϕ x T i)) (Λ := Λ)

variable {ϕ x T}

/-- The value of the round is the triple `(W(T), K(T), M(T))` of lines 06, 08 and 10 —
the objects §13.2 aggregates. -/
theorem run_localCertRound :
    (localCertRound ϕ x T (Λ := Λ)).run = (windowOut ϕ x T, certK ϕ x T, certM ϕ x T) :=
  run_localCertReduction _ (fun i => certLift_spec (stages ϕ x T i))

/-- **Theorem 13.1.3**, the cost clause, for the round: at most `t!n²` String Isomorphism
instances, on windows of at most `n/t` points. -/
theorem calls_localCertRound (h5 : 5 ≤ T.ncard) :
    (localCertRound ϕ x T (Λ := Λ)).calls.length
        ≤ Nat.factorial T.ncard * (Nat.card Ω) ^ 2 ∧
      ∀ I ∈ (localCertRound ϕ x T (Λ := Λ)).calls, T.ncard * I.Δ.ncard ≤ Nat.card Ω :=
  let h := theorem_13_1_3_calls h5 _ (fun i => certLift_spec (stages ϕ x T i)) (Λ := Λ)
  ⟨h.1, h.2.1⟩

/-- §13.1 and §15: **the calls of a certificate run make progress**.  A window of at most
`n/t` points with `t ≥ 5` is at most `4n/5`, which is the window alternative of
`Babai.MakesProgress`. -/
theorem five_mul_ncard_le_of_window_le {n k w : ℕ} (h5 : 5 ≤ k) (h : k * w ≤ n) :
    5 * w ≤ 4 * n := by
  have : 5 * w ≤ k * w := Nat.mul_le_mul_right _ h5
  omega

end Round

end Babai
