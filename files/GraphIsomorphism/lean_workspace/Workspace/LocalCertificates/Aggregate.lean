/-!
# §13.2 Aggregating the local certificates

> **Theorem 13.2.1** (AggregateCertificates).  Let `ϕ : G → S(Γ)` be a giant
> representation, where `G ≤ S(Ω)`, `|Ω| = n`, and `|Γ| = m`.  Let
> `max{8, 2 + log₂ n} < t < m/10`.  Then, at a multiplicative cost of `m^{O(t)}`, we can
> either find a canonical colored 4/5-partition of `Γ` or find a canonically embedded
> `t`-ary relational structure with relative symmetry defect `≥ 1/2` on `Γ`, or reduce the
> determination of `Iso_G(x,y)` to `n^{O(1)}` instances of size `≤ 2n/3`.

## The procedure

> Run the LocalCertificates routine for both inputs `x, y` and all test sets
> `T ∈ (Γ choose t)`.  Run the CompareLocalCertificates routine for all pairs
> `((x,T), (x',T'))` where `x` is fixed, `x' ∈ {x,y}`, and `T, T' ∈ (Γ choose t)` are test
> sets (a total of `2·C(m,t)²` runs).
>
> Let `F(x)` be the subgroup generated by the groups `K(T)` for all full subsets
> `T ∈ (Γ choose t)` with reference to input string `x`.  So `F(x)`, and with it `F(x)^Γ`,
> are canonically associated with `x`.  In particular, if `F(y)` is analogously defined
> for `y`, then `F(x)^Γ` is permutationally isomorphic to `F(y)^Γ`, i. e., there exists a
> permutation `α ∈ S(Γ)` such that `F(y)^Γ = α⁻¹F(x)^Γα`.

The counts `C(m,t)` and `2·C(m,t)²` are the paper's own `m^{O(t)}`: this is what the
multiplicative cost of the theorem is (`Babai.card_testSets`, `Babai.card_comparePairs`).
The running time proper is covered inside the RAM proof of Theorem 1.1.1 (`Algo.theorem_1_1_1`)
and not stated as a separate RAM theorem.

## The three cases

> (1) if the nontrivial orbits (orbits of length `≥ 2`) of `F^Γ` cover at least `m/5`
> elements of `Γ` and no orbit of `F^Γ` has length `> 4m/5` we found a colored
> 4/5-partition of `Γ`, exit
>
> (2) else if `F^Γ` has an orbit `C ⊆ Γ` of length `|C| > 4m/5` (: since `|C| > m/2`, this
> orbit is canonical :)
>
> 2a if `F^C ≥ A(C)` then apply Cor. 12.0.10
>
> 2b else let `d` be the degree of transitivity of `F^C` (see Def. 2.2.3) (: so `1 ≤ d ≤ 5`
> by Theorem 2.2.4 :) individualize the elements of a set `S ∈ (C choose d−1)` (: so
> `F^C_{(S)}` is transitive but not doubly transitive on `C' := C ∖ S` :) …
>
> (3) else `|D| ≥ 4m/5` where `D ⊆ Γ` is the set of fixed points of `F^Γ`.

The case split is exhaustive and the arithmetic of (3) is `Babai.four_mul_lt_five_mul_fixed`:
if (1) fails and (2) fails then the nontrivial orbits cover `< m/5` points, so
`|D| > 4m/5`.

## Numbering map

| Paper | Lean |
|---|---|
| `F(x)`, the subgroup generated by the `K(T)` | `Babai.bigF` |
| `F(x)^Γ` | `Babai.bigFGamma` |
| "`F(x)` … canonically associated with `x`" | `Babai.canonical_bigF`, `Babai.canonical_bigFGamma` |
| `D`, the fixed points of `F^Γ` | `Babai.fixedGamma` |
| case (1), the colored 4/5-partition | `Babai.orbitPartition`, `Babai.orbitPartition_isAlphaPartition` |
| the arithmetic of case (3) | `Babai.four_mul_lt_five_mul_fixed` |
| case (2a), the hypothesis of Cor. 12.0.10 | `Babai.Corollary_12_0_10_hypothesis`, `Babai.corollary_12_0_10_hypothesis_of_giant` |
| case (2b), `1 ≤ d ≤ 5` | `Babai.degtrans_restrict_le_five` |
| case (2b), `F^C_{(S)}` transitive, not doubly transitive on `C ∖ S` | `Babai.isTransitive_pointwiseStab_individualize`, `Babai.not_isDoublyTransitive_pointwiseStab_individualize` |
| case (2b), the orbital configuration | `Babai.orbitalConfig_individualize_isCoherent`, `..._isHomogeneous` |
| case (2b), the multiplicative cost `m^{d−1}(m−1)` | `Babai.case2b_cost` |
| case (3), "if `T ⊂ D` then `T` is not full" (and `T ∩ D ≠ ∅`) | `Babai.disjoint_fixedGamma_of_isFull` |
| `F(x)^Γ`, `D` canonically associated with `x` | `Babai.canonical_bigFGamma`, `Babai.canonical_fixedGamma` |
| case (3), the morphisms of `C` and of `𝓛` | `Babai.guideMorC`, `Babai.guideMorL` |
| case (3), "`𝓛` is a `t`-local guide for `C`" | `Babai.mem_compareIso_strAct`, the `guide` field of `Babai.localGuideData` |
| case (3), the two categories | `Babai.localGuideData` |
| case (3), "`Aut(T,i) ≤ M_i(T)`, so `Aut(T,i) ≠ S(T)`" | `Babai.not_isFullAt_guideMorL` |
| case (3), the Claim | `Babai.claim_13_2_1_3`, `Babai.IsCase3Output` |
| case (2b), the constituent defect `≥ 1/2` (Cor. 2.4.12) | `Babai.defect_extConstituent_ge_half`, `Babai.case2b_defect` |
| Theorem 13.2.1 | `Babai.theorem_13_2_1` (one statement), `Babai.theorem_13_2_1_cases` (the case split) |
-/

namespace Babai

open MulAction Equiv Equiv.Perm
open scoped Classical

universe u v

variable {Ω Γ Λ : Type*} [Fintype Ω] [DecidableEq Ω] [Fintype Γ] [DecidableEq Γ]
  {G : Subgroup (Equiv.Perm Ω)}

/-! ### The counts: the paper's `m^{O(t)}` -/

/-- §13.2: "Run the LocalCertificates routine for both inputs `x, y` and all test sets
`T ∈ (Γ choose t)`": the number of test sets is `C(m,t)`. -/
noncomputable def card_testSets (Γ : Type*) [Fintype Γ] (t : ℕ) : ℕ :=
  (Fintype.card Γ).choose t

/-- §13.2: "Run the CompareLocalCertificates routine for all pairs `((x,T), (x',T'))` …
(a total of `2·C(m,t)²` runs)". -/
noncomputable def card_comparePairs (Γ : Type*) [Fintype Γ] (t : ℕ) : ℕ :=
  2 * (card_testSets Γ t) ^ 2

/-! ### `F(x)` and `F(x)^Γ` -/

variable (ϕ : G →* Equiv.Perm Γ) (x : Ω → Λ) (t : ℕ)

/-- §13.2.  "Let `F(x)` be the subgroup generated by the groups `K(T)` for all full
subsets `T ∈ (Γ choose t)` with reference to input string `x`." -/
noncomputable def bigF : Subgroup (Equiv.Perm Ω) :=
  Subgroup.closure (⋃ T ∈ fullSets ϕ x t, (certK ϕ x T : Set (Equiv.Perm Ω)))

variable {ϕ x t}

theorem certK_le_bigF {T : Set Γ} (hT : T ∈ fullSets ϕ x t) :
    certK ϕ x T ≤ bigF ϕ x t := by
  intro σ hσ
  refine Subgroup.subset_closure ?_
  exact Set.mem_biUnion hT hσ

/-- `F(x) ≤ Aut_G(x)`: each generator is a certificate of fullness, hence consists of
`G`-automorphisms of `x` (Theorem 13.1.3 (a), Claim 13.1.6). -/
theorem bigF_le_autG : bigF ϕ x t ≤ autG G x := by
  refine (Subgroup.closure_le _).2 ?_
  intro σ hσ
  obtain ⟨T, -, hσT⟩ := Set.mem_iUnion₂.1 hσ
  have hmem := claim_13_1_6_le_aut (ϕ := ϕ) (x := x) (T := T) hσT
  exact ⟨stabIn_le hmem.1, hmem.2⟩

theorem bigF_le : bigF ϕ x t ≤ G := le_trans (bigF_le_autG) (autG_le G x)

variable (ϕ x t)

/-- §13.2.  `F(x)^Γ`, the image of `F(x)` under the giant representation. -/
noncomputable def bigFGamma : Subgroup (Equiv.Perm Γ) := imgPhi ϕ (bigF_le (ϕ := ϕ) (x := x) (t := t))

/-- §13.2, case (3).  `D ⊆ Γ`, the set of fixed points of `F^Γ`. -/
def fixedGamma : Set Γ := {γ | ∀ b ∈ bigFGamma ϕ x t, (b : Equiv.Perm Γ) γ = γ}

theorem mem_bigFGamma {b : Equiv.Perm Γ} :
    b ∈ bigFGamma ϕ x t ↔ ∃ σ ∈ bigF ϕ x t, ∀ (h : σ ∈ G), ϕ ⟨σ, h⟩ = b := by
  constructor
  · rintro ⟨⟨σ, hσ⟩, rfl⟩
    exact ⟨σ, hσ, fun h => by congr⟩
  · rintro ⟨σ, hσ, hb⟩
    exact ⟨⟨σ, hσ⟩, hb (bigF_le hσ)⟩

/-- A point outside `D` is moved by some element of `F^Γ`. -/
theorem exists_move_of_not_mem_fixedGamma {γ : Γ} (h : γ ∉ fixedGamma ϕ x t) :
    ∃ b ∈ bigFGamma ϕ x t, (b : Equiv.Perm Γ) γ ≠ γ := by
  by_contra hcon
  push_neg at hcon
  exact h hcon

variable {ϕ x t}

/-! ### §13.2, case (3): a full test set meets no fixed point

> Note that in this case, if `T ⊂ D` then `T` is not full.  (In fact even if `T ∩ D ≠ ∅`
> then `T` is not full.)

The proof of the stronger, parenthetical, form: if `T` is full then the certificate `K(T)`
satisfies `K(T)^T ≥ A(T)` (Claim 13.1.6) and `K(T) ≤ F(x)`, and for `t ≥ 3` the group
`A(T)` moves every point of `T`, so no point of `T` is fixed by `F^Γ`. -/

/-- For `|T| ≥ 3` and `p ∈ T`, some element of `A(T)` moves `p`: the product of two
transpositions `(p q)(q r)`. -/
theorem exists_alternating_move {T : Set Γ} (h3 : 3 ≤ T.ncard) {p : Γ} (hp : p ∈ T) :
    ∃ c ∈ alternatingGroup (T : Set Γ),
      (c : Equiv.Perm (T : Set Γ)) ⟨p, hp⟩ ≠ ⟨p, hp⟩ := by
  classical
  have hcard : 3 ≤ Fintype.card (T : Set Γ) := by
    have h : Nat.card (T : Set Γ) = T.ncard := Nat.card_coe_set_eq T
    rw [Nat.card_eq_fintype_card] at h
    omega
  have hnt : (({(⟨p, hp⟩ : (T : Set Γ))}ᶜ : Set (T : Set Γ))).Nontrivial := by
    rw [← Set.one_lt_ncard_iff_nontrivial]
    have hsum := Set.ncard_add_ncard_compl ({(⟨p, hp⟩ : (T : Set Γ))} : Set (T : Set Γ))
    rw [Set.ncard_singleton, Nat.card_eq_fintype_card] at hsum
    omega
  obtain ⟨q, hq, r, hr, hqr⟩ := hnt
  have hpq : (⟨p, hp⟩ : (T : Set Γ)) ≠ q := fun h => hq (by simp [h])
  have hpr : (⟨p, hp⟩ : (T : Set Γ)) ≠ r := fun h => hr (by simp [h])
  refine ⟨Equiv.swap (⟨p, hp⟩ : (T : Set Γ)) q * Equiv.swap q r, ?_, ?_⟩
  · rw [Equiv.Perm.mem_alternatingGroup, map_mul, Equiv.Perm.sign_swap hpq,
      Equiv.Perm.sign_swap hqr]
    simp
  · rw [Equiv.Perm.mul_apply, Equiv.swap_apply_of_ne_of_ne hpq hpr, Equiv.swap_apply_left]
    exact fun h => hpq h.symm

/-- §13.2, case (3): "Note that in this case, if `T ⊂ D` then `T` is not full.  (In fact
even if `T ∩ D ≠ ∅` then `T` is not full.)"

Proved in the stronger, parenthetical form: a full test set contains no fixed point of
`F^Γ`.  Indeed `A(T) ≤ K(T)^T` (Claim 13.1.6) and `K(T) ≤ F(x)`, and for `t ≥ 3` the
group `A(T)` moves every point of `T`. -/
theorem disjoint_fixedGamma_of_isFull {T : Set Γ} (hT : T ∈ fullSets ϕ x t)
    (ht : LargeK T.ncard (Nat.card Ω)) (h3 : 3 ≤ t) :
    ∀ p ∈ T, p ∉ fixedGamma ϕ x t := by
  intro p hp hfix
  have htn : 3 ≤ T.ncard := by rw [hT.1]; exact h3
  obtain ⟨c, hc, hcp⟩ := exists_alternating_move htn hp
  have hline07 : isFullOut ϕ x T :=
    le_trans hT.2 (imgOn_mono ϕ T (autStab_le_outStage_H ϕ x T))
  obtain ⟨σ, hσ⟩ := claim_13_1_6_giant (ϕ := ϕ) (x := x) (T := T) ht hline07 hc
  have hσF : (σ : Equiv.Perm Ω) ∈ bigF ϕ x t := certK_le_bigF hT σ.2
  have hmem : ϕ ⟨(σ : Equiv.Perm Ω), bigF_le hσF⟩ ∈ bigFGamma ϕ x t := ⟨⟨_, hσF⟩, rfl⟩
  have hfixp := hfix _ hmem
  have hval : ((c ⟨p, hp⟩ : (T : Set Γ)) : Γ) = ϕ ⟨(σ : Equiv.Perm Ω), bigF_le hσF⟩ p := by
    rw [← hσ]
    rfl
  exact hcp (Subtype.ext (by rw [hval, hfixp]))

/-! ### Canonicity of `F(x)`

> So `F(x)`, and with it `F(x)^Γ`, are canonically associated with `x`.  In particular, if
> `F(y)` is analogously defined for `y`, then `F(x)^Γ` is permutationally isomorphic to
> `F(y)^Γ`, i. e., there exists a permutation `α ∈ S(Γ)` such that
> `F(y)^Γ = α⁻¹F(x)^Γα`.

Canonicity is equivariance, as in `Workspace/LocalCertificates/Canonicity.lean`: the
morphisms of the category of strings are the `τ ∈ G`, and they carry `F(x)` to
`τ⁻¹F(x)τ`.  Since `F(y) = F(x^τ)` for any `τ ∈ Iso_G(x,y)`, this is the paper's
"permutationally isomorphic" statement with `α = τ^ϕ`. -/

variable (ϕ x t)

/-- The full test sets of `x^τ` are the images under `τ^ϕ` of the full test sets of `x`. -/
theorem fullSets_strAct (τ : G) :
    fullSets ϕ (strAct x (τ : Equiv.Perm Ω)) t
      = (fun T => testImage ϕ T τ) '' fullSets ϕ x t := by
  ext T'
  constructor
  · intro hT'
    refine ⟨(ϕ τ : Equiv.Perm Γ).symm '' T', ⟨?_, ?_⟩, ?_⟩
    · rw [Set.ncard_image_of_injective _ (ϕ τ : Equiv.Perm Γ).symm.injective]; exact hT'.1
    · have himg : testImage ϕ ((ϕ τ : Equiv.Perm Γ).symm '' T') τ = T' := by
        show (ϕ τ : Equiv.Perm Γ) '' ((ϕ τ : Equiv.Perm Γ).symm '' T') = T'
        simp
      rw [← canonical_isFull ϕ x ((ϕ τ : Equiv.Perm Γ).symm '' T') τ, himg]
      exact hT'.2
    · show (ϕ τ : Equiv.Perm Γ) '' ((ϕ τ : Equiv.Perm Γ).symm '' T') = T'
      simp
  · rintro ⟨T, hT, rfl⟩
    refine ⟨?_, (canonical_isFull ϕ x T τ).2 hT.2⟩
    show ((ϕ τ : Equiv.Perm Γ) '' T).ncard = t
    rw [Set.ncard_image_of_injective _ (ϕ τ : Equiv.Perm Γ).injective]
    exact hT.1

/-- §13.2.  `F(x)` is canonically associated with `x`: `F(x^τ) = τ⁻¹F(x)τ`. -/
theorem canonical_bigF (τ : G) :
    bigF ϕ (strAct x (τ : Equiv.Perm Ω)) t
      = (bigF ϕ x t).map (MulAut.conj (τ : Equiv.Perm Ω)).toMonoidHom := by
  have hset : (⋃ T ∈ fullSets ϕ (strAct x (τ : Equiv.Perm Ω)) t,
        (certK ϕ (strAct x (τ : Equiv.Perm Ω)) T : Set (Equiv.Perm Ω)))
      = (MulAut.conj (τ : Equiv.Perm Ω)).toMonoidHom ''
          (⋃ T ∈ fullSets ϕ x t, (certK ϕ x T : Set (Equiv.Perm Ω))) := by
    rw [fullSets_strAct ϕ x t τ]
    ext σ
    constructor
    · intro hσ
      obtain ⟨T', hT', hσT⟩ := Set.mem_iUnion₂.1 hσ
      obtain ⟨T, hT, rfl⟩ := hT'
      rw [canonical_certK ϕ x T τ] at hσT
      obtain ⟨ρ, hρ, rfl⟩ := hσT
      exact ⟨ρ, Set.mem_biUnion hT hρ, rfl⟩
    · rintro ⟨ρ, hρ, rfl⟩
      obtain ⟨T, hT, hρT⟩ := Set.mem_iUnion₂.1 hρ
      refine Set.mem_biUnion (Set.mem_image_of_mem _ hT) ?_
      rw [canonical_certK ϕ x T τ]
      exact ⟨ρ, hρT, rfl⟩
  rw [bigF, bigF, MonoidHom.map_closure, hset]

/-- §13.2.  `F(x)^Γ` is canonically associated with `x`: `F(x^τ)^Γ = τ^ϕ F(x)^Γ (τ^ϕ)⁻¹`.

This is the paper's "So `F(x)`, and with it `F(x)^Γ`, are canonically associated with `x`.
In particular, if `F(y)` is analogously defined for `y`, then `F(x)^Γ` is permutationally
isomorphic to `F(y)^Γ`": for `y = x^τ` the permutation `α ∈ S(Γ)` of the paper is
`α = (τ^ϕ)⁻¹`. -/
theorem canonical_bigFGamma (τ : G) :
    bigFGamma ϕ (strAct x (τ : Equiv.Perm Ω)) t
      = (bigFGamma ϕ x t).map (MulAut.conj (ϕ τ : Equiv.Perm Γ)).toMonoidHom := by
  ext b
  rw [mem_bigFGamma]
  constructor
  · rintro ⟨σ, hσ, hb⟩
    rw [canonical_bigF ϕ x t τ] at hσ
    obtain ⟨ρ, hρ, rfl⟩ := hσ
    have hρG : ρ ∈ G := bigF_le hρ
    have hconj : (τ : Equiv.Perm Ω) * ρ * (τ : Equiv.Perm Ω)⁻¹ ∈ G :=
      G.mul_mem (G.mul_mem τ.2 hρG) (G.inv_mem τ.2)
    have hval := hb (by exact hconj)
    refine ⟨ϕ ⟨ρ, hρG⟩, ?_, ?_⟩
    · exact (mem_bigFGamma ϕ x t).2 ⟨ρ, hρ, fun _ => by congr⟩
    · show (ϕ τ : Equiv.Perm Γ) * (ϕ ⟨ρ, hρG⟩ : Equiv.Perm Γ) * (ϕ τ : Equiv.Perm Γ)⁻¹ = b
      rw [← phi_conj' τ hρG hconj]
      exact hval
  · rintro ⟨c, hc, rfl⟩
    obtain ⟨ρ, hρ, hcv⟩ := (mem_bigFGamma ϕ x t).1 hc
    have hρG : ρ ∈ G := bigF_le hρ
    refine ⟨(τ : Equiv.Perm Ω) * ρ * (τ : Equiv.Perm Ω)⁻¹, ?_, fun h => ?_⟩
    · rw [canonical_bigF ϕ x t τ]
      exact ⟨ρ, hρ, rfl⟩
    · rw [phi_conj' τ hρG h, hcv hρG]
      rfl

/-- §13.2, case (3).  `D`, the set of fixed points of `F^Γ`, is canonically associated
with `x`: `D(x^τ) = D(x)^{τ^ϕ}`. -/
theorem canonical_fixedGamma (τ : G) :
    fixedGamma ϕ (strAct x (τ : Equiv.Perm Ω)) t
      = (ϕ τ : Equiv.Perm Γ) '' fixedGamma ϕ x t := by
  ext γ
  constructor
  · intro hγ
    refine ⟨(ϕ τ : Equiv.Perm Γ)⁻¹ γ, ?_, by simp⟩
    intro c hc
    have hmem : (ϕ τ : Equiv.Perm Γ) * c * (ϕ τ : Equiv.Perm Γ)⁻¹
        ∈ bigFGamma ϕ (strAct x (τ : Equiv.Perm Ω)) t := by
      rw [canonical_bigFGamma ϕ x t τ]
      exact ⟨c, hc, rfl⟩
    have h := hγ _ hmem
    have h' : (ϕ τ : Equiv.Perm Γ) (c ((ϕ τ : Equiv.Perm Γ)⁻¹ γ)) = γ := h
    exact (ϕ τ : Equiv.Perm Γ).injective (by rw [h']; simp)
  · rintro ⟨δ, hδ, rfl⟩
    intro b hb
    rw [canonical_bigFGamma ϕ x t τ] at hb
    obtain ⟨c, hc, rfl⟩ := hb
    show (ϕ τ : Equiv.Perm Γ) (c ((ϕ τ : Equiv.Perm Γ)⁻¹ ((ϕ τ : Equiv.Perm Γ) δ))) = _
    rw [show (ϕ τ : Equiv.Perm Γ)⁻¹ ((ϕ τ : Equiv.Perm Γ) δ) = δ by simp, hδ c hc]

/-- The bijection `D(x) → D(x^τ)` induced by `τ ∈ G` (`Babai.canonical_fixedGamma`). -/
noncomputable def fixedEquiv (τ : G) :
    ↥(fixedGamma ϕ x t) ≃ ↥(fixedGamma ϕ (strAct x (τ : Equiv.Perm Ω)) t) :=
  (Equiv.Set.image (ϕ τ : Equiv.Perm Γ) (fixedGamma ϕ x t)
      (ϕ τ : Equiv.Perm Γ).injective).trans
    (Equiv.setCongr (canonical_fixedGamma ϕ x t τ).symm)

@[simp] theorem fixedEquiv_apply (τ : G) (a : ↥(fixedGamma ϕ x t)) :
    ((fixedEquiv ϕ x t τ a : ↥(fixedGamma ϕ (strAct x (τ : Equiv.Perm Ω)) t)) : Γ)
      = (ϕ τ : Equiv.Perm Γ) (a : Γ) := rfl

/-! ### The three cases of Theorem 13.2.1 -/

section Cases

variable (H : Subgroup (Equiv.Perm Γ))

/-- The set of points of `Γ` that lie in a *nontrivial* orbit of `H` (equivalently, that
are moved by some element of `H`); its complement is the set `D` of fixed points. -/
def movedSet : Set Γ := {γ | ∃ b ∈ H, (b : Equiv.Perm Γ) γ ≠ γ}

/-- The fixed points of `H`. -/
def fixedSet : Set Γ := {γ | ∀ b ∈ H, (b : Equiv.Perm Γ) γ = γ}

theorem movedSet_compl : (movedSet H)ᶜ = fixedSet H := by
  ext γ
  simp only [movedSet, fixedSet, Set.mem_compl_iff, Set.mem_setOf_eq, not_exists, not_and,
    not_not]

theorem ncard_movedSet_add_ncard_fixedSet :
    (movedSet H).ncard + (fixedSet H).ncard = Fintype.card Γ := by
  have h := Set.ncard_add_ncard_compl (movedSet H)
  rw [movedSet_compl, Nat.card_eq_fintype_card] at h
  exact h

/-- §13.2, case (1): "the nontrivial orbits (orbits of length `≥ 2`) of `F^Γ` cover at
least `m/5` elements of `Γ` and no orbit of `F^Γ` has length `> 4m/5`". -/
def Case1 : Prop :=
  Fintype.card Γ ≤ 5 * (movedSet H).ncard ∧
    ∀ γ : Γ, 5 * (orbit H γ : Set Γ).ncard ≤ 4 * Fintype.card Γ

/-- §13.2, case (2): "`F^Γ` has an orbit `C ⊆ Γ` of length `|C| > 4m/5`". -/
def Case2 : Prop := ∃ γ : Γ, 4 * Fintype.card Γ < 5 * (orbit H γ : Set Γ).ncard

/-- §13.2, case (3): "else `|D| ≥ 4m/5` where `D ⊆ Γ` is the set of fixed points of
`F^Γ`".

The arithmetic: if case (2) fails then the second conjunct of case (1) holds, so the
failure of case (1) is the failure of its first conjunct, `5|Γ ∖ D| < m`; and
`|D| = m − |Γ ∖ D| > 4m/5`.  (The conclusion is the strict inequality `4m < 5|D|`, which
is stronger than the paper's `|D| ≥ 4m/5`.) -/
theorem four_mul_lt_five_mul_fixed (h1 : ¬ Case1 H) (h2 : ¬ Case2 H) :
    4 * Fintype.card Γ < 5 * (fixedSet H).ncard := by
  have horb : ∀ γ : Γ, 5 * (orbit H γ : Set Γ).ncard ≤ 4 * Fintype.card Γ := by
    intro γ
    by_contra hcon
    exact h2 ⟨γ, by omega⟩
  have hmoved : 5 * (movedSet H).ncard < Fintype.card Γ := by
    by_contra hcon
    exact h1 ⟨by omega, horb⟩
  have hsum := ncard_movedSet_add_ncard_fixedSet H
  omega

/-! #### Case (1): the canonical colored 4/5-partition -/

theorem orbit_eq_singleton_of_mem_fixedSet {γ : Γ} (h : γ ∈ fixedSet H) :
    (orbit H γ : Set Γ) = {γ} := by
  ext z
  constructor
  · rintro ⟨b, rfl⟩
    exact h (b : Equiv.Perm Γ) b.2
  · rintro rfl
    exact mem_orbit_self _

theorem mem_orbit_symm {a b : Γ} (h : b ∈ orbit H a) : a ∈ orbit H b := by
  obtain ⟨σ, rfl⟩ := mem_orbit_iff.1 h
  exact mem_orbit_iff.2 ⟨σ⁻¹, by simp [Subgroup.smul_def]⟩

theorem not_mem_fixedSet_of_mem_orbit {a b : Γ} (ha : a ∉ fixedSet H) (h : b ∈ orbit H a) :
    b ∉ fixedSet H := by
  intro hb
  refine ha ?_
  have : (orbit H b : Set Γ) = {b} := orbit_eq_singleton_of_mem_fixedSet H hb
  have hab : a ∈ (orbit H b : Set Γ) := mem_orbit_symm H h
  rw [this] at hab
  rwa [show a = b from hab]

/-- §13.2, case (1).  The colored partition of `Γ` used in case (1): the two color classes
are the set `D` of fixed points of `H = F^Γ` and its complement; `D` is one block, and the
blocks of the complement are the (nontrivial) orbits of `H`. -/
noncomputable def orbitPartition : ColoredPartition Γ Bool where
  color γ := decide (γ ∈ fixedSet H)
  part :=
    { r := fun a b => (a ∈ fixedSet H ∧ b ∈ fixedSet H) ∨ b ∈ orbit H a
      iseqv :=
        { refl := fun a => Or.inr (mem_orbit_self a)
          symm := by
            rintro a b (⟨ha, hb⟩ | h)
            · exact Or.inl ⟨hb, ha⟩
            · exact Or.inr (mem_orbit_symm H h)
          trans := by
            rintro a b c (⟨ha, hb⟩ | hab) hbc
            · rcases hbc with ⟨-, hc⟩ | hbc
              · exact Or.inl ⟨ha, hc⟩
              · have : (orbit H b : Set Γ) = {b} := orbit_eq_singleton_of_mem_fixedSet H hb
                rw [this] at hbc
                exact Or.inl ⟨ha, by rwa [show c = b from hbc]⟩
            · rcases hbc with ⟨hb, hc⟩ | hbc
              · have : (orbit H b : Set Γ) = {b} := orbit_eq_singleton_of_mem_fixedSet H hb
                have hab' : a ∈ (orbit H b : Set Γ) := mem_orbit_symm H hab
                rw [this] at hab'
                exact Or.inl ⟨by rwa [show a = b from hab'], hc⟩
              · obtain ⟨σ, rfl⟩ := mem_orbit_iff.1 hab
                obtain ⟨ρ, rfl⟩ := mem_orbit_iff.1 hbc
                exact Or.inr (mem_orbit_iff.2 ⟨ρ * σ, by rw [mul_smul]⟩) } }
  part_le_color := by
    rintro a b (⟨ha, hb⟩ | hab)
    · simp [ha, hb]
    · by_cases ha : a ∈ fixedSet H
      · have : (orbit H a : Set Γ) = {a} := orbit_eq_singleton_of_mem_fixedSet H ha
        rw [this] at hab
        rw [show b = a from hab]
      · have hb := not_mem_fixedSet_of_mem_orbit H ha hab
        simp [ha, hb]

theorem block_orbitPartition_of_mem_fixedSet {γ : Γ} (h : γ ∈ fixedSet H) :
    (orbitPartition H).block γ = fixedSet H := by
  ext z
  constructor
  · rintro (⟨hz, -⟩ | hz)
    · exact hz
    · have : (orbit H z : Set Γ) = {z} := by
        by_cases hzf : z ∈ fixedSet H
        · exact orbit_eq_singleton_of_mem_fixedSet H hzf
        · exact absurd h (not_mem_fixedSet_of_mem_orbit H hzf hz)
      rw [this] at hz
      rwa [show γ = z from hz] at h
  · intro hz
    exact Or.inl ⟨hz, h⟩

theorem block_orbitPartition_of_not_mem_fixedSet {γ : Γ} (h : γ ∉ fixedSet H) :
    (orbitPartition H).block γ = (orbit H γ : Set Γ) := by
  ext z
  constructor
  · rintro (⟨-, hγ⟩ | hz)
    · exact absurd hγ h
    · exact mem_orbit_symm H hz
  · intro hz
    exact Or.inr (mem_orbit_symm H hz)

theorem colorClass_orbitPartition_of_mem {γ : Γ} (h : γ ∈ fixedSet H) :
    (orbitPartition H).colorClass ((orbitPartition H).color γ) = fixedSet H := by
  ext z
  simp only [ColoredPartition.colorClass, orbitPartition, Set.mem_setOf_eq, h, decide_true,
    decide_eq_true_eq]

/-- §13.2, case (1): the colored partition of `Γ` by the orbits of `F^Γ` is a colored
4/5-partition, i.e. it is admissible and all of its blocks have size `≤ 4m/5`.

> if the nontrivial orbits (orbits of length `≥ 2`) of `F^Γ` cover at least `m/5` elements
> of `Γ` and no orbit of `F^Γ` has length `> 4m/5` we found a colored 4/5-partition of
> `Γ`, exit -/
theorem orbitPartition_isAlphaPartition (h : Case1 H) :
    (orbitPartition H).IsAlphaPartition (4 / 5 : ℝ) := by
  have hrho : 5 * (orbitPartition H).rho ≤ 4 * Fintype.card Γ := by
    have hbound : ∀ γ : Γ, 5 * ((orbitPartition H).block γ).ncard ≤ 4 * Fintype.card Γ := by
      intro γ
      by_cases hγ : γ ∈ fixedSet H
      · rw [block_orbitPartition_of_mem_fixedSet H hγ]
        have hsum := ncard_movedSet_add_ncard_fixedSet H
        have := h.1
        omega
      · rw [block_orbitPartition_of_not_mem_fixedSet H hγ]
        exact h.2 γ
    have : (orbitPartition H).rho ≤ (4 * Fintype.card Γ) / 5 := by
      refine ColoredPartition.rho_le _ fun γ => ?_
      have := hbound γ
      omega
    omega
  refine ⟨?_, ?_⟩
  · -- admissibility
    intro γ hγ
    by_cases hf : γ ∈ fixedSet H
    · rw [block_orbitPartition_of_mem_fixedSet H hf]
      rwa [colorClass_orbitPartition_of_mem H hf] at hγ
    · rw [block_orbitPartition_of_not_mem_fixedSet H hf]
      -- `γ` is moved, so its orbit has at least two points
      obtain ⟨b, hb, hbγ⟩ : ∃ b ∈ H, (b : Equiv.Perm Γ) γ ≠ γ := by
        by_contra hcon
        push_neg at hcon
        exact hf hcon
      have h1 : γ ∈ (orbit H γ : Set Γ) := mem_orbit_self γ
      have h2 : (b : Equiv.Perm Γ) γ ∈ (orbit H γ : Set Γ) :=
        mem_orbit_iff.2 ⟨⟨b, hb⟩, rfl⟩
      have : ({γ, (b : Equiv.Perm Γ) γ} : Set Γ) ⊆ (orbit H γ : Set Γ) := by
        intro z hz
        rcases hz with rfl | hz
        · exact h1
        · rw [show z = (b : Equiv.Perm Γ) γ from hz]; exact h2
      have hle := Set.ncard_le_ncard this (Set.toFinite _)
      rwa [Set.ncard_pair (Ne.symm hbγ)] at hle
  · -- `ρ ≤ (4/5) m`
    have hm : (0 : ℝ) ≤ (Fintype.card Γ : ℝ) := by positivity
    have : (5 : ℝ) * ((orbitPartition H).rho : ℝ) ≤ 4 * (Fintype.card Γ : ℝ) := by
      exact_mod_cast hrho
    linarith

/-! #### Case (2): an orbit `C` with `|C| > 4m/5` -/

/-- §13.2, case (2a).  The hypothesis of Corollary 12.0.10 for the color class `C`: the
restriction to `C` of `Aut_G(x)^ϕ` contains `A(C)`.  This is the hypothesis `hgiantC` of
`Babai.Corollary_12_0_10`, transported from the target `S_m` to `S(Γ)`: every even
permutation of `Γ` supported inside `C` agrees on `C` with an element of the group.

(The corollary itself is stated in `Workspace/TopAction/TopAction4.lean`; 2a only has to
supply its hypothesis.) -/
def Corollary_12_0_10_hypothesis (H : Subgroup (Equiv.Perm Γ)) (C : Set Γ) : Prop :=
  ∀ a : Equiv.Perm Γ, a ∈ alternatingGroup Γ → (∀ γ ∉ C, a γ = γ) →
    ∃ b ∈ H, ∀ γ ∈ C, (b : Equiv.Perm Γ) γ = a γ

/-- §13.2, case (2a): "if `F^C ≥ A(C)` then apply Cor. 12.0.10".  The hypothesis of
Corollary 12.0.10 follows from `A(C) ≤ F^C`. -/
theorem corollary_12_0_10_hypothesis_of_giant {C : Set Γ} (hinv : IsInvariant H C)
    (hgiant : alternatingGroup (C : Set Γ) ≤ restrictTo H C hinv) :
    Corollary_12_0_10_hypothesis H C := by
  classical
  intro a ha hfix
  -- the restriction of `a` to `C` is an even permutation of `C`
  have hmapsto : ∀ γ : Γ, γ ∈ C ↔ a γ ∈ C := by
    intro γ
    constructor
    · intro hγ
      by_contra hcon
      have : a γ = γ := by
        have := hfix (a γ) hcon
        exact a.injective this ▸ hfix (a γ) hcon
      rw [this] at hcon
      exact hcon hγ
    · intro hγ
      by_contra hcon
      rw [hfix γ hcon] at hγ
      exact hcon hγ
  set aC : Equiv.Perm (C : Set Γ) := Equiv.Perm.subtypePerm a (fun γ => (hmapsto γ).symm) with haC
  have hofs : Equiv.Perm.ofSubtype aC = a := by
    refine Equiv.ext fun γ => ?_
    by_cases hγ : γ ∈ C
    · rw [Equiv.Perm.ofSubtype_apply_of_mem aC hγ]
      rfl
    · rw [Equiv.Perm.ofSubtype_apply_of_not_mem aC hγ, hfix γ hγ]
  have hsign : Equiv.Perm.sign aC = 1 := by
    have h := Equiv.Perm.sign_ofSubtype aC
    rw [hofs] at h
    rw [← h]
    exact Equiv.Perm.mem_alternatingGroup.1 ha
  obtain ⟨b, hb⟩ := hgiant (Equiv.Perm.mem_alternatingGroup.2 hsign)
  refine ⟨(b : Equiv.Perm Γ), b.2, fun γ hγ => ?_⟩
  have := congrArg (fun p : Equiv.Perm (C : Set Γ) => ((p ⟨γ, hγ⟩ : (C : Set Γ)) : Γ)) hb
  simpa [restrictHom, Equiv.Perm.subtypePerm] using this

/-- §13.2, case (2b): "let `d` be the degree of transitivity of `F^C` (: so `1 ≤ d ≤ 5` by
Theorem 2.2.4 :)".

The upper bound is Theorem 2.2.4 (a) (`Babai.degtrans_le_five`, an axiom: a consequence of
the Classification), applicable because case (2b) is the case `F^C ≱ A(C)`, i.e. `F^C` is
not a giant.  Note that §16.1 lists the uses of the Classification without mentioning this
one; see the corrected paper. -/
theorem degtrans_restrict_le_five {C : Set Γ} (hinv : IsInvariant H C)
    (hnotgiant : ¬ alternatingGroup (C : Set Γ) ≤ restrictTo H C hinv) :
    degtrans (restrictTo H C hinv) ≤ 5 := by
  refine degtrans_le_five ?_ (degtrans_spec (restrictTo H C hinv)).1
  rw [isGiant_iff_alternating_le]
  exact hnotgiant

/-! #### Case (2b): individualization

The bookkeeping for the two standard steps "a `d`-transitive group is transitive on the
complement of `d − 1` individualized points" and "`d`-transitive plus doubly transitive
after individualizing `d − 1` points implies `(d+1)`-transitive": an enumeration of the
individualized set `S`, extended by one further point, as an injective `d`-tuple. -/

/-- An enumeration of a set of `k` elements. -/
theorem exists_enum_of_ncard {α : Type*} [Finite α] {S : Set α} {k : ℕ} (hS : S.ncard = k) :
    Nonempty (Fin k ≃ ↥S) := by
  classical
  have hcard : Nat.card ↥S = k := by rw [Nat.card_coe_set_eq]; exact hS
  exact ⟨(finCongr hcard.symm).trans (Finite.equivFin ↥S).symm⟩

/-- The `d`-tuple that lists `S` (of size `d − 1`) in its first `d − 1` entries and ends
with the point `c`. -/
def indivTuple {α : Type*} {d : ℕ} {S : Set α} (e : Fin (d - 1) ≃ ↥S) (c : α) :
    Fin d → α :=
  fun i => if h : (i : ℕ) < d - 1 then ((e ⟨i, h⟩ : ↥S) : α) else c

theorem indivTuple_castLE {α : Type*} {d : ℕ} {S : Set α} (e : Fin (d - 1) ≃ ↥S) (c : α)
    (i : Fin (d - 1)) :
    indivTuple e c (Fin.castLE (Nat.sub_le d 1) i) = ((e i : ↥S) : α) := by
  have h : ((Fin.castLE (Nat.sub_le d 1) i : Fin d) : ℕ) < d - 1 := i.isLt
  rw [indivTuple, dif_pos h]
  exact congrArg (fun z : Fin (d - 1) => ((e z : ↥S) : α)) (Fin.ext rfl)

theorem indivTuple_last {α : Type*} {d : ℕ} {S : Set α} (e : Fin (d - 1) ≃ ↥S) (c : α)
    (h : d - 1 < d) : indivTuple e c (⟨d - 1, h⟩ : Fin d) = c :=
  dif_neg (by simp)

theorem indivTuple_injective {α : Type*} {d : ℕ} {S : Set α} (e : Fin (d - 1) ≃ ↥S) {c : α}
    (hc : c ∉ S) : Function.Injective (indivTuple e c) := by
  intro i j hij
  simp only [indivTuple] at hij
  by_cases hi : (i : ℕ) < d - 1 <;> by_cases hj : (j : ℕ) < d - 1
  · rw [dif_pos hi, dif_pos hj] at hij
    have h := e.injective (Subtype.ext hij)
    have h2 : ((⟨(i : ℕ), hi⟩ : Fin (d - 1)) : ℕ) = ((⟨(j : ℕ), hj⟩ : Fin (d - 1)) : ℕ) :=
      congrArg Fin.val h
    exact Fin.ext h2
  · rw [dif_pos hi, dif_neg hj] at hij
    exact absurd (hij ▸ (e ⟨i, hi⟩).2) hc
  · rw [dif_neg hi, dif_pos hj] at hij
    exact absurd (hij.symm ▸ (e ⟨j, hj⟩).2) hc
  · have h1 := i.isLt
    have h2 := j.isLt
    exact Fin.ext (by omega)

/-- §13.2, case (2b): "individualize the elements of a set `S ∈ (C choose d−1)` (: so
`F^C_{(S)}` is transitive but not doubly transitive on `C' := C ∖ S` :)".

The first half: after individualizing `d − 1` points, the pointwise stabilizer is
transitive on the rest.  ("Transitive on `C ∖ S`" is the paper's "one orbit", stated
pointwise so that no restriction to a subtype is needed; `C ∖ S` is nonempty because
`d − 1 < |C|`.) -/
theorem isTransitive_pointwiseStab_individualize {α : Type*} [Fintype α] [DecidableEq α]
    (K : Subgroup (Equiv.Perm α)) {d : ℕ} (hd : IsMultiplyTransitive K d) (hd1 : 1 ≤ d)
    {S : Set α} (hS : S.ncard = d - 1) {a b : α} (ha : a ∉ S) (hb : b ∉ S) :
    ∃ g ∈ pointwiseStabilizer K S, (g : Equiv.Perm α) a = b := by
  classical
  obtain ⟨e⟩ := exists_enum_of_ncard (S := S) (k := d - 1) hS
  set ua : Fin d ↪ α := ⟨indivTuple e a, indivTuple_injective e ha⟩ with hua
  set ub : Fin d ↪ α := ⟨indivTuple e b, indivTuple_injective e hb⟩ with hub
  obtain ⟨-, hpre⟩ := (isMultiplyTransitive_iff K d).1 hd
  obtain ⟨g, hg⟩ := hpre.exists_smul_eq ua ub
  have hval : ∀ i : Fin d, (g : Equiv.Perm α) (ua i) = ub i := by
    intro i
    have h := congrArg (fun w : Fin d ↪ α => w i) hg
    simpa [Subgroup.smul_def, Equiv.Perm.smul_def] using h
  refine ⟨(g : Equiv.Perm α), ⟨g.2, ?_⟩, ?_⟩
  · intro s hs
    obtain ⟨i, hi⟩ : ∃ i : Fin (d - 1), ((e i : ↥S) : α) = s :=
      ⟨e.symm ⟨s, hs⟩, by simp⟩
    have h := hval (Fin.castLE (Nat.sub_le d 1) i)
    rw [show ua (Fin.castLE (Nat.sub_le d 1) i) = ((e i : ↥S) : α) from
        indivTuple_castLE e a i,
      show ub (Fin.castLE (Nat.sub_le d 1) i) = ((e i : ↥S) : α) from
        indivTuple_castLE e b i, hi] at h
    exact h
  · have h := hval (⟨d - 1, by omega⟩ : Fin d)
    rwa [show ua (⟨d - 1, by omega⟩ : Fin d) = a from indivTuple_last e a (by omega),
      show ub (⟨d - 1, by omega⟩ : Fin d) = b from indivTuple_last e b (by omega)] at h

/-- The normalization step of case (2b): a `d`-transitive group carries the first `d − 1`
entries of any injective `(d+1)`-tuple onto the individualized set `S` (of size `d − 1`),
and then the two remaining entries necessarily lie outside `S`. -/
theorem exists_normalize_individualize {α : Type*} [Fintype α] [DecidableEq α]
    (K : Subgroup (Equiv.Perm α)) {d : ℕ} (hdtr : IsMultiplyTransitive K d) (hd1 : 1 ≤ d)
    {S : Set α} (e : Fin (d - 1) ≃ ↥S) (w : Fin (d + 1) ↪ α) :
    ∃ h : Equiv.Perm α, h ∈ K ∧
      (∀ i : Fin (d - 1), h (w (Fin.castLE (by omega) i)) = ((e i : ↥S) : α)) ∧
      h (w ⟨d - 1, by omega⟩) ∉ S ∧ h (w ⟨d, by omega⟩) ∉ S := by
  classical
  have hdm : IsMultiplyTransitive K (d - 1) := IsMultiplyTransitive.mono (by omega) hdtr
  obtain ⟨-, hpre⟩ := (isMultiplyTransitive_iff K (d - 1)).1 hdm
  set p : Fin (d - 1) ↪ α :=
    ⟨fun i => w (Fin.castLE (by omega) i), fun a b hab =>
      Fin.ext (congrArg Fin.val (Fin.castLE_injective (by omega) (w.injective hab)))⟩ with hp
  set q : Fin (d - 1) ↪ α :=
    ⟨fun i => ((e i : ↥S) : α), fun a b hab => e.injective (Subtype.ext hab)⟩ with hq
  obtain ⟨g, hg⟩ := hpre.exists_smul_eq p q
  have hval : ∀ i : Fin (d - 1),
      (g : Equiv.Perm α) (w (Fin.castLE (by omega : d - 1 ≤ d + 1) i)) = ((e i : ↥S) : α) := by
    intro i
    have h := congrArg (fun z : Fin (d - 1) ↪ α => z i) hg
    simpa [hp, hq, Subgroup.smul_def, Equiv.Perm.smul_def] using h
  refine ⟨(g : Equiv.Perm α), g.2, hval, ?_, ?_⟩
  · intro hc
    obtain ⟨i, hi⟩ : ∃ i : Fin (d - 1), ((e i : ↥S) : α) = (g : Equiv.Perm α) (w ⟨d - 1, by omega⟩) :=
      ⟨e.symm ⟨_, hc⟩, by simp⟩
    rw [← hval i] at hi
    have := w.injective ((g : Equiv.Perm α).injective hi)
    have h2 := congrArg Fin.val this
    have h3 := i.isLt
    simp only [Fin.coe_castLE] at h2
    omega
  · intro hc
    obtain ⟨i, hi⟩ : ∃ i : Fin (d - 1), ((e i : ↥S) : α) = (g : Equiv.Perm α) (w ⟨d, by omega⟩) :=
      ⟨e.symm ⟨_, hc⟩, by simp⟩
    rw [← hval i] at hi
    have := w.injective ((g : Equiv.Perm α).injective hi)
    have h2 := congrArg Fin.val this
    have h3 := i.isLt
    simp only [Fin.coe_castLE] at h2
    omega

/-- §13.2, case (2b), second half: after individualizing `d − 1` points the pointwise
stabilizer is *not* doubly transitive on `C ∖ S`, because `F^C` is not `(d+1)`-transitive
(`d` is the degree of transitivity).  This needs `|C ∖ S| ≥ 2`, which holds since
`|C| > 4m/5` and `d ≤ 5`. -/
theorem not_isDoublyTransitive_pointwiseStab_individualize {α : Type*} [Fintype α]
    [DecidableEq α] (K : Subgroup (Equiv.Perm α)) {d : ℕ}
    (hd : ¬ IsMultiplyTransitive K (d + 1)) (hdtr : IsMultiplyTransitive K d) (hd1 : 1 ≤ d)
    {S : Set α} (hS : S.ncard = d - 1) (hcard : d + 1 ≤ Fintype.card α) :
    ¬ (∀ a b a' b' : α, a ∉ S → b ∉ S → a' ∉ S → b' ∉ S → a ≠ b → a' ≠ b' →
        ∃ g ∈ pointwiseStabilizer K S, (g : Equiv.Perm α) a = a' ∧ (g : Equiv.Perm α) b = b') := by
  classical
  intro hdt
  obtain ⟨e⟩ := exists_enum_of_ncard (S := S) (k := d - 1) hS
  refine hd ?_
  rw [isMultiplyTransitive_iff]
  refine ⟨hcard, ⟨fun w w' => ?_⟩⟩
  obtain ⟨h, hhK, hh, hha, hhb⟩ := exists_normalize_individualize K hdtr hd1 e w
  obtain ⟨h', hh'K, hh', hha', hhb'⟩ := exists_normalize_individualize K hdtr hd1 e w'
  -- the two points of `w` (resp. `w'`) that are not moved onto `S`
  have hne : ((⟨d - 1, by omega⟩ : Fin (d + 1))) ≠ (⟨d, by omega⟩ : Fin (d + 1)) := by
    intro hc
    have := congrArg Fin.val hc
    simp only at this
    omega
  have hab : h (w ⟨d - 1, by omega⟩) ≠ h (w ⟨d, by omega⟩) := fun hc =>
    hne (w.injective (h.injective hc))
  have hab' : h' (w' ⟨d - 1, by omega⟩) ≠ h' (w' ⟨d, by omega⟩) := fun hc =>
    hne (w'.injective (h'.injective hc))
  obtain ⟨g, hgmem, hga, hgb⟩ :=
    hdt (h (w ⟨d - 1, by omega⟩)) (h (w ⟨d, by omega⟩))
      (h' (w' ⟨d - 1, by omega⟩)) (h' (w' ⟨d, by omega⟩)) hha hhb hha' hhb' hab hab'
  obtain ⟨hgK, hgS⟩ := mem_pointwiseStabilizer.1 hgmem
  refine ⟨⟨h'⁻¹ * (g * h), K.mul_mem (K.inv_mem hh'K) (K.mul_mem hgK hhK)⟩, ?_⟩
  refine Function.Embedding.ext fun i => ?_
  show (h'⁻¹ * (g * h)) (w i) = w' i
  rcases Nat.lt_or_ge (i : ℕ) (d - 1) with hlt | hge
  · -- the first `d − 1` entries are carried onto `S`, which `g` fixes pointwise
    set j : Fin (d - 1) := ⟨(i : ℕ), hlt⟩ with hj
    have hi : i = Fin.castLE (by omega) j := Fin.ext rfl
    rw [hi, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hh j, hgS _ (e j).2, ← hh' j]
    simp
  · have hilt := i.isLt
    rcases Nat.lt_or_ge (i : ℕ) d with hlt2 | hge2
    · have hi : i = (⟨d - 1, by omega⟩ : Fin (d + 1)) :=
        Fin.ext (show (i : ℕ) = d - 1 by omega)
      rw [hi, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hga]
      simp
    · have hi : i = (⟨d, by omega⟩ : Fin (d + 1)) := Fin.ext (show (i : ℕ) = d by omega)
      rw [hi, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hgb]
      simp

/-- §13.2, case (2b): the orbital configuration of `F^C_{(S)}` on `C ∖ S` is a coherent
configuration (Observation 3.1.12) and it is homogeneous exactly when the group is
transitive (Observation 3.1.15). -/
theorem orbitalConfig_individualize_isCoherent {α : Type*} [Fintype α] [DecidableEq α]
    (K : Subgroup (Equiv.Perm α)) : (PartitionStructure.orbitalConfig K).IsCoherent :=
  PartitionStructure.orbitalConfig_isCoherent K

theorem orbitalConfig_individualize_isHomogeneous {α : Type*} [Fintype α] [DecidableEq α]
    [Nonempty α] (K : Subgroup (Equiv.Perm α)) (h : IsTransitive K) :
    (PartitionStructure.orbitalConfig K).IsHomogeneous :=
  (PartitionStructure.orbitalConfig_isHomogeneous_iff K).2 h

/-- §13.2, case (2b): "This is a non-clique homogeneous coherent configuration, so
`3 ≤ r ≤ m`."  Non-clique is the failure of double transitivity: a homogeneous coherent
configuration of rank `2` is the clique configuration (Definition 3.1.8), which is the
orbital configuration of a doubly transitive group. -/
theorem three_le_rank_orbitalConfig {α : Type*} [Fintype α] [DecidableEq α] [Nontrivial α]
    (K : Subgroup (Equiv.Perm α)) (htr : IsTransitive K) (h2 : ¬ IsDoublyTransitive K) :
    3 ≤ (PartitionStructure.orbitalConfig K).rank := by
  have hcfg : (PartitionStructure.orbitalConfig K).IsConfiguration :=
    (PartitionStructure.orbitalConfig_isCoherent K).toIsConfiguration
  have hge : 2 ≤ (PartitionStructure.orbitalConfig K).rank :=
    (PartitionStructure.orbitalConfig K).two_le_rank hcfg
  have hne : (PartitionStructure.orbitalConfig K).rank ≠ 2 := fun hc =>
    h2 ((PartitionStructure.orbitalConfig_rank_eq_two_iff K).1 hc)
  omega

/-! #### Case (2b): the constituents have relative symmetry defect `≥ 1/2`

> Let `R₁ = diag(C')` be the diagonal (: so for `i ≥ 2` the constituents
> `X_i = (C', R_i)` are nontrivial biregular digraphs :) … (: Note: `X_i` has relative
> symmetry defect `≥ 1/2` by Cor. 2.4.12 because `X_i` is an irreflexive, biregular,
> nontrivial digraph. :)

Corollary 2.4.12 is `Babai.Digraph.defect_biregular_ge_half`.  Its three hypotheses are
supplied below for the off-diagonal constituents of the orbital configuration of a
transitive group of rank `≥ 3`. -/

section Case2bDefect

open PartitionStructure

variable {α : Type*} [Fintype α] [DecidableEq α] [Nonempty α]
variable (K : Subgroup (Equiv.Perm α))

theorem exists_mem_smul_eq (htr : IsTransitive K) (u v : α) :
    ∃ σ ∈ K, (σ : Equiv.Perm α) u = v := by
  have h := (isTransitive_iff_orbit_eq_univ K).1 htr u
  have hv : v ∈ orbit K u := by rw [h]; trivial
  obtain ⟨σ, hσ⟩ := hv
  exact ⟨(σ : Equiv.Perm α), σ.2, hσ⟩

/-- In the orbital configuration of a transitive group all loops carry the same color:
the diagonal is a single orbital. -/
theorem orbitalConfig_color_self_eq (htr : IsTransitive K) (u v : α) :
    (orbitalConfig K).color u u = (orbitalConfig K).color v v := by
  obtain ⟨σ, hσ, hσv⟩ := exists_mem_smul_eq K htr v u
  exact (orbitalConfig_color_eq_iff K u u v v).2 ⟨σ, hσ, by rw [hσv]⟩

/-- An off-diagonal constituent of a coherent configuration is an irreflexive digraph
(Terminology 3.1.3). -/
theorem extConstituent_isIrreflexive {i : Fin (orbitalConfig K).rank}
    (hi : ¬ (orbitalConfig K).IsDiagonalColor i) :
    ((orbitalConfig K).extConstituent i).IsIrreflexive := by
  rcases (orbitalConfig K).diagonal_or_offDiagonal
      ((orbitalConfig_isCoherent K).toIsConfiguration) i with hd | ho
  · exact absurd hd hi
  · exact ho

/-- Every constituent of the orbital configuration of a transitive group is biregular: the
group carries the color-`i` neighbourhood of `u` onto that of `v`. -/
theorem extConstituent_isBiregular (htr : IsTransitive K)
    (i : Fin (orbitalConfig K).rank) :
    ((orbitalConfig K).extConstituent i).IsBiregular := by
  classical
  have hcol : ∀ (σ : Equiv.Perm α), σ ∈ K → ∀ u v : α,
      (orbitalConfig K).color (σ u) (σ v) = (orbitalConfig K).color u v := fun σ hσ u v =>
    le_aut_orbitalConfig K hσ u v
  have hout : ∀ u v : α, ((orbitalConfig K).extConstituent i).outDeg u
      = ((orbitalConfig K).extConstituent i).outDeg v := by
    intro u v
    obtain ⟨σ, hσ, hσv⟩ := exists_mem_smul_eq K htr u v
    have himg : (σ : Equiv.Perm α) '' outNbr ((orbitalConfig K).extConstituent i).E u
        = outNbr ((orbitalConfig K).extConstituent i).E v := by
      ext z
      constructor
      · rintro ⟨y, hy, rfl⟩
        show (orbitalConfig K).color v (σ y) = i
        rw [← hσv, hcol σ hσ u y]
        exact hy
      · intro hz
        refine ⟨σ⁻¹ z, ?_, by simp⟩
        show (orbitalConfig K).color u (σ⁻¹ z) = i
        have hrw : (σ : Equiv.Perm α) ((σ : Equiv.Perm α)⁻¹ z) = z := by simp
        have h := hcol σ hσ u ((σ : Equiv.Perm α)⁻¹ z)
        rw [hrw] at h
        rw [← h, hσv]
        exact hz
    show (outNbr _ u).ncard = (outNbr _ v).ncard
    rw [← himg, Set.ncard_image_of_injective _ (σ : Equiv.Perm α).injective]
  have hin : ∀ u v : α, ((orbitalConfig K).extConstituent i).inDeg u
      = ((orbitalConfig K).extConstituent i).inDeg v := by
    intro u v
    obtain ⟨σ, hσ, hσv⟩ := exists_mem_smul_eq K htr u v
    have himg : (σ : Equiv.Perm α) '' inNbr ((orbitalConfig K).extConstituent i).E u
        = inNbr ((orbitalConfig K).extConstituent i).E v := by
      ext z
      constructor
      · rintro ⟨y, hy, rfl⟩
        show (orbitalConfig K).color (σ y) v = i
        rw [← hσv, hcol σ hσ y u]
        exact hy
      · intro hz
        refine ⟨σ⁻¹ z, ?_, by simp⟩
        show (orbitalConfig K).color (σ⁻¹ z) u = i
        have hrw : (σ : Equiv.Perm α) ((σ : Equiv.Perm α)⁻¹ z) = z := by simp
        have h := hcol σ hσ ((σ : Equiv.Perm α)⁻¹ z) u
        rw [hrw] at h
        rw [← h, hσv]
        exact hz
    show (inNbr _ u).ncard = (inNbr _ v).ncard
    rw [← himg, Set.ncard_image_of_injective _ (σ : Equiv.Perm α).injective]
  obtain ⟨u₀⟩ := ‹Nonempty α›
  exact ⟨⟨_, fun u => hout u u₀⟩, ⟨_, fun u => hin u u₀⟩⟩

/-- An off-diagonal constituent of the orbital configuration of a transitive group of
rank `≥ 3` is a nontrivial digraph: it is neither empty, nor the diagonal, nor the complete
reflexive or irreflexive digraph.  The last case is where the rank bound is used: a third
color has to be realized, and it is realized by an off-diagonal pair. -/
theorem extConstituent_not_isTrivial (htr : IsTransitive K)
    (hrank : 3 ≤ (orbitalConfig K).rank) {i : Fin (orbitalConfig K).rank}
    (hi : ¬ (orbitalConfig K).IsDiagonalColor i) :
    ¬ ((orbitalConfig K).extConstituent i).IsTrivial := by
  classical
  obtain ⟨x₀⟩ := ‹Nonempty α›
  have hoff : (orbitalConfig K).rel i ∩ diag α = ∅ := extConstituent_isIrreflexive K hi
  have hnotdiag : ∀ z : α, (orbitalConfig K).color z z ≠ i := by
    intro z hz
    exact absurd (Set.eq_empty_iff_forall_notMem.1 hoff (z, z) ⟨hz, rfl⟩) not_false
  intro htriv
  rcases (Digraph.isTrivial_iff ((orbitalConfig K).extConstituent i)).1 htriv with
    h | h | h | h
  · obtain ⟨p, hp⟩ := (orbitalConfig K).rel_nonempty i
    have : p ∈ ((orbitalConfig K).extConstituent i).E := hp
    rw [h] at this
    exact this
  · have : ((x₀, x₀) : α × α) ∈ ((orbitalConfig K).extConstituent i).E := by
      rw [h]; exact rfl
    exact hnotdiag x₀ this
  · have : ((x₀, x₀) : α × α) ∈ ((orbitalConfig K).extConstituent i).E := by
      rw [h]; trivial
    exact hnotdiag x₀ this
  · -- `R_i` is the whole off-diagonal, so there is no room for a third color
    set dc : Fin (orbitalConfig K).rank := (orbitalConfig K).color x₀ x₀ with hdc
    have hne : ({dc, i} : Finset (Fin (orbitalConfig K).rank)) ≠ Finset.univ := by
      intro hcon
      have hcard := congrArg Finset.card hcon
      rw [Finset.card_univ, Fintype.card_fin] at hcard
      have h2 : ({dc, i} : Finset (Fin (orbitalConfig K).rank)).card ≤ 2 :=
        le_trans (Finset.card_insert_le _ _) (by simp)
      omega
    obtain ⟨j, -, hj⟩ :=
      Finset.exists_of_ssubset (lt_of_le_of_ne (Finset.subset_univ _) hne)
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hj
    obtain ⟨u, v, huv⟩ := (orbitalConfig K).color_surjective j
    have huv' : u ≠ v := by
      rintro rfl
      exact hj.1 (by rw [← huv, orbitalConfig_color_self_eq K htr u x₀])
    have hmem : ((u, v) : α × α) ∈ ((orbitalConfig K).extConstituent i).E := by
      rw [h]
      exact ⟨trivial, huv'⟩
    exact hj.2 (by rw [← huv]; exact hmem)

/-- §13.2, case (2b): "`X_i` has relative symmetry defect `≥ 1/2` by Cor. 2.4.12 because
`X_i` is an irreflexive, biregular, nontrivial digraph."

`X_i` is the color-`i` constituent of the orbital configuration of `F^C_{(S)}` on
`C' = C ∖ S`, for an off-diagonal color `i` (the paper's `i ≥ 2`); `F^C_{(S)}` is transitive
but not doubly transitive on `C'`, which by `Babai.three_le_rank_orbitalConfig` is what
makes the rank at least `3`. -/
theorem defect_extConstituent_ge_half (htr : IsTransitive K)
    (h2 : ¬ IsDoublyTransitive K) [Nontrivial α]
    {i : Fin (orbitalConfig K).rank} (hi : ¬ (orbitalConfig K).IsDiagonalColor i) :
    1 / 2 ≤ defect (Digraph.Aut ((orbitalConfig K).extConstituent i)) :=
  Digraph.defect_biregular_ge_half
    (extConstituent_not_isTrivial K htr (three_le_rank_orbitalConfig K htr h2) hi)
    (extConstituent_isIrreflexive K hi)
    (extConstituent_isBiregular K htr i)

end Case2bDefect

/-! #### Case (2b): the group `F^C_{(S)}` on `C' = C ∖ S`

The statements above are about a permutation group and its action on the ambient set; the
paper's `F^C_{(S)}` acts on `C' = C ∖ S`.  The two bridges below transport transitivity
one way and double transitivity the other. -/

section Case2bGroup

open PartitionStructure

variable {α : Type*} [Fintype α] [DecidableEq α]

theorem isTransitive_restrictTo_of_forall {H : Subgroup (Equiv.Perm α)} {A : Set α}
    (hinv : IsInvariant H A) [Nonempty ↥A]
    (h : ∀ a ∈ A, ∀ b ∈ A, ∃ g ∈ H, (g : Equiv.Perm α) a = b) :
    IsTransitive (restrictTo H A hinv) := by
  rw [isTransitive_iff_orbit_eq_univ]
  intro z
  ext w
  refine ⟨fun _ => trivial, fun _ => ?_⟩
  obtain ⟨g, hg, hgz⟩ := h (z : α) z.2 (w : α) w.2
  exact ⟨⟨restrictHom H A hinv ⟨g, hg⟩, ⟨⟨g, hg⟩, rfl⟩⟩, Subtype.ext hgz⟩

theorem exists_pair_of_isDoublyTransitive_restrictTo {H : Subgroup (Equiv.Perm α)}
    {A : Set α} (hinv : IsInvariant H A) (h : IsDoublyTransitive (restrictTo H A hinv))
    {a b a' b' : α} (ha : a ∈ A) (hb : b ∈ A) (ha' : a' ∈ A) (hb' : b' ∈ A)
    (hab : a ≠ b) (hab' : a' ≠ b') :
    ∃ g ∈ H, (g : Equiv.Perm α) a = a' ∧ (g : Equiv.Perm α) b = b' := by
  classical
  have hinj : ∀ {u v : ↥A}, u ≠ v → Function.Injective (![u, v]) := by
    intro u v huv i j hij
    fin_cases i <;> fin_cases j <;> simp_all
  set p : Fin 2 ↪ ↥A :=
    ⟨![(⟨a, ha⟩ : ↥A), ⟨b, hb⟩], hinj (fun hc => hab (congrArg Subtype.val hc))⟩ with hp
  set q : Fin 2 ↪ ↥A :=
    ⟨![(⟨a', ha'⟩ : ↥A), ⟨b', hb'⟩], hinj (fun hc => hab' (congrArg Subtype.val hc))⟩ with hq
  obtain ⟨-, hpre⟩ := (isMultiplyTransitive_iff (restrictTo H A hinv) 2).1 h
  obtain ⟨k, hk⟩ := hpre.exists_smul_eq p q
  have hval : ∀ i : Fin 2, (k : Equiv.Perm ↥A) (p i) = q i := by
    intro i
    have hi := congrArg (fun w : Fin 2 ↪ ↥A => w i) hk
    simpa [Subgroup.smul_def, Equiv.Perm.smul_def] using hi
  obtain ⟨⟨g, hg⟩, hgk⟩ := k.2
  refine ⟨g, hg, ?_, ?_⟩
  · have h0 := hval 0
    rw [← hgk] at h0
    have := congrArg Subtype.val h0
    simpa [hp, hq, restrictHom, Equiv.Perm.subtypePerm] using this
  · have h1 := hval 1
    rw [← hgk] at h1
    have := congrArg Subtype.val h1
    simpa [hp, hq, restrictHom, Equiv.Perm.subtypePerm] using this

/-- The complement of the individualized set is invariant under the pointwise stabilizer,
so the group can be restricted to it. -/
theorem isInvariant_compl_pointwiseStabilizer (H : Subgroup (Equiv.Perm α)) (S : Set α) :
    IsInvariant (pointwiseStabilizer H S) Sᶜ := by
  intro σ hσ
  obtain ⟨-, hfix⟩ := mem_pointwiseStabilizer.1 hσ
  have hS : (σ : Equiv.Perm α) '' S = S := by
    ext z
    constructor
    · rintro ⟨y, hy, rfl⟩; rwa [hfix y hy]
    · intro hz; exact ⟨z, hz, hfix z hz⟩
  rw [Set.image_compl_eq (σ : Equiv.Perm α).bijective, hS]

/-- §13.2, case (2b): `F^C_{(S)}`, the group of the individualized configuration, acting on
`C' = C ∖ S`. -/
noncomputable def indivGroup (K : Subgroup (Equiv.Perm α)) (S : Set α) :
    Subgroup (Equiv.Perm ↥(Sᶜ : Set α)) :=
  restrictTo (pointwiseStabilizer K S) Sᶜ (isInvariant_compl_pointwiseStabilizer K S)

theorem two_le_card_compl {S : Set α} {d : ℕ} (hS : S.ncard = d - 1) (hd1 : 1 ≤ d)
    (hcard : d + 1 ≤ Fintype.card α) : 2 ≤ Fintype.card ↥(Sᶜ : Set α) := by
  have hsum := Set.ncard_add_ncard_compl S
  have hcc : Nat.card ↥(Sᶜ : Set α) = (Sᶜ : Set α).ncard := (Nat.card_coe_set_eq _).symm
  rw [Nat.card_eq_fintype_card] at hcc hsum
  omega

/-- §13.2, case (2b), assembled.  After individualizing a set `S` of `d − 1` points of `C`,
where `d` is the degree of transitivity of `F^C`, the group `F^C_{(S)}` is transitive but
not doubly transitive on `C' = C ∖ S`, and therefore (`Babai.three_le_rank_orbitalConfig`,
Cor. 2.4.12) every off-diagonal constituent of its orbital configuration has relative
symmetry defect `≥ 1/2`.

> individualize the elements of a set `S ∈ (C choose d−1)` (: so `F^C_{(S)}` is transitive
> but not doubly transitive on `C' := C ∖ S` :) … (: Note: `X_i` has relative symmetry
> defect `≥ 1/2` by Cor. 2.4.12 … :) -/
theorem case2b_defect (K : Subgroup (Equiv.Perm α)) {S : Set α}
    (hS : S.ncard = degtrans K - 1) (hd1 : 1 ≤ degtrans K)
    (hcard : degtrans K + 1 ≤ Fintype.card α) :
    IsTransitive (indivGroup K S) ∧ ¬ IsDoublyTransitive (indivGroup K S) ∧
      ∀ i : Fin (orbitalConfig (indivGroup K S)).rank,
        ¬ (orbitalConfig (indivGroup K S)).IsDiagonalColor i →
        1 / 2 ≤ defect (Digraph.Aut ((orbitalConfig (indivGroup K S)).extConstituent i)) := by
  classical
  have h2card : 2 ≤ Fintype.card ↥(Sᶜ : Set α) := two_le_card_compl hS hd1 hcard
  haveI : Nontrivial ↥(Sᶜ : Set α) := Fintype.one_lt_card_iff_nontrivial.1 (by omega)
  haveI : Nonempty ↥(Sᶜ : Set α) := inferInstance
  have hdtr : IsMultiplyTransitive K (degtrans K) := (degtrans_spec K).1
  have hnd : ¬ IsMultiplyTransitive K (degtrans K + 1) := (degtrans_spec K).2
  have htr : IsTransitive (indivGroup K S) := by
    refine isTransitive_restrictTo_of_forall _ ?_
    intro a ha b hb
    exact isTransitive_pointwiseStab_individualize K hdtr hd1 hS ha hb
  have h2 : ¬ IsDoublyTransitive (indivGroup K S) := by
    intro hdt
    refine not_isDoublyTransitive_pointwiseStab_individualize K hnd hdtr hd1 hS hcard ?_
    intro a b a' b' ha hb ha' hb' hab hab'
    exact exists_pair_of_isDoublyTransitive_restrictTo _ hdt ha hb ha' hb' hab hab'
  exact ⟨htr, h2, fun i hi => defect_extConstituent_ge_half (indivGroup K S) htr h2 hi⟩

end Case2bGroup

/-- §13.2, case (2b): the multiplicative cost, "individualize the elements of a set
`S ∈ (C choose d−1)` … Individualize one of the `X_i` (`i ≥ 2`) (: multiplicative cost
`r − 1 ≤ m − 1` :)": `m^{d−1}(m−1)` in total. -/
def case2b_cost (m d : ℕ) : ℕ := m ^ (d - 1) * (m - 1)

end Cases

/-! ### §13.2, case (3): the two categories of the Claim

> Proof.  We apply Prop. ?? (Local guides).  To do so, we need to define the relevant
> categories.  Let `x₁` and `x₂` (rather than `x` and `y`) denote our two input strings.
> Let `D_i` be the subset `D` derived from input `x_i`.  We apply Prop. ?? with the
> assignment `Ω_i ← D_i` of variables.
>
> The objects of the category `𝓛` correspond to the pairs `(T, i)` where
> `T ∈ (D_i choose t)` is a test set.  The set of morphisms `(T,i) → (T',j)` are the
> bijections `T → T'` corresponding to the set
> `Iso_G((x_i)_T^{W_i(T)}, (x_j)_{T'}^{W_j(T')})` for all `T, T' ∈ (Γ choose t)`, where
> `W_i` corresponds to `W` under input `x_i`.
>
> The two abstract objects of category `C` are denoted `X₁` and `X₂`.  The underlying set
> of `X_i` is `□(X_i) = D_i`.  The morphisms are the bijections `D₁ → D₂` induced by the
> `G`-isomorphisms `x₁ → x₂`.

The two categories are built here as a `Babai.LocalGuideData` (`Babai.localGuideData`),
the input of the Local guide proposition `Babai.proposition_localGuide`.  As in
`Workspace/LocalCertificates/LocalGuide.lean`, the index set `I` of the inputs is left
arbitrary; the paper's case is `I = Fin 2`, `y = ![x₁, x₂]`.

The three facts that make this work are all from §13.1:

* a morphism of `𝓛` really *is* a bijection `T → T'`: an element of
  `Iso_G((x_i)_T^{W_i(T)}, (x_j)_{T'}^{W_j(T')})` carries `T` to `T'`
  (`Babai.compareIso_testImage`, the step of Proposition 13.1.11 that the paper's sketch
  omits; the corrected paper);
* `𝓛` is a `t`-local guide for `C`: a `G`-isomorphism `σ : x_i → x_j` carries `W_i(T)` to
  `W_j(T^{σ̄})` (Proposition 13.1.8 (v), `Babai.canonical_windowOut`) and `Ω(T)` to
  `Ω(T^{σ̄})` (`Babai.face_image`), hence the truncated colored strings of Notation
  13.1.10 to each other (`Babai.mem_compareIso_strAct`);
* the morphisms of `C` are defined on `D_i` at all: a `G`-isomorphism `x_i → x_j` carries
  `D_i` onto `D_j`, by the canonicity of `F` (`Babai.canonical_fixedGamma`).
-/

section Guide

variable {I : Type u} (y : I → (Ω → Λ))

/-! #### `Iso_G(x,y)` is a groupoid -/

theorem one_mem_strIso_self {A : Type*} (K : Subgroup (Equiv.Perm Ω)) (z : Ω → A) :
    (1 : Equiv.Perm Ω) ∈ strIso (K : Set (Equiv.Perm Ω)) z z :=
  ⟨K.one_mem, strAct_one z⟩

theorem inv_mem_strIso {A : Type*} {K : Subgroup (Equiv.Perm Ω)} {z z' : Ω → A}
    {σ : Equiv.Perm Ω} (h : σ ∈ strIso (K : Set (Equiv.Perm Ω)) z z') :
    σ⁻¹ ∈ strIso (K : Set (Equiv.Perm Ω)) z' z := by
  refine ⟨K.inv_mem h.1, ?_⟩
  rw [← h.2, ← strAct_mul, inv_mul_cancel, strAct_one]

theorem mul_mem_strIso {A : Type*} {K : Subgroup (Equiv.Perm Ω)} {z z' z'' : Ω → A}
    {σ ρ : Equiv.Perm Ω} (h : σ ∈ strIso (K : Set (Equiv.Perm Ω)) z z')
    (h' : ρ ∈ strIso (K : Set (Equiv.Perm Ω)) z' z'') :
    ρ * σ ∈ strIso (K : Set (Equiv.Perm Ω)) z z'' := by
  refine ⟨K.mul_mem h'.1 h.1, ?_⟩
  rw [strAct_mul, h.2, h'.2]

/-! #### The local guide property at the level of §13.1 -/

/-- "`𝓛` is a `t`-local guide for `C`", in the form §13.1 provides it: a `G`-isomorphism
`σ : x → x^σ` is a `G`-isomorphism of the truncated, `Ω(T)`-colored strings of Notation
13.1.10 belonging to `T` and to `T^{σ̄}`.

The two ingredients are the canonicity of `T ↦ W(T)` (Proposition 13.1.8 (v),
`Babai.canonical_windowOut`) and the equivariance of the face
(`Babai.face_image`), which is what makes the coloring of Notation 13.1.10 canonical. -/
theorem mem_compareIso_strAct (hset : LocalCertSetting G ϕ) (z : Ω → Λ) (T : Set Γ)
    (ht' : LargeK T.ncard (Nat.card Ω)) (htm' : 10 * T.ncard ≤ Nat.card Γ) [Nonempty Ω]
    (σ : G) :
    (σ : Equiv.Perm Ω) ∈ compareIso ϕ z (strAct z (σ : Equiv.Perm Ω)) T
      ((ϕ σ : Equiv.Perm Γ) '' T) := by
  have h8 : 8 < T.ncard := ht'.eight_lt
  have hk : VeryLargeK (Nat.card Γ) (maxOrbitLength G) :=
    veryLargeK_of_setting ϕ hset (by omega)
  have hW : windowOut ϕ (strAct z (σ : Equiv.Perm Ω)) ((ϕ σ : Equiv.Perm Γ) '' T)
      = (σ : Equiv.Perm Ω) '' windowOut ϕ z T := canonical_windowOut ϕ z T σ
  have hF : (σ : Equiv.Perm Ω) '' face ϕ T = face ϕ ((ϕ σ : Equiv.Perm Γ) '' T) :=
    face_image ϕ T hset hk σ
  refine ⟨σ.2, ?_⟩
  rw [strAct_eq_iff]
  intro u
  by_cases hu : u ∈ windowOut ϕ z T
  · have hu' : (σ : Equiv.Perm Ω) u
        ∈ windowOut ϕ (strAct z (σ : Equiv.Perm Ω)) ((ϕ σ : Equiv.Perm Γ) '' T) := by
      rw [hW]; exact ⟨u, hu, rfl⟩
    have hface : (u ∈ face ϕ T)
        ↔ ((σ : Equiv.Perm Ω) u ∈ face ϕ ((ϕ σ : Equiv.Perm Γ) '' T)) := by
      rw [← hF]
      constructor
      · intro h; exact ⟨u, h, rfl⟩
      · rintro ⟨v, hv, hvu⟩
        rwa [(σ : Equiv.Perm Ω).injective hvu] at hv
    rw [truncate_of_mem hu, truncate_of_mem hu']
    simp only [Option.some.injEq, colorByFace, Prod.mk.injEq, decide_eq_decide]
    exact ⟨(strAct_apply z (σ : Equiv.Perm Ω) u).symm, hface⟩
  · have hu' : (σ : Equiv.Perm Ω) u
        ∉ windowOut ϕ (strAct z (σ : Equiv.Perm Ω)) ((ϕ σ : Equiv.Perm Γ) '' T) := by
      rw [hW]
      rintro ⟨v, hv, hvu⟩
      exact hu (by rwa [(σ : Equiv.Perm Ω).injective hvu] at hv)
    rw [truncate_of_not_mem hu, truncate_of_not_mem hu']

/-! #### The morphisms of the two categories -/

/-- §13.2, case (3).  The morphisms `X_i → X_j` of the category `C`: "the bijections
`D₁ → D₂` induced by the `G`-isomorphisms `x₁ → x₂`".

That a `G`-isomorphism `σ : x_i → x_j` does induce a bijection `D_i → D_j` is the
canonicity of `F` (`Babai.canonical_fixedGamma`); `Babai.exists_mem_guideMorC` produces
it. -/
def guideMorC (i j : I) :
    Set (↥(fixedGamma ϕ (y i) t) ≃ ↥(fixedGamma ϕ (y j) t)) :=
  {f | ∃ σ : G, strAct (y i) (σ : Equiv.Perm Ω) = y j ∧
    ∀ a : ↥(fixedGamma ϕ (y i) t),
      ((f a : ↥(fixedGamma ϕ (y j) t)) : Γ) = (ϕ σ : Equiv.Perm Γ) ((a : Γ))}

/-- §13.2, case (3).  The morphisms `(T,i) → (T',j)` of the category `𝓛`: "the bijections
`T → T'` corresponding to the set `Iso_G((x_i)_T^{W_i(T)}, (x_j)_{T'}^{W_j(T')})`".

The bijection corresponding to `σ` is `γ ↦ γ^{σ̄}`; it maps `T` onto `T'` by
`Babai.compareIso_testImage`. -/
def guideMorL (i j : I) (L : Set ↥(fixedGamma ϕ (y i) t))
    (L' : Set ↥(fixedGamma ϕ (y j) t)) : Set (↥L ≃ ↥L') :=
  {α | ∃ σ : G, (σ : Equiv.Perm Ω) ∈ compareIso ϕ (y i) (y j)
      (Subtype.val '' L) (Subtype.val '' L') ∧
    ∀ a : ↥L, (((α a : ↥L') : ↥(fixedGamma ϕ (y j) t)) : Γ)
      = (ϕ σ : Equiv.Perm Γ) (((a : ↥(fixedGamma ϕ (y i) t)) : Γ))}

/-- Every `G`-isomorphism `σ : x_i → x_j` induces a morphism `X_i → X_j` of `C`, namely
the restriction of `σ^ϕ` to `D_i` (`Babai.canonical_fixedGamma`). -/
theorem exists_mem_guideMorC (i j : I) (σ : G)
    (hσ : strAct (y i) (σ : Equiv.Perm Ω) = y j) :
    ∃ f : ↥(fixedGamma ϕ (y i) t) ≃ ↥(fixedGamma ϕ (y j) t),
      f ∈ guideMorC ϕ t y i j ∧
      ∀ a : ↥(fixedGamma ϕ (y i) t),
        ((f a : ↥(fixedGamma ϕ (y j) t)) : Γ) = (ϕ σ : Equiv.Perm Γ) ((a : Γ)) := by
  have hDij : fixedGamma ϕ (y j) t = (ϕ σ : Equiv.Perm Γ) '' fixedGamma ϕ (y i) t := by
    rw [← hσ]
    exact canonical_fixedGamma ϕ (y i) t σ
  exact ⟨(Equiv.Set.image (ϕ σ : Equiv.Perm Γ) (fixedGamma ϕ (y i) t)
      (ϕ σ : Equiv.Perm Γ).injective).trans (Equiv.setCongr hDij.symm),
    ⟨σ, hσ, fun _ => rfl⟩, fun _ => rfl⟩

/-! #### The two categories, as the input of the Local guide proposition -/

/-- §13.2, case (3): the categories `C` and `𝓛` of the Claim, packaged as the input of
the Local guide proposition (`Babai.proposition_localGuide`) with the assignment
`Ω_i ← D_i`.

The groupoid axioms of `C` and of `𝓛` are the groupoid axioms of `Iso_G(·,·)`
(`Babai.one_mem_strIso_self`, `Babai.inv_mem_strIso`, `Babai.mul_mem_strIso`); the
local-guide axiom is `Babai.mem_compareIso_strAct`. -/
noncomputable def localGuideData (hset : LocalCertSetting G ϕ)
    (ht : LargeK t (Nat.card Ω)) (htm : 10 * t ≤ Nat.card Γ) [Nonempty Ω] :
    LocalGuideData I (fun i => ↥(fixedGamma ϕ (y i) t)) t where
  morC := guideMorC ϕ t y
  morL := guideMorL ϕ t y
  morC_refl i := ⟨1, by simp, fun a => by simp⟩
  morC_symm := by
    rintro i j f ⟨σ, hσ, hf⟩
    refine ⟨σ⁻¹, ?_, fun b => ?_⟩
    · have hc : ((σ⁻¹ : G) : Equiv.Perm Ω) = (σ : Equiv.Perm Ω)⁻¹ := rfl
      rw [hc, ← hσ, ← strAct_mul]
      simp
    · have h := hf (f.symm b)
      rw [Equiv.apply_symm_apply] at h
      rw [map_inv, h]
      simp
  morC_trans := by
    rintro i j l f g ⟨σ, hσ, hf⟩ ⟨ρ, hρ, hg⟩
    refine ⟨ρ * σ, ?_, fun a => ?_⟩
    · have hc : ((ρ * σ : G) : Equiv.Perm Ω)
          = (ρ : Equiv.Perm Ω) * (σ : Equiv.Perm Ω) := rfl
      rw [hc, strAct_mul, hσ, hρ]
    · show ((g (f a) : ↥(fixedGamma ϕ (y l) t)) : Γ) = _
      rw [map_mul, hg (f a), hf a]
      rfl
  morL_refl i L := ⟨1, one_mem_strIso_self G _, fun a => by simp⟩
  morL_symm := by
    rintro i j L L' α ⟨σ, hσ, hα⟩
    refine ⟨σ⁻¹, ?_, fun b => ?_⟩
    · have hc : ((σ⁻¹ : G) : Equiv.Perm Ω) = (σ : Equiv.Perm Ω)⁻¹ := rfl
      rw [hc]
      exact inv_mem_strIso hσ
    · have h := hα (α.symm b)
      rw [Equiv.apply_symm_apply] at h
      rw [map_inv, h]
      simp
  morL_trans := by
    rintro i j l L L' L'' α β ⟨σ, hσ, hα⟩ ⟨ρ, hρ, hβ⟩
    refine ⟨ρ * σ, ?_, fun a => ?_⟩
    · have hc : ((ρ * σ : G) : Equiv.Perm Ω)
          = (ρ : Equiv.Perm Ω) * (σ : Equiv.Perm Ω) := rfl
      rw [hc]
      exact mul_mem_strIso hσ hρ
    · show (((β (α a) : ↥L'') : ↥(fixedGamma ϕ (y l) t)) : Γ) = _
      rw [map_mul, hβ (α a), hα a]
      rfl
  guide := by
    rintro i j f ⟨σ, hσ, hf⟩ L hL
    have hTcard : (Subtype.val '' L : Set Γ).ncard = t := by
      rw [Set.ncard_image_of_injective _ Subtype.val_injective]
      exact hL
    refine ⟨σ, ?_, fun a => hf _⟩
    have hT2 : (Subtype.val ''
          ((f : ↥(fixedGamma ϕ (y i) t) → ↥(fixedGamma ϕ (y j) t)) '' L) : Set Γ)
        = (ϕ σ : Equiv.Perm Γ) '' (Subtype.val '' L) := by
      rw [← Set.image_comp, ← Set.image_comp]
      exact Set.image_congr fun a _ => hf a
    rw [hT2, ← hσ]
    exact mem_compareIso_strAct ϕ hset (y i) (Subtype.val '' L)
      (by rw [hTcard]; exact ht) (by rw [hTcard]; exact htm) σ

/-! #### Non-fullness -/

/-- §13.2, case (3).

> Our current assumption is that the objects in `𝓛` are not full in our sense, i. e.,
> `Aut(T,i) ≤ M_i(T)` where `M_i(T) ≱ A(T)`.  In particular it follows that the objects in
> `𝓛` are not full in the sense of Prop. ??, i. e., `Aut(T,i) ≠ S(T)`.

`Aut(T,i) ≤ M_i(T)` is `Babai.compareIso_mem_outStage_H`: a `G`-automorphism of the
truncated, colored string `(x_i)_T^{W_i(T)}` stabilizes `T` and respects `x_i` on the
window, so it lies in `H(W(T))`, whose image in `S(T)` is `M(T)`.  `M_i(T) ≱ A(T)` is the
certificate of non-fullness of Theorem 13.1.3, i.e. Claim 13.1.7, applied to the test set
`T ⊆ D_i`, which is not full because it meets `D_i`
(`Babai.disjoint_fixedGamma_of_isFull`).  So if `Aut(T,i)` were all of `S(T)` we would get
`A(T) ≤ S(T) = Aut(T,i) ≤ M_i(T)`, a contradiction. -/
theorem not_isFullAt_guideMorL (hset : LocalCertSetting G ϕ)
    (ht : LargeK t (Nat.card Ω)) (htm : 10 * t ≤ Nat.card Γ) [Nonempty Ω]
    (i : I) (L : Set ↥(fixedGamma ϕ (y i) t)) (hL : L.ncard = t) :
    guideMorL ϕ t y i i L L ≠ Set.univ := by
  classical
  intro hfull
  set T : Set Γ := Subtype.val '' L with hT
  have hTcard : T.ncard = t := by
    rw [hT, Set.ncard_image_of_injective _ Subtype.val_injective]
    exact hL
  have ht' : LargeK T.ncard (Nat.card Ω) := by rw [hTcard]; exact ht
  have htm' : 10 * T.ncard ≤ Nat.card Γ := by rw [hTcard]; exact htm
  have h8 : 8 < t := ht.eight_lt
  have hsub : T ⊆ fixedGamma ϕ (y i) t := by
    rintro _ ⟨a, -, rfl⟩
    exact a.2
  have hTne : T.Nonempty := by
    rw [← Set.ncard_pos (Set.toFinite T), hTcard]
    omega
  -- `T` meets `D_i`, so `T` is not full (Definition 13.1.2)
  have hnotfull : ¬ IsFull ϕ (y i) T := by
    intro hf
    obtain ⟨p, hp⟩ := hTne
    exact disjoint_fixedGamma_of_isFull ⟨hTcard, hf⟩ ht' (by omega) p hp (hsub hp)
  -- Claim 13.1.7: `M(T) ≱ A(T)`
  have hM := (claim_13_1_7 (ϕ := ϕ) (x := y i) (T := T) ht' hnotfull).1
  refine hM ?_
  -- fullness of `L` gives `S(T) ≤ M(T)`, in particular `A(T) ≤ M(T)`
  intro c _
  set e : ↥L ≃ ↥T := Equiv.Set.image Subtype.val L Subtype.val_injective with he
  have hev : ∀ a : ↥L, ((e a : ↥T) : Γ) = ((a : ↥(fixedGamma ϕ (y i) t)) : Γ) := fun _ => rfl
  obtain ⟨σ, hσc, hσv⟩ :
      (Equiv.permCongr e).symm c ∈ guideMorL ϕ t y i i L L := by
    rw [hfull]; trivial
  have hH : (σ : Equiv.Perm Ω) ∈ (outStage ϕ (y i) T).H :=
    compareIso_mem_outStage_H ϕ (y i) T hset ht' htm' hσc
  have hval : psi ϕ T ⟨(σ : Equiv.Perm Ω), (outStage ϕ (y i) T).le hH⟩ = c := by
    refine Equiv.ext fun b => Subtype.ext ?_
    have hb : e (e.symm b) = b := e.apply_symm_apply b
    have h1 := hσv (e.symm b)
    have h2 : ((((Equiv.permCongr e).symm c) (e.symm b) : ↥L) :
        ↥(fixedGamma ϕ (y i) t)) = ((e.symm (c b) : ↥L) : ↥(fixedGamma ϕ (y i) t)) := by
      congr 1
      show (Equiv.permCongr e).symm c (e.symm b) = e.symm (c b)
      simp [Equiv.permCongr, hb]
    rw [h2] at h1
    have h3 : ((e (e.symm (c b)) : ↥T) : Γ) = ((c b : ↥T) : Γ) := by
      rw [e.apply_symm_apply]
    have h4 : ((e (e.symm b) : ↥T) : Γ) = ((b : ↥T) : Γ) := by rw [hb]
    rw [hev (e.symm (c b))] at h3
    rw [hev (e.symm b)] at h4
    show (ϕ ⟨(σ : Equiv.Perm Ω), _⟩ : Equiv.Perm Γ) ((b : ↥T) : Γ) = ((c b : ↥T) : Γ)
    rw [← h3, ← h4, ← h1]
  rw [← hval]
  exact psi_mem_certM ϕ (y i) T hH

end Guide

/-! ### Case (3): turning local asymmetry into global irregularity

> Claim (Turning local asymmetry into global irregularity).  In time `m^{O(t)}` we can
> construct a canonical `t`-ary relational structure on `D` with symmetry defect (much)
> greater than `1/2`.
>
> Proof.  We apply Prop. ?? (Local guides).  To do so, we need to define the relevant
> categories.  Let `x₁` and `x₂` (rather than `x` and `y`) denote our two input strings.
> Let `D_i` be the subset `D` derived from input `x_i`.  We apply Prop. ?? with the
> assignment `Ω_i ← D_i`.
>
> The objects of the category `L` correspond to the pairs `(T, i)` where `T ∈ (D_i choose
> t)` is a test set.  The set of morphisms `(T,i) → (T',j)` are the bijections `T → T'`
> corresponding to the set `Iso_G((x_i)_T^{W_i(T)}, (x_j)_{T'}^{W_j(T')})` for all
> `T, T' ∈ (Γ choose t)`, where `W_i` corresponds to `W` under input `x_i`.
>
> The two abstract objects of category `C` are denoted `X₁` and `X₂`.  The underlying set
> of `X_i` is `□(X_i) = D_i`.  The morphisms are the bijections `D₁ → D₂` induced by the
> `G`-isomorphisms `x₁ → x₂`.
>
> Our current assumption is that the objects in `L` are not full in our sense, i. e.,
> `Aut(T,i) ≤ M_i(T)` where `M_i(T) ≱ A(T)`.  In particular it follows that the objects in
> `L` are not full in the sense of Prop. ??, i. e., `Aut(T,i) ≠ S(T)`.
>
> Thus the assumptions of Prop. ?? are satisfied.  The algorithm of Prop. ?? returns
> canonical `t`-ary relational structures on `D_i` with [strong] symmetry defect
> `≥ |D_i| − t + 1 > m/2`.

The Local guide proposition is `Babai.proposition_localGuide`
(`Workspace/LocalCertificates/LocalGuide.lean`), which fills the `Prop. ??` of version 2.5
from the original version of the paper.  Its input, the two categories `C` and `𝓛`, is
built above as `Babai.localGuideData`, and the hypothesis "the objects of `𝓛` are not
full" is `Babai.not_isFullAt_guideMorL`. -/

/-- §13.2, case (3): what the Claim delivers for a family of inputs `y : I → (Ω → Σ)`
(the paper's case is `I = Fin 2`, `y = ![x₁, x₂]`).

A family of `t`-ary relational structures `𝔷_i` on the sets `D_i`, with

* symmetry defect `≥ |D_i| − t + 1`, and `> m/2` in the form `m < 2·sd(𝔷_i)`;
* canonicity: every `G`-isomorphism `σ : x_i → x_j` induces a bijection `D_i → D_j`
  (namely the restriction of `σ^ϕ`, which exists by `Babai.canonical_fixedGamma`) and that
  bijection is an isomorphism `𝔷_i → 𝔷_j`.

This last clause is the paper's "canonically embedded … structure": the `D_i` are
canonical subsets of `Γ` and the structures on them commute with the isomorphisms of the
inputs. -/
def IsCase3Output {I : Type u} (y : I → (Ω → Λ))
    (𝔷 : ∀ i : I, RelStructure ↥(fixedGamma ϕ (y i) t)) : Prop :=
  (∀ i, (𝔷 i).IsKAry t) ∧
  (∀ i, Fintype.card ↥(fixedGamma ϕ (y i) t) - t + 1 ≤ symDefect (𝔷 i).Aut) ∧
  (∀ i, Fintype.card Γ < 2 * symDefect (𝔷 i).Aut) ∧
  (∀ (i j : I) (σ : G), strAct (y i) (σ : Equiv.Perm Ω) = y j →
    ∃ f : ↥(fixedGamma ϕ (y i) t) ≃ ↥(fixedGamma ϕ (y j) t),
      (∀ a : ↥(fixedGamma ϕ (y i) t),
        ((f a : ↥(fixedGamma ϕ (y j) t)) : Γ) = (ϕ σ : Equiv.Perm Γ) ((a : Γ))) ∧
      (𝔷 i).map (f : ↥(fixedGamma ϕ (y i) t) → ↥(fixedGamma ϕ (y j) t)) = 𝔷 j)

/-- The Local guide proposition in the numerical form the Claim needs: the abstract step,
before the two categories of §13.2 are substituted for `C` and `𝓛`.

The numerical conclusion `> m/2` uses `4m < 5|D_i|` (case (3), `four_mul_lt_five_mul_fixed`)
and `10t ≤ m` (the hypothesis `t < m/10` of Theorem 13.2.1):
`|D_i| − t + 1 > 4m/5 − m/10 = 7m/10 > m/2`. -/
theorem claim_13_2_1_3_of_localGuideData {I : Type u} [Finite I] {Ω' : I → Type v}
    [∀ i, Fintype (Ω' i)]
    [∀ i, DecidableEq (Ω' i)] (LG : LocalGuideData I Ω' t) (ht : 1 ≤ t) (m : ℕ)
    (htm : 10 * t ≤ m) (hD : ∀ i, 4 * m < 5 * Fintype.card (Ω' i))
    (hle : ∀ i, t ≤ Fintype.card (Ω' i))
    (hfull : ∀ (i : I) (L : Set (Ω' i)), L.ncard = t → ¬ LG.IsFullAt i L) :
    (∀ i, (LG.guideStruct i).IsKAry t) ∧
      (∀ {i j : I} {f : Ω' i ≃ Ω' j}, f ∈ LG.morC i j →
        (LG.guideStruct i).map (f : Ω' i → Ω' j) = LG.guideStruct j) ∧
      (∀ i, Fintype.card (Ω' i) - t + 1 ≤ symDefect (LG.guideStruct i).Aut) ∧
      (∀ i, m < 2 * symDefect (LG.guideStruct i).Aut) := by
  refine ⟨LG.isKAry_guideStruct, fun hf => LG.guideStruct_map hf,
    fun i => LG.symDefect_guideStruct ht (hle i) (hfull i), fun i => ?_⟩
  have hdef := LG.symDefect_guideStruct (i := i) ht (hle i) (hfull i)
  have h1 := hD i
  have h2 := hle i
  omega

/-- **§13.2, case (3), the Claim** (Turning local asymmetry into global irregularity).

> Claim (Turning local asymmetry into global irregularity).  In time `m^{O(t)}` we can
> construct a canonical `t`-ary relational structure on `D` with symmetry defect (much)
> greater than `1/2`.
>
> Proof.  We apply Prop. ?? (Local guides). … Thus the assumptions of Prop. ?? are
> satisfied.  The algorithm of Prop. ?? returns canonical `t`-ary relational structures on
> `D_i` with [strong] symmetry defect `≥ |D_i| − t + 1 > m/2`.

The proof is the paper's: build the two categories (`Babai.localGuideData`), check that no
object of `𝓛` is full (`Babai.not_isFullAt_guideMorL`), and apply the Local guide
proposition.  The running time `m^{O(t)}` is
covered inside the RAM proof of Theorem 1.1.1 (`Algo.theorem_1_1_1`) and not stated as a
separate RAM theorem. -/
theorem claim_13_2_1_3 {I : Type u} [Finite I] (y : I → (Ω → Λ))
    (hset : LocalCertSetting G ϕ) (ht : LargeK t (Nat.card Ω))
    (htm : 10 * t ≤ Fintype.card Γ)
    (hD : ∀ i : I, 4 * Fintype.card Γ < 5 * (fixedGamma ϕ (y i) t).ncard) :
    ∃ 𝔷 : ∀ i : I, RelStructure ↥(fixedGamma ϕ (y i) t), IsCase3Output ϕ t y 𝔷 := by
  classical
  obtain ⟨u₀, -⟩ := hset.transitive
  haveI : Nonempty Ω := ⟨u₀⟩
  have hmΓ : Nat.card Γ = Fintype.card Γ := Nat.card_eq_fintype_card
  have htm' : 10 * t ≤ Nat.card Γ := by rw [hmΓ]; exact htm
  have h8 : 8 < t := ht.eight_lt
  have hcard : ∀ i : I, Fintype.card ↥(fixedGamma ϕ (y i) t)
      = (fixedGamma ϕ (y i) t).ncard := fun i => by
    rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq]
  have hle : ∀ i : I, t ≤ Fintype.card ↥(fixedGamma ϕ (y i) t) := by
    intro i
    have h := hD i
    rw [hcard i]
    omega
  set LG := localGuideData ϕ t y hset ht htm' with hLG
  have hfull : ∀ (i : I) (L : Set ↥(fixedGamma ϕ (y i) t)), L.ncard = t →
      ¬ LG.IsFullAt i L := fun i L hL hf =>
    not_isFullAt_guideMorL ϕ t y hset ht htm' i L hL hf
  obtain ⟨hkary, hmap, hdef, hhalf⟩ :=
    claim_13_2_1_3_of_localGuideData (t := t) LG (by omega) (Fintype.card Γ) htm
      (fun i => by rw [hcard i]; exact hD i) hle hfull
  refine ⟨LG.guideStruct, hkary, hdef, hhalf, fun i j σ hσ => ?_⟩
  obtain ⟨f, hfmem, hfval⟩ := exists_mem_guideMorC ϕ t y i j σ hσ
  exact ⟨f, hfval, hmap hfmem⟩

/-! ### Theorem 13.2.1 -/

/-- **Theorem 13.2.1** (AggregateCertificates), §13.2, the case distinction.

> (1) if the nontrivial orbits … of `F^Γ` cover at least `m/5` elements of `Γ` and no
> orbit of `F^Γ` has length `> 4m/5` … (2) else if `F^Γ` has an orbit `C ⊆ Γ` of length
> `|C| > 4m/5` … (3) else `|D| ≥ 4m/5` where `D ⊆ Γ` is the set of fixed points of `F^Γ`.

The three cases are exhaustive, with the stronger, strict inequality `4m < 5|D|` in
case (3).  The outcome of each case is:

* case (1): the colored 4/5-partition `Babai.orbitPartition`
  (`Babai.orbitPartition_isAlphaPartition`);
* case (2a): the hypothesis of Corollary 12.0.10
  (`Babai.corollary_12_0_10_hypothesis_of_giant`);
* case (2b): `1 ≤ d ≤ 5` (`Babai.degtrans_restrict_le_five`), the individualization of
  `d − 1` points (`Babai.isTransitive_pointwiseStab_individualize`,
  `Babai.not_isDoublyTransitive_pointwiseStab_individualize`), the orbital configuration
  (`Babai.orbitalConfig_individualize_isCoherent`,
  `Babai.orbitalConfig_individualize_isHomogeneous`, `Babai.three_le_rank_orbitalConfig`)
  and the multiplicative cost `Babai.case2b_cost`;
* case (3): `Babai.claim_13_2_1_3`, via the Local guide proposition.

The multiplicative cost `m^{O(t)}` of the theorem is the number of runs of the two
routines of §13.1: `C(m,t)` runs of LocalCertificates and `2·C(m,t)²` runs of
CompareLocalCertificates (`Babai.card_testSets`, `Babai.card_comparePairs`), times the
`m^{d−1}(m−1)` of case (2b).  The running time proper is the RAM theorem
`Algo.theorem_13_2_1_ram` (`Algo/Agg1321RAM.lean`): `10¹²·Σ τ(W) + (m+1)^{O(t)}·poly(input)`
steps outside the String Isomorphism calls, and at most `Babai.aggregateRoundCost m t n`
calls on windows of at most `n/t` points (`Algo.a13_calls`). -/
theorem theorem_13_2_1_cases :
    Case1 (bigFGamma ϕ x t) ∨ Case2 (bigFGamma ϕ x t) ∨
      4 * Fintype.card Γ < 5 * (fixedSet (bigFGamma ϕ x t)).ncard := by
  by_cases h1 : Case1 (bigFGamma ϕ x t)
  · exact Or.inl h1
  by_cases h2 : Case2 (bigFGamma ϕ x t)
  · exact Or.inr (Or.inl h2)
  exact Or.inr (Or.inr (four_mul_lt_five_mul_fixed _ h1 h2))

/-- The multiplicative cost of case (2b), `m^{d−1}(m−1)`, is at most `m^5` because
`d ≤ 5` (Theorem 2.2.4). -/
theorem case2b_cost_le {m d : ℕ} (hm : 1 ≤ m) (hd : d ≤ 5) : case2b_cost m d ≤ m ^ 5 := by
  have h1 : m ^ (d - 1) ≤ m ^ 4 := Nat.pow_le_pow_right hm (by omega)
  have h2 : m - 1 ≤ m := Nat.sub_le _ _
  calc case2b_cost m d = m ^ (d - 1) * (m - 1) := rfl
    _ ≤ m ^ 4 * m := Nat.mul_le_mul h1 h2
    _ = m ^ 5 := by ring

/-- **Theorem 13.2.1** (AggregateCertificates), §13.2, as one statement.

> Let `ϕ : G → S(Γ)` be a giant representation, where `G ≤ S(Ω)`, `|Ω| = n`, and
> `|Γ| = m`.  Let `max{8, 2 + log₂ n} < t < m/10`.  Then, at a multiplicative cost of
> `m^{O(t)}`, we can either find a canonical colored 4/5-partition of `Γ` or find a
> canonically embedded `t`-ary relational structure with relative symmetry defect `≥ 1/2`
> on `Γ`, or reduce the determination of `Iso_G(x,y)` to `n^{O(1)}` instances of size
> `≤ 2n/3`.

The `cost` of the statement is the multiplicative cost of the *case analysis* (the paper's
`m^{O(t)}` is the number of runs of the two routines of §13.1, `Babai.card_testSets` and
`Babai.card_comparePairs`, which is paid before the case analysis begins and is the same in
all four branches).  Cases (1), (2a) and (3) cost `1`; case (2b) costs
`m^{d−1}(m−1) ≤ m^5` (`Babai.case2b_cost`, `Babai.case2b_cost_le`).

The four outcomes are:

* (1) the colored 4/5-partition `Babai.orbitPartition` of `Γ`, canonical because `F(x)` is
  (`Babai.canonical_bigF`);
* (2a) the hypothesis of Corollary 12.0.10 on the canonical orbit `C`, `|C| > 4m/5`;
* (2b) a canonical subset `C' = C ∖ S` of `Γ` carrying the orbital configuration of
  `F^C_{(S)}`, whose off-diagonal constituents are binary relational structures of relative
  symmetry defect `≥ 1/2` (`Babai.case2b_defect`);
* (3) the set `D` of fixed points of `F^Γ` with `|D| > 4m/5`, on which no test set is full
  (`Babai.disjoint_fixedGamma_of_isFull`), together with the output of the Claim
  (`Babai.claim_13_2_1_3`): for the pair `(x, x')` formed by `x` and any second input `x'`
  whose own set of fixed points is again large (which is what makes the procedure land in
  case (3) for `x'` as well), the canonical `t`-ary relational structures on `D(x)` and
  `D(x')` with symmetry defect `≥ |D| − t + 1 > m/2` (`Babai.IsCase3Output`).

Canonicity of all four outcomes is canonicity of `F(x)`, `Babai.canonical_bigF`: every
`τ ∈ G` carries `F(x^τ)` to `τ⁻¹F(x)τ`, hence `F(x^τ)^Γ` to `(τ^ϕ)⁻¹F(x)^Γτ^ϕ`, and each of
`Babai.orbitPartition`, the orbits `C`, the set `D` and the orbital configuration is built
from `F^Γ` alone. -/
theorem theorem_13_2_1 (hset : LocalCertSetting G ϕ) (ht : LargeK t (Nat.card Ω))
    (htm : 10 * t < Fintype.card Γ) :
    ∃ cost : ℕ, cost ≤ (Fintype.card Γ) ^ 5 ∧
      ((cost = 1 ∧ (orbitPartition (bigFGamma ϕ x t)).IsAlphaPartition (4 / 5 : ℝ)) ∨
       (cost = 1 ∧ ∃ C : Set Γ, (∃ γ : Γ, C = (orbit (bigFGamma ϕ x t) γ : Set Γ)) ∧
          4 * Fintype.card Γ < 5 * C.ncard ∧
          Corollary_12_0_10_hypothesis (bigFGamma ϕ x t) C) ∨
       (∃ (C : Set Γ) (hinv : IsInvariant (bigFGamma ϕ x t) C),
          (∃ γ : Γ, C = (orbit (bigFGamma ϕ x t) γ : Set Γ)) ∧
          4 * Fintype.card Γ < 5 * C.ncard ∧
          ∃ (K : Subgroup (Equiv.Perm ↥C)) (d : ℕ) (S : Set ↥C),
            K = restrictTo (bigFGamma ϕ x t) C hinv ∧ d = degtrans K ∧
            1 ≤ d ∧ d ≤ 5 ∧ S.ncard = d - 1 ∧
            cost = case2b_cost (Fintype.card Γ) d ∧
            IsTransitive (indivGroup K S) ∧ ¬ IsDoublyTransitive (indivGroup K S) ∧
            ∀ i : Fin (PartitionStructure.orbitalConfig (indivGroup K S)).rank,
              ¬ (PartitionStructure.orbitalConfig (indivGroup K S)).IsDiagonalColor i →
              1 / 2 ≤ defect (Digraph.Aut
                ((PartitionStructure.orbitalConfig (indivGroup K S)).extConstituent i))) ∨
       (cost = 1 ∧ 4 * Fintype.card Γ < 5 * (fixedGamma ϕ x t).ncard ∧
          (∀ T : Set Γ, T.ncard = t → (T ∩ fixedGamma ϕ x t).Nonempty →
            T ∉ fullSets ϕ x t) ∧
          ∀ x' : Ω → Λ, 4 * Fintype.card Γ < 5 * (fixedGamma ϕ x' t).ncard →
            ∃ 𝔷 : ∀ i : Fin 2, RelStructure ↥(fixedGamma ϕ (![x, x'] i) t),
              IsCase3Output ϕ t ![x, x'] 𝔷)) := by
  classical
  have ht8 : 8 < t := ht.eight_lt
  have hm : 90 < Fintype.card Γ := by omega
  have hone : 1 ≤ Fintype.card Γ := by omega
  rcases theorem_13_2_1_cases ϕ x t with h1 | h2 | h3
  · exact ⟨1, Nat.one_le_pow _ _ (by omega), Or.inl ⟨rfl, orbitPartition_isAlphaPartition _ h1⟩⟩
  · obtain ⟨γ, hγ⟩ := h2
    set C : Set Γ := (orbit (bigFGamma ϕ x t) γ : Set Γ) with hC
    have hinv : IsInvariant (bigFGamma ϕ x t) C := isInvariant_orbit _ γ
    have hCcard : 4 * Fintype.card Γ < 5 * C.ncard := hγ
    have hCfin : Fintype.card ↥C = C.ncard := by
      rw [← Nat.card_eq_fintype_card, Nat.card_coe_set_eq]
    by_cases hgiant : alternatingGroup (C : Set Γ) ≤ restrictTo (bigFGamma ϕ x t) C hinv
    · exact ⟨1, Nat.one_le_pow _ _ (by omega), Or.inr (Or.inl ⟨rfl, C, ⟨γ, rfl⟩, hCcard,
        corollary_12_0_10_hypothesis_of_giant _ hinv hgiant⟩)⟩
    · -- case (2b)
      set K : Subgroup (Equiv.Perm ↥C) := restrictTo (bigFGamma ϕ x t) C hinv with hK
      set d : ℕ := degtrans K with hd
      have hd5 : d ≤ 5 := degtrans_restrict_le_five _ hinv hgiant
      haveI : Nonempty ↥C := ⟨⟨γ, mem_orbit_self γ⟩⟩
      have hKtr : IsTransitive K := isTransitive_restrictTo_orbit hinv
      have hd1 : 1 ≤ d := by
        refine le_csSup (bddAbove_multiplyTransitive K) ?_
        show IsMultiplyTransitive K 1
        rw [isMultiplyTransitive_iff]
        refine ⟨Fintype.card_pos, ?_⟩
        rw [MulAction.is_one_pretransitive_iff]
        exact hKtr.isPretransitive
      have hCbig : 6 ≤ Fintype.card ↥C := by rw [hCfin]; omega
      obtain ⟨u, -, hu⟩ := Finset.exists_subset_card_eq
        (s := (Finset.univ : Finset ↥C)) (n := d - 1)
        (by rw [Finset.card_univ]; omega)
      refine ⟨case2b_cost (Fintype.card Γ) d, case2b_cost_le hone hd5,
        Or.inr (Or.inr (Or.inl ⟨C, hinv, ⟨γ, rfl⟩, hCcard, K, d, (u : Set ↥C), rfl, rfl,
          hd1, hd5, ?_, rfl, ?_, ?_, ?_⟩))⟩
      · rw [Set.ncard_coe_finset, hu]
      all_goals
        · have hSn : ((u : Set ↥C)).ncard = d - 1 := by rw [Set.ncard_coe_finset, hu]
          have hcard : d + 1 ≤ Fintype.card ↥C := by omega
          have hres := case2b_defect K hSn hd1 hcard
          first
            | exact hres.1
            | exact hres.2.1
            | exact hres.2.2
  · refine ⟨1, Nat.one_le_pow _ _ (by omega), Or.inr (Or.inr (Or.inr ⟨rfl, h3, ?_, ?_⟩))⟩
    · rintro T hT ⟨p, hpT, hpD⟩ hfull
      have ht' : LargeK T.ncard (Nat.card Ω) := by rw [hT]; exact ht
      exact disjoint_fixedGamma_of_isFull hfull ht' (by omega) p hpT hpD
    · intro x' hx'
      refine claim_13_2_1_3 ϕ t ![x, x'] hset ht (by omega) ?_
      intro i
      fin_cases i
      · simpa using h3
      · simpa using hx'

/-- `D`, the fixed points of `F^Γ`, in the notation of the case distinction. -/
theorem fixedGamma_eq_fixedSet : fixedGamma ϕ x t = fixedSet (bigFGamma ϕ x t) := rfl

end Babai