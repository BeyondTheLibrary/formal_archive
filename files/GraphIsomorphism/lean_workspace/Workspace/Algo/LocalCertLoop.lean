/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

The algorithmic layer: the while loop of Procedure LocalCertificates (§13.1, lines 01–05).
-/
import Workspace.Algo.LocalCertImg
import Workspace.Algo.TestSetNaming

/-!
# The while loop of Procedure LocalCertificates (§13.1, claim C2)

> 01  `W ← ∅`  (: so `H(W) = G_T` :)
> 02  while `H(W)^T ≥ A(T)` and `Aff(H(W), ψ_T) ⊄ W` do
> 03    `W_new ← Aff(H(W), ψ_T)`
> 04    recompute `H(W_new)`
> 05  end while

## The raw state

The loop carries the triple `(W, gens, imgs)` — the window, generators of `H(W)`, and the
images of those generators under `ψ_T` — beside a context `(x, tdom)` that never changes:
the string and the domain witness of the test set.  The images have to travel with the
generators because `ψ_T` cannot be read off a generator alone; the decision of "A13
session 3" in `Workspace/Algo/DESIGN.md` is to *recompute* them after every round with
`Algo.rawImgOf`, which is Prop. 2.2.6 (b) applied in the graph group on `Ω ⊔ T`.

## How the loop is run

The loop is **not** an `Algo.Round`.  `Algo.Round` has one instance type and one state type
for a node and for its children, so a loop node whose children are Recompute instances would
need a third phase in `Algo.RawLCSI` and a state type `RawCoset × (loop state)`, that is, a
second copy of `Workspace/Algo/LocalCertRound.lean`.  And it would not fit even then: the
answer type of a round is a `RawCoset` and `Algo.Implements` compares it with an
`SIReduction … (Set (Perm Ω))`, while the value of `Babai.loopReduction` is a *pair*
`Set Ω × Set (Perm Ω)`.  The loop is a caller of String Isomorphism, not an instance of it.

What it is instead is a **bounded iteration** of one step, in the sense of
`RAM.QuasiPolyFun.iterate`.  One step runs line 03 (`Algo.rawAff`), then line 04 — one whole
evaluation of the Recompute round, which `Algo.Round.runAnswer` turns into a single
`RAM.QuasiPolyFun` (`Algo.Round.quasiPolyFun_runAnswer`) — and then restores the images with
`Algo.rawImgOf`.  The step is the identity once the test of line 02 fails, so iterating it
`n` times is the same as stopping at `Babai.haltIndex`, which is at most `n`
(`Babai.haltIndex_le_card`).  The iteration count `n` is read off the *length* of the string,
never off a machine natural.

## Main definitions

* `Algo.RawLCCtx`, `Algo.RawLCSt` — the context and the state of the loop;
* `Algo.lcAffNew`, `Algo.lcCond`, `Algo.lcInst` — lines 03, 02 and 04;
* `Algo.lcStep`, `Algo.lcLoop`, `Algo.lcRun` — one round, `k` rounds, the whole loop;
* `Algo.StateFor` — **the invariant**: the raw state decodes to a `Babai.Stage`.

## Main results

* `Algo.winSet_lcAffNew` — line 03 computes `Aff(H(W), ψ_T)`;
* `Algo.lcCond_eq_true_iff` — line 02 decides `Babai.Stage.LoopCond`;
* `Algo.lcwf_lcInst` — the instance handed to Procedure Recompute `H(W)` is well formed, and
  `Algo.answer_lcInst` — its answer is `H(W_new)`;
* `Algo.stateFor_lcStep` — **the invariant is restored**: one step of the loop carries the
  state of stage `i` to the state of stage `i + 1`;
* `Algo.stateFor_lcLoop`, `Algo.stateFor_lcRun` — after `k ≤ haltIndex` steps the state
  decodes to `Babai.stages … k`, and after `n` steps to `Babai.outStage`;
* `Algo.quasiPolyFun_lcStep` — one round is a machine routine, `Algo.polyFun_lcCount` — so
  is the iteration count, and `Algo.size_lcStep_iterate_le` — the state never grows past
  `Algo.lcStBound`;
* `Algo.quasiPolyFun_lcRun` — **hence the whole loop is a machine routine**, given one for
  Procedure Recompute `H(W)`.

No axiom, no `sorry`, no `native_decide`.
-/

namespace Algo

open RAM RAM.Targets
open Equiv (Perm)
open scoped Classical

variable {n m : ℕ}

/-! ## The raw loop -/

/-- The data of the loop that never change: the string `x` and the domain witness of the test
set `T`.  The string doubles as the domain witness of `Ω`: only its length is read. -/
abbrev RawLCCtx := RawStr × List ℕ

/-- The state of the while loop: the window `W`, generators of `H(W)`, and the images of
those generators under `ψ_T`. -/
abbrev RawLCSt := List ℕ × RawGens × RawGens

/-- The loop: a fixed context and a state. -/
abbrev RawLCLoop := RawLCCtx × RawLCSt

/-- The action data `(Ω, H(W)) → (T, H(W)^T)` the state describes: this is what lines 03,
04a, 07 and 10 are handed (`Algo.RawAction`, the convention of Prop. 2.2.6). -/
def lcAct (p : RawLCLoop) : RawAction := ((p.1.1, p.2.2.1), (p.1.2, p.2.2.2))

/-- The number of cosets of `N = ker ψ_T` in `H(W)`, which is `|H(W)^T|`: the *order* of the
group generated by the stored images (`Algo.rawOrder`).  Enumerating the cosets is out of the
question — there are up to `t!` of them — but their number is a machine natural of
polynomially many bits. -/
def lcIdx (p : RawLCLoop) : ℕ := rawOrder (p.1.2, p.2.2.2)

/-- **Line 03**, `W_new ← Aff(H(W), ψ_T)`. -/
def lcAffNew (p : RawLCLoop) : List ℕ := rawAff (lcAct p)

/-- The second half of the test of line 02: `Aff(H(W), ψ_T) ⊄ W`, that is, the new window
lists a point the old one does not. -/
def lcGrown (p : RawLCLoop) : Bool :=
  decide (1 ≤ ((lcAffNew p).filter (fun u => decide (u ∉ p.2.1))).length)

/-- **Line 02**, the test of the while loop: `H(W)^T ≥ A(T)` and `Aff(H(W), ψ_T) ⊄ W`. -/
def lcCond (p : RawLCLoop) : Bool := rawIsFullT (p.1.2, p.2.2.2) && lcGrown p

/-- **Line 04**, the instance handed to Procedure Recompute `H(W)`
(`Workspace/Algo/LocalCertRound.lean`): the candidate set is `H(W_old)` with the identity as
representative, the window is `W_new`, the two strings are `x`, and the phase marker carries
the action on the test set together with the number of cosets of `N`. -/
def lcInst (p : RawLCLoop) : RawLCSI :=
  ((lcAffNew p, p.2.2.1, rawOne p.1.1, p.1.1, p.1.1), some ((p.1.2, p.2.2.2), lcIdx p))

/-- The generators of `H(W_new)` read off the answer of Procedure Recompute `H(W)`, shortened
to at most `n²` of them. -/
def lcNewGens (solve : RawLCSI → RawCoset) (p : RawLCLoop) : RawGens :=
  tidyGens (p.1.1, (solve (lcInst p)).elim [] (fun a => a.1))

/-- The images of the new generators under `ψ_T`, one call of `Algo.rawImgOf` each.  This is
what keeps the invariant of the loop: the images cannot be read off the new generators, but
they can be recomputed from the *old* action data, because `H(W_new) ≤ H(W_old)`.

The sanitizer `Algo.normPerm` is applied to each answer.  It changes nothing on a correct
answer (`Algo.decPerm_normPerm`), and it makes the state of the loop small *on every input*,
which is what `RAM.QuasiPolyFun.iterate` asks of an iterated step. -/
def lcNewImgs (solve : RawLCSI → RawCoset) (p : RawLCLoop) : RawGens :=
  (lcNewGens solve p).map (fun g => normPerm (p.1.2, rawImgOf (lcAct p, g)))

/-- **One round of the while loop** (lines 02–05).  When the test of line 02 fails the state
does not move, so iterating the step any number of times beyond `Babai.haltIndex` gives the
same state. -/
def lcStep (solve : RawLCSI → RawCoset) (p : RawLCLoop) : RawLCLoop :=
  if lcCond p then (p.1, (lcAffNew p, lcNewGens solve p, lcNewImgs solve p)) else p

/-- `k` rounds of the while loop. -/
def lcLoop (solve : RawLCSI → RawCoset) (k : ℕ) (p : RawLCLoop) : RawLCLoop :=
  (lcStep solve)^[k] p

/-- **The while loop** (lines 01–05), run `n` times, with `n` read off the length of the
string.  "The while loop is executed at most `n` times" (§13.1) is `Babai.haltIndex_le_card`,
so `n` rounds always reach the exit. -/
def lcRun (solve : RawLCSI → RawCoset) (p : RawLCLoop) : RawLCLoop :=
  lcLoop solve p.1.1.length p

@[simp] theorem lcStep_fst (solve : RawLCSI → RawCoset) (p : RawLCLoop) :
    (lcStep solve p).1 = p.1 := by
  rw [lcStep]; by_cases h : lcCond p <;> simp [h]

@[simp] theorem lcLoop_fst (solve : RawLCSI → RawCoset) (k : ℕ) (p : RawLCLoop) :
    (lcLoop solve k p).1 = p.1 := by
  induction k with
  | zero => rfl
  | succ k ih => rw [lcLoop, Function.iterate_succ_apply', ← lcLoop, lcStep_fst, ih]

/-! ## The well-formed context

The test-set witness is asked to be a list of points below `n`.  This is a *size* condition,
not a mathematical one: `Algo.LCWF` asks it of the descend-phase data so that the state of
the Recompute round stays polynomially small in the domain size (risk R-A13-3 of "A13
session 1").  It holds whenever `m ≤ n`, which is the situation of §13.1 — the giant
representation `ϕ : G → S(Γ)` comes from the action of `G ≤ S(Ω)`. -/

/-- The fixed data of the loop are well formed: the string has `n` letters, the test set is a
repetition-free list of at most `n` points, below `m` and below `n`. -/
structure LCCtxWF (n m : ℕ) (xs : RawStr) (tdom : List ℕ) : Prop where
  /-- The string has one letter per point of `Ω`. -/
  lenStr : xs.length = n
  /-- A test set lists each of its points once. -/
  nodup : tdom.Nodup
  /-- Its points are points of `Γ`. -/
  ltM : ∀ u ∈ tdom, u < m
  /-- Its labels are small (the size condition of `Algo.LCWF`). -/
  ltN : ∀ u ∈ tdom, u < n
  /-- The test set is not larger than `Ω` (the size condition of `Algo.LCWF`). -/
  lenLe : tdom.length ≤ n

/-! ## The invariant -/

section Inv

variable {G : Subgroup (Perm (Fin n))} {ϕ : G →* Perm (Fin m)} {xs : RawStr} {tdom : List ℕ}

/-- `ψ_T` does not depend on which subgroup of `G_T` it is restricted to: its value at a
permutation is the same in both.  (Definitional proof irrelevance: the two sides are the same
term.) -/
theorem psiFin_congr {H₁ H₂ : Subgroup (Perm (Fin n))} (hnd : tdom.Nodup)
    (hlt : ∀ u ∈ tdom, u < m)
    (h₁ : H₁ ≤ Babai.bigGT ϕ (winSet m tdom)) (h₂ : H₂ ≤ Babai.bigGT ϕ (winSet m tdom))
    {σ : Perm (Fin n)} (hσ₁ : σ ∈ H₁) (hσ₂ : σ ∈ H₂) :
    psiFin ϕ tdom hnd hlt h₁ ⟨σ, hσ₁⟩ = psiFin ϕ tdom hnd hlt h₂ ⟨σ, hσ₂⟩ := rfl

/-- **The invariant of the while loop**: the raw state `(W, gens, imgs)` decodes to the stage
`s = (W, H(W))` of `Workspace/LocalCertificates/Procedure.lean`, and the stored images really
are the `ψ_T`-images of the stored generators. -/
structure StateFor (hc : LCCtxWF n m xs tdom)
    (s : Babai.Stage ϕ (decStrN n xs) (winSet m tdom)) (st : RawLCSt) : Prop where
  /-- The window lists each of its points once. -/
  nodupW : st.1.Nodup
  /-- The window lists points of `Ω`. -/
  ltW : ∀ u ∈ st.1, u < n
  /-- The window is the window of the stage. -/
  winW : winSet n st.1 = s.W
  /-- The generators are permutations of `Ω`. -/
  wfG : RawGens.WF n st.2.1
  /-- There are at most `n²` of them. -/
  lenG : st.2.1.length ≤ n * n
  /-- They generate `H(W)`. -/
  grp : decGroup n st.2.1 = s.H
  /-- The images are permutations of the test set. -/
  wfI : RawGens.WF tdom.length st.2.2
  /-- **The images are the images**: `Algo.ImgsOf`, the convention of Prop. 2.2.6. -/
  himgs : ∀ hle : decGroup n st.2.1 ≤ Babai.bigGT ϕ (winSet m tdom),
    ImgsOf (st.2.1.map (decPerm n)) (st.2.2.map (decPerm tdom.length))
      (psiFin ϕ tdom hc.nodup hc.ltM hle)

variable {hc : LCCtxWF n m xs tdom} {s : Babai.Stage ϕ (decStrN n xs) (winSet m tdom)}
  {st : RawLCSt}

/-- `H(W) ≤ G_T`, on the raw generators. -/
theorem StateFor.le (h : StateFor hc s st) :
    decGroup n st.2.1 ≤ Babai.bigGT ϕ (winSet m tdom) := by
  rw [h.grp]; exact s.le

/-- The raw generator and image lists are the encodings of their decodings, which is the form
every specification lemma of `Algo/` is stated in. -/
theorem StateFor.act_eq (h : StateFor hc s st) :
    lcAct ((xs, tdom), st)
      = (((xs, (st.2.1.map (decPerm n)).map (encPerm n)),
          (tdom, (st.2.2.map (decPerm tdom.length)).map (encPerm tdom.length))) : RawAction) := by
  rw [lcAct, map_encPerm_decPerm h.wfG, map_encPerm_decPerm h.wfI]

/-! ### Line 03: the new window -/

/-- **Line 03 computes `Aff(H(W), ψ_T)`** (Definition 13.1.4). -/
theorem winSet_lcAffNew (h : StateFor hc s st) :
    winSet n (lcAffNew ((xs, tdom), st)) = s.aff := by
  rw [lcAffNew, h.act_eq,
    winSet_rawAff hc.lenStr rfl (h.himgs h.le)]
  ext u
  show Babai.AffectedIn (psiFin ϕ tdom hc.nodup hc.ltM h.le) u ↔ _
  rw [affectedIn_psiFin u]
  exact Babai.affectedIn_congr h.grp h.le s.le u

theorem nodup_lcAffNew (p : RawLCLoop) : (lcAffNew p).Nodup := nodup_rawAff _

theorem lt_lcAffNew (h : LCCtxWF n m xs tdom) {st : RawLCSt} {u : ℕ}
    (hu : u ∈ lcAffNew ((xs, tdom), st)) : u < n := by
  have := lt_of_mem_rawAff (p := lcAct ((xs, tdom), st)) hu
  rw [show (lcAct ((xs, tdom), st)).1.1 = xs from rfl, h.lenStr] at this
  exact this

/-! ### Line 02: the test -/

theorem lcGrown_eq_true_iff (h : StateFor hc s st) :
    lcGrown ((xs, tdom), st) = true ↔ ¬ s.aff ⊆ s.W := by
  have hsub : (s.aff ⊆ s.W) ↔ ∀ u ∈ lcAffNew ((xs, tdom), st), u ∈ st.1 := by
    rw [← winSet_lcAffNew h, ← h.winW]
    constructor
    · intro hs u hu
      have : (⟨u, lt_lcAffNew hc hu⟩ : Fin n) ∈ winSet n (lcAffNew ((xs, tdom), st)) :=
        mem_winSet.2 hu
      exact mem_winSet.1 (hs this)
    · intro hs y hy
      exact mem_winSet.2 (hs _ (mem_winSet.1 hy))
  rw [lcGrown, hsub, decide_eq_true_eq]
  constructor
  · intro hlen hall
    have hnil : (lcAffNew ((xs, tdom), st)).filter (fun u => decide (u ∉ st.1)) = [] := by
      refine List.filter_eq_nil_iff.2 (fun u hu => ?_)
      simp only [decide_eq_true_eq, not_not]
      exact hall u hu
    rw [hnil] at hlen
    simp at hlen
  · intro hnot
    rcases Nat.eq_zero_or_pos
        ((lcAffNew ((xs, tdom), st)).filter (fun u => decide (u ∉ st.1))).length with hz | hp
    · exfalso
      refine hnot (fun u hu => ?_)
      by_contra hmem
      have hmem' : u ∈ (lcAffNew ((xs, tdom), st)).filter (fun u => decide (u ∉ st.1)) :=
        List.mem_filter.2 ⟨hu, by simp [hmem]⟩
      have := List.length_pos_of_mem hmem'
      omega
    · exact hp

/-- **The test of lines 02 and 07** (Definition 13.1.2): the stored images decide
`H(W)^T ≥ A(T)`.  The test is on the *order* of the group they generate
(`Algo.rawIsGiantSub`), never on an enumeration of `A(T)`, which has `t!/2` elements. -/
theorem rawIsFullT_stateFor (h : StateFor hc s st) :
    rawIsFullT ((tdom, st.2.2) : RawTAct) = true
      ↔ alternatingGroup ↥(winSet m tdom) ≤ Babai.imgOn ϕ (winSet m tdom) s.le := by
    have e1 : rawIsFullT ((tdom, st.2.2) : RawTAct) = true
        ↔ alternatingGroup (Fin tdom.length)
            ≤ (psiFin ϕ tdom hc.nodup hc.ltM h.le).range :=
      rawIsFullT_eq_true_iff (gens := st.2.1.map (decPerm n))
        (td := ((tdom, st.2.2) : RawTAct)) h.wfI (h.himgs h.le)
    have e2 : alternatingGroup (Fin tdom.length)
          ≤ (psiFin ϕ tdom hc.nodup hc.ltM h.le).range
        ↔ alternatingGroup ↥(winSet m tdom) ≤ Babai.imgOn ϕ (winSet m tdom) h.le :=
      alternating_le_range_psiFin_iff
    have e3 : Babai.imgOn ϕ (winSet m tdom) h.le = Babai.imgOn ϕ (winSet m tdom) s.le :=
      Babai.imgOn_congr h.grp h.le s.le
    rw [e1, e2, e3]

/-- **Line 02 decides the while condition** (`Babai.Stage.LoopCond`): `H(W)^T ≥ A(T)` and
`Aff(H(W), ψ_T) ⊄ W`. -/
theorem lcCond_eq_true_iff (h : StateFor hc s st) :
    lcCond ((xs, tdom), st) = true ↔ s.LoopCond := by
  rw [lcCond, Bool.and_eq_true, rawIsFullT_stateFor h, lcGrown_eq_true_iff h]
  exact Iff.rfl

/-! ### Line 04: the instance -/

/-- The identity permutation of the domain, decoded. -/
theorem decPerm_rawOne (hx : xs.length = n) : decPerm n (rawOne xs) = 1 := by
  have h1 : rawOne xs = encPerm n 1 := by
    rw [rawOne, hx, encPerm_one]
  rw [h1, decPerm_encPerm]

/-- **The instance of line 04 is well formed** for the Recompute round. -/
theorem lcwf_lcInst (h : StateFor hc s st) : LCWF n (lcInst ((xs, tdom), st)) := by
  have hinv : rawIsInvariant (st.2.1, lcAffNew ((xs, tdom), st)) = true := by
    rw [rawIsInvariant_eq_true_iff h.wfG (fun u hu => lt_lcAffNew hc hu)]
    have : {y : Fin n | (y : ℕ) ∈ lcAffNew ((xs, tdom), st)}
        = winSet n (lcAffNew ((xs, tdom), st)) := rfl
    rw [this, winSet_lcAffNew h, h.grp]
    exact s.isInvariant_aff
  refine ⟨⟨hc.lenStr, hc.lenStr, nodup_lcAffNew _, fun u hu => lt_lcAffNew hc hu,
      h.wfG, h.lenG, ?_, hinv⟩, ?_⟩
  · rw [show (lcInst ((xs, tdom), st)).1.2.2.1 = rawOne xs from rfl, rawOne,
      hc.lenStr, ← encPerm_one]
    exact wf_encPerm n _
  · intro td idx hs
    have hq : (((tdom, st.2.2) : RawTAct), lcIdx ((xs, tdom), st)) = (td, idx) :=
      Option.some.inj hs
    have htd : td = ((tdom, st.2.2) : RawTAct) := (congrArg Prod.fst hq).symm
    have hidx : idx = lcIdx ((xs, tdom), st) := (congrArg Prod.snd hq).symm
    subst htd; subst hidx
    refine ⟨⟨hc.lenLe, hc.ltN⟩, h.wfI, ⟨psiFin ϕ tdom hc.nodup hc.ltM h.le, h.himgs h.le⟩, ?_⟩
    -- the stored index is the number of cosets of `N`
    have hψ : ImgsOf (st.2.1.map (decPerm n)) (st.2.2.map (decPerm tdom.length))
        (psiFin ϕ tdom hc.nodup hc.ltM h.le) := h.himgs h.le
    have h1 : actCosetIndex n tdom.length xs tdom (st.2.1.map (decPerm n))
        (st.2.2.map (decPerm tdom.length))
        = Nat.card (psiFin ϕ tdom hc.nodup hc.ltM h.le).range :=
      actCosetIndex_eq_card_range hc.lenStr rfl hψ
    have h2 : (psiFin ϕ tdom hc.nodup hc.ltM h.le).range
        = genGroup (st.2.2.map (decPerm tdom.length)) := hψ.range_eq_genGroup
    have h3 : rawOrder (tdom, st.2.2)
        = Nat.card (genGroup (st.2.2.map (decPerm tdom.length))) := by
      conv_lhs => rw [show st.2.2 = (st.2.2.map (decPerm tdom.length)).map
        (encPerm tdom.length) from (map_encPerm_decPerm h.wfI).symm]
      exact rawOrder_spec tdom rfl _
    show lcIdx ((xs, tdom), st)
      = actCosetIndex n tdom.length xs tdom (st.2.1.map (decPerm n))
          (st.2.2.map (decPerm tdom.length))
    rw [lcIdx, h3, h1, h2]

/-- **The answer of the instance of line 04 is `H(W_new)`**: the candidate set is `H(W_old)`,
the window is `W_new`, and the two strings are equal, so the answer is
`Aut^{W_new}_{H(W_old)}(x)`, which is `H(W_new)` (`Babai.Stage.step`). -/
theorem answer_lcInst (h : StateFor hc s st) :
    (decLCSI n (lcInst ((xs, tdom), st))).answer = (s.step.H : Set (Perm (Fin n))) := by
  have hK : (decLCSI n (lcInst ((xs, tdom), st))).K = (s.H : Set (Perm (Fin n))) := by
    show decCoset n (some (st.2.1, rawOne xs)) = _
    rw [← h.grp]
    ext τ
    constructor
    · rintro ⟨g, hg, rfl⟩
      rw [decPerm_rawOne hc.lenStr, one_mul]
      exact hg
    · intro hτ
      exact ⟨τ, hτ, by rw [decPerm_rawOne hc.lenStr, one_mul]⟩
  have hΔ : (decLCSI n (lcInst ((xs, tdom), st))).Δ = s.aff := winSet_lcAffNew h
  have hx : (decLCSI n (lcInst ((xs, tdom), st))).x = decStrN n xs := rfl
  have hy : (decLCSI n (lcInst ((xs, tdom), st))).y = decStrN n xs := rfl
  show Babai.wIso _ _ _ _ = _
  rw [hK, hΔ, hx, hy, Babai.Stage.step, Babai.coe_wAutSubgroup]
  rfl

end Inv

/-! ## A group read off a raw answer -/
section RawAnswer

/-- If a raw coset decodes to (the carrier of) a subgroup, then it is a `some`, and its
generator list generates that subgroup.  The representative is then an element of the group,
so multiplying by it changes nothing. -/
theorem decGroup_of_decCoset_eq {n : ℕ} {c : RawCoset} {K : Subgroup (Perm (Fin n))}
    (h : decCoset n c = (K : Set (Perm (Fin n)))) :
    ∃ a σ, c = some (a, σ) ∧ decGroup n a = K := by
  rcases c with _ | ⟨a, σ⟩
  · exfalso
    have h1 : (1 : Perm (Fin n)) ∈ (K : Set (Perm (Fin n))) := K.one_mem
    rw [← h] at h1
    exact h1
  · refine ⟨a, σ, rfl, ?_⟩
    set A := decGroup n a with hA
    set τ := decPerm n σ with hτdef
    have hfwd : ∀ g ∈ A, τ * g ∈ K := by
      intro g hg
      have h1 : τ * g ∈ decCoset n (some (a, σ)) := ⟨g, hg, rfl⟩
      rw [h] at h1
      exact h1
    have hbwd : ∀ k ∈ K, ∃ g ∈ A, k = τ * g := by
      intro k hk
      have h1 : k ∈ decCoset n (some (a, σ)) := by rw [h]; exact hk
      exact h1
    have hτK : τ ∈ K := by
      have := hfwd 1 A.one_mem
      rwa [mul_one] at this
    have hτA : τ ∈ A := by
      obtain ⟨g, hg, hg1⟩ := hbwd 1 K.one_mem
      have hgτ : τ⁻¹ = g := by
        rw [inv_eq_iff_mul_eq_one]
        exact hg1.symm
      rw [← hgτ] at hg
      exact A.inv_mem_iff.1 hg
    refine le_antisymm (fun g hg => ?_) (fun k hk => ?_)
    · have h2 : g = τ⁻¹ * (τ * g) := by group
      rw [h2]
      exact K.mul_mem (K.inv_mem hτK) (hfwd g hg)
    · obtain ⟨g, hg, rfl⟩ := hbwd k hk
      exact A.mul_mem hτA hg

end RawAnswer

/-! ## One round of the loop restores the invariant -/

section Step

variable {G : Subgroup (Perm (Fin n))} {ϕ : G →* Perm (Fin m)} {xs : RawStr} {tdom : List ℕ}
  {hc : LCCtxWF n m xs tdom} {s : Babai.Stage ϕ (decStrN n xs) (winSet m tdom)} {st : RawLCSt}

/-- **The forward image of one new generator** (`Algo.rawImgOf`, Prop. 2.2.6 (b)): the routine
returns the encoding of `ψ_T(g)`, for any `g` in the group the state holds. -/
theorem rawImgOf_state (h : StateFor hc s st) {g : RawPerm} (hg : RawPerm.WF n g)
    (hmem : decPerm n g ∈ decGroup n st.2.1) :
    rawImgOf (lcAct ((xs, tdom), st), g)
      = encPerm tdom.length (psiFin ϕ tdom hc.nodup hc.ltM h.le ⟨decPerm n g, hmem⟩) := by
  have hspec := rawImgOf_spec (dom := xs) (gdom := tdom) (gens := st.2.1.map (decPerm n))
    (imgs := st.2.2.map (decPerm tdom.length)) hc.lenStr rfl (h.himgs h.le) hmem
  rw [encPerm_decPerm hg] at hspec
  rw [h.act_eq]
  exact hspec

/-- **One round of the while loop carries stage `i` to stage `i + 1`.**  Line 03 is
`Algo.rawAff`, line 04 is one evaluation of the Recompute round, and the images of the new
generators are recomputed with `Algo.rawImgOf` — which is what re-establishes
`Algo.ImgsOf` and lets the next round run (§13.1; "A13 session 3" in
`Workspace/Algo/DESIGN.md`). -/
theorem stateFor_lcStep {solve : RawLCSI → RawCoset}
    (hsolve : ∀ I, LCWF n I → decCoset n (solve I) = (decLCSI n I).answer)
    (h : StateFor hc s st) (hcond : lcCond ((xs, tdom), st) = true) :
    StateFor hc s.step (lcStep solve ((xs, tdom), st)).2 := by
  -- the answer of line 04 is `H(W_new)`
  have hans : decCoset n (solve (lcInst ((xs, tdom), st)))
      = (s.step.H : Set (Perm (Fin n))) := by
    rw [hsolve _ (lcwf_lcInst h)]
    exact answer_lcInst h
  obtain ⟨a, σ, hsome, hgrpa⟩ := decGroup_of_decCoset_eq hans
  -- the new state
  have hstep : lcStep solve ((xs, tdom), st)
      = ((xs, tdom), (lcAffNew ((xs, tdom), st), lcNewGens solve ((xs, tdom), st),
          lcNewImgs solve ((xs, tdom), st))) := by
    rw [lcStep, if_pos hcond]
  have hgens : lcNewGens solve ((xs, tdom), st) = tidyGens (xs, a) := by
    rw [lcNewGens, hsome]
    rfl
  have hwfG : RawGens.WF n (lcNewGens solve ((xs, tdom), st)) := by
    rw [hgens]; exact wf_tidyGens hc.lenStr a
  have hgrp : decGroup n (lcNewGens solve ((xs, tdom), st)) = s.step.H := by
    rw [hgens, decGroup_tidyGens hc.lenStr, hgrpa]
  -- every new generator lies in the old group
  have hsub : ∀ g ∈ lcNewGens solve ((xs, tdom), st), decPerm n g ∈ decGroup n st.2.1 := by
    intro g hg
    have h1 : decPerm n g ∈ decGroup n (lcNewGens solve ((xs, tdom), st)) :=
      Subgroup.subset_closure (List.mem_map_of_mem hg)
    rw [hgrp] at h1
    rw [h.grp]
    exact s.step_H_le h1
  have himg : ∀ (g : RawPerm) (hg : g ∈ lcNewGens solve ((xs, tdom), st)),
      rawImgOf (lcAct ((xs, tdom), st), g)
        = encPerm tdom.length
            (psiFin ϕ tdom hc.nodup hc.ltM h.le ⟨decPerm n g, hsub g hg⟩) :=
    fun g hg => rawImgOf_state h (hwfG g hg) (hsub g hg)
  rw [hstep]
  refine ⟨nodup_lcAffNew _, fun u hu => lt_lcAffNew hc hu, ?_, hwfG, ?_, hgrp, ?_, ?_⟩
  · show winSet n (lcAffNew ((xs, tdom), st)) = s.step.W
    rw [winSet_lcAffNew h, Babai.Stage.step_W]
  · show (lcNewGens solve ((xs, tdom), st)).length ≤ n * n
    rw [hgens]; exact length_tidyGens hc.lenStr a
  · -- the images are well-formed permutations of the test set
    intro y hy
    obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hy
    exact wf_normPerm rfl _
  · -- and they really are the images
    intro hle
    refine ⟨by simp [lcNewImgs], ?_⟩
    intro i hi hi'
    have hi2 : i < (lcNewGens solve ((xs, tdom), st)).length := by
      simpa using hi
    have hmemg : (lcNewGens solve ((xs, tdom), st))[i] ∈ lcNewGens solve ((xs, tdom), st) :=
      List.getElem_mem hi2
    simp only [lcNewImgs, List.getElem_map]
    rw [decPerm_normPerm rfl, himg _ hmemg, decPerm_encPerm]
    exact psiFin_congr hc.nodup hc.ltM h.le hle _ _

end Step

/-! ## The loop -/

section Loop

variable {G : Subgroup (Perm (Fin n))} {ϕ : G →* Perm (Fin m)} {xs : RawStr} {tdom : List ℕ}
  {hc : LCCtxWF n m xs tdom}

/-- The loop is a pair whose first component never changes. -/
theorem lcLoop_eq_pair (solve : RawLCSI → RawCoset) (k : ℕ) (st : RawLCSt) :
    lcLoop solve k ((xs, tdom), st)
      = ((xs, tdom), (lcLoop solve k ((xs, tdom), st)).2) :=
  Prod.ext (lcLoop_fst solve k _) rfl

/-- **The invariant along the loop**: after `k ≤ haltIndex` rounds the raw state decodes to
the stage `Babai.stages … k`. -/
theorem stateFor_lcLoop {solve : RawLCSI → RawCoset}
    (hsolve : ∀ I, LCWF n I → decCoset n (solve I) = (decLCSI n I).answer)
    {st0 : RawLCSt}
    (h0 : StateFor hc (Babai.stages ϕ (decStrN n xs) (winSet m tdom) 0) st0) :
    ∀ k, k ≤ Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom) →
      StateFor hc (Babai.stages ϕ (decStrN n xs) (winSet m tdom) k)
        (lcLoop solve k ((xs, tdom), st0)).2 := by
  intro k
  induction k with
  | zero => intro _; exact h0
  | succ k ih =>
      intro hk
      have hkle : k ≤ Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom) := by omega
      have hst := ih hkle
      have hcond : lcCond ((xs, tdom), (lcLoop solve k ((xs, tdom), st0)).2) = true :=
        (lcCond_eq_true_iff hst).2
          (Babai.loopCond_of_lt_haltIndex ϕ (decStrN n xs) (winSet m tdom) (by omega))
      have hnext := stateFor_lcStep hsolve hst hcond
      have hiter : lcLoop solve (k + 1) ((xs, tdom), st0)
          = lcStep solve ((xs, tdom), (lcLoop solve k ((xs, tdom), st0)).2) := by
        rw [lcLoop, Function.iterate_succ_apply', ← lcLoop]
        exact congrArg (lcStep solve) (lcLoop_eq_pair solve k st0)
      rw [hiter, Babai.stages_succ]
      exact hnext

/-- **The loop stops**: once the test of line 02 fails the step is the identity, so any
number of further rounds changes nothing. -/
theorem lcLoop_add_haltIndex {solve : RawLCSI → RawCoset}
    (hsolve : ∀ I, LCWF n I → decCoset n (solve I) = (decLCSI n I).answer)
    {st0 : RawLCSt}
    (h0 : StateFor hc (Babai.stages ϕ (decStrN n xs) (winSet m tdom) 0) st0) :
    ∀ j, lcLoop solve (Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom) + j)
          ((xs, tdom), st0)
        = lcLoop solve (Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom)) ((xs, tdom), st0) := by
  intro j
  induction j with
  | zero => rfl
  | succ j ih =>
      have hst : StateFor hc (Babai.outStage ϕ (decStrN n xs) (winSet m tdom))
          (lcLoop solve (Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom))
            ((xs, tdom), st0)).2 :=
        stateFor_lcLoop hsolve h0 _ (le_refl _)
      have hcond : lcCond ((xs, tdom),
          (lcLoop solve (Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom))
            ((xs, tdom), st0)).2) = false := by
        by_contra hcon
        rw [Bool.not_eq_false] at hcon
        exact Babai.not_loopCond_outStage ϕ (decStrN n xs) (winSet m tdom)
          ((lcCond_eq_true_iff hst).1 hcon)
      have hiter : lcLoop solve (Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom) + (j + 1))
            ((xs, tdom), st0)
          = lcStep solve (lcLoop solve
              (Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom) + j) ((xs, tdom), st0)) := by
        rw [lcLoop, ← Nat.add_assoc, Function.iterate_succ_apply', ← lcLoop]
      have hcond' : lcCond (lcLoop solve
          (Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom)) ((xs, tdom), st0)) = false := by
        rw [lcLoop_eq_pair solve _ st0]; exact hcond
      rw [hiter, ih, lcStep, if_neg (by rw [hcond']; exact Bool.false_ne_true)]

/-- **The while loop of Procedure LocalCertificates** (lines 01–05): `n` rounds reach the
stage at which the loop exits.  "The while loop is executed at most `n` times" is
`Babai.haltIndex_le_card`. -/
theorem stateFor_lcRun {solve : RawLCSI → RawCoset}
    (hsolve : ∀ I, LCWF n I → decCoset n (solve I) = (decLCSI n I).answer)
    {st0 : RawLCSt}
    (h0 : StateFor hc (Babai.stages ϕ (decStrN n xs) (winSet m tdom) 0) st0) :
    StateFor hc (Babai.outStage ϕ (decStrN n xs) (winSet m tdom))
      (lcRun solve ((xs, tdom), st0)).2 := by
  have hhalt : Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom) ≤ n := by
    have h := Babai.haltIndex_le_card (ϕ := ϕ) (x := decStrN n xs) (T := winSet m tdom)
    rwa [Nat.card_eq_fintype_card, Fintype.card_fin] at h
  have hsplit : n = Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom)
      + (n - Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom)) := by omega
  have key : lcLoop solve n ((xs, tdom), st0)
      = lcLoop solve (Babai.haltIndex ϕ (decStrN n xs) (winSet m tdom))
          ((xs, tdom), st0) := by
    conv_lhs => rw [hsplit]
    exact lcLoop_add_haltIndex hsolve h0 _
  show StateFor hc _ (lcLoop solve xs.length ((xs, tdom), st0)).2
  rw [hc.lenStr, key]
  exact stateFor_lcLoop hsolve h0 _ (le_refl _)

end Loop

/-! ## The running time of one round

Everything the loop does besides line 04 is a `RAM.PolyFun`; line 04 is one evaluation of the
Recompute round, which `Algo.Round.quasiPolyFun_runAnswer` makes a single
`RAM.QuasiPolyFun`.  The factor `t!` is not in any of these routines: it is the *width* of
the descend phase of that round, that is, the number of times the evaluator runs its `child`
(`Algo.lcWidth_le_factorial`).  This is the split of Theorem 13.1.3, "`≤ t!n²` calls … and
`t!·poly(n)` computation". -/

section Cost

/-- The string of the loop. -/
theorem polyFun_lcStr : PolyFun (fun p : RawLCLoop => p.1.1) :=
  polyFun_fst.comp polyFun_fst

/-- The domain witness of the test set. -/
theorem polyFun_lcTdom : PolyFun (fun p : RawLCLoop => p.1.2) :=
  polyFun_fst.comp polyFun_snd

theorem polyFun_lcWin : PolyFun (fun p : RawLCLoop => p.2.1) :=
  polyFun_snd.comp polyFun_fst

theorem polyFun_lcGens : PolyFun (fun p : RawLCLoop => p.2.2.1) :=
  (polyFun_snd.comp polyFun_snd).comp polyFun_fst

theorem polyFun_lcImgsOf : PolyFun (fun p : RawLCLoop => p.2.2.2) :=
  (polyFun_snd.comp polyFun_snd).comp polyFun_snd

theorem polyFun_lcAct : PolyFun lcAct :=
  ((polyFun_lcStr.pair polyFun_lcGens).pair
    (polyFun_lcTdom.pair polyFun_lcImgsOf)).of_eq (fun _ => rfl)

theorem polyFun_lcIdx : PolyFun lcIdx :=
  ((polyFun_lcTdom.pair polyFun_lcImgsOf).comp polyFun_rawOrder).of_eq (fun _ => rfl)

theorem polyFun_lcAffNew : PolyFun lcAffNew :=
  (polyFun_lcAct.comp polyFun_rawAff).of_eq (fun _ => rfl)

theorem polyFun_lcGrown : PolyFun lcGrown := by
  classical
  have hmem : PolyFun (fun z : RawLCLoop × ℕ => decide (z.2 ∉ z.1.2.1)) := by
    have h1 : PolyFun (fun z : RawLCLoop × ℕ => decide (z.2 ∈ z.1.2.1)) :=
      (polyFun_snd.pair (polyFun_fst.comp polyFun_lcWin)).comp
        (polyFun_listMem (α := ℕ) polyFun_natEq)
    refine (PolyFun.ite h1 (polyFun_const false) (polyFun_const true)).of_eq (fun z => ?_)
    by_cases h : z.2 ∈ z.1.2.1 <;> simp [h]
  have hfil : PolyFun (fun p : RawLCLoop =>
      (lcAffNew p).filter (fun u => decide (u ∉ p.2.1))) :=
    (polyFun_id.pair polyFun_lcAffNew).comp (PolyFun.filterParam hmem)
  exact (((polyFun_const 1).pair (hfil.comp polyFun_length)).comp polyFun_le).of_eq
    (fun _ => rfl)

theorem polyFun_lcCond : PolyFun lcCond := by
  have hfull : PolyFun (fun p : RawLCLoop => rawIsFullT (p.1.2, p.2.2.2)) :=
    (polyFun_lcTdom.pair polyFun_lcImgsOf).comp polyFun_rawIsFullT
  refine (PolyFun.ite hfull polyFun_lcGrown (polyFun_const false)).of_eq (fun p => ?_)
  rw [lcCond]
  by_cases h : rawIsFullT (p.1.2, p.2.2.2) <;> simp [h]

theorem polyFun_lcInst : PolyFun lcInst := by
  have hwin : PolyFun (fun p : RawLCLoop =>
      ((lcAffNew p, p.2.2.1, rawOne p.1.1, p.1.1, p.1.1) : RawWinSI)) :=
    polyFun_lcAffNew.pair (polyFun_lcGens.pair
      ((polyFun_lcStr.comp polyFun_rawOne).pair (polyFun_lcStr.pair polyFun_lcStr)))
  have hq : PolyFun (fun p : RawLCLoop =>
      (some (((p.1.2, p.2.2.2), lcIdx p)) : Option (RawTAct × ℕ))) :=
    ((polyFun_lcTdom.pair polyFun_lcImgsOf).pair polyFun_lcIdx).comp polyFun_some
  exact (hwin.pair hq).of_eq (fun _ => rfl)

variable {solve : RawLCSI → RawCoset}

theorem quasiPolyFun_lcNewGens (hsolve : QuasiPolyFun solve) :
    QuasiPolyFun (lcNewGens solve) := by
  have hans : QuasiPolyFun (fun p : RawLCLoop => solve (lcInst p)) :=
    polyFun_lcInst.comp_quasi hsolve
  have helim : PolyFun (fun q : RawCoset × RawLCLoop =>
      q.1.elim ([] : RawGens) (fun b => b.1)) :=
    (PolyFun.optionElim (g := fun _ : RawLCLoop => ([] : RawGens))
      (h := fun z : (RawGens × RawPerm) × RawLCLoop => z.1.1)
      (polyFun_const _) (polyFun_fst.comp polyFun_fst)).of_eq (fun _ => rfl)
  have hgs : QuasiPolyFun (fun p : RawLCLoop =>
      (solve (lcInst p)).elim ([] : RawGens) (fun b => b.1)) :=
    ((hans.pair polyFun_id.quasiPolyFun).comp helim.quasiPolyFun).of_eq (fun _ => rfl)
  exact ((polyFun_lcStr.quasiPolyFun.pair hgs).comp
    polyFun_tidyGens.quasiPolyFun).of_eq (fun _ => rfl)

theorem quasiPolyFun_lcNewImgs (hsolve : QuasiPolyFun solve) :
    QuasiPolyFun (lcNewImgs solve) := by
  have hf : PolyFun (fun z : RawLCLoop × RawPerm =>
      normPerm (z.1.1.2, rawImgOf (lcAct z.1, z.2))) :=
    ((polyFun_fst.comp polyFun_lcTdom).pair
      (((polyFun_fst.comp polyFun_lcAct).pair polyFun_snd).comp polyFun_rawImgOf)).comp
      polyFun_normPerm
  exact ((polyFun_id.quasiPolyFun.pair (quasiPolyFun_lcNewGens hsolve)).comp
    (PolyFun.mapParam hf).quasiPolyFun).of_eq (fun _ => rfl)

/-- **One round of the while loop is a machine routine.**  Lines 02 and 03 and the state
update are `RAM.PolyFun`; line 04 costs one call of `solve`, the evaluation of Procedure
Recompute `H(W)`. -/
theorem quasiPolyFun_lcStep (hsolve : QuasiPolyFun solve) :
    QuasiPolyFun (lcStep solve) := by
  have hnew : QuasiPolyFun (fun p : RawLCLoop =>
      ((p.1, (lcAffNew p, lcNewGens solve p, lcNewImgs solve p)) : RawLCLoop)) :=
    polyFun_fst.quasiPolyFun.pair (polyFun_lcAffNew.quasiPolyFun.pair
      ((quasiPolyFun_lcNewGens hsolve).pair (quasiPolyFun_lcNewImgs hsolve)))
  refine (QuasiPolyFun.ite polyFun_lcCond hnew polyFun_id.quasiPolyFun).of_eq (fun p => ?_)
  rw [lcStep]
  by_cases h : lcCond p <;> simp [h]

/-- **The number of rounds is a routine**, read off the *length* of the string: a machine
natural is never a loop bound. -/
theorem polyFun_lcCount : PolyFun (fun p : RawLCLoop => (p.1.1.length, p)) :=
  (polyFun_lcStr.comp polyFun_length).pair polyFun_id

/-! ### The state stays small

`RAM.QuasiPolyFun.iterate` asks for a *polynomial* bound on every intermediate state of the
iteration, and it cannot be dropped: one clean step may double the length of its output, so
without the bound the states would grow exponentially along the loop.  Here the bound is
unconditional, because the step normalizes what it stores: the window is a sublist of
`0, …, n−1`, the generators are `Algo.tidyGens` of the answer — at most `n²` permutations of
`Ω` — and each image is sanitized by `Algo.normPerm` into a permutation of the test set.
The context `(x, tdom)` never changes, so one bound serves every round. -/

/-- The size of the state of the loop: a window of at most `n` points, at most `n²`
generators, and as many images. -/
def lcStBound (c : ℕ) : ℕ := 2 * strBound c + 2 * (2 * gensBound c + 2 * gensBound c)

theorem polyBound_strBound : PolyBound strBound :=
  (polyBound_const 1).add (polyBound_id.mul
    (((polyBound_const 2).mul (polyBound_id.add (polyBound_const 2))).add
      (polyBound_const 1)))

theorem polyBound_gensBound : PolyBound gensBound :=
  (polyBound_const 1).add ((polyBound_id.mul polyBound_id).mul
    (((polyBound_const 2).mul polyBound_strBound).add (polyBound_const 1)))

theorem polyBound_lcStBound : PolyBound lcStBound :=
  ((polyBound_const 2).mul polyBound_strBound).add
    ((polyBound_const 2).mul
      (((polyBound_const 2).mul polyBound_gensBound).add
        ((polyBound_const 2).mul polyBound_gensBound)))

theorem mono_strBound : Monotone strBound := by
  intro a b hab
  exact Nat.add_le_add_left (Nat.mul_le_mul hab (by omega)) 1

theorem mono_gensBound : Monotone gensBound := by
  intro a b hab
  exact Nat.add_le_add_left
    (Nat.mul_le_mul (Nat.mul_le_mul hab hab) (by have := mono_strBound hab; omega)) 1

theorem mono_lcStBound : Monotone lcStBound := by
  intro a b hab
  have h1 := mono_strBound hab
  have h2 := mono_gensBound hab
  have h3 : lcStBound a = 2 * strBound a + 2 * (2 * gensBound a + 2 * gensBound a) := rfl
  have h4 : lcStBound b = 2 * strBound b + 2 * (2 * gensBound b + 2 * gensBound b) := rfl
  omega

variable (solve)

/-- The domain size is at most the size of the context. -/
theorem lcDeg_le (p : RawLCLoop) : p.1.1.length ≤ Enc.size p.1 :=
  le_trans (length_le_size p.1.1) (size_fst_le' p.1)

/-- The size of the test set is at most the size of the context. -/
theorem lcTLen_le (p : RawLCLoop) : p.1.2.length ≤ Enc.size p.1 :=
  le_trans (length_le_size p.1.2) (size_snd_le' p.1)

theorem size_lcAffNew_le (p : RawLCLoop) :
    Enc.size (lcAffNew p) ≤ strBound (Enc.size p.1) := by
  have hN := lcDeg_le p
  have hlen : (lcAffNew p).length ≤ Enc.size p.1 := by
    have h1 : (lcAffNew p).length ≤ (List.range p.1.1.length).length :=
      List.length_filter_le _ _
    rw [List.length_range] at h1
    omega
  have hlt : ∀ u ∈ lcAffNew p, u < Enc.size p.1 := by
    intro u hu
    exact lt_of_lt_of_le (lt_of_mem_rawAff hu) hN
  exact size_natList_le hlen hlt

theorem size_lcNewGens_le (p : RawLCLoop) :
    Enc.size (lcNewGens solve p) ≤ gensBound (Enc.size p.1) := by
  have hN := lcDeg_le p
  have hwf : RawGens.WF p.1.1.length (lcNewGens solve p) := wf_tidyGens rfl _
  have hlen : (lcNewGens solve p).length ≤ p.1.1.length * p.1.1.length :=
    length_tidyGens rfl _
  have hentry : ∀ g ∈ lcNewGens solve p, Enc.size g ≤ strBound (Enc.size p.1) := by
    intro g hg
    exact size_natList_le (le_trans (le_of_eq (hwf g hg).length) hN)
      (fun u hu => lt_of_lt_of_le ((hwf g hg).lt hu) hN)
  have h1 := size_list_le_of_entries (lcNewGens solve p) (strBound (Enc.size p.1)) hentry
  have h2 : (lcNewGens solve p).length * (2 * strBound (Enc.size p.1) + 1)
      ≤ Enc.size p.1 * Enc.size p.1 * (2 * strBound (Enc.size p.1) + 1) :=
    Nat.mul_le_mul_right _ (le_trans hlen (Nat.mul_le_mul hN hN))
  have h3 : gensBound (Enc.size p.1)
      = 1 + Enc.size p.1 * Enc.size p.1 * (2 * strBound (Enc.size p.1) + 1) := rfl
  omega

theorem size_lcNewImgs_le (p : RawLCLoop) :
    Enc.size (lcNewImgs solve p) ≤ gensBound (Enc.size p.1) := by
  have hT := lcTLen_le p
  have hN := lcDeg_le p
  have hentry : ∀ y ∈ lcNewImgs solve p, Enc.size y ≤ strBound (Enc.size p.1) := by
    intro y hy
    obtain ⟨g, -, rfl⟩ := List.mem_map.1 hy
    have hwf : RawPerm.WF p.1.2.length (normPerm (p.1.2, rawImgOf (lcAct p, g))) :=
      wf_normPerm rfl _
    exact size_natList_le (le_trans (le_of_eq hwf.length) hT)
      (fun u hu => lt_of_lt_of_le (hwf.lt hu) hT)
  have hlen : (lcNewImgs solve p).length ≤ Enc.size p.1 * Enc.size p.1 := by
    have h0 : (lcNewImgs solve p).length = (lcNewGens solve p).length := by
      simp [lcNewImgs]
    have h1 : (lcNewGens solve p).length ≤ p.1.1.length * p.1.1.length :=
      length_tidyGens rfl _
    have h2 : p.1.1.length * p.1.1.length ≤ Enc.size p.1 * Enc.size p.1 :=
      Nat.mul_le_mul hN hN
    omega
  have h1 := size_list_le_of_entries (lcNewImgs solve p) (strBound (Enc.size p.1)) hentry
  have h2 : (lcNewImgs solve p).length * (2 * strBound (Enc.size p.1) + 1)
      ≤ Enc.size p.1 * Enc.size p.1 * (2 * strBound (Enc.size p.1) + 1) :=
    Nat.mul_le_mul_right _ hlen
  have h3 : gensBound (Enc.size p.1)
      = 1 + Enc.size p.1 * Enc.size p.1 * (2 * strBound (Enc.size p.1) + 1) := rfl
  omega

/-- **One round leaves a small state**, on every input. -/
theorem size_lcStep_snd_le (p : RawLCLoop) :
    Enc.size (lcStep solve p).2 ≤ max (Enc.size p.2) (lcStBound (Enc.size p.1)) := by
  rw [lcStep]
  by_cases hcond : lcCond p
  · rw [if_pos hcond]
    refine le_trans ?_ (le_max_right _ _)
    show Enc.size ((lcAffNew p, lcNewGens solve p, lcNewImgs solve p) : RawLCSt) ≤ _
    have h1 : Enc.size ((lcAffNew p, lcNewGens solve p, lcNewImgs solve p) : RawLCSt)
        ≤ 2 * Enc.size (lcAffNew p)
          + 2 * Enc.size ((lcNewGens solve p, lcNewImgs solve p) : RawGens × RawGens) :=
      size_pair_le' _
    have h2 : Enc.size ((lcNewGens solve p, lcNewImgs solve p) : RawGens × RawGens)
        ≤ 2 * Enc.size (lcNewGens solve p) + 2 * Enc.size (lcNewImgs solve p) :=
      size_pair_le' _
    have h3 := size_lcAffNew_le p
    have h4 := size_lcNewGens_le solve p
    have h5 := size_lcNewImgs_le solve p
    have h6 : lcStBound (Enc.size p.1)
        = 2 * strBound (Enc.size p.1)
          + 2 * (2 * gensBound (Enc.size p.1) + 2 * gensBound (Enc.size p.1)) := rfl
    omega
  · rw [if_neg hcond]
    exact le_max_left _ _

theorem lcStep_iterate_fst : ∀ (j : ℕ) (p : RawLCLoop), ((lcStep solve)^[j] p).1 = p.1 := by
  intro j
  induction j with
  | zero => intro p; rfl
  | succ j ih =>
      intro p
      rw [Function.iterate_succ_apply', lcStep_fst, ih]

/-- **Every state along the loop is small.** -/
theorem size_lcStep_iterate_le : ∀ (j : ℕ) (p : RawLCLoop),
    Enc.size ((lcStep solve)^[j] p).2 ≤ max (Enc.size p.2) (lcStBound (Enc.size p.1)) := by
  intro j
  induction j with
  | zero => intro p; exact le_max_left _ _
  | succ j ih =>
      intro p
      rw [Function.iterate_succ_apply']
      refine le_trans (size_lcStep_snd_le solve _) ?_
      rw [lcStep_iterate_fst solve j p]
      exact max_le (le_trans (ih p) (le_refl _)) (le_max_right _ _)

/-- The polynomial that bounds the state of the iteration. -/
def lcIterBound (s : ℕ) : ℕ := 2 * (s + 2) + 2 * (2 * s + 2 * (s + lcStBound s))

theorem polyBound_lcIterBound : PolyBound lcIterBound :=
  ((polyBound_const 2).mul (polyBound_id.add (polyBound_const 2))).add
    ((polyBound_const 2).mul
      (((polyBound_const 2).mul polyBound_id).add
        ((polyBound_const 2).mul (polyBound_id.add polyBound_lcStBound))))

/-- **The while loop is a machine routine.**  It is the bounded iteration
(`RAM.QuasiPolyFun.iterate`) of one round: `n` rounds, with `n` read off the length of the
string, one step each, and a state that never grows past `Algo.lcStBound`.  The only
quasipolynomial ingredient is `solve`, the evaluation of Procedure Recompute `H(W)`, whose
`t!` is the width of its descend phase. -/
theorem quasiPolyFun_lcRun (hsolve : QuasiPolyFun solve) : QuasiPolyFun (lcRun solve) := by
  have hstep : QuasiPolyFun (fun x : ℕ × RawLCLoop => (x.1 - 1, lcStep solve x.2)) :=
    (polyFun_fst.sub (polyFun_const 1)).quasiPolyFun.pair
      (polyFun_snd.quasiPolyFun.comp (quasiPolyFun_lcStep hsolve))
  have hq : ∀ a : RawLCLoop, a.1.1.length ≤ Enc.size a := by
    intro a
    exact le_trans (lcDeg_le a) (size_fst_le' a)
  have hp : ∀ (a : RawLCLoop), ∀ j ≤ a.1.1.length,
      Enc.size ((a.1.1.length - j, (lcStep solve)^[j] a) : ℕ × RawLCLoop)
        ≤ lcIterBound (Enc.size a) := by
    intro a j _
    have h1 : Enc.size ((a.1.1.length - j, (lcStep solve)^[j] a) : ℕ × RawLCLoop)
        ≤ 2 * Enc.size (a.1.1.length - j) + 2 * Enc.size ((lcStep solve)^[j] a) :=
      size_pair_le' _
    have h2 : Enc.size (a.1.1.length - j) ≤ Enc.size a + 2 := by
      have e1 : Enc.size (a.1.1.length - j) = Nat.size (a.1.1.length - j) + 2 :=
        Small.size_nat _
      have e2 : Nat.size (a.1.1.length - j) ≤ a.1.1.length - j := size_le_self _
      have e3 := hq a
      omega
    have h3 : Enc.size ((lcStep solve)^[j] a)
        ≤ 2 * Enc.size ((lcStep solve)^[j] a).1 + 2 * Enc.size ((lcStep solve)^[j] a).2 :=
      size_pair_le' _
    have h4 : ((lcStep solve)^[j] a).1 = a.1 := lcStep_iterate_fst solve j a
    have h5 := size_lcStep_iterate_le solve j a
    have h6 : Enc.size a.1 ≤ Enc.size a := size_fst_le' a
    have h7 : Enc.size a.2 ≤ Enc.size a := size_snd_le' a
    have h8 : lcStBound (Enc.size a.1) ≤ lcStBound (Enc.size a) := mono_lcStBound h6
    have h9 : max (Enc.size a.2) (lcStBound (Enc.size a.1))
        ≤ Enc.size a + lcStBound (Enc.size a) := by
      refine max_le ?_ ?_ <;> omega
    have h10 : lcIterBound (Enc.size a)
        = 2 * (Enc.size a + 2)
          + 2 * (2 * Enc.size a + 2 * (Enc.size a + lcStBound (Enc.size a))) := rfl
    rw [h4] at h3
    omega
  exact QuasiPolyFun.iterate (q := fun s => s) (p := lcIterBound) hstep
    polyFun_lcCount.quasiPolyFun hq polyBound_id.quasiPoly hp polyBound_lcIterBound

end Cost

end Algo
