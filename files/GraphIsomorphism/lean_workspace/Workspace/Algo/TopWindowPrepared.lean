import Workspace.Algo.TopSuppliedAuto

/-! # Preparing the computed restricted action
This file identifies the group generated by the raw restricted arrays with
the range of the restriction homomorphism. It preserves the actual generator
images, so the automatic top-action input can be used in the live matcher.
-/
namespace Algo
open RAM RAM.Targets Babai Equiv
open scoped Classical

 theorem topwAction_group {n : ℕ} {p : List ℕ × RawGens} (hgs : RawGens.WF n p.2)
    {Δ : List ℕ} (hnd : Δ.Nodup) (hlt : ∀ u ∈ Δ, u < n)
    (hinv : IsInvariant (decGroup n p.2) (winSet n Δ)) :
    decGroup Δ.length (rawRestrictGens (p, Δ)) =
      (winRestrictHom n Δ hnd hlt (decGroup n p.2) hinv).range := by
  have h := decGroup_rawRestrictGens hnd hlt p.1 (p.2.map (decPerm n)) hinv
  simpa only [map_encPerm_decPerm hgs] using h

noncomputable def topwActionHomRaw {n m : ℕ} {p : RawAction} (hgs : RawGens.WF n p.1.2)
    {Δ : List ℕ} (hnd : Δ.Nodup) (hlt : ∀ u ∈ Δ, u < n)
    (hinv : IsInvariant (decGroup n p.1.2) (winSet n Δ))
    (ϕ : restrictTo (decGroup n p.1.2) (winSet n Δ) hinv →* Perm (Fin m)) :
    decGroup Δ.length (topwAction (p, Δ)).1.2 →* Perm (Fin m) :=
  (topwInducedHom hnd hlt hinv ϕ).comp (Subgroup.inclusion (le_of_eq (topwAction_group hgs hnd hlt hinv)))

 theorem topwAction_WF_exact {n m : ℕ} {p : RawAction}
    {ψ : decGroup n p.1.2 →* Perm (Fin m)} (hp : RawAction.WF n m p ψ)
    {Δ : List ℕ} (hnd : Δ.Nodup) (hlt : ∀ u ∈ Δ, u < n)
    (hinv : IsInvariant (decGroup n p.1.2) (winSet n Δ))
    (ϕ : restrictTo (decGroup n p.1.2) (winSet n Δ) hinv →* Perm (Fin m))
    (hfactor : ∀ g : decGroup n p.1.2, ψ g = ϕ ⟨restrictHom (decGroup n p.1.2) (winSet n Δ) hinv g, ⟨g, rfl⟩⟩) :
    RawAction.WF Δ.length m (topwAction (p, Δ)) (topwActionHomRaw hp.2.2.1 hnd hlt hinv ϕ) := by
  refine ⟨rfl, hp.2.1, ?_, hp.2.2.2.1, ?_, ?_⟩
  · intro r hr
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hr
    have hg : decPerm n a ∈ decGroup n p.1.2 :=
      Subgroup.subset_closure (List.mem_map.2 ⟨a, ha, rfl⟩)
    have he := rawRestrictPerm_spec hnd hlt hinv hg
    rw [encPerm_decPerm (hp.2.2.1 a ha)] at he
    rw [he]
    exact wf_encPerm _ _
  · simpa only [topwAction, rawRestrictGens, List.length_map] using hp.2.2.2.2.1
  · intro i hi hi'
    have higen : i < p.1.2.length := by simpa only [topwAction, rawRestrictGens, List.length_map] using hi
    have hiimgs : i < p.2.2.length := by simpa only [topwAction, List.length_map] using hi'
    have hg : decPerm n p.1.2[i] ∈ decGroup n p.1.2 :=
      Subgroup.subset_closure (List.mem_map.2 ⟨_, List.getElem_mem higen, rfl⟩)
    have hv := (hp.2.2.2.2.2 i (by simpa using higen) (by simpa using hiimgs))
    simp only [List.getElem_map] at hv
    have hv' := hv.trans (hfactor ⟨_, hg⟩)
    simp only [topwAction, rawRestrictGens, List.getElem_map]
    unfold topwActionHomRaw
    change decPerm m p.2.2[i] = topwInducedHom hnd hlt hinv ϕ
      ⟨decPerm Δ.length (rawRestrictPerm (Δ, p.1.2[i])), _⟩
    rw [hv']
    apply congrArg ϕ
    apply Subtype.ext
    change restrictHom (decGroup n p.1.2) (winSet n Δ) hinv _ =
      (winEquiv n Δ hnd hlt).permCongr (decPerm Δ.length (rawRestrictPerm (Δ, p.1.2[i])))
    have he := rawRestrictPerm_spec hnd hlt hinv hg
    rw [encPerm_decPerm (hp.2.2.1 _ (List.getElem_mem higen))] at he
    rw [he, decPerm_encPerm]
    exact (congrArg Subtype.val (topwGroupEquiv_restrict hnd hlt hinv ⟨_, hg⟩)).symm

noncomputable def topwPreparedCompat {n m : ℕ} {p : RawAction} (hgs : RawGens.WF n p.1.2)
    {Δ : List ℕ} (hnd : Δ.Nodup) (hlt : ∀ u ∈ Δ, u < n)
    (hinv : IsInvariant (decGroup n p.1.2) (winSet n Δ))
    (ϕ : restrictTo (decGroup n p.1.2) (winSet n Δ) hinv →* Perm (Fin m)) :
    TopdCompat (Equiv.refl (Fin Δ.length)) (topwActionHomRaw hgs hnd hlt hinv ϕ)
      (topwInducedHom hnd hlt hinv ϕ) where
  group := MulEquiv.subgroupCongr (topwAction_group hgs hnd hlt hinv)
  coe := fun _ => rfl
  hom := fun _ => rfl

 theorem TopcsSpec.sameDomain {n m : ℕ} {G H : Subgroup (Perm (Fin n))}
    {ϕ : G →* Perm (Fin m)} {ψ : H →* Perm (Fin m)}
    (h : TopdCompat (Equiv.refl (Fin n)) ϕ ψ)
    {P : TopcsInput} {S : List (alternatingGroup (Fin m))} {O : TopActionOdd ϕ}
    {E : OrbitEnum (kerSubgroup ϕ)} {x y : Fin n → ℕ} (hp : TopcsSpec P ϕ S O E x y) :
    TopcsSpec P ψ S (h.odd O) (h.orbits E) x y := by
  have hg : (G : Set (Perm (Fin n))) = H := by simpa using h.group_image
  have hk : (kerSubgroup ϕ : Set (Perm (Fin n))) = kerSubgroup ψ := by simpa using h.kernel
  have hr : ϕ.range = ψ.range := h.range
  have ht (σ : alternatingGroup (Fin m)) : preimageSet (altHom ϕ) σ = preimageSet (altHom ψ) σ := by
    rw [topcsPreimage_altHom, topcsPreimage_altHom]
    simpa using h.preimage (σ : Perm (Fin m))
  constructor
  · exact hp.source_length
  · exact hp.source
  · exact hp.target
  · simpa [TopdCompat.orbits, topdOrbitEnum] using hp.windows
  · rw [hp.tests]
    exact List.map_congr_left (fun σ _ => ht σ)
  · exact hp.kernel.trans hk
  · simpa [TopdCompat.odd, hk] using hp.odd
  · simpa only [hr] using hp.even
  · exact hp.ambient.trans (SetLike.coe_injective hg)

end Algo
