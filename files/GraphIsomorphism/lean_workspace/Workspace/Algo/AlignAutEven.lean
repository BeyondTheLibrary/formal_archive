/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

The algorithmic layer: Procedure Align (§14.1), line 2 (iv) — the even part of a group given
by generators, on the unit-cost RAM.
-/
import Workspace.Algo.AlignParity

/-!
# §14.1, Procedure Align, line 2 (iv): the even part of a group given by generators

Line 2 (iv) builds `G₁ = ϕ⁻¹(Aut(X(x)))`, and the image of `G₁` is `Aut(X(x)) ∩ G^ϕ`
(`Babai.Align_G1_image`).  The giant `G^ϕ` is `S(Γ)` or `A(Γ)`, so in the second case the
generators of `Aut(X(x))` have to be turned into generators of its **even part**.

## The generators of an index-two subgroup

Given `W = ⟨S⟩` and a homomorphism `χ : G → ℤˣ`, the naive guess "the even members of `S`
together with the products of two odd members" does **not** generate `W ∩ ker χ` in general.
What does is the Schreier system for the transversal `{1, o}`, where `o ∈ S` is one fixed odd
generator: for a generator `s` and a transversal element `t`, the Schreier generator is
`t · s · (the representative of the coset of t·s)⁻¹`, which here is

* `s` for `t = 1` and `s` even,
* `s · o⁻¹` for `t = 1` and `s` odd,
* `o · s · o⁻¹` for `t = o` and `s` even,
* `o · s` for `t = o` and `s` odd.

`Algo.signKerGens` is that list and `Algo.closure_signKerGens` proves that it generates
`⟨S⟩ ∩ ker χ`.  The proof does not quote Schreier's lemma: the subgroup `K` generated by the
four families is normalized by `o` (each of the four families is carried into `K` by
conjugation with `o`), so every word in `S` lies in `K` or in `K·o`, and the words of `K·o`
are odd.

## Main definitions

* `Algo.signKerGens` — the four Schreier families;
* `Algo.rawEvenGens` — the same on raw generators, with `Algo.topEven` as the parity test.

## Main results

* `Algo.closure_signKerGens` — **`⟨S⟩ ∩ ker χ` is generated by the four families**;
* `Algo.decGroup_rawEvenGens` — **the raw routine computes the even part**:
  `decGroup m (rawEvenGens gs) = decGroup m gs ⊓ alternatingGroup (Fin m)`;
* `Algo.rawEvenGens_wf`, `Algo.length_rawEvenGens_le` — well formed, at most `4·|gs|`
  generators;
* `Algo.polyFun_rawEvenGens` — **the running time**.

No axiom, no `sorry`.
-/

namespace Algo

open RAM RAM.Targets
open Equiv (Perm)

/-! ## The Schreier generators of an index-two subgroup -/

section IndexTwo

variable {G : Type*} [Group G]

/-- §14.1, line 2 (iv).  **The Schreier generators of `⟨S⟩ ∩ ker χ`** for the transversal
`{1, o}`, with `o` one fixed generator outside the kernel. -/
def signKerGens (χ : G →* ℤˣ) (S : Set G) (o : G) : Set G :=
  {g | (∃ s ∈ S, χ s = 1 ∧ g = s) ∨ (∃ s ∈ S, χ s ≠ 1 ∧ g = s * o⁻¹) ∨
    (∃ s ∈ S, χ s = 1 ∧ g = o * s * o⁻¹) ∨ (∃ s ∈ S, χ s ≠ 1 ∧ g = o * s)}

theorem unit_eq_of_ne_one {z : ℤˣ} (h : z ≠ 1) : z = -1 :=
  (Int.units_eq_one_or z).resolve_left h

/-- §14.1, line 2 (iv).  **The four Schreier families generate `⟨S⟩ ∩ ker χ`.** -/
theorem closure_signKerGens (χ : G →* ℤˣ) (S : Set G) {o : G} (ho : o ∈ S)
    (hoχ : χ o ≠ 1) :
    Subgroup.closure (signKerGens χ S o) = Subgroup.closure S ⊓ χ.ker := by
  obtain ⟨K, hK⟩ : ∃ K : Subgroup G, K = Subgroup.closure (signKerGens χ S o) := ⟨_, rfl⟩
  have hoval : χ o = -1 := unit_eq_of_ne_one hoχ
  have hg1 : ∀ s ∈ S, χ s = 1 → s ∈ K := by
    intro s hs h; rw [hK]; exact Subgroup.subset_closure (Or.inl ⟨s, hs, h, rfl⟩)
  have hg2 : ∀ s ∈ S, χ s ≠ 1 → s * o⁻¹ ∈ K := by
    intro s hs h; rw [hK]; exact Subgroup.subset_closure (Or.inr (Or.inl ⟨s, hs, h, rfl⟩))
  have hg3 : ∀ s ∈ S, χ s = 1 → o * s * o⁻¹ ∈ K := by
    intro s hs h; rw [hK]
    exact Subgroup.subset_closure (Or.inr (Or.inr (Or.inl ⟨s, hs, h, rfl⟩)))
  have hg4 : ∀ s ∈ S, χ s ≠ 1 → o * s ∈ K := by
    intro s hs h; rw [hK]
    exact Subgroup.subset_closure (Or.inr (Or.inr (Or.inr ⟨s, hs, h, rfl⟩)))
  have hoo : o * o ∈ K := hg4 o ho hoχ
  -- `K` is normalized by `o`
  have hconj : ∀ g ∈ K, o * g * o⁻¹ ∈ K := by
    intro g hg
    rw [hK] at hg
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with ⟨s, hs, hχ, heq⟩ | ⟨s, hs, hχ, heq⟩ | ⟨s, hs, hχ, heq⟩ | ⟨s, hs, hχ, heq⟩
      · rw [heq]; exact hg3 s hs hχ
      · rw [heq, show o * (s * o⁻¹) * o⁻¹ = (o * s) * (o * o)⁻¹ from by group]
        exact K.mul_mem (hg4 s hs hχ) (K.inv_mem hoo)
      · rw [heq, show o * (o * s * o⁻¹) * o⁻¹ = (o * o) * s * (o * o)⁻¹ from by group]
        exact K.mul_mem (K.mul_mem hoo (hg1 s hs hχ)) (K.inv_mem hoo)
      · rw [heq, show o * (o * s) * o⁻¹ = (o * o) * (s * o⁻¹) from by group]
        exact K.mul_mem hoo (hg2 s hs hχ)
    | one => simp
    | mul a b _ _ iha ihb =>
      rw [show o * (a * b) * o⁻¹ = (o * a * o⁻¹) * (o * b * o⁻¹) from by group]
      exact K.mul_mem iha ihb
    | inv a _ iha =>
      rw [show o * a⁻¹ * o⁻¹ = (o * a * o⁻¹)⁻¹ from by group]
      exact K.inv_mem iha
  have hconj' : ∀ g ∈ K, o⁻¹ * g * o ∈ K := by
    intro g hg
    rw [show o⁻¹ * g * o = (o * o)⁻¹ * (o * g * o⁻¹) * (o * o) from by group]
    exact K.mul_mem (K.mul_mem (K.inv_mem hoo) (hconj g hg)) hoo
  -- `K` sits inside the answer
  have hKle : K ≤ Subgroup.closure S ⊓ χ.ker := by
    rw [hK]
    refine (Subgroup.closure_le _).2 ?_
    have hS : ∀ s ∈ S, s ∈ Subgroup.closure S := fun s hs => Subgroup.subset_closure hs
    rintro g hg
    rcases hg with ⟨s, hs, hχ, heq⟩ | ⟨s, hs, hχ, heq⟩ | ⟨s, hs, hχ, heq⟩ | ⟨s, hs, hχ, heq⟩
    · rw [heq]; exact ⟨hS s hs, hχ⟩
    · rw [heq]
      refine ⟨(Subgroup.closure S).mul_mem (hS s hs)
        ((Subgroup.closure S).inv_mem (hS o ho)), ?_⟩
      show χ (s * o⁻¹) = 1
      rw [map_mul, map_inv, unit_eq_of_ne_one hχ, hoval, mul_inv_cancel]
    · rw [heq]
      refine ⟨(Subgroup.closure S).mul_mem
        ((Subgroup.closure S).mul_mem (hS o ho) (hS s hs))
        ((Subgroup.closure S).inv_mem (hS o ho)), ?_⟩
      show χ (o * s * o⁻¹) = 1
      rw [map_mul, map_mul, map_inv, hχ, mul_one, mul_inv_cancel]
    · rw [heq]
      refine ⟨(Subgroup.closure S).mul_mem (hS o ho) (hS s hs), ?_⟩
      show χ (o * s) = 1
      rw [map_mul, unit_eq_of_ne_one hχ, hoval]
      decide
  -- every word in `S` lies in `K` or in `K·o`
  have hmain : ∀ g ∈ Subgroup.closure S,
      (χ g = 1 → g ∈ K) ∧ (χ g ≠ 1 → g * o⁻¹ ∈ K) := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem s hs => exact ⟨fun h => hg1 s hs h, fun h => hg2 s hs h⟩
    | one => exact ⟨fun _ => K.one_mem, fun h => absurd (map_one χ) h⟩
    | mul a b _ _ iha ihb =>
      refine ⟨fun h => ?_, fun h => ?_⟩
      · rcases Int.units_eq_one_or (χ a) with hA | hA
        · have hB : χ b = 1 := by
            have hab := map_mul χ a b
            rw [h, hA, one_mul] at hab
            exact hab.symm
          exact K.mul_mem (iha.1 hA) (ihb.1 hB)
        · have hB : χ b = -1 := by
            have hab := map_mul χ a b
            rw [h, hA] at hab
            rcases Int.units_eq_one_or (χ b) with hB | hB
            · rw [hB] at hab; exact absurd hab (by decide)
            · exact hB
          have ha' : a * o⁻¹ ∈ K := iha.2 (by rw [hA]; decide)
          have hb' : b * o⁻¹ ∈ K := ihb.2 (by rw [hB]; decide)
          have hob : o * b ∈ K := by
            rw [show o * b = (o * (b * o⁻¹) * o⁻¹) * (o * o) from by group]
            exact K.mul_mem (hconj _ hb') hoo
          rw [show a * b = (a * o⁻¹) * (o * b) from by group]
          exact K.mul_mem ha' hob
      · rcases Int.units_eq_one_or (χ a) with hA | hA
        · have hB : χ b ≠ 1 := fun hB => h (by rw [map_mul, hA, hB, one_mul])
          rw [show a * b * o⁻¹ = a * (b * o⁻¹) from by group]
          exact K.mul_mem (iha.1 hA) (ihb.2 hB)
        · have hA' : χ a ≠ 1 := by rw [hA]; decide
          have hB : χ b = 1 := by
            rcases Int.units_eq_one_or (χ b) with hB | hB
            · exact hB
            · exact absurd (show χ (a * b) = 1 by rw [map_mul, hA, hB]; decide) h
          rw [show a * b * o⁻¹ = (a * o⁻¹) * (o * b * o⁻¹) from by group]
          exact K.mul_mem (iha.2 hA') (hconj _ (ihb.1 hB))
    | inv a _ iha =>
      refine ⟨fun h => ?_, fun h => ?_⟩
      · have hA : χ a = 1 := by
          rw [map_inv] at h
          exact inv_eq_one.1 h
        exact K.inv_mem (iha.1 hA)
      · have hA : χ a ≠ 1 := fun hh => h (by rw [map_inv, hh, inv_one])
        have h1 : o * a⁻¹ ∈ K := by
          have hinv := K.inv_mem (iha.2 hA)
          rwa [mul_inv_rev, inv_inv] at hinv
        have h2 : a⁻¹ * o ∈ K := by
          have hc := hconj' _ h1
          rwa [show o⁻¹ * (o * a⁻¹) * o = a⁻¹ * o from by group] at hc
        rw [show a⁻¹ * o⁻¹ = (a⁻¹ * o) * (o * o)⁻¹ from by group]
        exact K.mul_mem h2 (K.inv_mem hoo)
  rw [← hK]
  refine le_antisymm hKle ?_
  rintro g ⟨hg, hker⟩
  exact (hmain g hg).1 (MonoidHom.mem_ker.1 hker)

/-- When every generator lies in the kernel, the kernel adds nothing. -/
theorem closure_inf_ker_of_all_mem (χ : G →* ℤˣ) (S : Set G) (h : ∀ s ∈ S, χ s = 1) :
    Subgroup.closure S ⊓ χ.ker = Subgroup.closure S := by
  refine inf_eq_left.2 ((Subgroup.closure_le _).2 (fun s hs => ?_))
  exact MonoidHom.mem_ker.2 (h s hs)

end IndexTwo

/-! ## The even part on raw generators -/

/-- The generators that fail the parity test. -/
def rawOddPart (gs : RawGens) : RawGens := gs.filter (fun r => !topEven r)

/-- The generators that pass the parity test. -/
def rawEvenPart (gs : RawGens) : RawGens := gs.filter topEven

/-- §14.1, line 2 (iv).  **The even part of a group given by raw generators**: the Schreier
system of `Algo.signKerGens` for the first odd generator, and the input itself when every
generator is even. -/
def rawEvenGens (gs : RawGens) : RawGens :=
  if (rawOddPart gs).isEmpty then gs
  else
    ((rawEvenPart gs ++
        (rawOddPart gs).map (fun s => rawMul (s, rawInv ((rawOddPart gs).getD 0 []))))
      ++ (rawEvenPart gs).map (fun s =>
        rawMul (rawMul ((rawOddPart gs).getD 0 [], s), rawInv ((rawOddPart gs).getD 0 []))))
      ++ (rawOddPart gs).map (fun s => rawMul ((rawOddPart gs).getD 0 [], s))

section Spec

variable {m : ℕ} {gs : RawGens}

theorem mem_rawOddPart {r : RawPerm} : r ∈ rawOddPart gs ↔ r ∈ gs ∧ topEven r = false := by
  rw [rawOddPart, List.mem_filter]
  constructor
  · rintro ⟨h1, h2⟩; exact ⟨h1, by simpa using h2⟩
  · rintro ⟨h1, h2⟩; exact ⟨h1, by simp [h2]⟩

theorem mem_rawEvenPart {r : RawPerm} : r ∈ rawEvenPart gs ↔ r ∈ gs ∧ topEven r = true := by
  rw [rawEvenPart, List.mem_filter]

/-- The parity test on a well-formed raw permutation is the sign. -/
theorem sign_decPerm_eq_one_iff {r : RawPerm} (h : RawPerm.WF m r) :
    Equiv.Perm.sign (decPerm m r) = 1 ↔ topEven r = true := by
  rw [topEven_of_wf h, Equiv.Perm.mem_alternatingGroup]

theorem sign_decPerm_ne_one {r : RawPerm} (h : RawPerm.WF m r) (hr : topEven r = false) :
    Equiv.Perm.sign (decPerm m r) ≠ 1 := by
  intro hh
  have h2 := (sign_decPerm_eq_one_iff h).1 hh
  rw [hr] at h2
  exact Bool.noConfusion h2

theorem topEven_eq_false_of_sign_ne_one {r : RawPerm} (h : RawPerm.WF m r)
    (hr : Equiv.Perm.sign (decPerm m r) ≠ 1) : topEven r = false := by
  cases hh : topEven r
  · rfl
  · exact absurd ((sign_decPerm_eq_one_iff h).2 hh) hr

theorem rawEvenGens_wf (hgs : RawGens.WF m gs) : RawGens.WF m (rawEvenGens gs) := by
  have hodd : ∀ r ∈ rawOddPart gs, RawPerm.WF m r :=
    fun r hr => hgs r (mem_rawOddPart.1 hr).1
  have heven : ∀ r ∈ rawEvenPart gs, RawPerm.WF m r :=
    fun r hr => hgs r (mem_rawEvenPart.1 hr).1
  rw [rawEvenGens]
  split
  · exact hgs
  · rename_i hne
    have ho : RawPerm.WF m ((rawOddPart gs).getD 0 []) := by
      refine hodd _ (getD_zero_mem ?_ _)
      intro hh
      rw [hh] at hne
      exact hne (by simp)
    intro r hr
    simp only [List.mem_append, List.mem_map] at hr
    rcases hr with ((hr | ⟨s, hs, rfl⟩) | ⟨s, hs, rfl⟩) | ⟨s, hs, rfl⟩
    · exact heven _ hr
    · exact wf_rawMul (hodd _ hs) (wf_rawInv ho)
    · exact wf_rawMul (wf_rawMul ho (heven _ hs)) (wf_rawInv ho)
    · exact wf_rawMul ho (hodd _ hs)

theorem length_rawEvenGens_le : (rawEvenGens gs).length ≤ 4 * gs.length := by
  have h1 : (rawOddPart gs).length ≤ gs.length := List.length_filter_le _ _
  have h2 : (rawEvenPart gs).length ≤ gs.length := List.length_filter_le _ _
  rw [rawEvenGens]
  split
  · omega
  · simp only [List.length_append, List.length_map]
    omega

/-- §14.1, line 2 (iv).  **The raw routine computes the even part of the group.** -/
theorem decGroup_rawEvenGens (hgs : RawGens.WF m gs) :
    decGroup m (rawEvenGens gs) = decGroup m gs ⊓ alternatingGroup (Fin m) := by
  classical
  obtain ⟨S, hS⟩ : ∃ S : Set (Perm (Fin m)), S = {g | g ∈ gs.map (decPerm m)} := ⟨_, rfl⟩
  have hker : (Equiv.Perm.sign (α := Fin m)).ker = alternatingGroup (Fin m) := rfl
  have hSgroup : Subgroup.closure S = decGroup m gs := by rw [hS, decGroup, genGroup]
  have hmemS : ∀ g : Perm (Fin m), g ∈ S ↔ ∃ r ∈ gs, decPerm m r = g := by
    intro g; rw [hS]; exact List.mem_map
  by_cases hempty : (rawOddPart gs).isEmpty = true
  · have h1 : rawEvenGens gs = gs := by rw [rawEvenGens, if_pos hempty]
    have hall : ∀ g ∈ S, Equiv.Perm.sign g = 1 := by
      intro g hg
      obtain ⟨r, hr, rfl⟩ := (hmemS g).1 hg
      refine (sign_decPerm_eq_one_iff (hgs r hr)).2 ?_
      by_contra hh
      have hmem : r ∈ rawOddPart gs := mem_rawOddPart.2 ⟨hr, by simpa using hh⟩
      rw [List.isEmpty_iff] at hempty
      rw [hempty] at hmem
      exact absurd hmem (by simp)
    rw [h1, ← hSgroup, ← hker]
    exact (closure_inf_ker_of_all_mem _ S hall).symm
  · have hne : rawOddPart gs ≠ [] := by
      intro hh
      rw [hh] at hempty
      exact hempty (by simp)
    obtain ⟨o, ho⟩ : ∃ o : RawPerm, o = (rawOddPart gs).getD 0 [] := ⟨_, rfl⟩
    have homem : o ∈ rawOddPart gs := by rw [ho]; exact getD_zero_mem hne _
    obtain ⟨hogs, hoodd⟩ := mem_rawOddPart.1 homem
    have howf : RawPerm.WF m o := hgs o hogs
    have hoS : decPerm m o ∈ S := (hmemS _).2 ⟨o, hogs, rfl⟩
    have hoχ : Equiv.Perm.sign (decPerm m o) ≠ 1 := sign_decPerm_ne_one howf hoodd
    have hoi : decPerm m (rawInv o) = (decPerm m o)⁻¹ := by
      rw [rawInv_of_wf howf, decPerm_encPerm]
    have hEG : rawEvenGens gs =
        ((rawEvenPart gs ++ (rawOddPart gs).map (fun s => rawMul (s, rawInv o)))
          ++ (rawEvenPart gs).map (fun s => rawMul (rawMul (o, s), rawInv o)))
          ++ (rawOddPart gs).map (fun s => rawMul (o, s)) := by
      rw [rawEvenGens, if_neg hempty, ho]
    -- the two directions of "even raw generator = even member of `S`"
    have hEven : ∀ t : Perm (Fin m), t ∈ S → Equiv.Perm.sign t = 1 →
        ∃ r ∈ rawEvenPart gs, decPerm m r = t := by
      intro t htS hsign
      obtain ⟨r, hr, rfl⟩ := (hmemS t).1 htS
      exact ⟨r, mem_rawEvenPart.2 ⟨hr, (sign_decPerm_eq_one_iff (hgs r hr)).1 hsign⟩, rfl⟩
    have hOdd : ∀ t : Perm (Fin m), t ∈ S → Equiv.Perm.sign t ≠ 1 →
        ∃ r ∈ rawOddPart gs, decPerm m r = t := by
      intro t htS hsign
      obtain ⟨r, hr, rfl⟩ := (hmemS t).1 htS
      exact ⟨r, mem_rawOddPart.2 ⟨hr,
        topEven_eq_false_of_sign_ne_one (hgs r hr) hsign⟩, rfl⟩
    have hgens : {g : Perm (Fin m) | g ∈ (rawEvenGens gs).map (decPerm m)} =
        signKerGens (Equiv.Perm.sign (α := Fin m)) S (decPerm m o) := by
      ext g
      constructor
      · intro hg
        obtain ⟨r, hr, rfl⟩ := List.mem_map.1 hg
        rw [hEG] at hr
        rcases List.mem_append.1 hr with hr | hr
        · rcases List.mem_append.1 hr with hr | hr
          · rcases List.mem_append.1 hr with hr | hr
            · obtain ⟨hrg, hre⟩ := mem_rawEvenPart.1 hr
              exact Or.inl ⟨decPerm m r, (hmemS _).2 ⟨r, hrg, rfl⟩,
                (sign_decPerm_eq_one_iff (hgs r hrg)).2 hre, rfl⟩
            · obtain ⟨s, hs, rfl⟩ := List.mem_map.1 hr
              obtain ⟨hsg, hso⟩ := mem_rawOddPart.1 hs
              refine Or.inr (Or.inl ⟨decPerm m s, (hmemS _).2 ⟨s, hsg, rfl⟩,
                sign_decPerm_ne_one (hgs s hsg) hso, ?_⟩)
              rw [rawMul_of_wf (hgs s hsg) (wf_rawInv howf), decPerm_encPerm, hoi]
          · obtain ⟨s, hs, rfl⟩ := List.mem_map.1 hr
            obtain ⟨hsg, hse⟩ := mem_rawEvenPart.1 hs
            refine Or.inr (Or.inr (Or.inl ⟨decPerm m s, (hmemS _).2 ⟨s, hsg, rfl⟩,
              (sign_decPerm_eq_one_iff (hgs s hsg)).2 hse, ?_⟩))
            rw [rawMul_of_wf (wf_rawMul howf (hgs s hsg)) (wf_rawInv howf), decPerm_encPerm,
              rawMul_of_wf howf (hgs s hsg), decPerm_encPerm, hoi]
        · obtain ⟨s, hs, rfl⟩ := List.mem_map.1 hr
          obtain ⟨hsg, hso⟩ := mem_rawOddPart.1 hs
          refine Or.inr (Or.inr (Or.inr ⟨decPerm m s, (hmemS _).2 ⟨s, hsg, rfl⟩,
            sign_decPerm_ne_one (hgs s hsg) hso, ?_⟩))
          rw [rawMul_of_wf howf (hgs s hsg), decPerm_encPerm]
      · intro hg
        show g ∈ (rawEvenGens gs).map (decPerm m)
        rw [hEG]
        rcases hg with ⟨t, htS, hsign, heq⟩ | ⟨t, htS, hsign, heq⟩ | ⟨t, htS, hsign, heq⟩ |
          ⟨t, htS, hsign, heq⟩
        · obtain ⟨r, hr, hrt⟩ := hEven t htS hsign
          refine List.mem_map.2 ⟨r, ?_, by rw [hrt, heq]⟩
          exact List.mem_append_left _ (List.mem_append_left _ (List.mem_append_left _ hr))
        · obtain ⟨r, hr, hrt⟩ := hOdd t htS hsign
          refine List.mem_map.2 ⟨rawMul (r, rawInv o), ?_, ?_⟩
          · exact List.mem_append_left _ (List.mem_append_left _
              (List.mem_append_right _ (List.mem_map.2 ⟨r, hr, rfl⟩)))
          · rw [rawMul_of_wf (hgs r (mem_rawOddPart.1 hr).1) (wf_rawInv howf),
              decPerm_encPerm, hoi, hrt, heq]
        · obtain ⟨r, hr, hrt⟩ := hEven t htS hsign
          have hwr : RawPerm.WF m r := hgs r (mem_rawEvenPart.1 hr).1
          refine List.mem_map.2 ⟨rawMul (rawMul (o, r), rawInv o), ?_, ?_⟩
          · exact List.mem_append_left _
              (List.mem_append_right _ (List.mem_map.2 ⟨r, hr, rfl⟩))
          · rw [rawMul_of_wf (wf_rawMul howf hwr) (wf_rawInv howf), decPerm_encPerm,
              rawMul_of_wf howf hwr, decPerm_encPerm, hoi, hrt, heq]
        · obtain ⟨r, hr, hrt⟩ := hOdd t htS hsign
          refine List.mem_map.2 ⟨rawMul (o, r), ?_, ?_⟩
          · exact List.mem_append_right _ (List.mem_map.2 ⟨r, hr, rfl⟩)
          · rw [rawMul_of_wf howf (hgs r (mem_rawOddPart.1 hr).1), decPerm_encPerm, hrt, heq]
    rw [decGroup, genGroup, hgens, closure_signKerGens _ S hoS hoχ, hker, hSgroup]

end Spec

/-! ## The running time -/

theorem polyFun_rawOddPart : PolyFun rawOddPart := by
  have hnot : PolyFun (fun r : RawPerm => !topEven r) :=
    (PolyFun.ite polyFun_topEven (polyFun_const false) (polyFun_const true)).of_eq
      (fun r => by cases topEven r <;> rfl)
  exact PolyFun.filter hnot

theorem polyFun_rawEvenPart : PolyFun rawEvenPart := PolyFun.filter polyFun_topEven

/-- §14.1, line 2 (iv): the even part **is computed in polynomial time**. -/
theorem polyFun_rawEvenGens : PolyFun rawEvenGens := by
  have ho : PolyFun (fun gs : RawGens => (rawOddPart gs).getD 0 []) :=
    ((polyFun_rawOddPart.pair (polyFun_const 0)).pair (polyFun_const [])).comp polyFun_getD
  have hoi : PolyFun (fun gs : RawGens => rawInv ((rawOddPart gs).getD 0 [])) :=
    ho.comp polyFun_rawInv
  have h2 : PolyFun (fun gs : RawGens =>
      (rawOddPart gs).map (fun s => rawMul (s, rawInv ((rawOddPart gs).getD 0 [])))) := by
    have hstep : PolyFun (fun z : RawPerm × RawPerm => rawMul (z.2, z.1)) :=
      polyFun_swap.comp polyFun_rawMul
    exact (hoi.pair polyFun_rawOddPart).comp (PolyFun.mapParam hstep)
  have h3 : PolyFun (fun gs : RawGens => (rawEvenPart gs).map (fun s =>
      rawMul (rawMul ((rawOddPart gs).getD 0 [], s), rawInv ((rawOddPart gs).getD 0 [])))) := by
    have hstep : PolyFun (fun z : (RawPerm × RawPerm) × RawPerm =>
        rawMul (rawMul (z.1.1, z.2), z.1.2)) :=
      ((((polyFun_fst.comp polyFun_fst).pair polyFun_snd).comp polyFun_rawMul).pair
        (polyFun_fst.comp polyFun_snd)).comp polyFun_rawMul
    exact ((ho.pair hoi).pair polyFun_rawEvenPart).comp (PolyFun.mapParam hstep)
  have h4 : PolyFun (fun gs : RawGens =>
      (rawOddPart gs).map (fun s => rawMul ((rawOddPart gs).getD 0 [], s))) :=
    (ho.pair polyFun_rawOddPart).comp (PolyFun.mapParam polyFun_rawMul)
  have hcat : PolyFun (fun gs : RawGens =>
      ((rawEvenPart gs ++ (rawOddPart gs).map
          (fun s => rawMul (s, rawInv ((rawOddPart gs).getD 0 []))))
        ++ (rawEvenPart gs).map (fun s =>
          rawMul (rawMul ((rawOddPart gs).getD 0 [], s), rawInv ((rawOddPart gs).getD 0 []))))
        ++ (rawOddPart gs).map (fun s => rawMul ((rawOddPart gs).getD 0 [], s))) :=
    (((((polyFun_rawEvenPart.pair h2).comp polyFun_append).pair h3).comp
      polyFun_append).pair h4).comp polyFun_append
  exact (PolyFun.ite (polyFun_rawOddPart.comp polyFun_isEmpty) polyFun_id hcat).of_eq
    (fun gs => by rw [rawEvenGens]; by_cases hh : (rawOddPart gs).isEmpty = true <;> simp [hh])

end Algo
