  set hdr := aggnL57Hdr c b t d dc dp (C, s₀) with hhdr_def
  have hhdr : ∀ s, AggnL57Post c dc dp C ϕ s → aggnL57Hdr c b t d dc dp (C, s) = hdr := by
    intro s hs
