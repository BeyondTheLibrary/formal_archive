    {s₀ : AggnAggregateState} (hs₀ : AggnL57Post c dc dp C ϕ s₀)
    (hsame : ∀ s, AggnL57Post c dc dp C ϕ s →
      aggnContinuation c b t d (C, s) = aggnContinuation c b t d (C, s₀))
    (htag : (aggnContinuation c b t d (C, s₀)).1 = 0 ∨ (aggnContinuation c b t d (C, s₀)).1 = 5 ∨
      (aggnContinuation c b t d (C, s₀)).1 = 6) :
    L57TreeOK c b t d dc dp u v e f n m C
