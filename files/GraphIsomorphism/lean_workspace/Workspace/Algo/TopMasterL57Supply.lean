/-- **Layer A** (§15, lines 5–7): on a context `C` of the round of lines 5–7 that satisfies
`Algo.L57Setting`, the round walks a tree with the condition `Algo.L57CM` at every step, whose
calls are coset instances in `G` with the letters of the two strings, and which returns
`Iso_G(x, y)`. -/
theorem exists_l57Tree (hS : L57Setting c b t d dc dp u v e f n m C ϕ) :
    ∃ T₀, L57TreeOK c b t d dc dp u v e f n m C T₀ := by
  haveI : Nonempty (Fin n) := hS.set.transitive.nonempty
  by_cases hex : ∃ s, AggnL57Post c dc dp C ϕ s
  swap
  · exact ⟨_, l57Tree_noPost hS fun s hs => hex ⟨s, hs⟩⟩
  obtain ⟨s₀, hs₀⟩ := hex
  have hsame : ∀ s, AggnL57Post c dc dp C ϕ s →
      aggnContinuation c b t d (C, s) = aggnContinuation c b t d (C, s₀) := fun s hs =>
    aggnContinuation_congr hS.ctx hs.2.2.1 hs₀.2.2.1 hs.2.2.2.2 hs₀.2.2.2.2 hS.set hS.large
      hS.tm b t d
  rcases aggnContinuation_tag_cases c b t d (C, s₀) with h | h | h | h | h | h | h
  · exact ⟨_, l57Tree_nil hS hs₀ hsame (Or.inl h)⟩
  · exact l57Tree_align hS hs₀ hsame (by rw [h]; decide)
  · exact l57Tree_giant hS hs₀ hsame h
  · exact l57Tree_align hS hs₀ hsame (by rw [h]; decide)
  · exact l57Tree_align hS hs₀ hsame (by rw [h]; decide)
  · exact ⟨_, l57Tree_nil hS hs₀ hsame (Or.inr (Or.inl h))⟩
  · exact ⟨_, l57Tree_nil hS hs₀ hsame (Or.inr (Or.inr h))⟩

end LayerA

/-! ## Layer B: the normalized context of a good node of route 5 -/

section LayerB

/-- A match with a condition on the steps gives a match with a weaker condition, when the
first gives the second at every step the round makes. -/
theorem LoopMatchS.mono_child {ι ω α Ω A : Type} [Fintype Ω] [DecidableEq Ω] {R : Round ι ω α}
    {C C' : ℕ → ω → ι → Prop} {decI : ι → SIInstance Ω A} {decA : α → Set (Perm Ω)} {I : ι}
    (hCC : ∀ j s J, R.child (I, j, s) = some J → C j s J → C' j s J) :
    ∀ {w j : ℕ} {s : ω} {T : SIReduction Ω A (Set (Perm Ω))},
      LoopMatchS R C decI decA I w j s T → LoopMatchS R C' decI decA I w j s T := by
  intro w j s T h
  induction h with
  | done w j s a hc ha => exact .done w j s a hc ha
  | call w j s J k hc hC _ ih => exact .call w j s J k hc (hCC j s J hc hC) ih

/-- **The normalized context** of the round of lines 5–7 on a window of `N` points: at most
`N²` generators, and every number the context stores (the two domains, the two strings, the
list fixing the test-set size) below `2N + 1`. This is what `Algo.masterL57Ctx_normal` gives
at a good node, and what the size bound of the round needs (`Algo.aggnCheckedWF_of_context`). -/
def AggnL57CtxNormal (N : ℕ) (C : AggnPhaseCtx) : Prop :=
  C.1.1.2.length ≤ N * N ∧
    ∀ xs ∈ [C.1.1.1, C.1.2.1, C.2.1, C.2.2.1, C.2.2.2], ∀ a ∈ xs, a < 2 * N + 1

theorem add_ten_le_two_pow {L : ℕ} (h : 4 ≤ L) : L + 10 ≤ 2 ^ L := by
  induction L, h using Nat.le_induction with
  | base => norm_num
  | succ k _ ih => rw [pow_succ]; omega

/-- For `N ≥ 64`, the test-set size `t = 10 + log N` is at most `N`. -/
theorem testSetSize_le_self {N : ℕ} (hN : 64 ≤ N) : testSetSize N ≤ N := by
  have hL := six_le_natLog hN
  have h1 := add_ten_le_two_pow (L := Nat.log 2 N) (by omega)
  have h2 := Nat.pow_log_le_self 2 (show N ≠ 0 by omega)
  unfold testSetSize
  omega

/-- For `N ≥ 64` and `c ≥ 2`, the test-set size meets the guard bound `(log N + 1)^c`. -/
theorem testSetSize_le_guardBound {c N : ℕ} (hc : 2 ≤ c) (hN : 64 ≤ N) :
    testSetSize N ≤ guardBound c N := by
  have hL := six_le_natLog hN
  unfold testSetSize guardBound
  calc 10 + Nat.log 2 N ≤ (Nat.log 2 N + 1) ^ 2 := by nlinarith
    _ ≤ (Nat.log 2 N + 1) ^ c := Nat.pow_le_pow_right (by omega) hc

