/-- The first string of the context of lines 5–7 has `|Δ|` letters below `2|Δ|`: they are
positions among the letters of the window, which are at most `2|Δ|`. -/
theorem masterL57Ctx_strWF_x (P : RawMasterSI) :
    RawStr.WF P.1.1.length (2 * P.1.1.length) (masterL57Ctx P).2.1 := by
  refine ⟨masterL57Ctx_length P, fun a ha => ?_⟩
  change a ∈ (masterL57XW P).map (fun b => masterL57Rank (masterL57Order P, b)) at ha
  obtain ⟨b, hb, rfl⟩ := List.mem_map.1 ha
  exact lt_of_lt_of_le (masterL57Rank_letter (masterL57XW_letters P b hb)).1
    (length_masterL57Letters_le P)

