        (.done ∅)) := by
  have h8 := hS.large.eight_lt
  have hcalls := l57_agg_calls hS (.done (∅ : Set (Perm (Fin n)))) (fun _ => False) (by simp)
  have hm := aggnL57G_nil_match (b := b) (t := t) (d := d) (u := u) (v := v) (e := e) (f := f)
    hS.ok hS.wf hS.ctx hS.set hS.large hS.tm hS.x hS.y
