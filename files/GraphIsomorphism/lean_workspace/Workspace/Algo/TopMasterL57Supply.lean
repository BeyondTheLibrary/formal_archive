  obtain ⟨hrun4, -, hsmall4⟩ := top4Aggregate_spec hS.ctx hs₀.2.2.1 hS.set hS.huge h2a
  have hlet4 := AllCalls.mem_calls (allCalls_top4AggregateTree hS.ctx hs₀.2.2.1 hS.set hS.huge h2a
