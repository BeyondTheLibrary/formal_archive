    fun j s J _ hV => l57CM_of_small hV.1.K_subset (three_mul_le_of_ts h8 hV.2)
  have hCM₃ : ∀ sR, AggnL57Post c dc dp C ϕ sR → ∀ j (s : AggnL57GState) J, s.1.1 = sR →
