/-- §15, lines 5–7, with the hinted call of line 11: **the supply of route 5 for the hint
routine `Algo.masterL57Hint`**. At a good node of route 5, the context of lines 5–7 is
normalized (`Algo.masterL57Ctx_normal`) and has the hint facts (`Algo.masterL57Ctx_hintFacts`),
so Layer A (`Algo.exists_l57Tree`) gives the tree; its condition at every step
(`Algo.L57CM`) gives the condition of the hint routine: without the test of the hinted call
the lifted call has at most `4/5` of the window's points, and with it the hint has its
meaning (`Algo.masterHintStepOK_masterL57Hint_alpha`). The tree makes at most as many calls
as the round's width, which the width bounds `Wc`, `Wp` of the two phases and the reserve
exponent `E` bound. -/
theorem masterL57SupplyH_masterL57Hint {E : ℕ} (hok : AggnPhasesOK c dc dp)
    (hcap : TopwpCap e f) (hsolver : AggnRestoredEntryGood c b t d)
    (hbip : BipInputRunCanonical b t d) (hc2 : 2 ≤ c) (hE : MasterL57EOK c b t d dc dp e f E)
    {Wc Wp : ℕ → ℕ}
    (hcw : ∀ (n : ℕ) (I : AggnPhaseNode), (aggnCheckedRound c n).WF I →
      (aggnCheckedRound c n).width I ≤ Wc ((aggnCheckedRound c n).ground I))
    (hpw : ∀ I, (aggnCompareCheckedRound c).WF I →
      (aggnCompareCheckedRound c).width I ≤ Wp ((aggnCompareCheckedRound c).ground I))
    (n : ℕ) :
    MasterL57SupplyH c b t d dc dp e f n (fun N => Wc N + Wp N + 2 ^ ((Nat.log 2 N + 2) ^ E))
      (masterL57Hint c b t d dc dp (l57UV e f).1 (l57UV e f).2 e f) := by
  intro W h hG hr
  obtain ⟨⟨-, hW, hinv⟩, hgoodAll⟩ := id hG
  have hgood : MasterHintGood (W, h) := hgoodAll h rfl
  have hx : W.2.2.2.1.length = n := hW.2.2.2.2.2.1.1
  have hgs := hW.2.2.1
  have hnd := hW.1
  have hlt := hW.2.1
  obtain ⟨m, ϕ, -, -, hA, hGt, hϕ, -, -, -, -, hmn, h64⟩ := masterL57Ctx_hintFacts hgood
  have hmh : h.1.1.length = m := by
    have e := hA.2.1
    change (List.range h.1.1.length).length = m at e
    rwa [List.length_range] at e
  have hell : ellOf W.1.length < m := by
    rw [← hmh]
    exact ((masterHintRoute_aggregate (W, h)).1 hr).1
  obtain ⟨inst, hcat⟩ := exists_isCatAction_splitOutcomes (Γ := Fin m)
  letI := inst
  have hts : (masterL57Ctx ((W, some h) : RawMasterSI)).2.2.2.length = testSetSize W.1.length := by
    change (List.range (min (10 + Nat.log 2 W.1.length) W.1.length)).length = _
    rw [List.length_range]
    exact min_eq_left (testSetSize_le_self h64)
  have hS := l57Setting_of_normal (b := b) (t := t) (d := d) (e := e) (f := f) hok hcap hsolver
    hbip hc2 (masterL57Ctx_normal hgood) hA (masterL57Ctx_strWF_x _) (masterL57Ctx_strWF_y _) hts
    hGt hϕ hmn h64 hell hcat
  obtain ⟨T₀, hm, hcos, hrun, hlet⟩ := exists_l57Tree hS
  have hguard := masterL57Guard_of_good hgood
  refine ⟨T₀, ?_, fun J hJ => (hcos J hJ).K_subset, hcos, hrun, hlet, ?_⟩
  · -- the condition of the hint routine at every step
    refine LoopMatchS.mono_child ?_ hm
    intro j s J hc hCM V hV
    obtain ⟨hrd, -⟩ := masterL57_child_decode (P := ((W, some h) : RawMasterSI)) hc
    have hgrp' : decGroup W.1.length (masterL57Ctx (W, some h)).1.1.2 =
        (winRestrictHom n W.1 hnd hlt (decGroup n W.2.1) hinv).range :=
      (masterL57Ctx_group' W h).trans (masterLine4b_group (p := (W, h)) hgs hnd hlt hinv)
    set Wc' := masterL57Read (W, some h) J
    have hKJ : (decWinSI W.1.length Wc').K ⊆
        ((winRestrictHom n W.1 hnd hlt (decGroup n W.2.1) hinv).range :
          Set (Perm (Fin W.1.length))) := by
      rw [hrd, siUnlabel_K, ← hgrp']
      exact hCM.1
    have hctx : masterWinCtx ((W, some h) : RawMasterSI) =
        ((W.2.2.2.1, (W.2.1.map (decPerm n)).map (encPerm n)), W.1, W.2.2.2.1) := by
      rw [masterWinCtx, map_encPerm_decPerm hgs]
    obtain ⟨Z, hZ, hdec⟩ := topwRawInstance_spec (dom := W.2.2.2.1) (x := W.2.2.2.1)
      (gens := W.2.1.map (decPerm n)) hx hx hnd hlt hinv Wc' hKJ
    have hV' := hV
    change topwRawInstance (masterWinCtx ((W, some h) : RawMasterSI), Wc') = some V at hV'
    rw [hctx, hZ] at hV'
    have hVZ : V = Z := (Option.some.inj hV').symm
    have hws : (decWinSI n V).windowSize = (aggnPhaseDecode W.1.length J).windowSize := by
      rw [hVZ, hdec, topwInstance_windowSize, hrd]
      rfl
    have hwin : (masterCheckedCall (W.2.2.2.1, V)).1.1.length =
        (aggnPhaseDecode W.1.length J).windowSize :=
      (masterCheckedCall_window hx V).trans hws
    have htest : masterL57HintTest c b t d dc dp (l57UV e f).1 (l57UV e f).2 e f
        ((((W, some h) : RawMasterSI), j, s), masterCheckedCall (W.2.2.2.1, V)) =
        l57TestA c b t d dc dp (l57UV e f).1 (l57UV e f).2 e f W.1.length
          (masterL57Ctx (W, some h)) j s (aggnPhaseDecode W.1.length J).windowSize := by
      unfold masterL57HintTest l57TestA
      rw [hwin]
      rfl
    cases hT : masterL57HintTest c b t d dc dp (l57UV e f).1 (l57UV e f).2 e f
        ((((W, some h) : RawMasterSI), j, s), masterCheckedCall (W.2.2.2.1, V))
    · -- no hint: the call has at most `4/5` of the window's points
      have h5 := hCM.2.1 (htest ▸ hT)
      show MasterHintStepOK n ((W, some h) : RawMasterSI) V
        (masterL57Hint c b t d dc dp (l57UV e f).1 (l57UV e f).2 e f
          ((((W, some h) : RawMasterSI), j, s), masterCheckedCall (W.2.2.2.1, V)))
      unfold masterL57Hint
      rw [if_neg (by rw [hT]; exact Bool.false_ne_true)]
      change 5 * (decWinSI n V).windowSize ≤ 4 * W.1.length
      rw [hws]
      exact h5
    · -- the hinted call of line 11
      obtain ⟨hLF, hfirst, X', α, hX, hα, -, hZs⟩ := hCM.2.2 (htest ▸ hT)
      have hvl := veryLargeK_of_hugeM hGt hS.huge
      exact masterHintStepOK_masterL57Hint_alpha hx hgs hnd hlt hinv hguard hc hV hT hLF.g1
        hLF.invD hLF.tail hfirst hA hGt hϕ hvl
        (fun u => tPoint_eq_of_transitive hGt hϕ hvl ⟨0, by omega⟩ u) hcat hX hα hZs hS.m217 hmn
        hLF.nt hLF.lp
  · -- the number of calls
    have hlen := LoopMatchS.calls_length_le hm (fun K hK => exists_rawCoset_answer (hcos K hK))
    have hw := masterL57Width_ge (P := ((W, some h) : RawMasterSI)) hE hguard
    have hI := masterL57Guard_wf hguard
    have h1 : aggnPhaseWidth c (masterL57Ctx ((W, some h) : RawMasterSI)) ≤
        Wc (masterL57Ctx ((W, some h) : RawMasterSI)).2.1.length :=
      hcw _ (masterL57Enter ((W, some h) : RawMasterSI)) hI
    have h2 : aggnCompareWidth c (masterL57Ctx ((W, some h) : RawMasterSI)) ≤
        Wp (masterL57Ctx ((W, some h) : RawMasterSI)).2.1.length :=
      hpw (masterL57Enter ((W, some h) : RawMasterSI)) hI
    rw [masterL57Ctx_length] at h1 h2
    have hwe : masterL57Width c E ((W, some h) : RawMasterSI) =
        aggnPhaseWidth c (masterL57Ctx ((W, some h) : RawMasterSI)) +
          aggnCompareWidth c (masterL57Ctx ((W, some h) : RawMasterSI)) +
          2 ^ ((Nat.log 2 W.1.length + 2) ^ E) := rfl
    have hle : T₀.calls.length ≤ masterL57Width c E ((W, some h) : RawMasterSI) :=
      le_trans hlen hw
    have h1' : aggnPhaseWidth c (masterL57Ctx ((W, some h) : RawMasterSI)) ≤ Wc W.1.length := h1
    have h2' : aggnCompareWidth c (masterL57Ctx ((W, some h) : RawMasterSI)) ≤ Wp W.1.length := h2
    rw [hwe] at hle
    show T₀.calls.length ≤ Wc W.1.length + Wp W.1.length + 2 ^ ((Nat.log 2 W.1.length + 2) ^ E)
    omega

