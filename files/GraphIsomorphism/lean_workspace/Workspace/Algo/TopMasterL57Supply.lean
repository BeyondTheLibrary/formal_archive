/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

The algorithmic layer: the supply of route 5 of the Master Algorithm (Sec. 15, lines 5–7),
with the hinted call of line 11 of Procedure Align.
-/
import Workspace.Algo.AlignL57Shape
import Workspace.Algo.AggNodeLine57MatchS
import Workspace.Algo.AggNodeContinuationUnique
import Workspace.Algo.AggNodeEntryCanonical
import Workspace.Algo.TopMasterHintedCallFacts
import Workspace.Algo.AggNodeLine57GiantCalls
import Workspace.Algo.TopFourAmbientEntry
import Workspace.Algo.TopMasterL57CtxGood
import Workspace.Master.SplitTransport
import Workspace.Master.Sec15

/-!
# The supply of route 5

`Algo.MasterL57SupplyH` asks, at every good node of route 5, for a window tree the round of
lines 5–7 walks with the condition of the hint routine at every step. This file proves it for
the hint routine `Algo.masterL57Hint`, in two layers.

**Layer A** (`Algo.exists_l57Tree`) works on any context `C` of the round of lines 5–7 that
satisfies the hypotheses of Theorem 13.2.1 and of the round's matches (`Algo.L57Setting`). The
round runs AggregateCertificates (stretch 1) and then one of the exits of lines 5–7:

* the reject exits (tags `0`, `5`, `6`), with answer `∅`;
* outcome (2a) (tag `2`), Cor. 12.0.10;
* Procedure Align (tags `1`, `3`, `4`), on the header of the continuation, which is the same
  at every state the phases may end in (`Algo.aggnContinuation_congr`), with the round of
  Align the header describes (`Algo.exists_alignL57Shape`).

The tree walked has coset calls in `G`, the letters of the two strings, and returns
`Iso_G(x, y)`; at every step the call is a subset of `G`, and either has at most `4n/5` points,
or passes the test of the hinted call and then the header has the facts the hint needs
(`Algo.L57CM`).

**Layer B** (`Algo.masterL57SupplyH_masterL57Hint`) puts Layer A on the normalized context
`Algo.masterL57Ctx` of a good node of route 5.
-/

set_option synthInstance.maxSize 2048
set_option maxHeartbeats 1000000

namespace Algo
open RAM RAM.Targets Babai Equiv
open scoped Pointwise

/-! ## Raw answers of coset calls -/

open scoped Classical in
/-- The answer of a coset instance has a raw form: it is `∅` or a coset `ρ M'` of a subgroup
(`Babai.wIso_smul_subgroup_of_invariant`), and a subgroup is generated by its elements. -/
theorem exists_rawCoset_answer {n : ℕ} {G : Subgroup (Perm (Fin n))} {K : SIInstance (Fin n) ℕ}
    (h : IsCosetInstance G K) : ∃ a : RawCoset, decCoset n a = K.answer := by
  obtain ⟨N, σ, hNG, hσ, hK, hinv⟩ := h
  have hans : K.answer = wIso K.Δ K.K K.x K.y := rfl
  rcases wIso_smul_subgroup_of_invariant (M := N) le_rfl hNG hinv K.x K.y hσ with
    he | ⟨M', ρ, -, -, he⟩
  · exact ⟨none, by rw [hans, hK, he]; rfl⟩
  · let gs : List (Perm (Fin n)) := (Finset.univ : Finset M').toList.map Subtype.val
    have hgs : genGroup gs = M' := by
      have he' : {g | g ∈ gs} = (M' : Set (Perm (Fin n))) := by
        ext g
        simp [gs]
      rw [genGroup, he', Subgroup.closure_eq]
    have hG : decGroup n (gs.map (encPerm n)) = M' := by
      rw [decGroup, List.map_map]
      simpa only [Function.comp_def, decPerm_encPerm, List.map_id_fun', id_eq] using hgs
    refine ⟨some (gs.map (encPerm n), encPerm n ρ), ?_⟩
    rw [decCoset_some, decPerm_encPerm, hG, hans, hK, he]

/-! ## The condition at a step -/

/-- The test of the hinted call (`Algo.masterL57HintTest`) on a context `C`: stretch 3 of the
round (not the giant branch, the phases done), the test of the repair of lines 7–11 on the
header, and a call of more than `2n/3` points. -/
def l57TestA (c b t d dc dp u v e f n : ℕ) (C : AggnPhaseCtx) (j : ℕ) (s : AggnL57GState)
    (ws : ℕ) : Bool :=
  !aggnL57GActive c b t d dc dp u v e f ((C, none), j, s) &&
    (aggnAggregateChild c ((C, none), j, s.1.1)).isNone &&
    alignRLarge ((aggnL57Hdr c b t d dc dp (C, s.1.1)).1,
      (aggnL57Hdr c b t d dc dp (C, s.1.1)).2.1) &&
    decide (2 * n < 3 * ws)

theorem l57TestA_true {c b t d dc dp u v e f n : ℕ} {C : AggnPhaseCtx} {j : ℕ}
    {s : AggnL57GState} {ws : ℕ} (h : l57TestA c b t d dc dp u v e f n C j s ws = true) :
    alignRLarge ((aggnL57Hdr c b t d dc dp (C, s.1.1)).1,
      (aggnL57Hdr c b t d dc dp (C, s.1.1)).2.1) = true ∧ 2 * n < 3 * ws := by
  simp only [l57TestA, Bool.and_eq_true, decide_eq_true_eq] at h
  exact ⟨h.1.2, h.2⟩

/-- What the hint of line 11 needs of the header of the fold state `s`: the facts of the
test of the repair (`Algo.L57LargeFacts`), the invariant of the loop of Eq. (71)
(`Algo.AVFirstOK`), and a fixed version that is a split outcome at a threshold
`1/2 < α ≤ 4/5`. -/
def L57HintFacts (n m : ℕ) (h : AVHdr) (st : AVState) : Prop :=
  L57LargeFacts n h ∧ AVFirstOK h st ∧
    ∃ (X' : Pt (SplitOutcomes (Fin m))) (α : ℝ), decAlignOutcome m h.2.1 = some X' ∧
      1 / 2 < α ∧ 5 * α ≤ 4 ∧ IsSplitOutcome α (Set.univ : Set (Fin m)) X'

/-- **The condition at a step of the round of lines 5–7** on a context `C`: the call is with
respect to a subset of `G`; without the test of the hinted call it has at most `4n/5` points,
and with it the header has the facts of `Algo.L57HintFacts`. -/
def L57CM (c b t d dc dp u v e f n m : ℕ) (C : AggnPhaseCtx) (j : ℕ) (s : AggnL57GState)
    (J : AggnPhaseNode) : Prop :=
  (aggnPhaseDecode n J).K ⊆ (decGroup n C.1.1.2 : Set (Perm (Fin n))) ∧
    (l57TestA c b t d dc dp u v e f n C j s (aggnPhaseDecode n J).windowSize = false →
      5 * (aggnPhaseDecode n J).windowSize ≤ 4 * n) ∧
    (l57TestA c b t d dc dp u v e f n C j s (aggnPhaseDecode n J).windowSize = true →
      L57HintFacts n m (aggnL57Hdr c b t d dc dp (C, s.1.1))
        (s.1.2.getD (l57Init (aggnL57Hdr c b t d dc dp (C, s.1.1)))).1)

/-- A call of at most `2n/3` points satisfies the condition at every step. -/
theorem l57CM_of_small {c b t d dc dp u v e f n m : ℕ} {C : AggnPhaseCtx} {j : ℕ}
    {s : AggnL57GState} {J : AggnPhaseNode}
    (hK : (aggnPhaseDecode n J).K ⊆ (decGroup n C.1.1.2 : Set (Perm (Fin n))))
    (h3 : 3 * (aggnPhaseDecode n J).windowSize ≤ 2 * n) :
    L57CM c b t d dc dp u v e f n m C j s J := by
  refine ⟨hK, fun _ => by omega, fun hT => ?_⟩
  have := (l57TestA_true hT).2
  omega

/-- The invariant of the loop of Eq. (71) at the states of stretch 3 (`Algo.L57Reach`), in
cases 2 and 3 of the repair. -/
theorem avFirstOK_of_l57Reach {c b t d dc dp : ℕ} {C : AggnPhaseCtx} {sR : AggnAggregateState}
    {o : Option ADState} (hr : L57Reach c b t d dc dp C sR o)
    (hs : l57Small (aggnL57Hdr c b t d dc dp (C, sR)) = false) :
    AVFirstOK (aggnL57Hdr c b t d dc dp (C, sR))
      (o.getD (l57Init (aggnL57Hdr c b t d dc dp (C, sR)))).1 := by
  rcases hr with rfl | ⟨st, a, rfl⟩
  · exact avFirstOK_l57Init hs
  · exact avFirstOK_l57Step hs st a

/-! ## The exits of the continuation -/

/-- The continuation takes one of its seven exits. -/
theorem aggnContinuation_tag_cases (c b t d : ℕ) (z : AggnPhaseCtx × AggnAggregateState) :
    (aggnContinuation c b t d z).1 = 0 ∨ (aggnContinuation c b t d z).1 = 1 ∨
      (aggnContinuation c b t d z).1 = 2 ∨ (aggnContinuation c b t d z).1 = 3 ∨
      (aggnContinuation c b t d z).1 = 4 ∨ (aggnContinuation c b t d z).1 = 5 ∨
      (aggnContinuation c b t d z).1 = 6 := by
  rcases aggnAggregateDispatch_cases z with h | h | h
  · rw [aggnContinuation_of_one h]; simp [aggnContCaseOne]
  · cases hg : aggnAggregateGiantBranch z
    · cases hr : aggnRejectCase z
      · rw [aggnContinuation_of_case2b h hg hr]; simp [aggnContCase2b]
      · rw [aggnContinuation_of_rejectCase h hg hr]; simp
    · rw [aggnContinuation_of_giant h hg]; simp
  · cases hr : aggnRejectDefect z
    · rw [aggnContinuation_of_case3 h hr]
      unfold aggnContCase3
      cases aggnGuideSplitFamilies c b t d z <;> simp
    · rw [aggnContinuation_of_rejectDefect h hr]; simp

theorem map_eq_filterMap_map_some {α β : Type*} {f : α → Option β} :
    ∀ {l : List α}, (∀ o ∈ l, ∃ Z, f o = some Z) → l.map f = (l.filterMap f).map some
  | [], _ => rfl
  | a :: l, h => by
    obtain ⟨Z, hZ⟩ := h a List.mem_cons_self
    rw [List.map_cons, List.filterMap_cons, hZ, List.map_cons,
      map_eq_filterMap_map_some (fun o ho => h o (List.mem_cons_of_mem _ ho))]

theorem mem_of_map_eq_map_some {α β : Type*} {f : α → Option β} {l : List α} {Ys : List β}
    (h : l.map f = Ys.map some) {o : α} (ho : o ∈ l) {Z : β} (hZ : f o = some Z) : Z ∈ Ys := by
  have hm := List.mem_map_of_mem (f := f) ho
  rw [h, hZ] at hm
  obtain ⟨Z', hZ', he⟩ := List.mem_map.1 hm
  rw [← Option.some.inj he]
  exact hZ'

section Hdr

variable {c b t d n m : ℕ} {C : AggnPhaseCtx} {s : AggnAggregateState}
  {ϕ : decGroup n C.1.1.2 →* Perm (Fin m)}
  [MulAction (Perm (Fin m)) (Pt (SplitOutcomes (Fin m)))]

/-- §13.2 with Theorem 9.2.3, at the Align exits (tags `1`, `3`, `4`): **the fixed version is a
split outcome at a threshold `1/2 < α ≤ 4/5`** (`4/5` at outcome (1), Line 7a of §15), every
listed version of `X(y)` decodes, and **every `σ ∈ Iso_G(x, y)` carries the fixed version to a
listed version of `X(y)`** (canonicity of Theorem 9.2.3,
`Algo.aggnContinuation_transport_of_bip`). -/
theorem l57_align_hdr_facts (hC : AggnPhaseCtxWF c n m C ϕ) (hs : AggnStoresComplete c ϕ s.1.2.1)
    (htbl : AggnCompareTableFor c ϕ (aggnCompareTable c (C, s.2.2.2.1)))
    (hset : LocalCertSetting (decGroup n C.1.1.2) ϕ)
    (ht : LargeK C.2.2.2.length (Nat.card (Fin n))) (htm : 10 * C.2.2.2.length ≤ m)
    [Nonempty (Fin n)] (hsolver : AggnRestoredEntryGood c b t d)
    (hbip : BipInputRunCanonical b t d) (hm : 217 ≤ m) (hK : IsCatAction (SplitOutcomes (Fin m)))
    (htag : (aggnContinuation c b t d (C, s)).1 ∈ ({1, 3, 4} : Finset ℕ)) :
    ∃ (X' : Pt (SplitOutcomes (Fin m))) (α : ℝ) (Ys : List (Pt (SplitOutcomes (Fin m)))),
      decAlignOutcome m (aggnL57Fixed (aggnContinuation c b t d (C, s))) = some X' ∧
      1 / 2 < α ∧ 5 * α ≤ 4 ∧ IsSplitOutcome α (Set.univ : Set (Fin m)) X' ∧
      (aggnContinuation c b t d (C, s)).2.2.map (decAlignOutcome m) = Ys.map some ∧
      ∀ σ : decGroup n C.1.1.2, strAct (decStrN n C.2.1) (σ : Perm (Fin n)) = decStrN n C.2.2.1 →
        ϕ σ • X' ∈ Ys := by
  set L := aggnContinuation c b t d (C, s) with hL
  -- the fixed version and the list of `X(y)`
  have key : ∃ (X' : Pt (SplitOutcomes (Fin m))) (α : ℝ) (Ys : List (Pt (SplitOutcomes (Fin m)))),
      aggnL57Fixed L ∈ L.2.1 ∧ decAlignOutcome m (aggnL57Fixed L) = some X' ∧
      1 / 2 < α ∧ 5 * α ≤ 4 ∧ IsSplitOutcome α (Set.univ : Set (Fin m)) X' ∧
      L.2.2.map (decAlignOutcome m) = Ys.map some := by
    simp only [Finset.mem_insert, Finset.mem_singleton] at htag
    rcases htag with h1 | h34
    · have hc1 := ((aggnContinuation_one_spec hC hs b t d).1).1 h1
      obtain ⟨hxl, hyl⟩ := (aggnContinuation_one_spec hC hs b t d).2 hc1
      rw [← hL] at hxl hyl
      obtain ⟨o, rest, hlo⟩ : ∃ o rest, L.2.1 = o :: rest := by
        cases hl : L.2.1 with
        | nil => rw [hl] at hxl; simp at hxl
        | cons o rest => exact ⟨o, rest, rfl⟩
      rw [hlo, List.map_cons, List.cons_eq_cons] at hxl
      have hfix : aggnL57Fixed L = o := by rw [aggnL57Fixed, hlo]; rfl
      refine ⟨_, 4 / 5, [orbitSplitOutcome (bigFGamma ϕ (decStrN n C.2.2.1) C.2.2.2.length)],
        by rw [hfix, hlo]; exact List.mem_cons_self, by rw [hfix]; exact hxl.1,
        by norm_num, by norm_num, isSplitOutcome_orbitSplitOutcome _ hc1, hyl.trans rfl⟩
    · have hgood : AggnSplitFamilyGood m L.2.1 ∧ AggnSplitFamilyGood m L.2.2 := by
        rcases h34 with h3 | h4
        · exact aggnContinuation_three_valid hC hsolver hm h3
        · obtain ⟨-, -, -, -, -, hx, hy⟩ :=
            aggnContinuation_four_spec hC hs hsolver htbl hset ht htm h4
          exact ⟨hx, hy⟩
      obtain ⟨⟨⟨o', ho'⟩, hallx⟩, -, hally⟩ := hgood
      obtain ⟨o, rest, hlo⟩ : ∃ o rest, L.2.1 = o :: rest := by
        cases hl : L.2.1 with
        | nil => rw [hl] at ho'; simp at ho'
        | cons o rest => exact ⟨o, rest, rfl⟩
      have hfix : aggnL57Fixed L = o := by rw [aggnL57Fixed, hlo]; rfl
      have hmem : aggnL57Fixed L ∈ L.2.1 := by rw [hfix, hlo]; exact List.mem_cons_self
      obtain ⟨β, Z, hZ, hβ, -, hβ5, hsplit⟩ := hallx _ hmem
      exact ⟨Z, β, _, hmem, hZ, hβ, hβ5, hsplit, map_eq_filterMap_map_some fun o ho => by
        obtain ⟨β', Z', hZ', -⟩ := hally o ho
        exact ⟨Z', hZ'⟩⟩
  obtain ⟨X', α, Ys, hmem, hX, hα, hα5, hsplit, hYs⟩ := key
  refine ⟨X', α, Ys, hX, hα, hα5, hsplit, hYs, fun σ hσ => ?_⟩
  obtain ⟨o', ho', Z, Z', hZ, hZ', hiso⟩ :=
    aggnContinuation_transport_of_bip hbip hC hs hm htbl hset ht htm htag σ hσ hmem
  rw [hX] at hZ
  obtain rfl := Option.some.inj hZ
  rw [← SplitOutcomeIso.eq_smul hK hiso]
  exact mem_of_map_eq_map_some hYs ho' hZ'

end Hdr

/-! ## Layer A: the tree on a context -/

section LayerA

variable {c b t d dc dp u v e f n m : ℕ} {C : AggnPhaseCtx}
  {ϕ : decGroup n C.1.1.2 →* Perm (Fin m)}
  [inst : MulAction (Perm (Fin m)) (Pt (SplitOutcomes (Fin m)))]

variable (c b t d dc dp u v e f n m C ϕ) in
/-- **The hypotheses of Layer A** on a context `C` of the round of lines 5–7: the constants
of the round meet their specifications (the phases of AggregateCertificates, the giant branch,
Theorem 9.2.3 valid and canonical), the node is well formed, `C` satisfies the hypotheses of
Theorem 13.2.1 (`G` transitive, `ϕ` a giant representation, `m ≥ 10 log n`, `t > 2 + log n`,
`m ≥ 10t`), `m ≥ max{16, 4 + 2 log n}` (Cor. 12.0.10) and `m ≥ 217`, the strings have letters
at most `2n`, and the category action of the outcomes of Theorem 9.2.3 is given. -/
structure L57Setting : Prop where
  ok : AggnPhasesOK c dc dp
  gwf : L57GWFOK u v e f
  cap : TopwpCap e f
  solver : AggnRestoredEntryGood c b t d
  bip : BipInputRunCanonical b t d
  wf : (aggnL57GRound c b t d dc dp u v e f).WF (C, none)
  ctx : AggnPhaseCtxWF c n m C ϕ
  set : LocalCertSetting (decGroup n C.1.1.2) ϕ
  large : LargeK C.2.2.2.length (Nat.card (Fin n))
  tm : 10 * C.2.2.2.length ≤ m
  x : RawStr.WF n (2 * n) C.2.1
  y : RawStr.WF n (2 * n) C.2.2.1
  huge : HugeM m (Nat.card (Fin n))
  m217 : 217 ≤ m
  cat : IsCatAction (SplitOutcomes (Fin m))

variable (c b t d dc dp u v e f n m C) in
/-- What Layer A supplies: a tree `T₀` the round walks from the node `(C, none)` with the
condition `Algo.L57CM` at every step, whose calls are coset instances in `G` with the letters
of the two strings, and which returns `Iso_G(x, y)`. -/
def L57TreeOK (T₀ : SIReduction (Fin n) ℕ (Set (Perm (Fin n)))) : Prop :=
  LoopMatchS (aggnL57GRound c b t d dc dp u v e f) (L57CM c b t d dc dp u v e f n m C)
      (aggnPhaseDecode n) (decCoset n) (C, none)
      ((aggnL57GRound c b t d dc dp u v e f).width (C, none)) 0
      ((aggnL57GRound c b t d dc dp u v e f).init (C, none)) T₀ ∧
    (∀ J ∈ T₀.calls, IsCosetInstance (decGroup n C.1.1.2) J) ∧
    T₀.run = strIso (decGroup n C.1.1.2 : Set (Perm (Fin n))) (decStrN n C.2.1)
      (decStrN n C.2.2.1) ∧
    (∀ J ∈ T₀.calls, MasterCallLetters (2 * n + 1) J)

/-- The enumeration of AggregateCertificates the round follows. -/
noncomputable abbrev l57Enum (c n m : ℕ) (C : AggnPhaseCtx)
    (ϕ : decGroup n C.1.1.2 →* Perm (Fin m)) : AggEnum (Fin n) (Fin m) :=
  aggnFullEnum ϕ (decStrN n C.2.1) (decStrN n C.2.2.1) ((aggnPhaseRows c C).map (winSet m))

/-- **The calls of AggregateCertificates** (§13.2): coset instances in `G` on at most `n/t`
points, with the letters of the two strings; the calls of the continuation `R` keep what
they have. -/
theorem l57_agg_calls (hS : L57Setting c b t d dc dp u v e f n m C ϕ)
    {α : Type} (R : SIReduction (Fin n) ℕ α) (P : SIInstance (Fin n) ℕ → Prop)
    (hR : ∀ K ∈ R.calls, IsCosetInstance (decGroup n C.1.1.2) K ∧
      MasterCallLetters (2 * n + 1) K ∧ P K) :
    ∀ K ∈ (aggregateRoundStrong ϕ (decStrN n C.2.1) (decStrN n C.2.2.1)
        (l57Enum c n m C ϕ) R).calls,
      IsCosetInstance (decGroup n C.1.1.2) K ∧ MasterCallLetters (2 * n + 1) K ∧
        (C.2.2.2.length * K.windowSize ≤ n ∨ P K) := by
  intro K hK
  have hE := aggnFullEnum_spec hS.ctx
  have h8 := hS.large.eight_lt
  refine ⟨isCosetInstance_calls_aggregateRoundStrong _ hE.toCover hE.toBound.invariant R
      (fun K hK => (hR K hK).1) hK,
    masterLetters_aggregateRoundStrong (fun u => by have := aggnDecodedStr_le hS.x u; omega)
      (fun u => by have := aggnDecodedStr_le hS.y u; omega) _ R (fun K hK => (hR K hK).2.1) K hK,
    ?_⟩
  rcases window_calls_aggregateRoundStrong _ hE.toBound (by omega) R hK with h | h
  · left
    simpa using h
  · exact Or.inr (hR K h).2.2

/-- A call on at most `n/t` points, `t ≥ 9`, has at most `2n/3` points. -/
theorem three_mul_le_of_ts {ts ws n : ℕ} (h8 : 8 < ts) (h : ts * ws ≤ n) : 3 * ws ≤ 2 * n := by
  have : 9 * ws ≤ ts * ws := Nat.mul_le_mul_right _ (by omega)
  omega

/-- The width of the round at the node covers the phases. -/
theorem l57_width_ge :
    aggnAggregateWidth c C ≤ (aggnL57GRound c b t d dc dp u v e f).width (C, none) := by
  show aggnAggregateWidth c C ≤ aggnAggregateWidth c C + aggnL57Cap c b t d dc dp C +
    aggnL57GCap c b t d dc dp u v e f C
  omega

/-- The calls of AggregateCertificates satisfy the condition at every step: they have at
most `n/t` points, so at most `2n/3`. -/
theorem l57_stretch1S (hS : L57Setting c b t d dc dp u v e f n m C ϕ) :
    PhaseMatchS (aggnL57GRound c b t d dc dp u v e f) (L57CM c b t d dc dp u v e f n m C)
      (aggnPhaseDecode n) (decCoset n) (C, none) (aggnAggregateWidth c C) 0
      ((aggnL57GRound c b t d dc dp u v e f).init (C, none))
      (aggregateRoundStrong ϕ (decStrN n C.2.1) (decStrN n C.2.2.1) (l57Enum c n m C ϕ)
        (.done ()))
      (fun _ j w => j ≤ aggnAggregateWidth c C ∧ w = ((w.1.1, none), none) ∧
        AggnL57Post c dc dp C ϕ w.1.1) := by
  have h8 := hS.large.eight_lt
  refine aggnL57G_stretch1S hS.ok hS.wf hS.ctx hS.set hS.large hS.tm hS.x hS.y
    (fun K => IsCosetInstance (decGroup n C.1.1.2) K ∧ C.2.2.2.length * K.windowSize ≤ n)
    (fun K hK => ?_) (fun j s J _ hV => l57CM_of_small hV.1.K_subset (three_mul_le_of_ts h8 hV.2))
  obtain ⟨h1, -, h3⟩ := l57_agg_calls hS (.done ()) (fun _ => False) (by simp) K hK
  exact ⟨h1, h3.resolve_right id⟩

/-- **No state ends the phases**: then stretch 3 is never reached, and any continuation of
AggregateCertificates is walked; take the one that returns `Iso_G(x, y)`. -/
theorem l57Tree_noPost (hS : L57Setting c b t d dc dp u v e f n m C ϕ)
    (hno : ∀ s, ¬ AggnL57Post c dc dp C ϕ s) :
    L57TreeOK c b t d dc dp u v e f n m C
      (aggregateRoundStrong ϕ (decStrN n C.2.1) (decStrN n C.2.2.1) (l57Enum c n m C ϕ)
        (.done (strIso (decGroup n C.1.1.2 : Set (Perm (Fin n))) (decStrN n C.2.1)
          (decStrN n C.2.2.1)))) := by
  have he : aggregateRoundStrong ϕ (decStrN n C.2.1) (decStrN n C.2.2.1) (l57Enum c n m C ϕ)
