/-- §15, lines 5–7, with the hinted call of line 11: **the supply of route 5 exists**, with a
monotone quasipolynomial bound `q45` on the number of calls, for the constants of the round
meeting their specifications with `c ≥ 2` and a reserve exponent `E` of the round. -/
theorem exists_masterL57SupplyH {E : ℕ} (hok : AggnPhasesOK c dc dp) (hcap : TopwpCap e f)
    (hsolver : AggnRestoredEntryGood c b t d) (hbip : BipInputRunCanonical b t d) (hc2 : 2 ≤ c)
    (hE : MasterL57EOK c b t d dc dp e f E) :
    ∃ q45 : ℕ → ℕ, Monotone q45 ∧ QuasiPolyBound q45 ∧
      ∀ n, MasterL57SupplyH c b t d dc dp e f n q45
        (masterL57Hint c b t d dc dp (l57UV e f).1 (l57UV e f).2 e f) := by
  obtain ⟨Wc, hWc, hWcm, hcw⟩ := aggnChecked_width_bound c
  obtain ⟨Wp, hWp, hWpm, hpw⟩ := aggnCompareChecked_width_bound c
  refine ⟨fun N => Wc N + Wp N + 2 ^ ((Nat.log 2 N + 2) ^ E), ?_,
    (hWc.add hWp).add (quasiPolyBound_witness E),
    fun n => masterL57SupplyH_masterL57Hint hok hcap hsolver hbip hc2 hE hcw hpw n⟩
  intro x y hxy
  have h1 := hWcm hxy
  have h2 := hWpm hxy
  have h3 := quasiPolyBound_witness_mono E hxy
  show Wc x + Wp x + _ ≤ Wc y + Wp y + _
  omega

