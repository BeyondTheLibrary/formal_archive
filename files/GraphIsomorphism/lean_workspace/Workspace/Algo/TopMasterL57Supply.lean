  · exact ((aggnContinuation_zero_spec hS.ctx hs b t d).2 h0).symm
  · exact ((aggnContinuation_five_spec hS.ctx hs b t d).2 h5).symm
  · exact ((aggnContinuation_six_spec hS.ctx hs b t d htbl hS.set hS.large hS.tm).2 h6).symm

