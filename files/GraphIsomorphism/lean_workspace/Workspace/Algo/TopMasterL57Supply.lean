  have hm := aggnL57G_giant_match (b := b) (t := t) (d := d) hS.ok hS.gwf hS.cap hS.wf hS.ctx
    hS.set hS.large hS.tm hS.x hS.y hS.huge (fun s hs => by rw [hsame s hs]; exact htag) T4
    (fun s hs h2a' => top4AggregateTree_congr hS.ctx hs.2.2.1 hs₀.2.2.1 hS.set hS.huge h2a' h2a)
  have hcalls : ∀ K ∈ ((aggregateRoundStrong ϕ (decStrN n C.2.1) (decStrN n C.2.2.1)
