/-- §15, lines 5–7: **the hypotheses of Layer A on a normalized context** of a window of
`N ≥ 64` points, for the constants of the round meeting their specifications with `c ≥ 2`:
the action is well formed for a giant representation `ϕ` of the transitive group, the two
strings have `N` letters below `2N`, the test-set size is `t = 10 + log N`, and `m > (log N)³`
(the test of line 2). -/
theorem l57Setting_of_normal (hok : AggnPhasesOK c dc dp) (hcap : TopwpCap e f)
    (hsolver : AggnRestoredEntryGood c b t d) (hbip : BipInputRunCanonical b t d) (hc2 : 2 ≤ c)
    (hnorm : AggnL57CtxNormal N C) (hA : RawAction.WF N m C.1 ϕ)
    (hlx : RawStr.WF N (2 * N) C.2.1) (hly : RawStr.WF N (2 * N) C.2.2.1)
    (hts : C.2.2.2.length = testSetSize N) (hG : IsTransitive (decGroup N C.1.1.2))
    (hϕ : IsGiantRep ϕ) (hmn : m ≤ N) (hN : 64 ≤ N) (hell : ellOf N < m)
    (hcat : IsCatAction (SplitOutcomes (Fin m))) :
    L57Setting c b t d dc dp (l57UV e f).1 (l57UV e f).2 e f N m C ϕ := by
  have hC : AggnPhaseCtxWF c N m C ϕ :=
    { action := hA
      source := hlx.1
      target := hly.1
      degree := hmn
      arity := by rw [hts]; exact testSetSize_le_self hN
      guard := by rw [hts, hlx.1]; exact testSetSize_le_guardBound hc2 hN }
  have hwf : (aggnL57GRound c b t d dc dp (l57UV e f).1 (l57UV e f).2 e f).WF (C, none) := by
    show AggnCheckedWF C.2.1.length (C, none)
    rw [hlx.1]
    exact aggnCheckedWF_of_context hC hnorm.1 hnorm.2
  have hcard : Nat.card (Fin N) = N := Nat.card_fin N
  have hL := six_le_natLog hN
  have h216 : 216 ≤ Nat.log 2 N ^ 3 :=
    calc 216 = 6 ^ 3 := by norm_num
      _ ≤ Nat.log 2 N ^ 3 := Nat.pow_le_pow_left hL 3
  exact
    { ok := hok
      gwf := l57UV_spec e f
      cap := hcap
      solver := hsolver
      bip := hbip
      wf := hwf
      ctx := hC
      set := localCertSetting_of_line3 hG hϕ (by rw [hcard]; exact hN)
        (by rw [hcard, Nat.card_fin]; exact hell)
      large := by rw [hts, hcard]; exact largeK_testSetSize (by omega)
      tm := by rw [hts]; exact (ten_mul_testSetSize_lt hN hell).le
      x := hlx
      y := hly
      huge := by rw [hcard]; exact hugeM_of_line2 hN hell
      m217 := by unfold ellOf at hell; omega
      cat := hcat }

