/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

The algorithmic layer: the union of two answer cosets (§11.1, Prop. 11.1.6, Eq. (62)).
-/
import Workspace.Algo.Luks

/-!
# Joining two answer cosets

Proposition 11.1.6 (Descent) answers the union

> `Iso^Δ_G(x,y) = ⋃_σ Iso^Δ_{Hσ}(x,y)`,  (62)

and Observation 11.1.11 says that the answer of an instance is empty or a coset
`Aut^Δ_G(x)·σ` of one group.  So the union of the `|G : H|` partial answers is again empty or
a coset, and a machine that holds one answer in the representation of Definition 11.1.2 —
generators of a group and one representative — can fold the partial answers one by one.

The fold step is `Algo.rawCosetJoin`.  Its two inputs are cosets `τ·M` and `ρ·N`; the answer
is the coset `τ·⟨M ∪ N ∪ {τ⁻¹ρ}⟩` generated by the two of them, shortened.  That is **not**
the union of the two: the union of two cosets of the same group is not a coset.  What is true
is that the join is the smallest coset containing the two, and that the join of *all* the
partial answers of Eq. (62) is their union, because that union is already a coset.  The first
statement is `Algo.decCoset_rawCosetJoin`; the second is proved where the descent round is
(`Workspace/Algo/Descent.lean`, `Algo.run_descentChain`).

## The smallest coset containing a set

`Algo.cosetHull S` is that smallest coset: pick any `τ ∈ S` and take `τ·⟨τ⁻¹S⟩`.  The choice
of `τ` does not matter (`Algo.genCoset_indep`), so the definition takes the union over all
`τ ∈ S`, which is choice-free and total: on the empty set it is empty.

## Main definitions

* `Algo.cosetHull` — the smallest coset of a subgroup containing a set;
* `Algo.rawCosetJoin` — the fold step, on raw cosets.

## Main results

* `Algo.cosetHull_eq` — any representative computes the hull;
* `Algo.subset_cosetHull`, `Algo.cosetHull_subset_of_subset` — the hull is the smallest coset
  containing the set;
* `Algo.decCoset_rawCosetJoin` — **the specification**: the routine computes the hull of the
  union of the two decoded sets;
* `Algo.polyFun_rawCosetJoin`, `Algo.size_rawCosetJoin_le` — the cost.

No axiom and no `sorry`.
-/

namespace Algo

open RAM RAM.Targets
open Equiv (Perm)
open scoped Pointwise

/-! ## The coset hull -/

section Hull

variable {Γ : Type*} [Group Γ]

theorem mem_smul_set_group {τ x : Γ} {S : Set Γ} : x ∈ τ • S ↔ τ⁻¹ * x ∈ S := by
  constructor
  · rintro ⟨u, hu, rfl⟩
    simpa [smul_eq_mul] using hu
  · intro h
    exact ⟨τ⁻¹ * x, h, by simp [smul_eq_mul]⟩

/-- **The smallest coset of a subgroup containing `S`**: `τ·⟨τ⁻¹S⟩` for any `τ ∈ S`, and the
empty set when `S` is empty.  Paper: the answer representation of Definition 11.1.2 — a group
and one representative — as it is used in Eq. (62). -/
def cosetHull (S : Set Γ) : Set Γ :=
  ⋃ τ ∈ S, τ • (Subgroup.closure (τ⁻¹ • S) : Set Γ)

@[simp] theorem cosetHull_empty : cosetHull (∅ : Set Γ) = ∅ := by
  simp [cosetHull]

/-- **The representative does not matter.**  If `τ` and `ν` both lie in `S` then the two
cosets `τ·⟨τ⁻¹S⟩` and `ν·⟨ν⁻¹S⟩` are the same.

*Proof.*  Each of the two generated subgroups contains the other's generating set: for `s ∈ S`,
`ν⁻¹s = (τ⁻¹ν)⁻¹(τ⁻¹s)`, and both factors lie in `⟨τ⁻¹S⟩` because `τ⁻¹ν` and `τ⁻¹s` do.  So the
subgroups are equal, and the two cosets agree because `ν⁻¹τ` lies in the subgroup. -/
theorem genCoset_indep {S : Set Γ} {τ ν : Γ} (hτ : τ ∈ S) (hν : ν ∈ S) :
    τ • (Subgroup.closure (τ⁻¹ • S) : Set Γ) = ν • (Subgroup.closure (ν⁻¹ • S) : Set Γ) := by
  have key : ∀ a b : Γ, a ∈ S → b ∈ S →
      Subgroup.closure (b⁻¹ • S) ≤ Subgroup.closure (a⁻¹ • S) := by
    intro a b ha hb
    refine Subgroup.closure_le _ |>.2 ?_
    rintro y ⟨s, hs, rfl⟩
    have h1 : a⁻¹ * s ∈ Subgroup.closure (a⁻¹ • S) :=
      Subgroup.subset_closure ⟨s, hs, by simp [smul_eq_mul]⟩
    have h2 : a⁻¹ * b ∈ Subgroup.closure (a⁻¹ • S) :=
      Subgroup.subset_closure ⟨b, hb, by simp [smul_eq_mul]⟩
    show b⁻¹ * s ∈ Subgroup.closure (a⁻¹ • S)
    have h3 : b⁻¹ * s = (a⁻¹ * b)⁻¹ * (a⁻¹ * s) := by group
    rw [h3]
    exact mul_mem (inv_mem h2) h1
  have hK : Subgroup.closure (τ⁻¹ • S) = Subgroup.closure (ν⁻¹ • S) :=
    le_antisymm (key ν τ hν hτ) (key τ ν hτ hν)
  have hmem : ν⁻¹ * τ ∈ Subgroup.closure (ν⁻¹ • S) :=
    Subgroup.subset_closure ⟨τ, hτ, by simp [smul_eq_mul]⟩
  ext x
  rw [mem_smul_set_group, mem_smul_set_group, hK]
  constructor
  · intro h
    have : ν⁻¹ * x = (ν⁻¹ * τ) * (τ⁻¹ * x) := by group
    rw [this]
    exact mul_mem hmem h
  · intro h
    have : τ⁻¹ * x = (ν⁻¹ * τ)⁻¹ * (ν⁻¹ * x) := by group
    rw [this]
    exact mul_mem (inv_mem hmem) h

/-- **Any representative computes the hull.** -/
theorem cosetHull_eq {S : Set Γ} {τ : Γ} (hτ : τ ∈ S) :
    cosetHull S = τ • (Subgroup.closure (τ⁻¹ • S) : Set Γ) := by
  ext x
  rw [cosetHull]
  simp only [Set.mem_iUnion, exists_prop]
  constructor
  · rintro ⟨ν, hν, hx⟩
    rwa [genCoset_indep hν hτ] at hx
  · intro hx
    exact ⟨τ, hτ, hx⟩

/-- The hull contains the set. -/
theorem subset_cosetHull (S : Set Γ) : S ⊆ cosetHull S := by
  intro x hx
  rw [cosetHull_eq hx, mem_smul_set_group]
  simpa using (Subgroup.closure (x⁻¹ • S)).one_mem

/-- **The hull is the smallest coset containing the set.** -/
theorem cosetHull_subset_of_subset {S : Set Γ} {A : Subgroup Γ} {τ : Γ}
    (h : S ⊆ τ • (A : Set Γ)) : cosetHull S ⊆ τ • (A : Set Γ) := by
  rcases Set.eq_empty_or_nonempty S with rfl | ⟨ν, hν⟩
  · rw [cosetHull_empty]; exact Set.empty_subset _
  rw [cosetHull_eq hν]
  have hνA : τ⁻¹ * ν ∈ A := mem_smul_set_group.1 (h hν)
  have hle : Subgroup.closure (ν⁻¹ • S) ≤ A := by
    refine Subgroup.closure_le _ |>.2 ?_
    rintro y ⟨s, hs, rfl⟩
    have hs' : τ⁻¹ * s ∈ A := mem_smul_set_group.1 (h hs)
    show ν⁻¹ * s ∈ A
    have : ν⁻¹ * s = (τ⁻¹ * ν)⁻¹ * (τ⁻¹ * s) := by group
    rw [this]
    exact mul_mem (inv_mem hνA) hs'
  intro x hx
  rw [mem_smul_set_group] at hx ⊢
  have hxA : ν⁻¹ * x ∈ A := hle hx
  have : τ⁻¹ * x = (τ⁻¹ * ν) * (ν⁻¹ * x) := by group
  rw [this]
  exact mul_mem hνA hxA

/-- **A coset is its own hull.** -/
theorem cosetHull_smul_subgroup (τ : Γ) (A : Subgroup Γ) :
    cosetHull (τ • (A : Set Γ)) = τ • (A : Set Γ) :=
  le_antisymm (cosetHull_subset_of_subset (le_refl _)) (subset_cosetHull _)

/-- **The hull of the union of two cosets**: the coset of the group generated by the two
groups and the ratio of the two representatives.  This is what `Algo.rawCosetJoin`
computes. -/
theorem cosetHull_union_smul (τ ρ : Γ) (A B : Subgroup Γ) :
    cosetHull (τ • (A : Set Γ) ∪ ρ • (B : Set Γ))
      = τ • ((A ⊔ B ⊔ Subgroup.closure {τ⁻¹ * ρ} : Subgroup Γ) : Set Γ) := by
  have hτ : τ ∈ τ • (A : Set Γ) ∪ ρ • (B : Set Γ) :=
    Or.inl (mem_smul_set_group.2 (by simpa using A.one_mem))
  rw [cosetHull_eq hτ]
  congr 1
  refine congrArg (fun K : Subgroup Γ => (K : Set Γ)) (le_antisymm ?_ ?_)
  · refine Subgroup.closure_le _ |>.2 ?_
    rintro y ⟨s, hs, rfl⟩
    show τ⁻¹ * s ∈ (A ⊔ B ⊔ Subgroup.closure {τ⁻¹ * ρ} : Subgroup Γ)
    rcases hs with hs | hs
    · have h' : τ⁻¹ * s ∈ A := mem_smul_set_group.1 hs
      exact Subgroup.mem_sup_left (Subgroup.mem_sup_left h')
    · have hsB : ρ⁻¹ * s ∈ B := mem_smul_set_group.1 hs
      have hg : τ⁻¹ * ρ ∈ (A ⊔ B ⊔ Subgroup.closure {τ⁻¹ * ρ} : Subgroup Γ) :=
        Subgroup.mem_sup_right (Subgroup.subset_closure rfl)
      have hB : ρ⁻¹ * s ∈ (A ⊔ B ⊔ Subgroup.closure {τ⁻¹ * ρ} : Subgroup Γ) :=
        Subgroup.mem_sup_left (Subgroup.mem_sup_right hsB)
      have h2 : τ⁻¹ * s = (τ⁻¹ * ρ) * (ρ⁻¹ * s) := by group
      rw [h2]
      exact mul_mem hg hB
  · refine sup_le (sup_le ?_ ?_) ?_
    · intro a ha
      exact Subgroup.subset_closure ⟨τ * a, Or.inl (mem_smul_set_group.2 (by simpa using ha)),
        by simp [smul_eq_mul]⟩
    · intro b hb
      have hg : τ⁻¹ * ρ ∈ Subgroup.closure (τ⁻¹ • (τ • (A : Set Γ) ∪ ρ • (B : Set Γ))) :=
        Subgroup.subset_closure ⟨ρ, Or.inr (mem_smul_set_group.2 (by simpa using B.one_mem)),
          by simp [smul_eq_mul]⟩
      have hmem : τ⁻¹ * (ρ * b)
          ∈ Subgroup.closure (τ⁻¹ • (τ • (A : Set Γ) ∪ ρ • (B : Set Γ))) :=
        Subgroup.subset_closure ⟨ρ * b, Or.inr (mem_smul_set_group.2 (by simpa using hb)),
          by simp [smul_eq_mul]⟩
      have : b = (τ⁻¹ * ρ)⁻¹ * (τ⁻¹ * (ρ * b)) := by group
      rw [this]
      exact mul_mem (inv_mem hg) hmem
    · refine (Subgroup.closure_le _).2 ?_
      rintro y rfl
      exact Subgroup.subset_closure ⟨ρ, Or.inr (mem_smul_set_group.2 (by simpa using B.one_mem)),
        by simp [smul_eq_mul]⟩

end Hull

/-! ## The routine

The join takes the domain witness — a list of length `n`, in practice the string `x` of the
instance — because its two inputs are *arbitrary* raw cosets: the fold of a round receives
whatever raw answer the recursion produced, and all that is known of it is what it decodes to
(`Algo.LoopMatch.call`).  So the routine sanitizes both inputs with `Algo.normPerm` and
`Algo.normGens`, which does not change the decoded set, and only then multiplies and
shortens. -/

variable {n : ℕ}

/-- **The join of two answer cosets** (§11.1, Prop. 11.1.6, Eq. (62)).  The empty answer joined
with anything is the other one; `τ·M` joined with `ρ·N` is `τ·⟨M ∪ N ∪ {τ⁻¹ρ}⟩`, shortened to
at most `n²` generators. -/
def rawCosetJoin (p : RawStr × RawCoset × RawCoset) : RawCoset :=
  match p.2.1, p.2.2 with
  | none, c => c
  | some q, none => some q
  | some (M, τ), some (N, ρ) =>
      some (rawShorten (p.1, normGens (p.1, M) ++ normGens (p.1, N)
          ++ [rawMul (rawInv (normPerm (p.1, τ)), normPerm (p.1, ρ))]),
        normPerm (p.1, τ))

/-- **The specification of `Algo.rawCosetJoin`**: it computes the smallest coset containing
the two decoded sets.  Paper: Prop. 11.1.6, Eq. (62), with the answer representation of
Def. 11.1.2. -/
theorem decCoset_rawCosetJoin {x : RawStr} (hx : x.length = n) (c₁ c₂ : RawCoset) :
    decCoset n (rawCosetJoin (x, c₁, c₂)) = cosetHull (decCoset n c₁ ∪ decCoset n c₂) := by
  match c₁, c₂ with
  | none, c =>
      show decCoset n c = cosetHull (∅ ∪ decCoset n c)
      rw [Set.empty_union]
      match c with
      | none => simp [decCoset]
      | some (N, ρ) =>
          rw [decCoset_some, cosetHull_smul_subgroup]
  | some (M, τ), none =>
      show decCoset n (some (M, τ)) = cosetHull (decCoset n (some (M, τ)) ∪ ∅)
      rw [Set.union_empty, decCoset_some, cosetHull_smul_subgroup]
  | some (M, τ), some (N, ρ) =>
      have hMwf : RawGens.WF n (normGens (x, M)) := wf_normGens hx M
      have hNwf : RawGens.WF n (normGens (x, N)) := wf_normGens hx N
      have hτwf : RawPerm.WF n (normPerm (x, τ)) := wf_normPerm hx τ
      have hρwf : RawPerm.WF n (normPerm (x, ρ)) := wf_normPerm hx ρ
      have hgwf : RawPerm.WF n (rawMul (rawInv (normPerm (x, τ)), normPerm (x, ρ))) :=
        wf_rawMul (wf_rawInv hτwf) hρwf
      have hallwf : RawGens.WF n (normGens (x, M) ++ normGens (x, N)
          ++ [rawMul (rawInv (normPerm (x, τ)), normPerm (x, ρ))]) := by
        intro g hg
        rcases List.mem_append.1 hg with hg | hg
        · rcases List.mem_append.1 hg with hg | hg
          · exact hMwf g hg
          · exact hNwf g hg
        · rw [List.mem_singleton.1 hg]; exact hgwf
      have hdecg : decPerm n (rawMul (rawInv (normPerm (x, τ)), normPerm (x, ρ)))
          = (decPerm n τ)⁻¹ * decPerm n ρ := by
        rw [rawMul_of_wf (wf_rawInv hτwf) hρwf, decPerm_encPerm, rawInv_of_wf hτwf,
          decPerm_encPerm, decPerm_normPerm hx, decPerm_normPerm hx]
      have hgrp : decGroup n (rawShorten (x, normGens (x, M) ++ normGens (x, N)
            ++ [rawMul (rawInv (normPerm (x, τ)), normPerm (x, ρ))]))
          = decGroup n M ⊔ decGroup n N
              ⊔ Subgroup.closure {(decPerm n τ)⁻¹ * decPerm n ρ} := by
        rw [decGroup_rawShorten_wf hx hallwf, decGroup_append, decGroup_append,
          decGroup_normGens hx, decGroup_normGens hx]
        congr 1
        rw [decGroup, List.map_cons, List.map_nil, genGroup, hdecg]
        congr 1
        ext z
        simp
      show decCoset n (some (_, normPerm (x, τ))) = _
      rw [decCoset_some, decCoset_some, decCoset_some, hgrp, decPerm_normPerm hx,
        cosetHull_union_smul]

/-! ## The cost -/

theorem polyFun_rawCosetJoin : PolyFun rawCosetJoin := by
  classical
  -- the body on two present cosets: the option is `c₂`, the parameter is `(q, x)`
  have hx : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × RawStr) => z.2.2) :=
    polyFun_snd.comp polyFun_snd
  have hτ : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × RawStr) =>
      normPerm (z.2.2, z.2.1.2)) :=
    (hx.pair ((polyFun_snd.comp polyFun_fst).comp polyFun_snd)).comp polyFun_normPerm
  have hρ : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × RawStr) =>
      normPerm (z.2.2, z.1.2)) :=
    (hx.pair (polyFun_fst.comp polyFun_snd)).comp polyFun_normPerm
  have hM : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × RawStr) =>
      normGens (z.2.2, z.2.1.1)) :=
    (hx.pair ((polyFun_snd.comp polyFun_fst).comp polyFun_fst)).comp polyFun_normGens
  have hN : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × RawStr) =>
      normGens (z.2.2, z.1.1)) :=
    (hx.pair (polyFun_fst.comp polyFun_fst)).comp polyFun_normGens
  have hg : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × RawStr) =>
      rawMul (rawInv (normPerm (z.2.2, z.2.1.2)), normPerm (z.2.2, z.1.2))) :=
    ((hτ.comp polyFun_rawInv).pair hρ).comp polyFun_rawMul
  have hlist : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × RawStr) =>
      normGens (z.2.2, z.2.1.1) ++ normGens (z.2.2, z.1.1)
        ++ [rawMul (rawInv (normPerm (z.2.2, z.2.1.2)), normPerm (z.2.2, z.1.2))]) :=
    (((hM.pair hN).comp polyFun_append).pair
      ((hg.pair (polyFun_nil (α := (RawGens × RawPerm) × ((RawGens × RawPerm) × RawStr))
        (β := RawPerm))).comp polyFun_cons)).comp polyFun_append
  have hbody : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × RawStr) =>
      (some (rawShorten (z.2.2, normGens (z.2.2, z.2.1.1) ++ normGens (z.2.2, z.1.1)
          ++ [rawMul (rawInv (normPerm (z.2.2, z.2.1.2)), normPerm (z.2.2, z.1.2))]),
        normPerm (z.2.2, z.2.1.2)) : RawCoset)) :=
    (((hx.pair hlist).comp polyFun_rawShorten).pair hτ).comp polyFun_some
  have hinner : PolyFun (fun p : RawCoset × ((RawGens × RawPerm) × RawStr) =>
      rawCosetJoin (p.2.2, some p.2.1, p.1)) := by
    refine (PolyFun.optionElim
      (g := fun z : (RawGens × RawPerm) × RawStr => (some z.1 : RawCoset))
      (polyFun_fst.comp polyFun_some) hbody).of_eq (fun p => ?_)
    obtain ⟨c₂, q, x⟩ := p
    obtain ⟨M, τ⟩ := q
    cases c₂ with
    | none => rfl
    | some r => obtain ⟨N, ρ⟩ := r; rfl
  -- the outer case analysis, on `c₁`, with `(c₂, x)` as the parameter
  have houter : PolyFun (fun p : RawCoset × (RawCoset × RawStr) =>
      rawCosetJoin (p.2.2, p.1, p.2.1)) := by
    refine (PolyFun.optionElim
      (g := fun z : RawCoset × RawStr => z.1)
      (h := fun z : (RawGens × RawPerm) × (RawCoset × RawStr) =>
        rawCosetJoin (z.2.2, some z.1, z.2.1))
      polyFun_fst
      (((polyFun_snd.comp polyFun_fst).pair
        (polyFun_fst.pair (polyFun_snd.comp polyFun_snd))).comp hinner)).of_eq (fun p => ?_)
    obtain ⟨c₁, c₂, x⟩ := p
    cases c₁ with
    | none => cases c₂ <;> rfl
    | some q => rfl
  exact ((polyFun_snd.comp polyFun_fst).pair
    ((polyFun_snd.comp polyFun_snd).pair polyFun_fst)).comp houter

/-! ### The size of the answer

The answer of the join is a well-formed generating list of at most `n²` entries together with
one representative, so it is small in the sense of `Algo.chainBound`, the bound of the Chain
Rule round. -/

/-- A well-formed short generating list is small. -/
theorem size_gens_le' {gs : RawGens} {m : ℕ} (hm : n ≤ m) (hwf : RawGens.WF n gs)
    (hlen : gs.length ≤ n * n) : Enc.size gs ≤ gensBound m := by
  have hentry : ∀ g ∈ gs, Enc.size g ≤ strBound m := by
    intro g hg
    exact size_natList_le (by rw [(hwf g hg).length]; exact hm)
      (fun a ha => lt_of_lt_of_le ((hwf g hg).lt ha) hm)
  have h1 := size_list_le_of_entries gs (strBound m) hentry
  have h2 : gs.length * (2 * strBound m + 1) ≤ m * m * (2 * strBound m + 1) :=
    Nat.mul_le_mul_right _ (le_trans hlen (Nat.mul_le_mul hm hm))
  have h3 : gensBound m = 1 + m * m * (2 * strBound m + 1) := rfl
  omega

/-- A well-formed raw permutation is small. -/
theorem size_perm_le' {l : RawPerm} {m : ℕ} (hm : n ≤ m) (hwf : RawPerm.WF n l) :
    Enc.size l ≤ strBound m :=
  size_natList_le (by rw [hwf.length]; exact hm) (fun a ha => lt_of_lt_of_le (hwf.lt ha) hm)

/-- A raw coset built from a well-formed short generating list and a well-formed
representative is small. -/
theorem size_coset_le' {gs : RawGens} {l : RawPerm} {m : ℕ} (hm : n ≤ m)
    (hwf : RawGens.WF n gs) (hlen : gs.length ≤ n * n) (hl : RawPerm.WF n l) :
    Enc.size (some (gs, l) : RawCoset) ≤ chainBound m := by
  have h0 : Enc.size (some (gs, l) : RawCoset) = Enc.size ((gs, l) : RawGens × RawPerm) + 2 :=
    size_some_eq _
  have h1 : Enc.size ((gs, l) : RawGens × RawPerm) ≤ 2 * Enc.size gs + 2 * Enc.size l :=
    Combine.size_pair_le _ _
  have h2 := size_gens_le' hm hwf hlen
  have h3 := size_perm_le' hm hl
  have h4 := strBound_le_gensBound m
  have h5 : chainBound m = 16 * (gensBound m + m + 1) := rfl
  omega

/-- **The join does not grow the answer.**  Paper: the answer representation of
Definition 11.1.2 stays of polynomial size along Eq. (62). -/
theorem size_rawCosetJoin_le {x : RawStr} (hx : x.length = n) {c₁ c₂ : RawCoset} {m bd : ℕ}
    (hm : n ≤ m) (hb : chainBound m ≤ bd) (h₁ : Enc.size c₁ ≤ bd) (h₂ : Enc.size c₂ ≤ bd) :
    Enc.size (rawCosetJoin (x, c₁, c₂)) ≤ bd := by
  match c₁, c₂ with
  | none, c => exact h₂
  | some q, none => exact h₁
  | some (M, τ), some (N, ρ) =>
      have hallwf : RawGens.WF n (normGens (x, M) ++ normGens (x, N)
          ++ [rawMul (rawInv (normPerm (x, τ)), normPerm (x, ρ))]) := by
        intro g hg
        rcases List.mem_append.1 hg with hg | hg
        · rcases List.mem_append.1 hg with hg | hg
          · exact wf_normGens hx M g hg
          · exact wf_normGens hx N g hg
        · rw [List.mem_singleton.1 hg]
          exact wf_rawMul (wf_rawInv (wf_normPerm hx τ)) (wf_normPerm hx ρ)
      exact le_trans (size_coset_le' hm (rawShorten_wf hx hallwf)
        (length_rawShorten_wf hx hallwf) (wf_normPerm hx τ)) hb

end Algo
