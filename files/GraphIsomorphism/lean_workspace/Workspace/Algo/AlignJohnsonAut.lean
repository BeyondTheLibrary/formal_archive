/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

The algorithmic layer: Procedure Align (§14.1), line 2 (iv) — generators of `Aut(X(x))`
when `X(x)` is a Johnson scheme, on the unit-cost RAM.
-/
import Workspace.Algo.AlignJohnsonParity
import Workspace.Algo.AlignStruct

/-!
# §14.1, Procedure Align, line 2 (iv): generators of `Aut(X)` for a Johnson scheme

`Algo.decJohnson m r` marks the class `W` that carries the scheme with the vertex color `1`,
and colors the pairs inside `W` by the Johnson color.  So an automorphism is a permutation
of `Γ` that carries `W` onto itself, acts on `W` as an automorphism of the Johnson graph,
and is arbitrary outside `W`.  By Prop. 3.2.11 (`Babai.aut_johnsonGraph`) the automorphisms
of the Johnson graph are induced by the permutations of `Γ*`.  So `Aut(X)` is generated by

* the automorphisms induced by the transpositions `(i, i+1)` of `Γ*`, which generate the
  whole of `S(Γ*)`, and
* the transpositions of two points outside `W`.

Both families are computed as raw permutations: the first one by relabelling the rows of the
scheme and calling the aligning permutation of `Workspace/Algo/AlignJohnsonIso.lean`, the
second one by `Algo.rawTopSwap`.  The loop runs over the points of `Γ`, which is a list of
the input, and `m* ≤ m` (`Algo.alignJ_deg_le`), so every transposition of `Γ*` is reached.

## Main definitions

* `Algo.alignJAdjRow` — the transposition `(i, i+1)` of `Γ*`, on a row;
* `Algo.alignJAdjScheme` — the scheme with its rows relabelled;
* `Algo.alignJAutHom` — the map `S(Γ*) → S(Γ)`, `π ↦` the automorphism it induces;
* `Algo.alignJAdjGen`, `Algo.alignJOutGen`, `Algo.alignJAutGens` — **the generators**.

## Main results

* `Algo.alignJ_deg_le` — `m* ≤ m`;
* `Algo.decJohnson_alignJAdjScheme` — the relabelled scheme decodes to the same structure;
* `Algo.alignJ_restrict_perm` — Prop. 3.2.11 in raw words: the action of an automorphism on
  the rows is the action of a permutation of `Γ*`;
* `Algo.decGroup_alignJAutGens` — **the computed list generates `Aut(X)`**;
* `Algo.polyFun_alignJAutGens` — the running time.

No axiom, no `sorry`.
-/

namespace Algo

open RAM RAM.Targets
open Equiv (Perm)

/-! ## `m* ≤ m`

The class `W` has `C(m*, t*)` points, and `C(m*, t*) ≥ C(m*, 1) = m*` because `t*` is at
most `m*/2`.  So the degree of `Γ*` is at most the degree of `Γ`, and a loop over the points
of `Γ` reaches every point of `Γ*`. -/

/-- Binomial coefficients grow up to the middle. -/
theorem alignJ_choose_mono {n : ℕ} :
    ∀ b, b ≤ n / 2 → ∀ a, a ≤ b → n.choose a ≤ n.choose b := by
  intro b
  induction b with
  | zero => intro _ a ha; rw [Nat.le_zero.1 ha]
  | succ k ih =>
    intro hk a ha
    rcases Nat.eq_or_lt_of_le ha with h | h
    · rw [h]
    · exact (ih (by omega) a (by omega)).trans
        (Nat.choose_le_succ_of_lt_half_left (by omega))

/-- **`m* ≤ m`**: the class `W` has `C(m*, t*) ≥ m*` points, and they lie in `Γ`. -/
theorem alignJ_deg_le {m ms ts : ℕ} {r : RawJohnson} (h : RawJohnson.WF m ms ts r) :
    ms ≤ m := by
  have hhalf : ts ≤ ms / 2 := by have := h.params; omega
  have h1 : ms.choose 1 ≤ ms.choose ts :=
    alignJ_choose_mono ts hhalf 1 (by have := h.two_le; omega)
  rw [Nat.choose_one_right] at h1
  have hcard : (rawJSet m r.1).card = r.1.length := card_rawJSet h.wNodup h.wLt
  have hle : (rawJSet m r.1).card ≤ m := by
    have := Finset.card_le_univ (rawJSet m r.1)
    rwa [Fintype.card_fin] at this
  have hrows : ms.choose ts = r.1.length := by rw [← h.card, h.rowsLen]
  omega

/-! ## The transposition `(i, i+1)` of `Γ*`, on raw rows

A strictly increasing row stays strictly increasing after the relabelling by an *adjacent*
transposition: a row that contains `i` but not `i + 1` has its next entry above `i + 1`.  So
no row has to be sorted again, exactly as for the transposition `(0 1)` of
`Workspace/Algo/AlignJohnsonParity.lean`. -/

/-- The transposition `(i, i+1)` of `Γ*`, on one point. -/
def alignJAdjNat (p : ℕ × ℕ) : ℕ :=
  if p.2 = p.1 then p.1 + 1 else if p.2 = p.1 + 1 then p.1 else p.2

@[simp] theorem alignJAdjNat_involutive (i a : ℕ) :
    alignJAdjNat (i, alignJAdjNat (i, a)) = a := by
  show (if (if a = i then i + 1 else if a = i + 1 then i else a) = i then i + 1
    else if (if a = i then i + 1 else if a = i + 1 then i else a) = i + 1 then i
    else (if a = i then i + 1 else if a = i + 1 then i else a)) = a
  split_ifs <;> omega

theorem alignJAdjNat_lt {i a b : ℕ} (hab : a < b)
    (h : (a ≠ i + 1 ∧ b ≠ i + 1) ∨ (a ≠ i ∧ b ≠ i)) :
    alignJAdjNat (i, a) < alignJAdjNat (i, b) := by
  show (if a = i then i + 1 else if a = i + 1 then i else a)
    < (if b = i then i + 1 else if b = i + 1 then i else b)
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> split_ifs <;> omega

theorem alignJAdjNat_le {i a ms : ℕ} (ha : a < ms) (hi : i + 1 < ms) :
    alignJAdjNat (i, a) < ms := by
  show (if a = i then i + 1 else if a = i + 1 then i else a) < ms
  split_ifs <;> omega

theorem mem_map_alignJAdjNat {i : ℕ} {l : List ℕ} {a : ℕ} :
    a ∈ l.map (fun c => alignJAdjNat (i, c)) ↔ alignJAdjNat (i, a) ∈ l := by
  constructor
  · rintro hmem
    obtain ⟨b, hb, rfl⟩ := List.mem_map.1 hmem
    rwa [alignJAdjNat_involutive]
  · intro hmem
    exact List.mem_map.2 ⟨alignJAdjNat (i, a), hmem, alignJAdjNat_involutive i a⟩

/-- The transposition `(i, i+1)` of `Γ*`, on a row.  A row that contains both `i` and `i+1`,
or neither, describes a set that the transposition fixes, and is left alone. -/
def alignJAdjRow (p : ℕ × List ℕ) : List ℕ :=
  if decide (p.1 ∈ p.2) = decide (p.1 + 1 ∈ p.2) then p.2
  else p.2.map (fun c => alignJAdjNat (p.1, c))

@[simp] theorem length_alignJAdjRow (i : ℕ) (row : List ℕ) :
    (alignJAdjRow (i, row)).length = row.length := by
  show (if decide (i ∈ row) = decide (i + 1 ∈ row) then row else _).length = _
  split <;> simp

theorem alignJAdjRow_involutive (i : ℕ) (row : List ℕ) :
    alignJAdjRow (i, alignJAdjRow (i, row)) = row := by
  by_cases hc : decide (i ∈ row) = decide (i + 1 ∈ row)
  · have hfix : alignJAdjRow (i, row) = row := by
      show (if decide (i ∈ row) = decide (i + 1 ∈ row) then row else _) = row
      rw [if_pos hc]
    rw [hfix, hfix]
  · have hmap : alignJAdjRow (i, row) = row.map (fun c => alignJAdjNat (i, c)) := by
      show (if decide (i ∈ row) = decide (i + 1 ∈ row) then row else _) = _
      rw [if_neg hc]
    have h0 : (i ∈ row.map (fun c => alignJAdjNat (i, c))) ↔ (i + 1 ∈ row) := by
      rw [mem_map_alignJAdjNat]
      show (if i = i then i + 1 else _) ∈ row ↔ _
      rw [if_pos rfl]
    have h1 : (i + 1 ∈ row.map (fun c => alignJAdjNat (i, c))) ↔ (i ∈ row) := by
      rw [mem_map_alignJAdjNat]
      show (if i + 1 = i then i + 1 else if i + 1 = i + 1 then i else i + 1) ∈ row ↔ _
      rw [if_neg (by omega), if_pos rfl]
    have hc' : ¬ (decide (i ∈ row.map (fun c => alignJAdjNat (i, c)))
        = decide (i + 1 ∈ row.map (fun c => alignJAdjNat (i, c)))) := by
      rw [decide_eq_decide, h0, h1]
      rw [decide_eq_decide] at hc
      exact fun hh => hc hh.symm
    have hid : (fun c => alignJAdjNat (i, c)) ∘ (fun c => alignJAdjNat (i, c)) = id :=
      funext (fun a => alignJAdjNat_involutive i a)
    rw [hmap]
    show (if decide (i ∈ row.map (fun c => alignJAdjNat (i, c)))
      = decide (i + 1 ∈ row.map (fun c => alignJAdjNat (i, c))) then _ else _) = row
    rw [if_neg hc', List.map_map, hid, List.map_id]

theorem alignJAdjRow_injective (i : ℕ) :
    Function.Injective (fun row => alignJAdjRow (i, row)) := by
  intro a b hab
  have hinv := alignJAdjRow_involutive i a
  rw [show alignJAdjRow (i, a) = alignJAdjRow (i, b) from hab,
    alignJAdjRow_involutive] at hinv
  exact hinv.symm

section AdjFin

variable {ms i : ℕ}

/-- The transposition `(i, i+1)` of `Γ* = [0, m*)`, as a permutation of `Fin m*`. -/
def alignJAdjFin (hi : i + 1 < ms) : Perm (Fin ms) :=
  Equiv.swap ⟨i, by omega⟩ ⟨i + 1, hi⟩

theorem val_alignJAdjFin (hi : i + 1 < ms) (j : Fin ms) :
    ((alignJAdjFin hi j : Fin ms) : ℕ) = alignJAdjNat (i, (j : ℕ)) := by
  rw [alignJAdjFin]
  by_cases h0 : j = (⟨i, by omega⟩ : Fin ms)
  · subst h0
    rw [Equiv.swap_apply_left]
    show (i + 1 : ℕ) = if i = i then i + 1 else _
    rw [if_pos rfl]
  by_cases h1 : j = (⟨i + 1, hi⟩ : Fin ms)
  · subst h1
    rw [Equiv.swap_apply_right]
    show (i : ℕ) = if i + 1 = i then i + 1 else if i + 1 = i + 1 then i else i + 1
    rw [if_neg (by omega), if_pos rfl]
  · rw [Equiv.swap_apply_of_ne_of_ne h0 h1]
    have k0 : (j : ℕ) ≠ i := fun hh => h0 (Fin.ext hh)
    have k1 : (j : ℕ) ≠ i + 1 := fun hh => h1 (Fin.ext hh)
    show (j : ℕ) = if (j : ℕ) = i then i + 1 else if (j : ℕ) = i + 1 then i else (j : ℕ)
    rw [if_neg k0, if_neg k1]

theorem sign_alignJAdjFin (hi : i + 1 < ms) :
    Equiv.Perm.sign (alignJAdjFin hi) = -1 := by
  rw [alignJAdjFin]
  exact Equiv.Perm.sign_swap (by simp [Fin.ext_iff])

/-- **The relabelled row describes the relabelled set.** -/
theorem rawJSet_alignJAdjRow (hi : i + 1 < ms) {row : List ℕ} (hlt : ∀ a ∈ row, a < ms) :
    rawJSet ms (alignJAdjRow (i, row)) = (rawJSet ms row).image (alignJAdjFin hi) := by
  classical
  show rawJSet ms (if decide (i ∈ row) = decide (i + 1 ∈ row) then row else _) = _
  split_ifs with hc
  · rw [alignJAdjFin, eq_comm, alignJ_image_swap_eq_iff]
    rw [decide_eq_decide] at hc
    exact ⟨fun hh => mem_rawJSet.2 (hc.1 (mem_rawJSet.1 hh)),
      fun hh => mem_rawJSet.2 (hc.2 (mem_rawJSet.1 hh))⟩
  · ext j
    simp only [mem_rawJSet, Finset.mem_image]
    constructor
    · intro hmem
      obtain ⟨a, ha, haj⟩ := List.mem_map.1 hmem
      exact ⟨⟨a, hlt a ha⟩, ha, Fin.ext (by rw [val_alignJAdjFin hi]; exact haj)⟩
    · rintro ⟨k, hk, rfl⟩
      rw [val_alignJAdjFin hi]
      exact List.mem_map.2 ⟨(k : ℕ), hk, rfl⟩

end AdjFin

/-- The same Johnson scheme with its rows relabelled by the transposition `(i, i+1)` of
`Γ*`. -/
def alignJAdjScheme (p : RawJohnson × ℕ) : RawJohnson :=
  (p.1.1, p.1.2.1, p.1.2.2.map (fun row => alignJAdjRow (p.2, row)))

@[simp] theorem alignJAdjScheme_fst (r : RawJohnson) (i : ℕ) :
    (alignJAdjScheme (r, i)).1 = r.1 := rfl

section AdjScheme

variable {m ms ts i : ℕ} {r : RawJohnson}

theorem alignJAdjScheme_wf (h : RawJohnson.WF m ms ts r) (hi : i + 1 < ms) :
    RawJohnson.WF m ms ts (alignJAdjScheme (r, i)) := by
  have hrows : ∀ row' ∈ (alignJAdjScheme (r, i)).2.2,
      ∃ row ∈ r.2.2, alignJAdjRow (i, row) = row' := by
    intro row' hrow'
    obtain ⟨row, hrow, hq⟩ := List.mem_map.1 hrow'
    exact ⟨row, hrow, hq⟩
  refine ⟨h.two_le, h.params, h.hdr, h.wLt, h.wNodup, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · show (r.2.2.map (fun row => alignJAdjRow (i, row))).length = r.1.length
    rw [List.length_map]; exact h.rowsLen
  · intro row' hrow'
    obtain ⟨row, hrow, rfl⟩ := hrows row' hrow'
    have hs := h.rowSorted row hrow
    show (if decide (i ∈ row) = decide (i + 1 ∈ row) then row
      else row.map (fun c => alignJAdjNat (i, c))).SortedLT
    split_ifs with hc
    · exact hs
    · rw [decide_eq_decide] at hc
      rw [List.sortedLT_iff_pairwise] at hs ⊢
      rw [List.pairwise_map]
      refine hs.imp_of_mem ?_
      intro a b ha hb hab
      by_cases h0 : i ∈ row
      · have h1 : i + 1 ∉ row := fun hh => hc ⟨fun _ => hh, fun _ => h0⟩
        exact alignJAdjNat_lt (i := i) hab
          (Or.inl ⟨fun hh => h1 (hh ▸ ha), fun hh => h1 (hh ▸ hb)⟩)
      · have h1 : i + 1 ∈ row := by
          by_contra hh
          exact hc ⟨fun kk => absurd kk h0, fun kk => absurd kk hh⟩
        exact alignJAdjNat_lt (i := i) hab
          (Or.inr ⟨fun hh => h0 (hh ▸ ha), fun hh => h0 (hh ▸ hb)⟩)
  · intro row' hrow'
    obtain ⟨row, hrow, rfl⟩ := hrows row' hrow'
    rw [length_alignJAdjRow]; exact h.rowLen row hrow
  · intro row' hrow' a ha
    obtain ⟨row, hrow, rfl⟩ := hrows row' hrow'
    show a < ms
    rw [show alignJAdjRow (i, row)
      = if decide (i ∈ row) = decide (i + 1 ∈ row) then row
        else row.map (fun c => alignJAdjNat (i, c)) from rfl] at ha
    split_ifs at ha with hc
    · exact h.rowLt row hrow a ha
    · obtain ⟨c, hcmem, rfl⟩ := List.mem_map.1 ha
      exact alignJAdjNat_le (h.rowLt row hrow c hcmem) hi
  · show (r.2.2.map (fun row => alignJAdjRow (i, row))).Nodup
    exact h.rowsNodup.map (alignJAdjRow_injective i)
  · show (r.2.2.map (fun row => alignJAdjRow (i, row))).length = _
    rw [List.length_map]; exact h.card

theorem rawJRow_alignJAdjScheme (h : RawJohnson.WF m ms ts r) (hi : i + 1 < ms) {w : ℕ}
    (hw : w ∈ r.1) :
    rawJRow (alignJAdjScheme (r, i), w) = alignJAdjRow (i, rawJRow (r, w)) := by
  obtain ⟨j, hj, hjw⟩ := List.getElem_of_mem hw
  have h' := alignJAdjScheme_wf h hi
  have e1 : rawJRow (alignJAdjScheme (r, i), w)
      = (r.2.2.map (fun row => alignJAdjRow (i, row)))[j]'
        (by rw [List.length_map, h.rowsLen]; exact hj) := by
    rw [← hjw]
    exact h'.rawJRow_getElem (show j < (alignJAdjScheme (r, i)).1.length from hj)
  have e2 : rawJRow (r, w) = r.2.2[j]'(by rw [h.rowsLen]; exact hj) := by
    rw [← hjw]
    exact h.rawJRow_getElem hj
  rw [e1, e2]
  simp

/-- **The relabelled scheme is the same structure.**  Relabelling `Γ*` does not change which
points lie in `W`, and it does not change the Johnson color of a pair, because a bijection of
`Γ*` does not change `|S ∖ T|`. -/
theorem decJohnson_alignJAdjScheme (h : RawJohnson.WF m ms ts r) (hi : i + 1 < ms) :
    decJohnson m (alignJAdjScheme (r, i)) = decJohnson m r := by
  classical
  have h' := alignJAdjScheme_wf h hi
  refine Babai.ColStruct.ext (funext fun u => ?_) (funext fun u => funext fun v => ?_)
  · rfl
  · by_cases hu : (u : ℕ) ∈ r.1
    · by_cases hv : (v : ℕ) ∈ r.1
      · have hu' : (u : ℕ) ∈ (alignJAdjScheme (r, i)).1 := hu
        have hv' : (v : ℕ) ∈ (alignJAdjScheme (r, i)).1 := hv
        rw [decJohnson_ecol_mem m _ hu' hv', decJohnson_ecol_mem m r hu hv,
          rawJDiff_eq_card (ms := ms) (h'.rowNodup (h'.rawJRow_mem hu'))
            (h'.rowLt _ (h'.rawJRow_mem hu')),
          rawJDiff_eq_card (ms := ms) (h.rowNodup (h.rawJRow_mem hu))
            (h.rowLt _ (h.rawJRow_mem hu)),
          rawJRow_alignJAdjScheme h hi hu, rawJRow_alignJAdjScheme h hi hv,
          rawJSet_alignJAdjRow hi (h.rowLt _ (h.rawJRow_mem hu)),
          rawJSet_alignJAdjRow hi (h.rowLt _ (h.rawJRow_mem hv)),
          ← Finset.image_sdiff _ _ (alignJAdjFin hi).injective,
          Finset.card_image_of_injective _ (alignJAdjFin hi).injective]
      · show (if _ ∈ r.1 then (if _ ∈ r.1 then _ else 0) else 0)
          = (if _ ∈ r.1 then (if _ ∈ r.1 then _ else 0) else 0)
        rw [if_neg hv, if_neg hv]
    · show (if _ ∈ r.1 then _ else 0) = (if _ ∈ r.1 then _ else 0)
      rw [if_neg hu, if_neg hu]

end AdjScheme

/-! ## The automorphism of `X` induced by a permutation of `Γ*`

The map `π ↦` (the automorphism of `X` that `π` induces) is a group homomorphism, because it
is the composition of `Babai.tAction`, the identification of `W` with the `t*`-subsets of
`Γ*`, and the extension by the identity outside `W`. -/

/-- Conjugation of permutations by an equivalence, as a group homomorphism. -/
def alignJCongrHom {α β : Type*} (e : α ≃ β) : Perm α →* Perm β where
  toFun := e.permCongr
  map_one' := by ext x; simp
  map_mul' p q := by ext x; simp [Equiv.permCongr_apply]

section Hom

variable {m ms ts : ℕ} {r : RawJohnson}

/-- The action on `W` of the automorphism induced by `π`. -/
noncomputable def alignJAutSub (h : RawJohnson.WF m ms ts r) (π : Perm (Fin ms)) :
    Perm {u : Fin m // (u : ℕ) ∈ r.1} :=
  alignJCongrHom (alignJEquiv h).symm (Babai.tAction ts π)

/-- §14.1, line 2 (iv).  **The automorphism of `X` induced by a permutation of `Γ*`**, as a
group homomorphism `S(Γ*) → S(Γ)`. -/
noncomputable def alignJAutHom (h : RawJohnson.WF m ms ts r) :
    Perm (Fin ms) →* Perm (Fin m) :=
  (Equiv.Perm.ofSubtype (p := fun u : Fin m => (u : ℕ) ∈ r.1)).comp
    ((alignJCongrHom (alignJEquiv h).symm).comp (Babai.tAction ts))

theorem alignJAutHom_of_mem (h : RawJohnson.WF m ms ts r) (π : Perm (Fin ms)) {u : Fin m}
    (hu : (u : ℕ) ∈ r.1) :
    alignJAutHom h π u = ((alignJAutSub h π ⟨u, hu⟩ : {u : Fin m // (u : ℕ) ∈ r.1}) : Fin m) :=
  Equiv.Perm.ofSubtype_apply_of_mem (alignJAutSub h π) hu

theorem alignJAutHom_of_not_mem (h : RawJohnson.WF m ms ts r) (π : Perm (Fin ms)) {u : Fin m}
    (hu : (u : ℕ) ∉ r.1) : alignJAutHom h π u = u :=
  Equiv.Perm.ofSubtype_apply_of_not_mem (alignJAutSub h π) hu

theorem alignJAutHom_mem (h : RawJohnson.WF m ms ts r) (π : Perm (Fin ms)) {u : Fin m}
    (hu : (u : ℕ) ∈ r.1) : ((alignJAutHom h π u : Fin m) : ℕ) ∈ r.1 := by
  rw [alignJAutHom_of_mem h π hu]
  exact (alignJAutSub h π ⟨u, hu⟩).2

/-- **The rows of the image**: the automorphism induced by `π` relabels the rows by `π`. -/
theorem alignJAutHom_row (h : RawJohnson.WF m ms ts r) (π : Perm (Fin ms)) {u : Fin m}
    (hu : (u : ℕ) ∈ r.1) :
    rawJSet ms (rawJRow (r, ((alignJAutHom h π u : Fin m) : ℕ)))
      = (rawJSet ms (rawJRow (r, (u : ℕ)))).image π := by
  have hstep : alignJEquiv h (alignJAutSub h π ⟨u, hu⟩)
      = Babai.tAction ts π (alignJEquiv h ⟨u, hu⟩) := by
    show alignJEquiv h ((alignJEquiv h).symm.permCongr (Babai.tAction ts π) ⟨u, hu⟩)
      = Babai.tAction ts π (alignJEquiv h ⟨u, hu⟩)
    rw [Equiv.permCongr_apply, Equiv.symm_symm, Equiv.apply_symm_apply]
  rw [alignJAutHom_of_mem h π hu, ← alignJEquiv_coe h (alignJAutSub h π ⟨u, hu⟩), hstep,
    Babai.tAction_apply_coe, alignJEquiv_coe h ⟨u, hu⟩]

/-- **Two automorphisms with the same rows agree on `W`**: a point of `W` is determined by
its row. -/
theorem alignJ_eq_on_W (h : RawJohnson.WF m ms ts r) {f g : Perm (Fin m)}
    (hf : ∀ u : Fin m, (u : ℕ) ∈ r.1 → ((f u : Fin m) : ℕ) ∈ r.1)
    (hg : ∀ u : Fin m, (u : ℕ) ∈ r.1 → ((g u : Fin m) : ℕ) ∈ r.1)
    (hrow : ∀ u : Fin m, (u : ℕ) ∈ r.1 →
      rawJSet ms (rawJRow (r, ((f u : Fin m) : ℕ)))
        = rawJSet ms (rawJRow (r, ((g u : Fin m) : ℕ))))
    {u : Fin m} (hu : (u : ℕ) ∈ r.1) : f u = g u := by
  have hb := h.toBinom_bijective.1
    (a₁ := (⟨_, hf u hu⟩ : RawJohnson.carrier m r))
    (a₂ := (⟨_, hg u hu⟩ : RawJohnson.carrier m r))
    (Subtype.ext (hrow u hu))
  exact congrArg Subtype.val hb

/-- §14.1, line 2 (iv).  **The induced permutation is an automorphism of `X`, and its sign is
the sign of the action of `π` on the `t*`-subsets.** -/
theorem alignJAutHom_spec (h : RawJohnson.WF m ms ts r) (π : Perm (Fin ms)) :
    alignJAutHom h π ∈ Babai.structAut (decJohnson m r) ∧
      Equiv.Perm.sign (alignJAutHom h π) = Equiv.Perm.sign (Babai.tAction ts π) := by
  obtain ⟨f, hfaut, hfsign, hfout, hfrow⟩ := alignJ_aut_of_perm h π
  have heq : alignJAutHom h π = f := by
    refine Equiv.ext (fun u => ?_)
    by_cases hu : (u : ℕ) ∈ r.1
    · exact alignJ_eq_on_W h (fun v hv => alignJAutHom_mem h π hv)
        (fun v hv => ((mem_structAut_decJohnson_iff.1 hfaut).1 v).2 hv)
        (fun v hv => by rw [alignJAutHom_row h π hv, hfrow v hv]) hu
    · rw [alignJAutHom_of_not_mem h π hu, hfout u hu]
  rw [heq]
  exact ⟨hfaut, hfsign⟩

/-- §14.1, line 7 (B).  **Prop. 3.2.11 in raw words**: the action of an automorphism of `X`
on the rows is the action of a permutation of `Γ*`. -/
theorem alignJ_restrict_perm (h : RawJohnson.WF m ms ts r) {f : Perm (Fin m)}
    (hf : f ∈ Babai.structAut (decJohnson m r)) :
    ∃ π : Perm (Fin ms), ∀ u : Fin m, (u : ℕ) ∈ r.1 →
      rawJSet ms (rawJRow (r, ((f u : Fin m) : ℕ)))
        = (rawJSet ms (rawJRow (r, (u : ℕ)))).image π := by
  classical
  obtain ⟨hmem, hecol⟩ := mem_structAut_decJohnson_iff.1 hf
  set fW : Perm {u : Fin m // (u : ℕ) ∈ r.1} :=
    Equiv.Perm.subtypePerm (p := fun u : Fin m => (u : ℕ) ∈ r.1) f (fun u => hmem u)
    with hfWdef
  set e := alignJEquiv h with hedef
  set σ : Perm (Babai.binom (Fin ms) ts) := e.permCongr fW with hσdef
  have hcoe : ∀ u : {u : Fin m // (u : ℕ) ∈ r.1},
      ((σ (e u) : Babai.binom (Fin ms) ts) : Finset (Fin ms))
        = rawJSet ms (rawJRow (r, ((f (u : Fin m) : Fin m) : ℕ))) := by
    intro u
    have hstep : σ (e u) = e (fW u) := by
      rw [hσdef, Equiv.permCongr_apply, Equiv.symm_apply_apply]
    rw [hstep, alignJEquiv_coe]
    rfl
  have hpres : ∀ S T : Babai.binom (Fin ms) ts,
      (((σ S : Babai.binom (Fin ms) ts) : Finset (Fin ms)) \
        ((σ T : Babai.binom (Fin ms) ts) : Finset (Fin ms))).card
        = (((S : Babai.binom (Fin ms) ts) : Finset (Fin ms)) \
          ((T : Babai.binom (Fin ms) ts) : Finset (Fin ms))).card := by
    intro S T
    obtain ⟨u, rfl⟩ : ∃ u, e u = S := ⟨e.symm S, e.apply_symm_apply S⟩
    obtain ⟨v, rfl⟩ : ∃ v, e v = T := ⟨e.symm T, e.apply_symm_apply T⟩
    rw [hcoe u, hcoe v, alignJEquiv_coe, alignJEquiv_coe,
      ← rawJDiff_eq_card (ms := ms) (h.rowNodup (h.rawJRow_mem ((hmem _).2 u.2)))
        (h.rowLt _ (h.rawJRow_mem ((hmem _).2 u.2))),
      ← rawJDiff_eq_card (ms := ms) (h.rowNodup (h.rawJRow_mem u.2))
        (h.rowLt _ (h.rawJRow_mem u.2))]
    exact hecol (u : Fin m) (v : Fin m) u.2 v.2
  have haut : σ ∈ (Babai.johnsonGraph (Fin ms) ts).Aut := by
    refine Babai.Digraph.mem_aut.2 (fun S T => ?_)
    show ((((σ S : Babai.binom (Fin ms) ts) : Finset (Fin ms)) \
      ((σ T : Babai.binom (Fin ms) ts) : Finset (Fin ms))).card = 1) ↔ _
    rw [hpres S T]
    rfl
  have hparams : Babai.IsJohnsonGraphParams (Fin ms) ts :=
    ⟨h.two_le, by rw [Fintype.card_fin]; exact h.params⟩
  rw [Babai.aut_johnsonGraph ts hparams] at haut
  obtain ⟨π, -, hπ⟩ := Subgroup.mem_map.1 haut
  refine ⟨π, fun u hu => ?_⟩
  have hu' := hcoe ⟨u, hu⟩
  rw [← hu', ← hπ, Babai.tAction_apply_coe, alignJEquiv_coe]

/-- A permutation that fixes `W` pointwise is a product of transpositions outside `W`. -/
theorem alignJ_fixW_mem (H : Subgroup (Perm (Fin m)))
    (hswap : ∀ a b : Fin m, (a : ℕ) ∉ r.1 → (b : ℕ) ∉ r.1 → Equiv.swap a b ∈ H)
    {g : Perm (Fin m)} (hg : ∀ u : Fin m, (u : ℕ) ∈ r.1 → g u = u) : g ∈ H := by
  suffices hmain : ∀ k (c : Perm (Fin m)), c.support.card = k →
      (∀ u : Fin m, (u : ℕ) ∈ r.1 → c u = u) → c ∈ H by
    exact hmain _ g rfl hg
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
    intro c hcard hcfix
    by_cases hc1 : c = 1
    · subst hc1; exact H.one_mem
    obtain ⟨a, ha⟩ : ∃ a : Fin m, c a ≠ a := by
      by_contra hh
      exact hc1 (Equiv.ext (fun a => not_not.1 (fun hk => hh ⟨a, hk⟩)))
    have haW : (a : ℕ) ∉ r.1 := fun hh => ha (hcfix a hh)
    have hcaW : ((c a : Fin m) : ℕ) ∉ r.1 := by
      intro hh
      exact ha (c.injective (hcfix (c a) hh))
    have hsmall : (Equiv.swap a (c a) * c).support.card < k := by
      rw [← hcard]
      exact Equiv.Perm.card_support_swap_mul ha
    have hfix' : ∀ u : Fin m, (u : ℕ) ∈ r.1 → (Equiv.swap a (c a) * c) u = u := by
      intro u hu
      show Equiv.swap a (c a) (c u) = u
      rw [hcfix u hu]
      exact Equiv.swap_apply_of_ne_of_ne (fun hh => haW (hh ▸ hu)) (fun hh => hcaW (hh ▸ hu))
    have hmem := ih _ hsmall (Equiv.swap a (c a) * c) rfl hfix'
    have hprod := H.mul_mem (hswap a (c a) haW hcaW) hmem
    simpa [← mul_assoc] using hprod

end Hom

/-! ## The symmetric group from its adjacent transpositions -/

/-- **Induction along the adjacent transpositions**: they generate `S(Γ*)`. -/
theorem alignJ_perm_induction {ms : ℕ} (hms : 1 ≤ ms) {P : Perm (Fin ms) → Prop}
    (hone : P 1) (hmul : ∀ a b, P a → P b → P (a * b))
    (hswap : ∀ (i : ℕ) (hi : i + 1 < ms), P (alignJAdjFin hi)) :
    ∀ π, P π := by
  obtain ⟨n, rfl⟩ : ∃ n, ms = n + 1 := ⟨ms - 1, by omega⟩
  intro π
  have hmem : π ∈ Submonoid.closure
      (Set.range fun i : Fin n => Equiv.swap i.castSucc i.succ) := by
    rw [Equiv.Perm.mclosure_swap_castSucc_succ n]
    trivial
  induction hmem using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    have hi : (i : ℕ) + 1 < n + 1 := by omega
    have e1 : Fin.castSucc i = (⟨(i : ℕ), by omega⟩ : Fin (n + 1)) := Fin.ext (by simp)
    have e2 : Fin.succ i = (⟨(i : ℕ) + 1, hi⟩ : Fin (n + 1)) := Fin.ext (by simp)
    show P (Equiv.swap (Fin.castSucc i) (Fin.succ i))
    rw [e1, e2]
    exact hswap (i : ℕ) hi
  | one => exact hone
  | mul x y _ _ hx hy => exact hmul x y hx hy

/-! ## The generators, on raw data -/

/-- §14.1, line 2 (iv).  **One generator per point `i` of `Γ`**: the automorphism of `X`
induced by the transposition `(i, i+1)` of `Γ*`, and the identity when `i + 1` is not a point
of `Γ*`. -/
def alignJAdjGen (p : (List ℕ × RawJohnson) × ℕ) : RawPerm :=
  if p.2 + 1 < rawJDeg p.1.2 then
    alignJPerm (p.1.1, (p.1.2, alignJAdjScheme (p.1.2, p.2)))
  else rawOne p.1.1

/-- §14.1, line 2 (iv).  **One generator per ordered pair of points of `Γ`**: the
transposition of the two points when both lie outside `W`, and the identity otherwise. -/
def alignJOutGen (p : (List ℕ × RawJohnson) × ℕ × ℕ) : RawPerm :=
  if p.2.1 ∈ p.1.2.1 ∨ p.2.2 ∈ p.1.2.1 then rawOne p.1.1
  else rawTopSwap (p.1.1, p.2)

/-- §14.1, line 2 (iv).  **Generators of `Aut(X)`** for a Johnson scheme `X`. -/
def alignJAutGens (p : List ℕ × RawJohnson) : RawGens :=
  (List.range p.1.length).map (fun i => alignJAdjGen (p, i))
    ++ (cpPairs (List.range p.1.length)).map (fun q => alignJOutGen (p, q))

section Gens

variable {m ms ts i : ℕ} {dom : List ℕ} {r : RawJohnson}

theorem mem_alignJAutGens_adj (hi : i < dom.length) :
    alignJAdjGen ((dom, r), i) ∈ alignJAutGens (dom, r) :=
  List.mem_append_left _ (List.mem_map.2 ⟨i, List.mem_range.2 hi, rfl⟩)

theorem mem_alignJAutGens_out {a b : ℕ} (ha : a < dom.length) (hb : b < dom.length) :
    alignJOutGen ((dom, r), (a, b)) ∈ alignJAutGens (dom, r) :=
  List.mem_append_right _ (List.mem_map.2 ⟨(a, b),
    mem_cpPairs.2 ⟨List.mem_range.2 ha, List.mem_range.2 hb⟩, rfl⟩)

/-- The generator for `i` is the aligning permutation to the relabelled scheme. -/
theorem alignJAdjGen_eq (h : RawJohnson.WF m ms ts r) (hi : i + 1 < ms) :
    alignJAdjGen ((dom, r), i) = alignJPerm (dom, (r, alignJAdjScheme (r, i))) := by
  show (if i + 1 < rawJDeg r then _ else _) = _
  rw [if_pos (by rw [h.rawJDeg_eq]; exact hi)]

theorem alignJAdjGen_of_ge (h : RawJohnson.WF m ms ts r) (hi : ¬ i + 1 < ms) :
    alignJAdjGen ((dom, r), i) = rawOne dom := by
  show (if i + 1 < rawJDeg r then _ else _) = _
  rw [if_neg (by rw [h.rawJDeg_eq]; exact hi)]

/-- **Each `Γ*`-generator is an automorphism of `X`.** -/
theorem alignJAdjGen_spec (hd : dom.length = m) (h : RawJohnson.WF m ms ts r) (i : ℕ) :
    RawPerm.WF m (alignJAdjGen ((dom, r), i)) ∧
      decPerm m (alignJAdjGen ((dom, r), i)) ∈ Babai.structAut (decJohnson m r) := by
  by_cases hi : i + 1 < ms
  · have h' := alignJAdjScheme_wf h hi
    rw [alignJAdjGen_eq h hi]
    refine ⟨alignJPerm_wf hd h h', ?_⟩
    have hsmul := alignJPerm_smul hd h h'
    rw [decJohnson_alignJAdjScheme h hi] at hsmul
    exact Babai.mem_structAut.2 hsmul
  · rw [alignJAdjGen_of_ge h hi, rawOne_eq, hd, decPerm_encPerm]
    exact ⟨wf_encPerm m 1, (Babai.structAut (decJohnson m r)).one_mem⟩

/-- **The `Γ*`-generator for `i` relabels the rows by the transposition `(i, i+1)`.** -/
theorem alignJAdjGen_row (hd : dom.length = m) (h : RawJohnson.WF m ms ts r)
    (hi : i + 1 < ms) {u : Fin m} (hu : (u : ℕ) ∈ r.1) :
    rawJSet ms (rawJRow (r,
        ((decPerm m (alignJAdjGen ((dom, r), i)) u : Fin m) : ℕ)))
      = (rawJSet ms (rawJRow (r, (u : ℕ)))).image (alignJAdjFin hi) := by
  have h' := alignJAdjScheme_wf h hi
  have hwf := alignJPerm_wf hd h h'
  have himg : ((decPerm m (alignJPerm (dom, (r, alignJAdjScheme (r, i)))) u : Fin m) : ℕ)
      = alignJMatch ((dom, (r, alignJAdjScheme (r, i))), (u : ℕ)) := by
    rw [← labAt_eq_decPerm hwf u.isLt, labAt_alignJPerm hd u.isLt]
  obtain ⟨hmem, hrow⟩ := alignJMatch_mem (dom := dom) h h' hu
  have hmem' : alignJMatch ((dom, (r, alignJAdjScheme (r, i))), (u : ℕ)) ∈ r.1 := hmem
  rw [rawJRow_alignJAdjScheme h hi hmem'] at hrow
  have hrow' : rawJRow (r, alignJMatch ((dom, (r, alignJAdjScheme (r, i))), (u : ℕ)))
      = alignJAdjRow (i, rawJRow (r, (u : ℕ))) := by
    rw [← hrow, alignJAdjRow_involutive]
  rw [alignJAdjGen_eq h hi, himg, hrow',
    rawJSet_alignJAdjRow hi (h.rowLt _ (h.rawJRow_mem hu))]

/-- **Each pair generator is an automorphism of `X`.** -/
theorem alignJOutGen_spec (hd : dom.length = m) (h : RawJohnson.WF m ms ts r) {a b : ℕ}
    (ha : a < m) (hb : b < m) :
    RawPerm.WF m (alignJOutGen ((dom, r), (a, b))) ∧
      decPerm m (alignJOutGen ((dom, r), (a, b))) ∈ Babai.structAut (decJohnson m r) := by
  by_cases hc : a ∈ r.1 ∨ b ∈ r.1
  · have he : alignJOutGen ((dom, r), (a, b)) = rawOne dom := by
      show (if a ∈ r.1 ∨ b ∈ r.1 then _ else _) = _
      rw [if_pos hc]
    rw [he, rawOne_eq, hd, decPerm_encPerm]
    exact ⟨wf_encPerm m 1, (Babai.structAut (decJohnson m r)).one_mem⟩
  · have he : alignJOutGen ((dom, r), (a, b))
        = encPerm m (Equiv.swap (⟨a, ha⟩ : Fin m) ⟨b, hb⟩) := by
      show (if a ∈ r.1 ∨ b ∈ r.1 then _ else _) = _
      rw [if_neg hc]
      exact rawTopSwap_spec hd ⟨a, ha⟩ ⟨b, hb⟩
    rw [he, decPerm_encPerm]
    exact ⟨wf_encPerm _ _, alignJ_swap_out_mem_structAut
      (fun hh => hc (Or.inl hh)) (fun hh => hc (Or.inr hh))⟩

/-- The generators are well formed. -/
theorem alignJAutGens_wf (hd : dom.length = m) (h : RawJohnson.WF m ms ts r) :
    RawGens.WF m (alignJAutGens (dom, r)) := by
  intro g hg
  rcases List.mem_append.1 hg with hg | hg
  · obtain ⟨i, -, rfl⟩ := List.mem_map.1 hg
    exact (alignJAdjGen_spec hd h i).1
  · obtain ⟨⟨a, b⟩, hq, rfl⟩ := List.mem_map.1 hg
    obtain ⟨ha, hb⟩ := mem_cpPairs.1 hq
    exact (alignJOutGen_spec hd h (hd ▸ List.mem_range.1 ha) (hd ▸ List.mem_range.1 hb)).1

/-- §14.1, line 2 (iv).  **The computed list generates `Aut(X)`.** -/
theorem decGroup_alignJAutGens (hd : dom.length = m) (h : RawJohnson.WF m ms ts r) :
    decGroup m (alignJAutGens (dom, r)) = Babai.structAut (decJohnson m r) := by
  classical
  set H := decGroup m (alignJAutGens (dom, r)) with hHdef
  -- the transpositions outside `W` lie in `H`
  have hswapH : ∀ a b : Fin m, (a : ℕ) ∉ r.1 → (b : ℕ) ∉ r.1 → Equiv.swap a b ∈ H := by
    intro a b ha hb
    have hmem : alignJOutGen ((dom, r), ((a : ℕ), (b : ℕ))) ∈ alignJAutGens (dom, r) :=
      mem_alignJAutGens_out (by rw [hd]; exact a.isLt) (by rw [hd]; exact b.isLt)
    have he : alignJOutGen ((dom, r), ((a : ℕ), (b : ℕ))) = encPerm m (Equiv.swap a b) := by
      show (if (a : ℕ) ∈ r.1 ∨ (b : ℕ) ∈ r.1 then _ else _) = _
      rw [if_neg (fun hh => by rcases hh with hh | hh; exacts [ha hh, hb hh])]
      exact rawTopSwap_spec hd a b
    have hx : decPerm m (alignJOutGen ((dom, r), ((a : ℕ), (b : ℕ)))) ∈ H :=
      Subgroup.subset_closure (List.mem_map.2 ⟨_, hmem, rfl⟩)
    rwa [he, decPerm_encPerm] at hx
  -- the induced automorphisms lie in `H`
  have hhom : ∀ π : Perm (Fin ms), alignJAutHom h π ∈ H := by
    refine alignJ_perm_induction (by have := h.two_le; have := h.params; omega)
      ?_ ?_ ?_
    · rw [map_one]; exact H.one_mem
    · intro a b hga hgb
      rw [map_mul]
      exact H.mul_mem hga hgb
    · intro i hi
      have hig : i < dom.length := by
        have := alignJ_deg_le h
        omega
      have hgH : decPerm m (alignJAdjGen ((dom, r), i)) ∈ H :=
        Subgroup.subset_closure (List.mem_map.2 ⟨_, mem_alignJAutGens_adj hig, rfl⟩)
      set g := decPerm m (alignJAdjGen ((dom, r), i)) with hgdef
      have hgaut : g ∈ Babai.structAut (decJohnson m r) := (alignJAdjGen_spec hd h i).2
      have hgW : ∀ u : Fin m, (u : ℕ) ∈ r.1 → ((g u : Fin m) : ℕ) ∈ r.1 :=
        fun u hu => ((mem_structAut_decJohnson_iff.1 hgaut).1 u).2 hu
      have hsame : ∀ u : Fin m, (u : ℕ) ∈ r.1 → alignJAutHom h (alignJAdjFin hi) u = g u := by
        intro u hu
        exact alignJ_eq_on_W h (fun v hv => alignJAutHom_mem h _ hv) hgW
          (fun v hv => by
            rw [alignJAutHom_row h _ hv, alignJAdjGen_row hd h hi hv]) hu
      have hfix : ∀ u : Fin m, (u : ℕ) ∈ r.1 →
          (g⁻¹ * alignJAutHom h (alignJAdjFin hi)) u = u := by
        intro u hu
        show g⁻¹ (alignJAutHom h (alignJAdjFin hi) u) = u
        rw [hsame u hu]
        exact Equiv.symm_apply_apply g u
      have hk := alignJ_fixW_mem (r := r) H hswapH hfix
      have : alignJAutHom h (alignJAdjFin hi)
          = g * (g⁻¹ * alignJAutHom h (alignJAdjFin hi)) := by group
      rw [this]
      exact H.mul_mem hgH hk
  apply le_antisymm
  · refine (Subgroup.closure_le _).2 ?_
    rintro s hs
    obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hs
    rcases List.mem_append.1 hg with hg | hg
    · obtain ⟨i, -, rfl⟩ := List.mem_map.1 hg
      exact (alignJAdjGen_spec hd h i).2
    · obtain ⟨⟨a, b⟩, hq, rfl⟩ := List.mem_map.1 hg
      obtain ⟨ha, hb⟩ := mem_cpPairs.1 hq
      exact (alignJOutGen_spec hd h (hd ▸ List.mem_range.1 ha)
        (hd ▸ List.mem_range.1 hb)).2
  · intro f hf
    obtain ⟨π, hπ⟩ := alignJ_restrict_perm h hf
    have hfW : ∀ u : Fin m, (u : ℕ) ∈ r.1 → ((f u : Fin m) : ℕ) ∈ r.1 :=
      fun u hu => ((mem_structAut_decJohnson_iff.1 hf).1 u).2 hu
    have hsame : ∀ u : Fin m, (u : ℕ) ∈ r.1 → f u = alignJAutHom h π u := by
      intro u hu
      exact alignJ_eq_on_W h hfW (fun v hv => alignJAutHom_mem h π hv)
        (fun v hv => by rw [hπ v hv, alignJAutHom_row h π hv]) hu
    have hfix : ∀ u : Fin m, (u : ℕ) ∈ r.1 → ((alignJAutHom h π)⁻¹ * f) u = u := by
      intro u hu
      show (alignJAutHom h π)⁻¹ (f u) = u
      rw [hsame u hu]
      exact Equiv.symm_apply_apply _ u
    have hk := alignJ_fixW_mem (r := r) H hswapH hfix
    have hsplit : f = alignJAutHom h π * ((alignJAutHom h π)⁻¹ * f) := by group
    rw [hsplit]
    exact H.mul_mem (hhom π) hk

end Gens

/-! ## The running time -/

theorem polyFun_alignJAdjNat : PolyFun alignJAdjNat := by
  have hsucc : PolyFun (fun p : ℕ × ℕ => p.1 + 1) :=
    (polyFun_fst.pair (polyFun_const 1)).comp polyFun_add
  refine (PolyFun.ite ((polyFun_snd.pair polyFun_fst).comp polyFun_natEq)
    hsucc
    (PolyFun.ite ((polyFun_snd.pair hsucc).comp polyFun_natEq)
      polyFun_fst polyFun_snd)).of_eq (fun p => ?_)
  show _ = (if p.2 = p.1 then p.1 + 1 else if p.2 = p.1 + 1 then p.1 else p.2)
  by_cases h0 : p.2 = p.1 <;> by_cases h1 : p.2 = p.1 + 1 <;> simp [h0, h1]

theorem polyFun_alignJAdjRow : PolyFun alignJAdjRow := by
  have hsucc : PolyFun (fun p : ℕ × List ℕ => p.1 + 1) :=
    (polyFun_fst.pair (polyFun_const 1)).comp polyFun_add
  have hm0 : PolyFun (fun p : ℕ × List ℕ => decide (p.1 ∈ p.2)) := polyFun_natListMem
  have hm1 : PolyFun (fun p : ℕ × List ℕ => decide (p.1 + 1 ∈ p.2)) :=
    (hsucc.pair polyFun_snd).comp polyFun_natListMem
  have htest : PolyFun (fun p : ℕ × List ℕ =>
      decide (decide (p.1 ∈ p.2) = decide (p.1 + 1 ∈ p.2))) := by
    refine (PolyFun.ite hm0 hm1 (polyFun_rawJNot hm1)).of_eq (fun p => ?_)
    by_cases h0 : p.1 ∈ p.2 <;> by_cases h1 : p.1 + 1 ∈ p.2 <;> simp [h0, h1]
  have hmap : PolyFun (fun p : ℕ × List ℕ => p.2.map (fun c => alignJAdjNat (p.1, c))) :=
    PolyFun.mapParam polyFun_alignJAdjNat
  refine (PolyFun.ite htest polyFun_snd hmap).of_eq (fun p => ?_)
  show _ = (if decide (p.1 ∈ p.2) = decide (p.1 + 1 ∈ p.2) then p.2 else _)
  by_cases hc : decide (p.1 ∈ p.2) = decide (p.1 + 1 ∈ p.2) <;> simp [hc]

theorem polyFun_alignJAdjScheme : PolyFun alignJAdjScheme := by
  have hrows : PolyFun (fun p : RawJohnson × ℕ =>
      p.1.2.2.map (fun row => alignJAdjRow (p.2, row))) :=
    (polyFun_snd.pair ((polyFun_fst.comp polyFun_snd).comp polyFun_snd)).comp
      (PolyFun.mapParam polyFun_alignJAdjRow)
  exact (((polyFun_fst.comp polyFun_fst).pair
    (((polyFun_fst.comp polyFun_snd).comp polyFun_fst).pair hrows))).of_eq (fun _ => rfl)

theorem polyFun_alignJAdjGen : PolyFun alignJAdjGen := by
  have hsucc : PolyFun (fun p : (List ℕ × RawJohnson) × ℕ => p.2 + 1) :=
    (polyFun_snd.pair (polyFun_const 1)).comp polyFun_add
  have hdeg : PolyFun (fun p : (List ℕ × RawJohnson) × ℕ => rawJDeg p.1.2) :=
    (polyFun_fst.comp polyFun_snd).comp polyFun_rawJDeg
  have htest : PolyFun (fun p : (List ℕ × RawJohnson) × ℕ =>
      decide (p.2 + 1 < rawJDeg p.1.2)) := by
    refine ((hsucc.pair ((hdeg.pair (polyFun_const 1)).comp polyFun_sub)).comp
      polyFun_le).of_eq (fun p => ?_)
    by_cases hc : p.2 + 1 < rawJDeg p.1.2
    · have h1 : p.2 + 1 ≤ rawJDeg p.1.2 - 1 := by omega
      simp [hc, h1]
    · have h1 : ¬ (p.2 + 1 ≤ rawJDeg p.1.2 - 1) := by omega
      simp [hc, h1]
  have hyes : PolyFun (fun p : (List ℕ × RawJohnson) × ℕ =>
      alignJPerm (p.1.1, (p.1.2, alignJAdjScheme (p.1.2, p.2)))) :=
    (((polyFun_fst.comp polyFun_fst).pair
      ((polyFun_fst.comp polyFun_snd).pair
        (((polyFun_fst.comp polyFun_snd).pair polyFun_snd).comp
          polyFun_alignJAdjScheme)))).comp polyFun_alignJPerm
  have hno : PolyFun (fun p : (List ℕ × RawJohnson) × ℕ => rawOne p.1.1) :=
    (polyFun_fst.comp polyFun_fst).comp polyFun_rawOne
  refine (PolyFun.ite htest hyes hno).of_eq (fun p => ?_)
  show _ = (if p.2 + 1 < rawJDeg p.1.2 then _ else _)
  by_cases hc : p.2 + 1 < rawJDeg p.1.2 <;> simp [hc]

theorem polyFun_alignJOutGen : PolyFun alignJOutGen := by
  have hm1 : PolyFun (fun p : (List ℕ × RawJohnson) × ℕ × ℕ => decide (p.2.1 ∈ p.1.2.1)) :=
    ((polyFun_snd.comp polyFun_fst).pair
      ((polyFun_fst.comp polyFun_snd).comp polyFun_fst)).comp polyFun_natListMem
  have hm2 : PolyFun (fun p : (List ℕ × RawJohnson) × ℕ × ℕ => decide (p.2.2 ∈ p.1.2.1)) :=
    ((polyFun_snd.comp polyFun_snd).pair
      ((polyFun_fst.comp polyFun_snd).comp polyFun_fst)).comp polyFun_natListMem
  have hone : PolyFun (fun p : (List ℕ × RawJohnson) × ℕ × ℕ => rawOne p.1.1) :=
    (polyFun_fst.comp polyFun_fst).comp polyFun_rawOne
  have hswap : PolyFun (fun p : (List ℕ × RawJohnson) × ℕ × ℕ => rawTopSwap (p.1.1, p.2)) :=
    ((polyFun_fst.comp polyFun_fst).pair polyFun_snd).comp polyFun_rawTopSwap
  refine (PolyFun.ite (polyFun_rawJOr hm1 hm2) hone hswap).of_eq (fun p => ?_)
  show _ = (if p.2.1 ∈ p.1.2.1 ∨ p.2.2 ∈ p.1.2.1 then _ else _)
  by_cases h1 : p.2.1 ∈ p.1.2.1 <;> by_cases h2 : p.2.2 ∈ p.1.2.1 <;> simp [h1, h2]

/-- §14.1, line 2 (iv): the generators of `Aut(X)` for a Johnson scheme **are computed in
polynomial time**. -/
theorem polyFun_alignJAutGens : PolyFun alignJAutGens := by
  have hadj : PolyFun (fun p : List ℕ × RawJohnson =>
      (List.range p.1.length).map (fun i => alignJAdjGen (p, i))) :=
    (polyFun_id.pair (polyFun_fst.comp polyFun_rangeLength)).comp
      (PolyFun.mapParam polyFun_alignJAdjGen)
  have hout : PolyFun (fun p : List ℕ × RawJohnson =>
      (cpPairs (List.range p.1.length)).map (fun q => alignJOutGen (p, q))) :=
    (polyFun_id.pair ((polyFun_fst.comp polyFun_rangeLength).comp polyFun_cpPairs)).comp
      (PolyFun.mapParam polyFun_alignJOutGen)
  exact ((hadj.pair hout).comp polyFun_append).of_eq (fun _ => rfl)

end Algo
