/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

The algorithmic layer: the outputs of Procedure LocalCertificates (§13.1, lines 07–11).
-/
import Workspace.Algo.LocalCertRound

/-!
# The certificates `K(T)` and `M(T)` (§13.1, claim C3)

> 07  if `H(W)^T ≥ A(T)` then
> 08    `K(T) ← H(W)_(W̄)`            (: `W̄ = Ω ∖ W` :)
> 09  else
> 10    `M(T) ← H(W)^T`
>
> `K(T)` represents an easily (polynomial-time) verifiable proof of fullness of `T`.

The three routines of this file are the three lines, on raw data.

* Line 07, the test `H(W)^T ≥ A(T)`: the group `H(W)^T` is handed to the routine as the
  images of the generators of `H(W)` under `ψ_T` (`Algo.RawTAct`, the convention of
  Prop. 2.2.6), and the images of the generators generate the image
  (`Algo.ImgsOf.range_eq_genGroup`), so the test is the order test of session 1
  (`Algo.rawIsGiantSub`, `Algo.alternating_le_iff_factorial_le`) applied to that list.
  Enumerating `A(T)` is out of the question, since `t!` is quasipolynomial.
* Line 08, `K(T) = H(W)_(W̄)`: the pointwise stabilizer of the complement of the window,
  which is `Algo.rawPointStab` (§2.2.1, Eq. (12)) applied to the complement.  The complement
  is computed by `Algo.rawWinCompl`: the points `0, …, n−1` — read off the *length* of the
  string, never off a machine natural — that the window does not list.
* Line 10, `M(T) = H(W)^T`: the images themselves, again by
  `Algo.ImgsOf.range_eq_genGroup`.  Nothing has to be computed; what has to be proved is that
  the stored list generates the right group.

## Main definitions

* `Algo.rawWinCompl` — the complement `W̄` of the window;
* `Algo.rawCertK` — line 08;
* `Algo.rawCertM` — line 10;
* `Algo.rawIsFullT` — line 07.

## Main results

* `Algo.decGroup_rawCertK` — `K(T) = H(W)_(W̄)` (`Babai.certK`, `Babai.certKOf`);
* `Algo.decGroup_rawCertM` — `M(T) = H(W)^T` (`Babai.certM`, `Babai.certMOf`);
* `Algo.rawIsFullT_eq_true_iff` — line 07 decides `H(W)^T ≥ A(T)` (Definition 13.1.2);
* `Algo.polyFun_rawCertK`, `Algo.polyFun_rawCertM`, `Algo.polyFun_rawIsFullT` — the time
  classes.

No axiom, no `sorry`, no `native_decide`.
-/

namespace Algo

open RAM RAM.Targets
open Equiv (Perm)

variable {n m : ℕ}

/-! ## The complement of the window -/

/-- **The complement `W̄ = Ω ∖ W` of the window**, as a list of points.  The points are
`0, …, n−1`, read off the *length* of the string: a machine natural is never a loop bound
(`RAM.polyFun_rangeLength`). -/
def rawWinCompl (p : RawStr × List ℕ) : List ℕ :=
  (List.range p.1.length).filter (fun u => decide (u ∉ p.2))

theorem nodup_rawWinCompl (p : RawStr × List ℕ) : (rawWinCompl p).Nodup :=
  List.Nodup.filter _ List.nodup_range

theorem lt_rawWinCompl {x : RawStr} (hx : x.length = n) {W : List ℕ} {u : ℕ}
    (hu : u ∈ rawWinCompl (x, W)) : u < n := by
  rw [rawWinCompl, List.mem_filter] at hu
  have h := List.mem_range.1 hu.1
  rw [← hx]
  exact h

/-- **The routine computes the complement of the window.** -/
theorem winSet_rawWinCompl {x : RawStr} (hx : x.length = n) (W : List ℕ) :
    {y : Fin n | (y : ℕ) ∈ rawWinCompl (x, W)} = (winSet n W)ᶜ := by
  ext y
  simp only [Set.mem_setOf_eq, Set.mem_compl_iff, mem_winSet, rawWinCompl, List.mem_filter,
    List.mem_range, decide_eq_true_eq]
  constructor
  · rintro ⟨-, hy⟩; exact hy
  · intro hy
    exact ⟨by rw [hx]; exact y.isLt, hy⟩

/-! ## Line 08: the certificate `K(T)` -/

/-- **Line 08**, `K(T) ← H(W)_(W̄)`: the pointwise stabilizer of the complement of the
window inside `H(W)`. -/
def rawCertK (W : RawWinSI) : RawGens :=
  rawPointStab ((W.2.2.2.1, W.2.1), rawWinCompl (W.2.2.2.1, W.1))

/-- **Line 08 is correct** (`Babai.certK`, `Babai.certKOf`): the routine returns generators of
the pointwise stabilizer of `Ω ∖ W` in `H(W)`. -/
theorem decGroup_rawCertK {W : RawWinSI} (hW : WinWF n W) :
    decGroup n (rawCertK W)
      = Babai.pointwiseStabilizer (decGroup n W.2.1) (winSet n W.1)ᶜ := by
  have hx : W.2.2.2.1.length = n := hW.1
  have hgens : W.2.1 = (descGens n W).map (encPerm n) :=
    (map_encPerm_decPerm hW.2.2.2.2.1).symm
  have h := decGroup_rawPointStab (n := n) W.2.2.2.1 hx (descGens n W)
    (rawWinCompl (W.2.2.2.1, W.1)) (nodup_rawWinCompl _)
    (fun u hu => lt_rawWinCompl hx hu)
  rw [rawCertK, hgens, h, winSet_rawWinCompl hx W.1, decGroup_map_encPerm]

/-! ## Line 10: the certificate `M(T)` -/

/-- **Line 10**, `M(T) ← H(W)^T`: the image of `H(W)` under `ψ_T`, which is generated by the
images of the generators of `H(W)` — the list the routine already carries. -/
def rawCertM (td : RawTAct) : RawGens := td.2

/-- **Line 10 is correct** (`Babai.certM`, `Babai.certMOf`): the stored image list generates
`H(W)^T = ψ_T(H(W))`.

*Proof.*  `Algo.ImgsOf.range_eq_genGroup`: the image of a group under a homomorphism is
generated by the images of its generators. -/
theorem decGroup_rawCertM {gens : List (Perm (Fin n))} {td : RawTAct}
    (hwf : RawGens.WF td.1.length td.2)
    {ψ : genGroup gens →* Perm (Fin td.1.length)} (hψ : ImgsOf gens (lcImgs td) ψ) :
    decGroup td.1.length (rawCertM td) = ψ.range := by
  rw [hψ.range_eq_genGroup]
  rfl

/-! ## Line 07: the fullness test -/

/-- **Line 07**, the test `H(W)^T ≥ A(T)`: the order test of Definition 13.1.4 applied to the
image `H(W)^T`, which the routine holds by generators (`Algo.rawCertM`). -/
def rawIsFullT (td : RawTAct) : Bool := rawIsGiantSub (td.1, td.2)

/-- **Line 07 is correct** (Definition 13.1.2, `Babai.IsFull`): the test says exactly that the
group induced on the test set contains the alternating group. -/
theorem rawIsFullT_eq_true_iff {gens : List (Perm (Fin n))} {td : RawTAct}
    (hwf : RawGens.WF td.1.length td.2)
    {ψ : genGroup gens →* Perm (Fin td.1.length)} (hψ : ImgsOf gens (lcImgs td) ψ) :
    rawIsFullT td = true ↔ alternatingGroup (Fin td.1.length) ≤ ψ.range := by
  have himgs : (lcImgs td).map (encPerm td.1.length) = td.2 := map_encPerm_decPerm hwf
  rw [rawIsFullT, hψ.range_eq_genGroup]
  conv_lhs => rw [show td.2 = (lcImgs td).map (encPerm td.1.length) from himgs.symm]
  exact rawIsGiantSub_eq_true_iff rfl (lcImgs td)

/-! ## The time classes -/

theorem polyFun_rawWinCompl : PolyFun rawWinCompl := by
  classical
  have hmem : PolyFun (fun z : (RawStr × List ℕ) × ℕ => decide (z.2 ∉ z.1.2)) := by
    have h1 : PolyFun (fun z : (RawStr × List ℕ) × ℕ => decide (z.2 ∈ z.1.2)) :=
      (polyFun_snd.pair (polyFun_fst.comp polyFun_snd)).comp
        (polyFun_listMem (α := ℕ) polyFun_natEq)
    refine (PolyFun.ite h1 (polyFun_const false) (polyFun_const true)).of_eq (fun z => ?_)
    by_cases h : z.2 ∈ z.1.2 <;> simp [h]
  have hrange : PolyFun (fun p : RawStr × List ℕ => List.range p.1.length) :=
    polyFun_fst.comp polyFun_rangeLength
  exact ((polyFun_id.pair hrange).comp (PolyFun.filterParam hmem)).of_eq (fun _ => rfl)

theorem polyFun_rawCertK : PolyFun rawCertK := by
  have hx : PolyFun (fun W : RawWinSI => W.2.2.2.1) :=
    ((polyFun_snd.comp polyFun_snd).comp polyFun_snd).comp polyFun_fst
  have hgens : PolyFun (fun W : RawWinSI => W.2.1) := polyFun_snd.comp polyFun_fst
  have hcompl : PolyFun (fun W : RawWinSI => rawWinCompl (W.2.2.2.1, W.1)) :=
    (hx.pair polyFun_fst).comp polyFun_rawWinCompl
  exact (((hx.pair hgens).pair hcompl).comp polyFun_rawPointStab).of_eq (fun _ => rfl)

theorem polyFun_rawCertM : PolyFun rawCertM := polyFun_snd

theorem polyFun_rawIsFullT : PolyFun rawIsFullT :=
  ((polyFun_fst.pair polyFun_snd).comp polyFun_rawIsGiantSub).of_eq (fun _ => rfl)

end Algo
