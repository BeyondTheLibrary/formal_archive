theorem polyFun_top3Answer : PolyFun (fun z : RawTop3 × Top3State => top3Answer z.1 z.2) := by
  have hdom : PolyFun (fun z : RawTop3 × Top3State => top3Dom z.1) :=
    polyFun_fst.comp polyFun_top3Dom
  have hr0 : PolyFun (fun z : RawTop3 × Top3State => z.2.2.2.2.1.getD (none : RawCoset)) :=
    ((((polyFun_snd.comp polyFun_snd).comp polyFun_snd).comp polyFun_snd).comp
      polyFun_fst).pair (polyFun_const (none : RawCoset)) |>.comp polyFun_optionGetD
  have hs1 : PolyFun (fun z : RawTop3 × Top3State => z.2.2.2.2.2.1) :=
    ((((polyFun_snd.comp polyFun_snd).comp polyFun_snd).comp polyFun_snd).comp
      polyFun_snd).comp polyFun_fst
  have hs2 : PolyFun (fun z : RawTop3 × Top3State => z.2.2.2.2.2.2) :=
    ((((polyFun_snd.comp polyFun_snd).comp polyFun_snd).comp polyFun_snd).comp
      polyFun_snd).comp polyFun_snd
  have hu1 : PolyFun (fun z : RawTop3 × Top3State =>
      top3Prod (top3Dom z.1, z.2.2.2.2.2.1, z.2.2.2.2.1.getD none)) :=
    (hdom.pair (hs1.pair hr0)).comp polyFun_top3Prod
  have hu2 : PolyFun (fun z : RawTop3 × Top3State =>
      top3Prod (top3Dom z.1, z.2.2.2.2.2.2, z.2.2.2.2.1.getD none)) :=
    (hdom.pair (hs2.pair hr0)).comp polyFun_top3Prod
  have hodd : PolyFun (fun z : RawTop3 × Top3State => top3Odd z.1) :=
    polyFun_fst.comp polyFun_top3Odd
  have hshift : PolyFun (fun z : RawTop3 × Top3State =>
      top3Shift (top3Dom z.1, top3Odd z.1,
        top3Prod (top3Dom z.1, z.2.2.2.2.2.2, z.2.2.2.2.1.getD none))) :=
    (hdom.pair (hodd.pair hu2)).comp polyFun_top3Shift
  have hjoin : PolyFun (fun z : RawTop3 × Top3State =>
      rawCosetJoin (top3Dom z.1,
        top3Prod (top3Dom z.1, z.2.2.2.2.2.1, z.2.2.2.2.1.getD none),
        top3Shift (top3Dom z.1, top3Odd z.1,
          top3Prod (top3Dom z.1, z.2.2.2.2.2.2, z.2.2.2.2.1.getD none)))) :=
    (hdom.pair (hu1.pair hshift)).comp polyFun_rawCosetJoin
  have hev : PolyFun (fun z : RawTop3 × Top3State => topAllEven z.1.1) :=
    (polyFun_fst.comp polyFun_fst).comp polyFun_topAllEven
  exact (PolyFun.ite hev hu1 hjoin).of_eq (fun z => by rw [top3Answer])

theorem quasiPolyFun_top3Finish {solve : RawWinSI → RawCoset} (hs : QuasiPolyFun solve) :
    QuasiPolyFun (top3Finish solve) := by
  have hacc : PolyFun (fun z : RawTop3Node × Top3State => top3Answer z.1.1 z.2) :=
    ((polyFun_fst.comp polyFun_fst).pair polyFun_snd).comp polyFun_top3Answer
  exact ((((polyFun_fst.comp polyFun_snd).pair polyFun_id).comp_quasi
    (QuasiPolyFun.optionElim hacc.quasiPolyFun (polyFun_fst.comp_quasi hs)))).of_eq
      (fun z => by cases hoz : z.1.2 <;> simp [top3Finish, hoz])

/-! ### The size bound

Everything the round stores is normalised, so every coset it keeps is bounded by
`Algo.chainBound` of the domain.  What grows with the instance is the pair of strings of a
job, and that is what `Algo.top3Str` bounds.  The counter of the round is at most
`Algo.top3Jobs`, which is the number of top tests plus two. -/

/-- A six-component state costs at most thirty-two times its components. -/
theorem size_top3State_le (s : Top3State) :
    Enc.size s ≤ 2 * Enc.size s.1 + 4 * Enc.size s.2.1 + 8 * Enc.size s.2.2.1
      + 16 * Enc.size s.2.2.2.1 + 32 * Enc.size s.2.2.2.2.1 + 32 * Enc.size s.2.2.2.2.2 := by
  have h1 : Enc.size s ≤ 2 * Enc.size s.1 + 2 * Enc.size s.2 := Combine.size_pair_le _ _
  have h2 : Enc.size s.2 ≤ 2 * Enc.size s.2.1 + 2 * Enc.size s.2.2 := Combine.size_pair_le _ _
  have h3 : Enc.size s.2.2 ≤ 2 * Enc.size s.2.2.1 + 2 * Enc.size s.2.2.2 :=
    Combine.size_pair_le _ _
  have h4 : Enc.size s.2.2.2 ≤ 2 * Enc.size s.2.2.2.1 + 2 * Enc.size s.2.2.2.2 :=
    Combine.size_pair_le _ _
  have h5 : Enc.size s.2.2.2.2 ≤ 2 * Enc.size s.2.2.2.2.1 + 2 * Enc.size s.2.2.2.2.2 :=
    Combine.size_pair_le _ _
  omega

@[simp] theorem top3Test_dom (P : RawTop3) (t : ℕ) : (top3Test P t).1.1.1 = P.1.1.1 := rfl

/-- The product of two normalised cosets is a normalised coset. -/
theorem size_top3Prod_le {n M : ℕ} {dom : List ℕ} (hd : dom.length = n) (hm : n ≤ M)
    (a b : RawCoset) : Enc.size (top3Prod (dom, a, b)) ≤ chainBound M := by
  have h0 := chainBound_ge M
  rcases h : top3Prod (dom, a, b) with _ | ⟨gs, ρ⟩
  · rw [size_none]; omega
  · obtain ⟨h1, h2, h3⟩ := top3Prod_wf hd a b h
    exact size_coset_le' (n := n) hm h1 h2 h3

/-- A translated normalised coset is a normalised coset. -/
theorem size_top3Shift_le {n M : ℕ} {dom : List ℕ} (hd : dom.length = n) (hm : n ≤ M)
    (r : RawPerm) (c : RawCoset) : Enc.size (top3Shift (dom, r, c)) ≤ chainBound M := by
  have h0 := chainBound_ge M
  rcases h : top3Shift (dom, r, c) with _ | ⟨gs, ρ⟩
  · rw [size_none]; omega
  · obtain ⟨h1, h2, h3⟩ := top3Shift_wf hd r c h
    exact size_coset_le' (n := n) hm h1 h2 h3

theorem rawCosetJoin_none (x : RawStr) (c : RawCoset) : rawCosetJoin (x, c, none) = c := by
  cases c <;> rfl

/-- The candidate set the round starts a job with is a normalised coset. -/
theorem size_top3Begin_le {n M : ℕ} {P : RawTop3} (hd : P.1.1.1.length = n) (hm : n ≤ M)
    (k : ℕ) : Enc.size (top3Begin P k) ≤ chainBound M := by
  rw [top3Begin]
  by_cases hk : k < (top3Tests P).length
  · rw [if_pos hk]
    exact size_topWinStart_le (by rw [top3Test_dom]; exact hd) hm
  · rw [if_neg hk, top3Start]
    exact size_coset_le' (n := n) hm (wf_tidyGens hd _) (length_tidyGens hd _)
      (by rw [← hd]; exact wf_rawOne _)

/-- The answer the round returns at the top node is a normalised coset. -/
theorem size_top3Answer_le {n M : ℕ} {P : RawTop3} (hd : P.1.1.1.length = n) (hm : n ≤ M)
    (s : Top3State) : Enc.size (top3Answer P s) ≤ chainBound M := by
  have hdom : (top3Dom P).length = n := hd
  rw [top3Answer]
  by_cases hev : topAllEven P.1 = true
  · rw [if_pos hev]; exact size_top3Prod_le hdom hm _ _
  · rw [if_neg hev]
    rcases hsh : top3Shift (top3Dom P, top3Odd P,
        top3Prod (top3Dom P, s.2.2.2.2.2, s.2.2.2.1.getD none)) with _ | q
    · rw [rawCosetJoin_none]; exact size_top3Prod_le hdom hm _ _
    · exact size_rawCosetJoin_some_le (n := n) hdom hm _ q
        (by rw [← hsh]; exact size_top3Shift_le hdom hm _ _)

/-- The size the two strings of a job can reach, in terms of the size bound `D` of the
routine that computes them and the size bound `T` of the list of top tests.  A job index is
at most the number of top tests plus one. -/
def top3Str (D T : ℕ → ℕ) (m : ℕ) : ℕ := D (2 * m + 2 * (T m + 6)) + m

/-- **The size bound of the round of Cor. 12.0.8.** -/
def top3Bound (D T K : ℕ → ℕ) (m : ℕ) : ℕ :=
  128 * (chainBound (top3Str D T m) + T m + K m + 8)

theorem le_top3Str (D T : ℕ → ℕ) (m : ℕ) : m ≤ top3Str D T m := by
  rw [top3Str]; omega

theorem mono_top3Str {D T : ℕ → ℕ} (hD : ∀ a b, a ≤ b → D a ≤ D b)
    (hT : ∀ a b, a ≤ b → T a ≤ T b) : Monotone (top3Str D T) := by
  intro a b hab
  have h1 : 2 * a + 2 * (T a + 6) ≤ 2 * b + 2 * (T b + 6) := by
    have := hT a b hab; omega
  have h2 := hD _ _ h1
  rw [top3Str, top3Str]; omega

theorem mono_top3Bound {D T K : ℕ → ℕ} (hD : ∀ a b, a ≤ b → D a ≤ D b)
    (hT : ∀ a b, a ≤ b → T a ≤ T b) (hK : ∀ a b, a ≤ b → K a ≤ K b) :
    Monotone (top3Bound D T K) := by
  intro a b hab
  have h1 := mono_chainBound (mono_top3Str hD hT hab)
  have h2 := hT a b hab
  have h3 := hK a b hab
  rw [top3Bound, top3Bound]; omega

theorem polyBound_top3Bound {D T K : ℕ → ℕ} (hD : PolyBound D) (hT : PolyBound T)
    (hK : PolyBound K) : PolyBound (top3Bound D T K) := by
  have hE : PolyBound (fun m => 2 * m + 2 * (T m + 6)) :=
    ((polyBound_const 2).mul polyBound_id).add
      ((polyBound_const 2).mul (hT.add (polyBound_const 6)))
  have hS : PolyBound (top3Str D T) := (hD.comp hE).add polyBound_id
  exact (polyBound_const 128).mul
    ((((polyBound_chainBound.comp hS).add hT).add hK).add (polyBound_const 8))

/-- A state whose six components are all small is small. -/
private theorem top3_state_bound {D T K : ℕ → ℕ} {m : ℕ} (t i : ℕ) (c : RawCoset)
    (acc : Top1State) (s1 s2 : RawCoset)
    (h1 : Enc.size t ≤ T m + 6) (h2 : Enc.size i ≤ K m + 6)
    (h3 : Enc.size c ≤ chainBound (top3Str D T m))
    (h4 : Enc.size acc ≤ chainBound (top3Str D T m) + 2)
    (h5 : Enc.size s1 ≤ chainBound (top3Str D T m))
    (h6 : Enc.size s2 ≤ chainBound (top3Str D T m)) :
    Enc.size ((t, i, c, acc, s1, s2) : Top3State) ≤ top3Bound D T K m := by
  have hs := size_top3State_le ((t, i, c, acc, s1, s2) : Top3State)
  dsimp only at hs
  have hbd : top3Bound D T K m
      = 128 * (chainBound (top3Str D T m) + T m + K m + 8) := rfl
  omega

/-- **The cost data of the round of Cor. 12.0.8.**  The solver is charged for: it has to be
a `RAM.QuasiPolyFun` and to answer within the bound of the Chain Rule round. -/
def top3CostOf (n : ℕ) (solve : RawWinSI → RawCoset)
    (hsolve : QuasiPolyFun solve)
    (hsize : ∀ W, Top2LeafWF n W → Enc.size (solve W) ≤ chainBound (Enc.size W.2.2.2))
    (D T K : ℕ → ℕ)
    (hDb : PolyBound D) (hDm : ∀ a b : ℕ, a ≤ b → D a ≤ D b)
    (hD : ∀ z : RawTop3 × ℕ,
      Enc.size ((top3Src z.1 z.2, top3Tgt z.1 z.2) : RawStr × RawStr) ≤ D (Enc.size z))
    (hTb : PolyBound T) (hTm : ∀ a b : ℕ, a ≤ b → T a ≤ T b)
    (hT : ∀ P : RawTop3, Enc.size (top3Tests P) ≤ T (Enc.size P))
    (hKb : PolyBound K) (hKm : ∀ a b : ℕ, a ≤ b → K a ≤ K b)
    (hK : ∀ P : RawTop3, Enc.size (top3Wins P) ≤ K (Enc.size P)) :
    Round.Cost (top3Round n solve) := by
  have hn_le : ∀ I : RawTop3Node, Top3WF n I → n ≤ Enc.size I.1 := by
    intro I hI
    have h1 : I.1.1.1.1.length ≤ Enc.size I.1.1.1.1 := length_le_size _
    have h2 : Enc.size I.1.1.1.1 ≤ Enc.size I.1.1.1 := size_fst_le' _
    have h3 : Enc.size I.1.1.1 ≤ Enc.size I.1.1 := size_fst_le' _
    have h4 : Enc.size I.1.1 ≤ Enc.size I.1 := size_fst_le' _
    rw [← hI.2.1]; omega
  have htests : ∀ P : RawTop3, (top3Tests P).length ≤ T (Enc.size P) := fun P =>
    le_trans (length_le_size _) (hT P)
  have hwins : ∀ P : RawTop3, (top3Wins P).length ≤ K (Enc.size P) := fun P =>
    le_trans (length_le_size _) (hK P)
  -- the two strings of the `t`-th job, for `t` below the number of jobs
  have hstr : ∀ (P : RawTop3) (t : ℕ), t < top3Jobs P →
      Enc.size ((top3Src P t, top3Tgt P t) : RawStr × RawStr)
        ≤ top3Str D T (Enc.size P) := by
    intro P t ht
    have h1 : Enc.size ((P, t) : RawTop3 × ℕ) ≤ 2 * Enc.size P + 2 * Enc.size t :=
      Combine.size_pair_le _ _
    have h2 := size_nat_le_self t
    have h3 : t ≤ T (Enc.size P) + 1 := by
      have := htests P; rw [top3Jobs] at ht; omega
    have h5 : Enc.size ((P, t) : RawTop3 × ℕ)
        ≤ 2 * Enc.size P + 2 * (T (Enc.size P) + 6) := by omega
    have h6 : Enc.size ((top3Src P t, top3Tgt P t) : RawStr × RawStr)
        ≤ D (Enc.size ((P, t) : RawTop3 × ℕ)) := hD (P, t)
    have h7 := hDm _ _ h5
    have h8 : top3Str D T (Enc.size P)
        = D (2 * Enc.size P + 2 * (T (Enc.size P) + 6)) + Enc.size P := rfl
    omega
  have hleaf : ∀ (P : RawTop3) (t i : ℕ) (c : RawGens × RawPerm), n ≤ Enc.size P →
      P.1.1.1.length = n → t < top3Jobs P →
      Enc.size (top3Leaf P t i c) ≤ chainBound (top3Str D T (Enc.size P)) := by
    intro P t i c hn hd ht
    exact size_top2LeafWF_le (top3LeafWF hd t i c) (le_trans hn (le_top3Str D T _))
      (hstr P t ht)
  have hsolveleaf : ∀ (P : RawTop3) (t i : ℕ) (c : RawGens × RawPerm), P.1.1.1.length = n →
      t < top3Jobs P →
      Enc.size (solve (top3Leaf P t i c)) ≤ chainBound (top3Str D T (Enc.size P)) := by
    intro P t i c hd ht
    exact le_trans (hsize _ (top3LeafWF hd t i c)) (mono_chainBound (hstr P t ht))
  refine
    { bound := top3Bound D T K
      polyBound_bound := polyBound_top3Bound hDb hTb hKb
      mono_bound := mono_top3Bound hDm hTm hKm
      widthBound := fun m => (T m + 2) * K m
      quasiPolyBound_widthBound := ((hTb.add (polyBound_const 2)).mul hKb).quasiPoly
      quasiPolyFun_child := polyFun_top3Child.quasiPolyFun
      quasiPolyFun_init := ?_
      quasiPolyFun_combine := polyFun_top3Combine.quasiPolyFun
      quasiPolyFun_finish := quasiPolyFun_top3Finish hsolve
      ground_le := fun I => size_fst_le' I
      size_le := ?_
      init_le := ?_
      combine_le := ?_
      finish_le := ?_
      bot_le := ?_
      width_le := ?_ }
  · show QuasiPolyFun (fun I : RawTop3Node =>
      ((0, 0, top3Begin I.1 0, (some none : Top1State), (none : RawCoset),
        (none : RawCoset)) : Top3State))
    have hb : PolyFun (fun I : RawTop3Node => top3Begin I.1 0) :=
      (polyFun_fst.pair (polyFun_const (0 : ℕ))).comp polyFun_top3Begin
    exact ((polyFun_const (0 : ℕ)).pair ((polyFun_const (0 : ℕ)).pair
      (hb.pair ((polyFun_const (some none : Top1State)).pair
        ((polyFun_const (none : RawCoset)).pair
          (polyFun_const (none : RawCoset))))))).quasiPolyFun
  · -- `size_le`
    intro I hI
    show Enc.size I ≤ top3Bound D T K (Enc.size I.1)
    have hm := hn_le I hI
    have hp : Enc.size I ≤ 2 * Enc.size I.1 + 2 * Enc.size I.2 := Combine.size_pair_le _ _
    have hcb := chainBound_ge (top3Str D T (Enc.size I.1))
    have hst := le_top3Str D T (Enc.size I.1)
    have hbd : top3Bound D T K (Enc.size I.1)
        = 128 * (chainBound (top3Str D T (Enc.size I.1)) + T (Enc.size I.1)
            + K (Enc.size I.1) + 8) := rfl
    rcases ho : I.2 with _ | W
    · have h2 : Enc.size I.2 = 2 := by rw [ho]; exact size_none
      omega
    · obtain ⟨t, i, c, ht, hWeq⟩ := hI.2.2 W ho
      have h1 : Enc.size I.2 = Enc.size W + 2 := by rw [ho]; exact size_some_eq _
      have h2 : Enc.size W ≤ chainBound (top3Str D T (Enc.size I.1)) := by
        rw [hWeq]; exact hleaf I.1 t i c hm hI.2.1 ht
      omega
  · -- `init_le`
    intro I hI
    show Enc.size ((0, 0, top3Begin I.1 0, (some none : Top1State), (none : RawCoset),
      (none : RawCoset)) : Top3State) ≤ top3Bound D T K (Enc.size I.1)
    have hm := hn_le I hI
    have hcb := chainBound_ge (top3Str D T (Enc.size I.1))
    have hst := le_top3Str D T (Enc.size I.1)
    have h0 := size_nat_le_self 0
    refine top3_state_bound _ _ _ _ _ _ ?_ ?_ ?_ ?_ ?_ ?_
    · omega
    · omega
    · exact size_top3Begin_le hI.2.1 (le_trans hm hst) 0
    · show Enc.size (some none : Top1State) ≤ _
      rw [size_some_eq, size_none]; omega
    · rw [size_none]; omega
    · rw [size_none]; omega
  · -- `combine_le`
    intro I j s a hI _ _
    show Enc.size (top3Combine (I, j, s, a)) ≤ top3Bound D T K (Enc.size I.1)
    have hm := hn_le I hI
    have hd : I.1.1.1.1.length = n := hI.2.1
    have hdom : (top3Dom I.1).length = n := hd
    have hcb := chainBound_ge (top3Str D T (Enc.size I.1))
    have hst := le_top3Str D T (Enc.size I.1)
    have hM : n ≤ top3Str D T (Enc.size I.1) := le_trans hm hst
    have hT' := htests I.1
    have hK' := hwins I.1
    have hjobs : top3Jobs I.1 = (top3Tests I.1).length + 2 := rfl
    have hnormC : ∀ c : RawCoset, Enc.size (top2NormC (top3Dom I.1) c)
        ≤ chainBound (top3Str D T (Enc.size I.1)) := fun c =>
      size_top2NormC_le hdom hM c
    have hnormS : ∀ o : Top1State, Enc.size (top2NormS (top3Dom I.1) o)
        ≤ chainBound (top3Str D T (Enc.size I.1)) + 2 := fun o =>
      size_top2NormS_le hdom hM o
    have hjoin : ∀ (t : ℕ) (o : Top1State) (c : RawCoset),
        Enc.size (top3Join I.1 t o c) ≤ chainBound (top3Str D T (Enc.size I.1)) + 2 := by
      intro t o c; exact hnormS _
    have hbegin : ∀ k : ℕ, Enc.size (top3Begin I.1 k)
        ≤ chainBound (top3Str D T (Enc.size I.1)) := fun k => size_top3Begin_le hd hM k
    show Enc.size (top3Step I.1 s.1 s.2.1 s.2.2.2.1 s.2.2.2.2.1 s.2.2.2.2.2 a)
      ≤ top3Bound D T K (Enc.size I.1)
    rw [top3Step]
    by_cases hA : a.isSome = true ∧ s.2.1 + 1 < (top3Wins I.1).length
    · rw [if_pos hA]
      refine top3_state_bound _ _ _ _ _ _ ?_ ?_ (hnormC _) (hnormS _) (hnormC _) (hnormC _)
      · have h1 := size_nat_le_self (min s.1 (top3Jobs I.1))
        have h2 : min s.1 (top3Jobs I.1) ≤ top3Jobs I.1 := Nat.min_le_right _ _
        omega
      · have h1 := size_nat_le_self (min (s.2.1 + 1) (top3Wins I.1).length)
        have h2 : min (s.2.1 + 1) (top3Wins I.1).length ≤ (top3Wins I.1).length :=
          Nat.min_le_right _ _
        omega
    · rw [if_neg hA]
      have h0 := size_nat_le_self 0
      by_cases hB : s.1 + 1 < (top3Tests I.1).length
      · rw [if_pos hB]
        refine top3_state_bound _ _ _ _ _ _ ?_ (by omega) (hbegin _) (hjoin _ _ _)
          (hnormC _) (hnormC _)
        · have h1 := size_nat_le_self (s.1 + 1); omega
      · rw [if_neg hB]
        by_cases hC : s.1 + 1 = (top3Tests I.1).length
        · rw [if_pos hC]
          refine top3_state_bound _ _ _ _ _ _ ?_ (by omega) (hbegin _) (hjoin _ _ _)
            (hnormC _) (hnormC _)
          · by_cases hs : ((top3Join I.1 s.1 s.2.2.2.1 a).getD none).isSome = true
            · rw [if_pos hs]
              have h1 := size_nat_le_self (top3Tests I.1).length; omega
            · rw [if_neg hs]
              have h1 := size_nat_le_self (top3Jobs I.1); omega
        · rw [if_neg hC]
          by_cases hDd : s.1 = (top3Tests I.1).length
          · rw [if_pos hDd]
            refine top3_state_bound _ _ _ _ _ _ ?_ (by omega) (hbegin _) (hnormS _)
              (hnormC _) (hnormC _)
            · by_cases hev : topAllEven I.1.1 = true
              · rw [if_pos hev]
                have h1 := size_nat_le_self (top3Jobs I.1); omega
              · rw [if_neg hev]
                have h1 := size_nat_le_self ((top3Tests I.1).length + 1); omega
          · rw [if_neg hDd]
            refine top3_state_bound _ _ _ _ _ _ ?_ (by omega) (hbegin _) (hnormS _)
              (hnormC _) (hnormC _)
            · have h1 := size_nat_le_self (top3Jobs I.1); omega
  · -- `finish_le`
    intro I s hI hs
    have hgr : (top3Round n solve).ground I = Enc.size I.1 := rfl
    rw [hgr] at hs
    show Enc.size (top3Finish solve (I, s)) ≤ top3Bound D T K (Enc.size I.1)
    have hm := hn_le I hI
    have hcb := chainBound_ge (top3Str D T (Enc.size I.1))
    have hbd : top3Bound D T K (Enc.size I.1)
        = 128 * (chainBound (top3Str D T (Enc.size I.1)) + T (Enc.size I.1)
            + K (Enc.size I.1) + 8) := rfl
    rcases ho : I.2 with _ | W
    · have he : top3Finish solve (I, s) = top3Answer I.1 s := by rw [top3Finish, ho]; rfl
      have h2 : Enc.size (top3Answer I.1 s) ≤ chainBound (top3Str D T (Enc.size I.1)) :=
        size_top3Answer_le hI.2.1 (le_trans hm (le_top3Str D T _)) s
      rw [he]; omega
    · obtain ⟨t, i, c, ht, hWeq⟩ := hI.2.2 W ho
      have he : top3Finish solve (I, s) = solve W := by rw [top3Finish, ho]; rfl
      have h2 : Enc.size (solve W) ≤ chainBound (top3Str D T (Enc.size I.1)) := by
        rw [hWeq]; exact hsolveleaf I.1 t i c hI.2.1 ht
      rw [he]; omega
  · -- `bot_le`
    intro m
    have hcb := chainBound_ge (top3Str D T m)
    have hbd : top3Bound D T K m
        = 128 * (chainBound (top3Str D T m) + T m + K m + 8) := rfl
    show Enc.size (none : RawCoset) ≤ top3Bound D T K m
    rw [size_none]; omega
  · -- `width_le`
    intro I hI
    show I.2.elim (top3Jobs I.1 * (top3Wins I.1).length) (fun _ => 0)
      ≤ (T (Enc.size I.1) + 2) * K (Enc.size I.1)
    rcases ho : I.2 with _ | W
    · exact Nat.mul_le_mul (by rw [top3Jobs]; have := htests I.1; omega) (hwins I.1)
    · exact Nat.zero_le _

/-- The size bound of the routine that computes the two strings of a job. -/
private theorem top3SB_str : ∃ S : ℕ → ℕ, PolyBound S ∧ (∀ a b : ℕ, a ≤ b → S a ≤ S b) ∧
    ∀ z : RawTop3 × ℕ,
      Enc.size ((top3Src z.1 z.2, top3Tgt z.1 z.2) : RawStr × RawStr) ≤ S (Enc.size z) :=
  SizeBound.exists_polyBound (polyFun_top3Src.pair polyFun_top3Tgt).size

/-- The size bound of the routine that lists the top tests. -/
private theorem top3SB_tests : ∃ S : ℕ → ℕ, PolyBound S ∧ (∀ a b : ℕ, a ≤ b → S a ≤ S b) ∧
    ∀ P : RawTop3, Enc.size (top3Tests P) ≤ S (Enc.size P) :=
  SizeBound.exists_polyBound polyFun_top3Tests.size

/-- The size bound of the routine that lists the orbits of the kernel. -/
private theorem top3SB_wins : ∃ S : ℕ → ℕ, PolyBound S ∧ (∀ a b : ℕ, a ≤ b → S a ≤ S b) ∧
    ∀ P : RawTop3, Enc.size (top3Wins P) ≤ S (Enc.size P) :=
  SizeBound.exists_polyBound polyFun_top3Wins.size

/-- **Cor. 12.0.8: the round is paid for.**  The bounds of the three routines that read the
instance are the ones `RAM.PolyFun` carries. -/
noncomputable def top3Cost (n : ℕ) (solve : RawWinSI → RawCoset)
    (hsolve : QuasiPolyFun solve)
    (hsize : ∀ W, Top2LeafWF n W → Enc.size (solve W) ≤ chainBound (Enc.size W.2.2.2)) :
    Round.Cost (top3Round n solve) :=
  top3CostOf n solve hsolve hsize
    top3SB_str.choose top3SB_tests.choose top3SB_wins.choose
    top3SB_str.choose_spec.1 top3SB_str.choose_spec.2.1 top3SB_str.choose_spec.2.2
    top3SB_tests.choose_spec.1 top3SB_tests.choose_spec.2.1 top3SB_tests.choose_spec.2.2
    top3SB_wins.choose_spec.1 top3SB_wins.choose_spec.2.1 top3SB_wins.choose_spec.2.2

end Cost

end Algo
