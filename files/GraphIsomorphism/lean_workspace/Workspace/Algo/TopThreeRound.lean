import Workspace.Algo.TopWindowRound
import Workspace.Algo.TopRoundCost

/-!
# Sec. 12, Corollary 12.0.8: the round of the top action with the giant test

`Workspace/Algo/TopWindowRound.lean` (T4, Cor. 12.0.6) turns Prop. 12.0.5 with the Chain
Rule into one flat adaptive round.  Corollary 12.0.8 is built on top of it in three phases,
following the repaired proof of `Workspace/TopAction/TopAction2.lean`
(`Babai.topAction3Reduction`, the corrected paper Cor. 12.0.8):

* **phase 0** applies Cor. 12.0.6 to the pair `(x, x)` and the alternating generators, which
  decides item (i) and, when the answer is affirmative, returns `Aut_{G₁}(x)`;
* **phase 1** is one kernel instance `Iso_N(x, y)`, cut by Luks's Chain Rule into the `k`
  orbits of `N`;
* **phase 2** is the same for the shifted target `y^{τ⁻¹}`, and runs only when the image of
  the action is not contained in `A(Γ)`.

All three phases are walked by **one flat loop**, exactly as in `Algo.top2Round`: the state
is `(t, i, c, acc, s₁, s₂)`, where `t` is the index of the current *job* — a top test of
phase 0, or phase 1, or phase 2 — `i` the index of the current orbit of `N`, `c` the coset
the Chain Rule has reached, `acc` the accumulator of phase 0 and `s₁`, `s₂` the answers of
phases 1 and 2.  The three phase changes happen inside `Algo.top3Combine`, in the same step
that closes a job.

## Reconstructing the answer

Step (ii) of the proof recovers `Iso_{G₁}(x,y)` from one element `ρ` of `Iso_N(x,y)` and
the group `Aut_{G₁}(x)`: it is `ρ·Aut_{G₁}(x)`.  A round may not read `ρ` off the answer of
a child, because `Algo.LoopMatch` lets the child return *any* raw coset that decodes to the
right set, and two such raw cosets carry different representatives.  What is a function of
the two answer **sets** is the coset hull of their product,

```
cosetHull (Iso_N(x,y) * Aut_{G₁}(x)),
```

and that is what the round computes (`Algo.top3Prod`), so the link to the mathematical
layer is a literal `Algo.Implements`.  Under the hypotheses of Cor. 12.0.8 the product is
already the coset `Iso_{G₁}(x,y)`, because `Aut_N(x) ≤ Aut_{G₁}(x)`, so the hull changes
nothing; that is the content of `Algo.top3Prod_eq_cosetUnion`, and it is where the paper's
`Babai.cosetUnion` comes back.

## Main definitions

* `Algo.top3Prod`, `Algo.top3Shift` — the two new raw operations on answer cosets;
* `Algo.top3Round` — the computable round;
* `Algo.top3RoundReduction` — what it implements.

## Main results

* `Algo.implements_top3Round` — **the link**;
* `Algo.run_top3RoundReduction_eq_topAction3` — the value is the value of
  `Babai.topAction3Reduction`, the negative decision read as the empty answer;
* `Algo.calls_length_top3RoundReduction` — `12k` calls, windows of
  size `n/k`;
* `Algo.top3Cost` — the `Algo.Round.Cost` of the round.

No axiom, no `sorry`.
-/

namespace Algo

open RAM RAM.Targets
open Equiv (Perm)
open Babai (SIReduction SIInstance)
open scoped Pointwise

/-! ## The hull of a product of two cosets

The one piece of group theory this file needs: the smallest coset containing the product of
two cosets, in the representation of Def. 11.1.2 (a group and one representative). -/

section Algebra

variable {Γ : Type*} [Group Γ]

/-- The subgroup generated by the product of two subgroups is their join. -/
theorem closure_mul_subgroups (H K : Subgroup Γ) :
    Subgroup.closure ((H : Set Γ) * (K : Set Γ)) = H ⊔ K := by
  refine le_antisymm ((Subgroup.closure_le _).2 ?_) (sup_le ?_ ?_)
  · rintro y ⟨h, hh, k, hk, rfl⟩
    exact mul_mem (le_sup_left (α := Subgroup Γ) hh) (le_sup_right (α := Subgroup Γ) hk)
  · intro h hh
    exact Subgroup.subset_closure ⟨h, hh, 1, K.one_mem, by simp⟩
  · intro k hk
    exact Subgroup.subset_closure ⟨1, H.one_mem, k, hk, by simp⟩

/-- **The hull of the product of two cosets.**  `τM · ρN` is contained in the coset
`(τρ)·(ρ⁻¹Mρ ⊔ N)`, and that coset is the smallest one containing it.  This is what
`Algo.top3Prod` computes. -/
theorem cosetHull_smul_mul_smul (M N : Subgroup Γ) (τ ρ : Γ) :
    cosetHull ((τ • (M : Set Γ)) * (ρ • (N : Set Γ)))
      = (τ * ρ) • ((M.map (MulAut.conj ρ⁻¹).toMonoidHom ⊔ N : Subgroup Γ) : Set Γ) := by
  have hmem : τ * ρ ∈ (τ • (M : Set Γ)) * (ρ • (N : Set Γ)) :=
    ⟨τ, mem_smul_set_group.2 (by simpa using M.one_mem), ρ,
      mem_smul_set_group.2 (by simpa using N.one_mem), rfl⟩
  rw [cosetHull_eq hmem]
  congr 1
  have hset : (τ * ρ)⁻¹ • ((τ • (M : Set Γ)) * (ρ • (N : Set Γ)))
      = ((M.map (MulAut.conj ρ⁻¹).toMonoidHom : Subgroup Γ) : Set Γ) * (N : Set Γ) := by
    ext z
    constructor
    · rintro ⟨w, ⟨a, ha, b, hb, rfl⟩, hz⟩
      obtain ⟨m, hm, rfl⟩ := ha
      obtain ⟨u, hu, rfl⟩ := hb
      refine ⟨ρ⁻¹ * m * ρ, ⟨m, hm, ?_⟩, u, hu, ?_⟩
      · show (MulAut.conj ρ⁻¹) m = ρ⁻¹ * m * ρ
        rw [MulAut.conj_apply]; group
      · have : z = (τ * ρ)⁻¹ * ((τ * m) * (ρ * u)) := by
          rw [← hz]; simp [smul_eq_mul]
        rw [this]; group
    · rintro ⟨g, ⟨m, hm, rfl⟩, u, hu, rfl⟩
      refine ⟨(τ * m) * (ρ * u), ⟨τ * m, ⟨m, hm, rfl⟩, ρ * u, ⟨u, hu, rfl⟩, rfl⟩, ?_⟩
      show (τ * ρ)⁻¹ * ((τ * m) * (ρ * u)) = (MulAut.conj ρ⁻¹) m * u
      rw [MulAut.conj_apply]
      group
  rw [hset, closure_mul_subgroups]

end Algebra

/-! ## The two new raw operations -/

variable {n : ℕ}

/-- **The hull of the product of two raw answer cosets.**  This is step (ii) of the proof of
Cor. 12.0.8 in a form that depends only on the two decoded sets: `τM · ρN` is written
`(τρ)·(ρ⁻¹Mρ ⊔ N)`, with the generators shortened to at most `n²`. -/
def top3Prod (p : List ℕ × RawCoset × RawCoset) : RawCoset :=
  match p.2.1, p.2.2 with
  | some (M, τ), some (N, ρ) =>
      some (tidyGens (p.1, rawConj (normPerm (p.1, ρ), normGens (p.1, M)) ++ normGens (p.1, N)),
        rawMul (normPerm (p.1, τ), normPerm (p.1, ρ)))
  | _, _ => none

/-- **The specification of `Algo.top3Prod`**, for arbitrary raw inputs. -/
theorem decCoset_top3Prod {dom : List ℕ} (hd : dom.length = n) (a b : RawCoset) :
    decCoset n (top3Prod (dom, a, b)) = cosetHull (decCoset n a * decCoset n b) := by
  match a, b with
  | none, b =>
      show decCoset n none = cosetHull (∅ * decCoset n b)
      rw [Set.empty_mul, cosetHull_empty]
      rfl
  | some q, none =>
      show decCoset n none = cosetHull (decCoset n (some q) * ∅)
      rw [Set.mul_empty, cosetHull_empty]
      rfl
  | some (M, τ), some (N, ρ) =>
      have hMwf : RawGens.WF n (normGens (dom, M)) := wf_normGens hd M
      have hNwf : RawGens.WF n (normGens (dom, N)) := wf_normGens hd N
      have hτwf : RawPerm.WF n (normPerm (dom, τ)) := wf_normPerm hd τ
      have hρwf : RawPerm.WF n (normPerm (dom, ρ)) := wf_normPerm hd ρ
      have hgrp : decGroup n (tidyGens (dom,
            rawConj (normPerm (dom, ρ), normGens (dom, M)) ++ normGens (dom, N)))
          = (decGroup n M).map (MulAut.conj (decPerm n ρ)⁻¹).toMonoidHom ⊔ decGroup n N := by
        rw [decGroup_tidyGens hd, decGroup_append, decGroup_rawConj hρwf hMwf,
          decGroup_normGens hd, decGroup_normGens hd, decPerm_normPerm hd]
      show decCoset n (some (_, _)) = _
      rw [decCoset_some, decCoset_some, decCoset_some, hgrp,
        rawMul_of_wf hτwf hρwf, decPerm_encPerm, decPerm_normPerm hd, decPerm_normPerm hd,
        cosetHull_smul_mul_smul]

/-- The product answer is well formed: at most `n²` generators, all of them permutations of
the domain, and a well-formed representative. -/
theorem top3Prod_wf {dom : List ℕ} (hd : dom.length = n) (a b : RawCoset) {gs : RawGens}
    {ρ : RawPerm} (h : top3Prod (dom, a, b) = some (gs, ρ)) :
    RawGens.WF n gs ∧ gs.length ≤ n * n ∧ RawPerm.WF n ρ := by
  match a, b with
  | none, b => exact absurd h (by cases b <;> simp [top3Prod])
  | some q, none => exact absurd h (by simp [top3Prod])
  | some (M, τ), some (N, ρ') =>
      have he : top3Prod (dom, some (M, τ), some (N, ρ')) =
          some (tidyGens (dom,
              rawConj (normPerm (dom, ρ'), normGens (dom, M)) ++ normGens (dom, N)),
            rawMul (normPerm (dom, τ), normPerm (dom, ρ'))) := rfl
      rw [he] at h
      cases h
      exact ⟨wf_tidyGens hd _, length_tidyGens hd _,
        wf_rawMul (wf_normPerm hd _) (wf_normPerm hd _)⟩

theorem polyFun_top3Prod : PolyFun top3Prod := by
  have hbody : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × List ℕ) =>
      (some (tidyGens (z.2.2,
          rawConj (normPerm (z.2.2, z.1.2), normGens (z.2.2, z.2.1.1)) ++ normGens (z.2.2, z.1.1)),
        rawMul (normPerm (z.2.2, z.2.1.2), normPerm (z.2.2, z.1.2))) : RawCoset)) := by
    have hd : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × List ℕ) => z.2.2) :=
      polyFun_snd.comp polyFun_snd
    have hM : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × List ℕ) =>
        normGens (z.2.2, z.2.1.1)) :=
      (hd.pair ((polyFun_snd.comp polyFun_fst).comp polyFun_fst)).comp polyFun_normGens
    have hN : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × List ℕ) =>
        normGens (z.2.2, z.1.1)) :=
      (hd.pair (polyFun_fst.comp polyFun_fst)).comp polyFun_normGens
    have hτ : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × List ℕ) =>
        normPerm (z.2.2, z.2.1.2)) :=
      (hd.pair ((polyFun_snd.comp polyFun_fst).comp polyFun_snd)).comp polyFun_normPerm
    have hρ : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × List ℕ) =>
        normPerm (z.2.2, z.1.2)) :=
      (hd.pair (polyFun_fst.comp polyFun_snd)).comp polyFun_normPerm
    have hconj : PolyFun (fun z : (RawGens × RawPerm) × ((RawGens × RawPerm) × List ℕ) =>
        rawConj (normPerm (z.2.2, z.1.2), normGens (z.2.2, z.2.1.1))) :=
      (hρ.pair hM).comp polyFun_rawConj
    exact ((hd.pair ((hconj.pair hN).comp polyFun_append)).comp polyFun_tidyGens).pair
      ((hτ.pair hρ).comp polyFun_rawMul) |>.comp polyFun_some
  have hsnd : PolyFun (fun z : (RawGens × RawPerm) × (List ℕ × RawCoset × RawCoset) =>
      (top3Prod (z.2.1, some z.1, z.2.2.2) : RawCoset)) := by
    refine (((polyFun_snd.comp polyFun_snd).comp polyFun_snd).pair
      (polyFun_fst.pair (polyFun_snd.comp polyFun_fst))).comp
        (PolyFun.optionElim (polyFun_const (none : RawCoset)) hbody) |>.of_eq ?_
    intro z
    cases hz : z.2.2.2 <;> simp [top3Prod, hz]
  exact ((polyFun_snd.comp polyFun_fst).pair polyFun_id).comp
    (PolyFun.optionElim (polyFun_const (none : RawCoset)) hsnd) |>.of_eq (fun z => by
      cases hz : z.2.1 <;> simp [top3Prod, hz])

/-- **Left translation of a raw answer coset** by a raw permutation: the Luks descent of
Cor. 12.0.6 puts back the odd representative. -/
def top3Shift (p : List ℕ × RawPerm × RawCoset) : RawCoset :=
  p.2.2.map (fun q =>
    (tidyGens (p.1, q.1), rawMul (normPerm (p.1, p.2.1), normPerm (p.1, q.2))))

theorem decCoset_top3Shift {dom : List ℕ} (hd : dom.length = n) (r : RawPerm) (c : RawCoset) :
    decCoset n (top3Shift (dom, r, c)) = decPerm n r • decCoset n c := by
  cases c with
  | none => simp [top3Shift, decCoset]
  | some q =>
      obtain ⟨gs, ρ⟩ := q
      have hr := wf_normPerm hd r
      have hρ := wf_normPerm hd ρ
      show decCoset n (some (_, _)) = _
      rw [decCoset_some, decCoset_some, decGroup_tidyGens hd, rawMul_of_wf hr hρ,
        decPerm_encPerm, decPerm_normPerm hd, decPerm_normPerm hd, smul_smul]

theorem top3Shift_wf {dom : List ℕ} (hd : dom.length = n) (r : RawPerm) (c : RawCoset)
    {gs : RawGens} {ρ : RawPerm} (h : top3Shift (dom, r, c) = some (gs, ρ)) :
    RawGens.WF n gs ∧ gs.length ≤ n * n ∧ RawPerm.WF n ρ := by
  obtain ⟨q, _, hq⟩ := Option.map_eq_some_iff.1 h
  cases hq
  exact ⟨wf_tidyGens hd _, length_tidyGens hd _,
    wf_rawMul (wf_normPerm hd _) (wf_normPerm hd _)⟩

theorem polyFun_top3Shift : PolyFun top3Shift := by
  have hbody : PolyFun (fun z : (RawGens × RawPerm) × (List ℕ × RawPerm × RawCoset) =>
      (some (tidyGens (z.2.1, z.1.1),
        rawMul (normPerm (z.2.1, z.2.2.1), normPerm (z.2.1, z.1.2))) : RawCoset)) := by
    have hd : PolyFun (fun z : (RawGens × RawPerm) × (List ℕ × RawPerm × RawCoset) => z.2.1) :=
      polyFun_snd.comp polyFun_fst
    have hg : PolyFun (fun z : (RawGens × RawPerm) × (List ℕ × RawPerm × RawCoset) =>
        tidyGens (z.2.1, z.1.1)) :=
      (hd.pair (polyFun_fst.comp polyFun_fst)).comp polyFun_tidyGens
    have hr : PolyFun (fun z : (RawGens × RawPerm) × (List ℕ × RawPerm × RawCoset) =>
        normPerm (z.2.1, z.2.2.1)) :=
      (hd.pair ((polyFun_snd.comp polyFun_snd).comp polyFun_fst)).comp polyFun_normPerm
    have hq : PolyFun (fun z : (RawGens × RawPerm) × (List ℕ × RawPerm × RawCoset) =>
        normPerm (z.2.1, z.1.2)) :=
      (hd.pair (polyFun_fst.comp polyFun_snd)).comp polyFun_normPerm
    exact (hg.pair ((hr.pair hq).comp polyFun_rawMul)).comp polyFun_some
  exact (((polyFun_snd.comp polyFun_snd).pair polyFun_id).comp
    (PolyFun.optionElim (polyFun_const (none : RawCoset)) hbody)).of_eq (fun z => by
      cases hz : z.2.2 <;> simp [top3Shift, hz])

/-! ## The data of one instance of Cor. 12.0.8

A raw instance is the action together with the two strings.  Phase 0 is the round of
Cor. 12.0.6 for the *pair* `(x, x)` and the alternating generators — that is the instance
`Algo.top3Top` — and phases 1 and 2 are two kernel instances for the targets `y` and
`y^{τ⁻¹}`. -/

/-- A raw instance of Cor. 12.0.8: the action, the string `x` and the string `y`. -/
abbrev RawTop3 := RawAction × RawStr × RawStr

/-- A node of the round: the top node, or one window instance. -/
abbrev RawTop3Node := RawTop3 × Option RawWinSI

/-- The state of the loop: the current job, the current orbit of `N`, the coset the Chain
Rule has reached, the accumulator of phase 0, and the answers of phases 1 and 2. -/
abbrev Top3State := ℕ × ℕ × RawCoset × Top1State × RawCoset × RawCoset

/-- The domain of the instance. -/
def top3Dom (P : RawTop3) : List ℕ := P.1.1.1

/-- **Phase 0 of Cor. 12.0.8**: Cor. 12.0.6 applied to `(x, x)` with the generators of
`A(Γ)`.  Its answer is `Aut_{G₁}(x)`, and it is empty exactly when `ϕ` does not map
`Aut_G(x)` onto a giant. -/
def top3Top (P : RawTop3) : RawTop1 := (P.1, topAltGens P.1.2.1, P.2.1, P.2.1)

/-- The top tests of phase 0. -/
def top3Tests (P : RawTop3) : List RawTopLift := top2Tests (top3Top P)

/-- The `k` orbits of `N = ker ϕ`. -/
def top3Wins (P : RawTop3) : List (List ℕ) := top2Wins (top3Top P)

/-- The `t`-th top test of phase 0. -/
def top3Test (P : RawTop3) (t : ℕ) : RawTopLift := top2Test (top3Top P) t

/-- The number of jobs: the top tests of phase 0, then phase 1, then phase 2. -/
def top3Jobs (P : RawTop3) : ℕ := (top3Tests P).length + 2

@[simp] theorem top3Top_dom (P : RawTop3) : (top3Top P).1.1.1 = P.1.1.1 := rfl

theorem top3Tests_ne_nil (P : RawTop3) : 0 < (top3Tests P).length := by
  show 0 < (top1Inputs (top3Top P)).length
  rw [length_top1Inputs]
  omega

/-- The source string of phases 1 and 2, forced to the length of the domain. -/
def top3X (P : RawTop3) : RawStr := fixStr (P.1.1.1, P.2.1)

/-- The target string of phase 1. -/
def top3Y (P : RawTop3) : RawStr := fixStr (P.1.1.1, P.2.2)

/-- The computed odd lift `τ` of the Luks descent, the identity when there is none. -/
def top3Odd (P : RawTop3) : RawPerm := (topOddLift P.1).getD (rawOne P.1.1.1)

/-- The target string of phase 2: `y^{τ⁻¹}`. -/
def top3Y' (P : RawTop3) : RawStr := fixStr (P.1.1.1, rawStrAct (rawInv (top3Odd P), P.2.2))

/-- The candidate set phases 1 and 2 start from: the kernel `N`, with the identity as
representative. -/
def top3Start (P : RawTop3) : RawCoset :=
  some (tidyGens (P.1.1.1, topKernel P.1), rawOne P.1.1.1)

/-- The source string of the `t`-th job. -/
def top3Src (P : RawTop3) (t : ℕ) : RawStr :=
  if t < (top3Tests P).length then topWinSrc (top3Test P t) else top3X P

/-- The target string of the `t`-th job. -/
def top3Tgt (P : RawTop3) (t : ℕ) : RawStr :=
  if t < (top3Tests P).length then topWinTgt (top3Test P t)
  else if t = (top3Tests P).length then top3Y P else top3Y' P

/-- The candidate set the `t`-th job starts from. -/
def top3Begin (P : RawTop3) (t : ℕ) : RawCoset :=
  if t < (top3Tests P).length then topWinStart (top3Test P t) else top3Start P

@[simp] theorem top3Src_ge {P : RawTop3} {t : ℕ} (ht : ¬ t < (top3Tests P).length) :
    top3Src P t = top3X P := by rw [top3Src, if_neg ht]

@[simp] theorem top3Begin_ge {P : RawTop3} {t : ℕ} (ht : ¬ t < (top3Tests P).length) :
    top3Begin P t = top3Start P := by rw [top3Begin, if_neg ht]

theorem top3Tgt_one (P : RawTop3) : top3Tgt P (top3Tests P).length = top3Y P := by
  rw [top3Tgt, if_neg (by omega), if_pos rfl]

theorem top3Tgt_two (P : RawTop3) : top3Tgt P ((top3Tests P).length + 1) = top3Y' P := by
  rw [top3Tgt, if_neg (by omega), if_neg (by omega)]

/-- The window instance the round hands on at the state `(t, i, c)`. -/
def top3Leaf (P : RawTop3) (t i : ℕ) (c : RawGens × RawPerm) : RawWinSI :=
  ((top3Wins P).getD i [], tidyGens (top3Src P t, c.1), normPerm (top3Src P t, c.2),
    top3Src P t, top3Tgt P t)

/-- The instance a node describes: `Iso_G(x,y)` on the full window at the top node, and the
window instance stored at a child. -/
noncomputable def decTop3Node (n : ℕ) (I : RawTop3Node) : SIInstance (Fin n) ℕ :=
  I.2.elim (decFullSI n (I.1.1.1.2, I.1.2.1, I.1.2.2)) (decWinSI n)

/-! ## The loop -/

/-- The `j`-th child of the top node: the `i`-th orbit of `N` inside the `t`-th job. -/
def top3Child (z : RawTop3Node × ℕ × Top3State) : Option RawTop3Node :=
  z.1.2.elim
    (if z.2.2.1 < top3Jobs z.1.1 ∧ z.2.2.2.1 < (top3Wins z.1.1).length ∧
        z.2.1 < top3Jobs z.1.1 * (top3Wins z.1.1).length then
      (z.2.2.2.2.1).map (fun c => (z.1.1, some (top3Leaf z.1.1 z.2.2.1 z.2.2.2.1 c)))
     else none)
    (fun _ => none)

/-- The accumulator of phase 0 after the `t`-th test is closed with the answer `a`. -/
def top3Join (P : RawTop3) (t : ℕ) (acc : Top1State) (a : RawCoset) : Top1State :=
  top2NormS (top3Dom P) (top1Join (top3Dom P, acc,
    topLiftFinish (top3Dom P, topLiftPrepare (top3Test P t), a)))

/-- **The adaptive step**, on unpacked arguments.  While the chain of the current job is
alive and has orbits left, the answer becomes the next candidate set.  Otherwise the job is
closed, and the next one is opened in the same step.  Closing the last test of phase 0 opens
phase 1, or stops at once when the giant test failed; closing phase 1 opens phase 2, or
stops when the image of the action is contained in `A(Γ)`. -/
def top3Step (P : RawTop3) (t i : ℕ) (acc : Top1State) (s1 s2 a : RawCoset) : Top3State :=
  if a.isSome = true ∧ i + 1 < (top3Wins P).length then
    (min t (top3Jobs P), min (i + 1) (top3Wins P).length, top2NormC (top3Dom P) a, top2NormS (top3Dom P) acc,
      top2NormC (top3Dom P) s1, top2NormC (top3Dom P) s2)
  else if t + 1 < (top3Tests P).length then
    (t + 1, 0, top3Begin P (t + 1), top3Join P t acc a,
      top2NormC (top3Dom P) s1, top2NormC (top3Dom P) s2)
  else if t + 1 = (top3Tests P).length then
    (if ((top3Join P t acc a).getD none).isSome then (top3Tests P).length else top3Jobs P,
      0, top3Begin P (top3Tests P).length, top3Join P t acc a,
      top2NormC (top3Dom P) s1, top2NormC (top3Dom P) s2)
  else if t = (top3Tests P).length then
    (if topAllEven P.1 then top3Jobs P else (top3Tests P).length + 1, 0,
      top3Begin P ((top3Tests P).length + 1), top2NormS (top3Dom P) acc,
      top2NormC (top3Dom P) a, top2NormC (top3Dom P) s2)
  else
    (top3Jobs P, 0, top3Begin P (top3Jobs P), top2NormS (top3Dom P) acc,
      top2NormC (top3Dom P) s1, top2NormC (top3Dom P) a)

/-- The adaptive step of the round. -/
def top3Combine (z : RawTop3Node × ℕ × Top3State × RawCoset) : Top3State :=
  top3Step z.1.1 z.2.2.1.1 z.2.2.1.2.1 z.2.2.1.2.2.2.1 z.2.2.1.2.2.2.2.1
    z.2.2.1.2.2.2.2.2 z.2.2.2

/-- **The answer of Cor. 12.0.8 read off the final state.**  `Aut_{G₁}(x)` is the
accumulator of phase 0; step (ii) multiplies it by the answer of phase 1 and, in the
descent, joins the shifted answer of phase 2. -/
def top3Answer (P : RawTop3) (s : Top3State) : RawCoset :=
  if topAllEven P.1 then
    top3Prod (top3Dom P, s.2.2.2.2.1, s.2.2.2.1.getD none)
  else
    rawCosetJoin (top3Dom P, top3Prod (top3Dom P, s.2.2.2.2.1, s.2.2.2.1.getD none),
      top3Shift (top3Dom P, top3Odd P,
        top3Prod (top3Dom P, s.2.2.2.2.2, s.2.2.2.1.getD none)))

/-- The answer of a node: the reconstructed coset at the top node, the solver at a child. -/
def top3Finish (solve : RawWinSI → RawCoset) (z : RawTop3Node × Top3State) : RawCoset :=
  z.1.2.elim (top3Answer z.1.1 z.2) solve

/-- Well-formed nodes.  A child records *which* window instance of the top node it is, which
is what bounds its size in terms of the size of the top node. -/
def Top3WF (n : ℕ) (I : RawTop3Node) : Prop :=
  0 < n ∧ I.1.1.1.1.length = n ∧
    ∀ W, I.2 = some W → ∃ t, ∃ i, ∃ c : RawGens × RawPerm,
      t < top3Jobs I.1 ∧ W = top3Leaf I.1 t i c

theorem top3Child_eq_some {z : RawTop3Node × ℕ × Top3State} {J : RawTop3Node}
    (h : top3Child z = some J) :
    ∃ c : RawGens × RawPerm, z.1.2 = none ∧ z.2.2.2.2.1 = some c ∧
      z.2.2.1 < top3Jobs z.1.1 ∧ z.2.2.2.1 < (top3Wins z.1.1).length ∧
      z.2.1 < top3Jobs z.1.1 * (top3Wins z.1.1).length ∧
      J = (z.1.1, some (top3Leaf z.1.1 z.2.2.1 z.2.2.2.1 c)) := by
  rcases ho : z.1.2 with _ | W
  · rw [top3Child, ho, Option.elim_none] at h
    by_cases hcond : z.2.2.1 < top3Jobs z.1.1 ∧ z.2.2.2.1 < (top3Wins z.1.1).length ∧
        z.2.1 < top3Jobs z.1.1 * (top3Wins z.1.1).length
    · rw [if_pos hcond] at h
      rcases hs : z.2.2.2.2.1 with _ | c
      · rw [hs] at h; simp at h
      · rw [hs] at h
        simp only [Option.map_some] at h
        exact ⟨c, rfl, rfl, hcond.1, hcond.2.1, hcond.2.2, (Option.some.inj h).symm⟩
    · rw [if_neg hcond] at h; simp at h
  · rw [top3Child, ho] at h; simp at h

theorem top3Child_eq_some_of {P : RawTop3} {j t i : ℕ} {c : RawGens × RawPerm}
    {acc : Top1State} {s1 s2 : RawCoset} (ht : t < top3Jobs P)
    (hi : i < (top3Wins P).length) (hj : j < top3Jobs P * (top3Wins P).length) :
    top3Child (((P, none) : RawTop3Node), j, (t, i, (some c : RawCoset), acc, s1, s2)) =
      some (P, some (top3Leaf P t i c)) := by
  rw [top3Child]
  simp only [Option.elim_none]
  rw [if_pos ⟨ht, hi, hj⟩]
  rfl

/-- **Corollary 12.0.8 as a computable round.** -/
def top3Round (n : ℕ) (solve : RawWinSI → RawCoset) :
    Round RawTop3Node Top3State RawCoset where
  WF := Top3WF n
  ground := fun I => Enc.size I.1
  measure := fun I => I.2.elim 1 (fun _ => 0)
  width := fun I => I.2.elim (top3Jobs I.1 * (top3Wins I.1).length) (fun _ => 0)
  child := top3Child
  init := fun I => (0, 0, top3Begin I.1 0, some none, none, none)
  combine := top3Combine
  finish := top3Finish solve
  bot := none
  child_eq_none := by
    rintro ⟨P, o⟩ j s hj
    cases o with
    | some W => rfl
    | none =>
        simp only [Option.elim_none] at hj
        show top3Child ((P, none), j, s) = none
        simp only [top3Child, Option.elim_none]
        rw [if_neg (fun h => absurd h.2.2 (by omega))]
  child_wf := by
    intro I j s J hI hc
    obtain ⟨c, ho, -, ht, -, -, rfl⟩ := top3Child_eq_some (z := (I, j, s)) hc
    refine ⟨hI.1, hI.2.1, fun W hW => ⟨s.1, s.2.1, c, ht, ?_⟩⟩
    cases hW
    rfl
  child_measure := by
    intro I j s J hI hc
    obtain ⟨c, ho, -, -, -, -, rfl⟩ := top3Child_eq_some (z := (I, j, s)) hc
    show (0 : ℕ) < I.2.elim 1 (fun _ => 0)
    rw [ho]
    exact Nat.zero_lt_one
  child_ground := by
    intro I j s J hI hc
    obtain ⟨c, ho, -, -, -, -, rfl⟩ := top3Child_eq_some (z := (I, j, s)) hc
    exact le_refl _

theorem top3Child_done {P : RawTop3} {j : ℕ} {s : Top3State} (ht : ¬ s.1 < top3Jobs P) :
    top3Child (((P, none) : RawTop3Node), j, s) = none := by
  simp only [top3Child, Option.elim_none]
  rw [if_neg (fun h => ht h.1)]

/-! ## The mathematical round

The tree of Cor. 12.0.8 with the choices the RAM routines make: phase 0 is
`Algo.top2Tail`, the tree of Cor. 12.0.6 for `(x, x)`, and the two other phases are two
Luks chains over the same orbits.  The answer is reconstructed by `Algo.top3Final`, which is
the coset hull of a product — a function of the two answer **sets**, and exactly what
`Algo.top3Answer` computes. -/

/-- **Step (ii) of Cor. 12.0.8, as a function of the answer sets.**  In the alternating
branch the answer is the hull of `Iso_N(x,y)·Aut_{G₁}(x)`; in the descent the two branches
are joined, the second one shifted by the odd lift. -/
noncomputable def top3Final (n : ℕ) (P : RawTop3) (r0 s1 s2 : Set (Perm (Fin n))) :
    Set (Perm (Fin n)) :=
  if topAllEven P.1 then cosetHull (s1 * r0)
  else cosetHull (cosetHull (s1 * r0) ∪ decPerm n (top3Odd P) • cosetHull (s2 * r0))

theorem top3Final_empty (n : ℕ) (P : RawTop3) (s1 s2 : Set (Perm (Fin n))) :
    top3Final n P ∅ s1 s2 = ∅ := by
  rw [top3Final]
  split_ifs <;> simp [Set.mul_empty]

/-- Phase 2: the chain for the shifted target, then the answer. -/
noncomputable def top3Chain2 (n : ℕ) (P : RawTop3) (r0 s1 : Set (Perm (Fin n)))
    (rest : List (List ℕ)) (C : Set (Perm (Fin n))) : SIReduction (Fin n) ℕ (Set (Perm (Fin n))) :=
  (cosetChain (decStrN n (top3X P)) (decStrN n (top3Y' P)) (rest.map (winSet n)) C).bind
    (fun z => .done (top3Final n P r0 s1 z))

/-- Phase 1: the chain for `y`, then either the answer or phase 2. -/
noncomputable def top3Chain1 (n : ℕ) (P : RawTop3) (r0 : Set (Perm (Fin n)))
    (rest : List (List ℕ)) (C : Set (Perm (Fin n))) : SIReduction (Fin n) ℕ (Set (Perm (Fin n))) :=
  (cosetChain (decStrN n (top3X P)) (decStrN n (top3Y P)) (rest.map (winSet n)) C).bind
    (fun z => if topAllEven P.1 then .done (top3Final n P r0 z ∅)
      else top3Chain2 n P r0 z (top3Wins P) (decCoset n (top3Start P)))

/-- What happens after phase 0: nothing when the giant test failed. -/
noncomputable def top3Enter (n : ℕ) (P : RawTop3) (r0 : Set (Perm (Fin n))) :
    SIReduction (Fin n) ℕ (Set (Perm (Fin n))) :=
  if r0 = ∅ then .done ∅ else top3Chain1 n P r0 (top3Wins P) (decCoset n (top3Start P))

/-- **Corollary 12.0.8 with the computed choices.** -/
noncomputable def top3RoundReduction (n : ℕ) (solve : RawWinSI → RawCoset) (I : RawTop3Node) :
    SIReduction (Fin n) ℕ (Set (Perm (Fin n))) :=
  I.2.elim ((top2Tail n (top3Wins I.1) (top3Tests I.1) (some ∅)).bind (top3Enter n I.1))
    (fun W => .done (decCoset n (solve W)))

/-! ## The shapes the matching proof needs -/

section Shapes

variable {n : ℕ} {P : RawTop3}

theorem length_top3Src (hd : P.1.1.1.length = n) (t : ℕ) : (top3Src P t).length = n := by
  rw [top3Src]
  split_ifs
  · exact length_topWinSrc hd t
  · rw [top3X, length_fixStr, hd]

theorem length_top3Tgt (hd : P.1.1.1.length = n) (t : ℕ) : (top3Tgt P t).length = n := by
  rw [top3Tgt]
  split_ifs
  · exact length_topWinTgt hd t
  · rw [top3Y, length_fixStr, hd]
  · rw [top3Y', length_fixStr, hd]

theorem top3LeafWF (hd : P.1.1.1.length = n) (t i : ℕ) (c : RawGens × RawPerm) :
    Top2LeafWF n (top3Leaf P t i c) := by
  have hs := length_top3Src hd t
  exact ⟨hs, length_top3Tgt hd t, (top2Wins_getD_wf hd i).1, (top2Wins_getD_wf hd i).2,
    wf_tidyGens hs _, length_tidyGens hs _, wf_normPerm hs _⟩

theorem decTop3Node_leaf (hd : P.1.1.1.length = n) (t i : ℕ) (c : RawGens × RawPerm) :
    decTop3Node n (P, some (top3Leaf P t i c)) =
      ⟨decCoset n (some c), winSet n ((top3Wins P).getD i []),
        decStrN n (top3Src P t), decStrN n (top3Tgt P t)⟩ := by
  have hs := length_top3Src hd t
  show decWinSI n (top3Leaf P t i c) = _
  rw [decWinSI, top3Leaf]
  simp only
  rw [decCoset_some, decGroup_tidyGens hs, decPerm_normPerm hs, ← decCoset_some]

theorem top3Wins_ne_nil' (hn : 0 < n) (hd : P.1.1.1.length = n) : 0 < (top3Wins P).length :=
  top2Wins_ne_nil hn hd

theorem decCoset_top2NormS_getD {dom : List ℕ} (hd : dom.length = n) (acc : Top1State) :
    decCoset n ((top2NormS dom acc).getD none) = decCoset n (acc.getD none) := by
  cases acc with
  | none => rfl
  | some c => exact decCoset_top2NormC hd c

theorem decCoset_top3Answer (hd : P.1.1.1.length = n) (s : Top3State) :
    decCoset n (top3Answer P s) =
      top3Final n P (decCoset n (s.2.2.2.1.getD none)) (decCoset n s.2.2.2.2.1)
        (decCoset n s.2.2.2.2.2) := by
  have hdom : (top3Dom P).length = n := hd
  rw [top3Answer, top3Final]
  split_ifs with h
  · exact decCoset_top3Prod hdom _ _
  · rw [decCoset_rawCosetJoin hdom, decCoset_top3Prod hdom, decCoset_top3Shift hdom,
      decCoset_top3Prod hdom]

theorem top3Branch_start_index (n : ℕ) (P : RawTop3) (t : ℕ)
    (acc : Option (Set (Perm (Fin n)))) :
    top2Branch n (top3Wins P) ((top3Tests P).drop t) (top3Wins P)
        (decCoset n (topWinStart (top3Test P t))) acc
      = top2Tail n (top3Wins P) ((top3Tests P).drop t) acc :=
  top2Branch_start_index n (top3Top P) t acc

theorem top3Branch_start_zero (n : ℕ) (P : RawTop3) (acc : Option (Set (Perm (Fin n)))) :
    top2Branch n (top3Wins P) (top3Tests P) (top3Wins P)
        (decCoset n (topWinStart (top3Test P 0))) acc
      = top2Tail n (top3Wins P) (top3Tests P) acc :=
  top2Branch_start_zero n (top3Top P) acc

theorem decTop1State_getD (s : Top1State) :
    (decTop1State n s).getD ∅ = decCoset n (s.getD none) := by
  cases s <;> rfl

end Shapes

/-- Binding a finished reduction. -/
theorem done_bind {Ω A α β : Type*} (v : α) (f : α → SIReduction Ω A β) :
    (SIReduction.done v).bind f = f v := rfl

/-! ## The matching proof

Three inductions, one per phase, each on the remaining budget `w`.  The budget invariant is
uniform: at the job `t` with the orbit `i` there are `(jobs - t)·k - i` calls left, where
`jobs` counts the top tests of phase 0 and the two later phases.  The last step of a phase
hands over to the next lemma, in the same `combine` that closes the job. -/

section Match

variable {n : ℕ} {P : RawTop3}

/-- **Phase 2**: the chain for the shifted target `y^{τ⁻¹}`, then the answer. -/
theorem loopMatch_top3_two (solve : RawWinSI → RawCoset) (hd : P.1.1.1.length = n) :
    ∀ (w i j : ℕ) (c : RawCoset) (acc : Top1State) (s1 s2 : RawCoset),
      c.isSome = true → i < (top3Wins P).length →
      j ≤ ((top3Tests P).length + 1) * (top3Wins P).length + i →
      (top3Wins P).length ≤ w + i →
      LoopMatch (top3Round n solve) (decTop3Node n) (decCoset n) (P, none) w j
        ((top3Tests P).length + 1, i, c, acc, s1, s2)
        ((cosetChain (decStrN n (top3X P)) (decStrN n (top3Y' P))
            (((top3Wins P).drop i).map (winSet n)) (decCoset n c)).bind
          (fun z => .done (top3Final n P (decCoset n (acc.getD none)) (decCoset n s1) z))) := by
  have hdom : (top3Dom P).length = n := hd
  intro w
  induction w with
  | zero => intro i j c acc s1 s2 _ hi _ hb; exact absurd hb (by omega)
  | succ w ih =>
      intro i j c acc s1 s2 hc hi hj hb
      obtain ⟨q, hq⟩ : ∃ q, c = some q := Option.isSome_iff_exists.1 hc
      subst hq
      have hCne : decCoset n (some q) ≠ ∅ := by
        intro h
        exact absurd ((decCoset_eq_empty_iff n _).1 h) (by simp)
      have hW : (top3Wins P).drop i
          = ((top3Wins P)[i]'hi) :: (top3Wins P).drop (i + 1) := List.drop_eq_getElem_cons hi
      have hgetd : (top3Wins P).getD i [] = (top3Wins P)[i]'hi :=
        List.getD_eq_getElem _ _ hi
      have hexp : ((top3Tests P).length + 2) * (top3Wins P).length
          = ((top3Tests P).length + 1) * (top3Wins P).length + (top3Wins P).length := by ring
      have hjlt : j < top3Jobs P * (top3Wins P).length := by rw [top3Jobs, hexp]; omega
      set J : RawTop3Node := (P, some (top3Leaf P ((top3Tests P).length + 1) i q)) with hJ
      have hdec : decTop3Node n J
          = ⟨decCoset n (some q), winSet n ((top3Wins P)[i]'hi),
              decStrN n (top3X P), decStrN n (top3Y' P)⟩ := by
        rw [hJ, decTop3Node_leaf hd, hgetd, top3Src_ge (by omega), top3Tgt_two]
      have hchild : (top3Round n solve).child
          (((P, none) : RawTop3Node), j,
            (((top3Tests P).length + 1, i, (some q : RawCoset), acc, s1, s2) : Top3State))
            = some J := top3Child_eq_some_of (by rw [top3Jobs]; omega) hi hjlt
      rw [hW, List.map_cons, cosetChain, if_neg hCne, bind_call, ← hdec]
      refine LoopMatch.call w j _ J _ hchild ?_
      intro a ha
      by_cases hA : a.isSome = true ∧ i + 1 < (top3Wins P).length
      · have hcomb : (top3Round n solve).combine
            (((P, none) : RawTop3Node), j,
              (((top3Tests P).length + 1, i, (some q : RawCoset), acc, s1, s2) : Top3State), a)
              = ((top3Tests P).length + 1, i + 1, top2NormC (top3Dom P) a,
                  top2NormS (top3Dom P) acc, top2NormC (top3Dom P) s1,
                  top2NormC (top3Dom P) s2) := by
          show top3Step _ _ _ _ _ _ _ = _
          rw [top3Step, if_pos hA, Nat.min_eq_left (show (top3Tests P).length + 1 ≤ top3Jobs P by rw [top3Jobs]; omega),
            Nat.min_eq_left (le_of_lt hA.2)]
        rw [hcomb]
        have hnext := ih (i + 1) (j + 1) (top2NormC (top3Dom P) a) (top2NormS (top3Dom P) acc)
          (top2NormC (top3Dom P) s1) (top2NormC (top3Dom P) s2)
          (by rw [isSome_top2NormC]; exact hA.1) hA.2 (by omega) (by omega)
        simp only [decCoset_top2NormC hdom, decCoset_top2NormS_getD hdom, ha] at hnext
        exact hnext
      · have hcomb : (top3Round n solve).combine
            (((P, none) : RawTop3Node), j,
              (((top3Tests P).length + 1, i, (some q : RawCoset), acc, s1, s2) : Top3State), a)
              = (top3Jobs P, 0, top3Begin P (top3Jobs P), top2NormS (top3Dom P) acc,
                  top2NormC (top3Dom P) s1, top2NormC (top3Dom P) a) := by
          show top3Step _ _ _ _ _ _ _ = _
          rw [top3Step, if_neg hA,
            if_neg (show ¬ ((top3Tests P).length + 1 + 1 < (top3Tests P).length) by omega),
            if_neg (show ¬ ((top3Tests P).length + 1 + 1 = (top3Tests P).length) by omega),
            if_neg (show ¬ ((top3Tests P).length + 1 = (top3Tests P).length) by omega)]
        rw [hcomb]
        have hstop : (cosetChain (decStrN n (top3X P)) (decStrN n (top3Y' P))
            (((top3Wins P).drop (i + 1)).map (winSet n)) (decTop3Node n J).answer)
            = .done (decTop3Node n J).answer := by
          rcases ha' : a with _ | q'
          · have hz : (decTop3Node n J).answer = ∅ := by rw [← ha, ha']; rfl
            rw [hz, cosetChain_empty]
          · have hik : (top3Wins P).drop (i + 1) = [] :=
              List.drop_eq_nil_of_le (by
                have : ¬ (i + 1 < (top3Wins P).length) := by
                  intro hlt; exact hA ⟨by rw [ha']; rfl, hlt⟩
                omega)
            rw [hik, List.map_nil, cosetChain]
        show LoopMatch _ _ _ _ _ _ _ ((cosetChain _ _ _ (decTop3Node n J).answer).bind _)
        rw [hstop]
        refine LoopMatch.done w (j + 1) _ _ ?_ ?_
        · exact top3Child_done (by rw [top3Jobs]; omega)
        · show decCoset n (top3Answer P _) = _
          rw [decCoset_top3Answer hd]
          simp only [decCoset_top2NormC hdom, decCoset_top2NormS_getD hdom, ha]

/-- **Phase 1**: the chain for `y`, then the answer or phase 2. -/
theorem loopMatch_top3_one (solve : RawWinSI → RawCoset) (hd : P.1.1.1.length = n) :
    ∀ (w i j : ℕ) (c : RawCoset) (acc : Top1State) (s1 s2 : RawCoset),
      c.isSome = true → i < (top3Wins P).length →
      j ≤ (top3Tests P).length * (top3Wins P).length + i →
      2 * (top3Wins P).length ≤ w + i →
      LoopMatch (top3Round n solve) (decTop3Node n) (decCoset n) (P, none) w j
        ((top3Tests P).length, i, c, acc, s1, s2)
        ((cosetChain (decStrN n (top3X P)) (decStrN n (top3Y P))
            (((top3Wins P).drop i).map (winSet n)) (decCoset n c)).bind
          (fun z => if topAllEven P.1 then
              .done (top3Final n P (decCoset n (acc.getD none)) z ∅)
            else top3Chain2 n P (decCoset n (acc.getD none)) z (top3Wins P)
              (decCoset n (top3Start P)))) := by
  have hdom : (top3Dom P).length = n := hd
  intro w
  induction w with
  | zero => intro i j c acc s1 s2 _ hi _ hb; exact absurd hb (by omega)
  | succ w ih =>
      intro i j c acc s1 s2 hc hi hj hb
      obtain ⟨q, hq⟩ : ∃ q, c = some q := Option.isSome_iff_exists.1 hc
      subst hq
      have hCne : decCoset n (some q) ≠ ∅ := by
        intro h
        exact absurd ((decCoset_eq_empty_iff n _).1 h) (by simp)
      have hW : (top3Wins P).drop i
          = ((top3Wins P)[i]'hi) :: (top3Wins P).drop (i + 1) := List.drop_eq_getElem_cons hi
      have hgetd : (top3Wins P).getD i [] = (top3Wins P)[i]'hi :=
        List.getD_eq_getElem _ _ hi
      have hexp : ((top3Tests P).length + 2) * (top3Wins P).length
          = (top3Tests P).length * (top3Wins P).length + 2 * (top3Wins P).length := by ring
      have hexp1 : ((top3Tests P).length + 1) * (top3Wins P).length
          = (top3Tests P).length * (top3Wins P).length + (top3Wins P).length := by ring
      have hjlt : j < top3Jobs P * (top3Wins P).length := by rw [top3Jobs, hexp]; omega
      set J : RawTop3Node := (P, some (top3Leaf P (top3Tests P).length i q)) with hJ
      have hdec : decTop3Node n J
          = ⟨decCoset n (some q), winSet n ((top3Wins P)[i]'hi),
              decStrN n (top3X P), decStrN n (top3Y P)⟩ := by
        rw [hJ, decTop3Node_leaf hd, hgetd, top3Src_ge (by omega), top3Tgt_one]
      have hchild : (top3Round n solve).child
          (((P, none) : RawTop3Node), j,
            (((top3Tests P).length, i, (some q : RawCoset), acc, s1, s2) : Top3State))
            = some J := top3Child_eq_some_of (by rw [top3Jobs]; omega) hi hjlt
      rw [hW, List.map_cons, cosetChain, if_neg hCne, bind_call, ← hdec]
      refine LoopMatch.call w j _ J _ hchild ?_
      intro a ha
      by_cases hA : a.isSome = true ∧ i + 1 < (top3Wins P).length
      · have hcomb : (top3Round n solve).combine
            (((P, none) : RawTop3Node), j,
              (((top3Tests P).length, i, (some q : RawCoset), acc, s1, s2) : Top3State), a)
              = ((top3Tests P).length, i + 1, top2NormC (top3Dom P) a,
                  top2NormS (top3Dom P) acc, top2NormC (top3Dom P) s1,
                  top2NormC (top3Dom P) s2) := by
          show top3Step _ _ _ _ _ _ _ = _
          rw [top3Step, if_pos hA, Nat.min_eq_left (show (top3Tests P).length ≤ top3Jobs P by rw [top3Jobs]; omega),
            Nat.min_eq_left (le_of_lt hA.2)]
        rw [hcomb]
        have hnext := ih (i + 1) (j + 1) (top2NormC (top3Dom P) a) (top2NormS (top3Dom P) acc)
          (top2NormC (top3Dom P) s1) (top2NormC (top3Dom P) s2)
          (by rw [isSome_top2NormC]; exact hA.1) hA.2 (by omega) (by omega)
        simp only [decCoset_top2NormC hdom, decCoset_top2NormS_getD hdom, ha] at hnext
        exact hnext
      · have hcomb : (top3Round n solve).combine
            (((P, none) : RawTop3Node), j,
              (((top3Tests P).length, i, (some q : RawCoset), acc, s1, s2) : Top3State), a)
              = ((if topAllEven P.1 then top3Jobs P else (top3Tests P).length + 1), 0,
                  top3Begin P ((top3Tests P).length + 1), top2NormS (top3Dom P) acc,
                  top2NormC (top3Dom P) a, top2NormC (top3Dom P) s2) := by
          show top3Step _ _ _ _ _ _ _ = _
          rw [top3Step, if_neg hA,
            if_neg (show ¬ ((top3Tests P).length + 1 < (top3Tests P).length) by omega),
            if_neg (show ¬ ((top3Tests P).length + 1 = (top3Tests P).length) by omega),
            if_pos rfl]
        rw [hcomb]
        have hstop : (cosetChain (decStrN n (top3X P)) (decStrN n (top3Y P))
            (((top3Wins P).drop (i + 1)).map (winSet n)) (decTop3Node n J).answer)
            = .done (decTop3Node n J).answer := by
          rcases ha' : a with _ | q'
          · have hz : (decTop3Node n J).answer = ∅ := by rw [← ha, ha']; rfl
            rw [hz, cosetChain_empty]
          · have hik : (top3Wins P).drop (i + 1) = [] :=
              List.drop_eq_nil_of_le (by
                have : ¬ (i + 1 < (top3Wins P).length) := by
                  intro hlt; exact hA ⟨by rw [ha']; rfl, hlt⟩
                omega)
            rw [hik, List.map_nil, cosetChain]
        show LoopMatch _ _ _ _ _ _ _ ((cosetChain _ _ _ (decTop3Node n J).answer).bind _)
        rw [hstop, done_bind]
        by_cases hev : topAllEven P.1 = true
        · rw [if_pos hev, if_pos hev]
          refine LoopMatch.done w (j + 1) _ _ ?_ ?_
          · exact top3Child_done (by rw [top3Jobs]; omega)
          · show decCoset n (top3Answer P _) = _
            rw [decCoset_top3Answer hd]
            simp only [decCoset_top2NormC hdom, decCoset_top2NormS_getD hdom, ha]
            rw [top3Final, top3Final, if_pos hev, if_pos hev]
        · rw [if_neg hev, if_neg hev, top3Begin_ge (by omega)]
          have hnext := loopMatch_top3_two (P := P) solve hd w 0 (j + 1) (top3Start P)
            (top2NormS (top3Dom P) acc) (top2NormC (top3Dom P) a) (top2NormC (top3Dom P) s2)
            rfl (by omega) (by omega) (by omega)
          rw [List.drop_zero] at hnext
          simp only [decCoset_top2NormC hdom, decCoset_top2NormS_getD hdom, ha] at hnext
          exact hnext

/-- **Phase 0**: the tree of Cor. 12.0.6 for the pair `(x, x)`, followed by the two later
phases. -/
theorem loopMatch_top3_zero (solve : RawWinSI → RawCoset) (hn : 0 < n)
    (hd : P.1.1.1.length = n) :
    ∀ (w t i j : ℕ) (c : RawCoset) (acc : Top1State) (s1 s2 : RawCoset),
      c.isSome = true → i < (top3Wins P).length → t < (top3Tests P).length →
      j ≤ t * (top3Wins P).length + i →
      (top3Jobs P - t) * (top3Wins P).length ≤ w + i →
      LoopMatch (top3Round n solve) (decTop3Node n) (decCoset n) (P, none) w j
        (t, i, c, acc, s1, s2)
        ((top2Branch n (top3Wins P) ((top3Tests P).drop t) ((top3Wins P).drop i)
            (decCoset n c) (decTop1State n acc)).bind (top3Enter n P)) := by
  have hdom : (top3Dom P).length = n := hd
  have hk : 0 < (top3Wins P).length := top3Wins_ne_nil' hn hd
  intro w
  induction w with
  | zero =>
      intro t i j c acc s1 s2 _ hi ht _ hb
      have h2 : 1 * (top3Wins P).length ≤ (top3Jobs P - t) * (top3Wins P).length :=
        Nat.mul_le_mul_right _ (by rw [top3Jobs]; omega)
      exact absurd hb (by omega)
  | succ w ih =>
      intro t i j c acc s1 s2 hc hi ht hj hb
      obtain ⟨q, hq⟩ : ∃ q, c = some q := Option.isSome_iff_exists.1 hc
      subst hq
      have hCne : decCoset n (some q) ≠ ∅ := by
        intro h
        exact absurd ((decCoset_eq_empty_iff n _).1 h) (by simp)
      have hW : (top3Wins P).drop i
          = ((top3Wins P)[i]'hi) :: (top3Wins P).drop (i + 1) := List.drop_eq_getElem_cons hi
      have hgetd : (top3Wins P).getD i [] = (top3Wins P)[i]'hi :=
        List.getD_eq_getElem _ _ hi
      have hmul : (t + 1) * (top3Wins P).length
          ≤ (top3Tests P).length * (top3Wins P).length :=
        Nat.mul_le_mul_right _ (by omega)
      have hexp : (t + 1) * (top3Wins P).length
          = t * (top3Wins P).length + (top3Wins P).length := by ring
      have hjobs : top3Jobs P * (top3Wins P).length
          = (top3Tests P).length * (top3Wins P).length + 2 * (top3Wins P).length := by
        rw [top3Jobs]; ring
      have hjlt : j < top3Jobs P * (top3Wins P).length := by rw [hjobs]; omega
      have hstep : (top3Jobs P - t) * (top3Wins P).length
          = (top3Jobs P - (t + 1)) * (top3Wins P).length + (top3Wins P).length := by
        have he : top3Jobs P - t = (top3Jobs P - (t + 1)) + 1 := by rw [top3Jobs]; omega
        rw [he]; ring
      have hL : (top3Tests P).drop t = top3Test P t :: (top3Tests P).drop (t + 1) := by
        rw [List.drop_eq_getElem_cons ht]
        exact congrArg (fun z => z :: _) (top2Test_eq_getElem (top3Top P) ht).symm
      have hsrc : top3Src P t = topWinSrc (top3Test P t) := by rw [top3Src, if_pos ht]
      have htgt : top3Tgt P t = topWinTgt (top3Test P t) := by rw [top3Tgt, if_pos ht]
      set J : RawTop3Node := (P, some (top3Leaf P t i q)) with hJ
      have hdec : decTop3Node n J
          = ⟨decCoset n (some q), winSet n ((top3Wins P)[i]'hi),
              decStrN n (topWinSrc (top3Test P t)), decStrN n (topWinTgt (top3Test P t))⟩ := by
        rw [hJ, decTop3Node_leaf hd, hgetd, hsrc, htgt]
      have hchild : (top3Round n solve).child
          (((P, none) : RawTop3Node), j, ((t, i, (some q : RawCoset), acc, s1, s2) : Top3State))
            = some J := top3Child_eq_some_of (by rw [top3Jobs]; omega) hi hjlt
      rw [hL, top2Branch_cons, hW, List.map_cons, cosetChain, if_neg hCne, bind_call,
        bind_call, ← hdec]
      refine LoopMatch.call w j _ J _ hchild ?_
      intro a ha
      by_cases hA : a.isSome = true ∧ i + 1 < (top3Wins P).length
      · have hcomb : (top3Round n solve).combine
            (((P, none) : RawTop3Node), j,
              ((t, i, (some q : RawCoset), acc, s1, s2) : Top3State), a)
              = (t, i + 1, top2NormC (top3Dom P) a, top2NormS (top3Dom P) acc,
                  top2NormC (top3Dom P) s1, top2NormC (top3Dom P) s2) := by
          show top3Step _ _ _ _ _ _ _ = _
          rw [top3Step, if_pos hA, Nat.min_eq_left (show t ≤ top3Jobs P by rw [top3Jobs]; omega),
            Nat.min_eq_left (le_of_lt hA.2)]
        rw [hcomb]
        have hnext := ih t (i + 1) (j + 1) (top2NormC (top3Dom P) a)
          (top2NormS (top3Dom P) acc) (top2NormC (top3Dom P) s1) (top2NormC (top3Dom P) s2)
          (by rw [isSome_top2NormC]; exact hA.1) hA.2 ht (by omega) (by omega)
        rw [decCoset_top2NormC hdom, decTop1State_top2NormS hdom, hL, top2Branch_cons, ha]
          at hnext
        exact hnext
      · have hacc : decTop1State n (top3Join P t acc a)
            = top1JoinSet (decTop1State n acc)
                (topLiftAnswer n (top3Test P t) (decCoset n a)) := by
          rw [top3Join, decTop1State_top2NormS hdom, decTop1State_top1Join hdom]
          exact congrArg (top1JoinSet (decTop1State n acc))
            (decCoset_topLiftFinish (top3Test P t) hd a)
        have hstop : (cosetChain (decStrN n (topWinSrc (top3Test P t)))
            (decStrN n (topWinTgt (top3Test P t)))
            (((top3Wins P).drop (i + 1)).map (winSet n)) (decTop3Node n J).answer)
            = .done (decTop3Node n J).answer := by
          rcases ha' : a with _ | q'
          · have hz : (decTop3Node n J).answer = ∅ := by rw [← ha, ha']; rfl
            rw [hz, cosetChain_empty]
          · have hik : (top3Wins P).drop (i + 1) = [] :=
              List.drop_eq_nil_of_le (by
                have : ¬ (i + 1 < (top3Wins P).length) := by
                  intro hlt; exact hA ⟨by rw [ha']; rfl, hlt⟩
                omega)
            rw [hik, List.map_nil, cosetChain]
        by_cases hlast : t + 1 < (top3Tests P).length
        · have hcomb : (top3Round n solve).combine
              (((P, none) : RawTop3Node), j,
                ((t, i, (some q : RawCoset), acc, s1, s2) : Top3State), a)
                = (t + 1, 0, top3Begin P (t + 1), top3Join P t acc a,
                    top2NormC (top3Dom P) s1, top2NormC (top3Dom P) s2) := by
            show top3Step _ _ _ _ _ _ _ = _
            rw [top3Step, if_neg hA, if_pos hlast]
          rw [hcomb]
          have hnext := ih (t + 1) 0 (j + 1) (top3Begin P (t + 1)) (top3Join P t acc a)
            (top2NormC (top3Dom P) s1) (top2NormC (top3Dom P) s2)
            (by rw [top3Begin, if_pos hlast]; rfl) hk hlast (by omega) (by omega)
          rw [List.drop_zero, top3Begin, if_pos hlast] at hnext
          rw [top3Branch_start_index, hacc, ha] at hnext
          show LoopMatch _ _ _ _ _ _ _
            (((cosetChain _ _ _ (decTop3Node n J).answer).bind _).bind _)
          rw [hstop, done_bind, top3Begin, if_pos hlast]
          exact hnext
        · have hT : t + 1 = (top3Tests P).length := by omega
          have h3 : (top3Jobs P - t) * (top3Wins P).length = 3 * (top3Wins P).length := by
            have he : top3Jobs P - t = 3 := by rw [top3Jobs]; omega
            rw [he]
          have hcomb : (top3Round n solve).combine
              (((P, none) : RawTop3Node), j,
                ((t, i, (some q : RawCoset), acc, s1, s2) : Top3State), a)
                = ((if ((top3Join P t acc a).getD none).isSome then (top3Tests P).length
                      else top3Jobs P), 0, top3Begin P (top3Tests P).length,
                    top3Join P t acc a, top2NormC (top3Dom P) s1,
                    top2NormC (top3Dom P) s2) := by
            show top3Step _ _ _ _ _ _ _ = _
            rw [top3Step, if_neg hA, if_neg hlast, if_pos hT]
          rw [hcomb]
          show LoopMatch _ _ _ _ _ _ _
            (((cosetChain _ _ _ (decTop3Node n J).answer).bind _).bind _)
          rw [hstop]
          have hnil : (top3Tests P).drop (t + 1) = [] := List.drop_eq_nil_of_le (by omega)
          rw [hnil]
          show LoopMatch _ _ _ _ _ _ _
            ((top2Tail n (top3Wins P) [] (top1JoinSet (decTop1State n acc)
              (topLiftAnswer n (top3Test P t) (decTop3Node n J).answer))).bind (top3Enter n P))
          rw [← ha, ← hacc]
          show LoopMatch _ _ _ _ _ _ _
            (top3Enter n P ((decTop1State n (top3Join P t acc a)).getD ∅))
          rw [decTop1State_getD, top3Enter]
          by_cases hr0 : (top3Join P t acc a).getD none = none
          · rw [hr0, if_pos (by rfl : decCoset n (none : RawCoset) = ∅)]
            refine LoopMatch.done w (j + 1) _ _ ?_ ?_
            · refine top3Child_done ?_
              show ¬ (if ((none : RawCoset)).isSome = true then (top3Tests P).length
                else top3Jobs P) < top3Jobs P
              simp only [Option.isSome_none, Bool.false_eq_true, if_false]
              omega
            · show decCoset n (top3Answer P _) = _
              rw [decCoset_top3Answer hd]
              simp only
              rw [hr0]
              exact top3Final_empty n P _ _
          · obtain ⟨u, hu⟩ := Option.ne_none_iff_exists'.1 hr0
            rw [if_neg (show ¬ decCoset n ((top3Join P t acc a).getD none) = ∅ by
                  rw [hu]
                  intro hcon
                  exact absurd ((decCoset_eq_empty_iff n _).1 hcon) (by simp)),
              if_pos (show ((top3Join P t acc a).getD none).isSome = true by rw [hu]; rfl),
              top3Begin_ge (by omega)]
            have hnext := loopMatch_top3_one (P := P) solve hd w 0 (j + 1)
              (top3Start P) (top3Join P t acc a) (top2NormC (top3Dom P) s1)
              (top2NormC (top3Dom P) s2) rfl hk (by omega) (by omega)
            rw [List.drop_zero] at hnext
            exact hnext

/-- **The link (Cor. 12.0.8).**  The round implements the three-phase reduction with the
computed choices. -/
theorem implements_top3Round (solve : RawWinSI → RawCoset) :
    Implements (top3Round n solve) id (decTop3Node n) (decCoset n)
      (top3RoundReduction n solve) := by
  rintro ⟨P', o⟩ hI
  cases o with
  | some W => exact LoopMatch.done 0 0 _ _ rfl rfl
  | none =>
      have hk : 0 < (top3Wins P').length := top3Wins_ne_nil' hI.1 hI.2.1
      have hT : 0 < (top3Tests P').length := top3Tests_ne_nil P'
      have h := loopMatch_top3_zero (P := P') solve hI.1 hI.2.1
        (top3Jobs P' * (top3Wins P').length) 0 0 0 (top3Begin P' 0) (some none) none none
        (by rw [top3Begin, if_pos hT]; rfl) hk hT (by omega) (by simp)
      simp only [List.drop_zero] at h
      rw [top3Begin, if_pos hT] at h
      rw [show (decTop1State n (some none : Top1State)) = some ∅ from rfl,
        top3Branch_start_zero] at h
      exact h

end Match

/-! ## The value

Two facts about sets of permutations turn the round's answer, which is the hull of a
*product*, into the paper's `Babai.cosetUnion`: the union of the translates `σ·B` over
`σ ∈ A` is the set product `A·B`, and a set of isomorphisms is its own hull. -/

section Sets

variable {Ω : Type*} {A : Type*}

/-- `Babai.cosetUnion` is the set product. -/
theorem cosetUnion_eq_mul (s t : Set (Perm Ω)) : Babai.cosetUnion s t = s * t := by
  ext g
  simp only [Babai.cosetUnion, Set.mem_iUnion, exists_prop, Set.mem_mul, Set.mem_smul_set,
    smul_eq_mul]

theorem coe_strAutSubgroup (K : Subgroup (Perm Ω)) (x : Ω → A) :
    ((Babai.strAutSubgroup K x : Subgroup (Perm Ω)) : Set (Perm Ω))
      = Babai.strAut (K : Set (Perm Ω)) x := by
  rw [Babai.strAutSubgroup, Babai.coe_wAutSubgroup, Babai.wAut_univ]

theorem one_mem_strIso_self (K : Subgroup (Perm Ω)) (x : Ω → A) :
    (1 : Perm Ω) ∈ Babai.strIso (K : Set (Perm Ω)) x x := by
  rw [show Babai.strIso (K : Set (Perm Ω)) x x = Babai.strAut (K : Set (Perm Ω)) x from rfl,
    ← coe_strAutSubgroup]
  exact (Babai.strAutSubgroup K x).one_mem

theorem strIso_self_ne_empty (K : Subgroup (Perm Ω)) (x : Ω → A) :
    Babai.strIso (K : Set (Perm Ω)) x x ≠ ∅ := by
  intro hc
  have h := one_mem_strIso_self K x
  rw [hc] at h
  exact h

variable [Fintype Ω] [DecidableEq Ω]

/-- **A set of isomorphisms is its own hull**: it is empty or a coset of `Aut_K(x)`. -/
theorem cosetHull_strIso (K : Subgroup (Perm Ω)) (x y : Ω → A) :
    cosetHull (Babai.strIso (K : Set (Perm Ω)) x y)
      = Babai.strIso (K : Set (Perm Ω)) x y := by
  rcases Set.eq_empty_or_nonempty (Babai.strIso (K : Set (Perm Ω)) x y) with h | ⟨σ, hσ⟩
  · rw [h, cosetHull_empty]
  · rw [Babai.strIso_eq_smul_strAut hσ, ← coe_strAutSubgroup, cosetHull_smul_subgroup]

end Sets

section Value

variable {n m : ℕ} {dom gdom : List ℕ} {gens : List (Perm (Fin n))}
  {imgs : List (Perm (Fin m))} {ϕ : genGroup gens →* Perm (Fin m)}

/-- The raw instance of Cor. 12.0.8 built from typed data. -/
def top3Inst (dom : List ℕ) (gens : List (Perm (Fin n))) (gdom : List ℕ)
    (imgs : List (Perm (Fin m))) (x y : Fin n → ℕ) : RawTop3 :=
  (((dom, gens.map (encPerm n)), (gdom, imgs.map (encPerm m))), encStrN x, encStrN y)

theorem top3Inst_act (x y : Fin n → ℕ) : (top3Inst dom gens gdom imgs x y).1
    = ((dom, gens.map (encPerm n)), (gdom, imgs.map (encPerm m))) := rfl

theorem top3Inst_dom (x y : Fin n → ℕ) : (top3Inst dom gens gdom imgs x y).1.1.1 = dom := rfl

theorem top3Inst_src (x y : Fin n → ℕ) :
    (top3Inst dom gens gdom imgs x y).2.1 = encStrN x := rfl

theorem top3Inst_tgt (x y : Fin n → ℕ) :
    (top3Inst dom gens gdom imgs x y).2.2 = encStrN y := rfl

/-- One Luks chain over the orbits of `N` answers a full-window kernel instance. -/
theorem run_top3Kernel {P : RawTop3} (hd : P.1.1.1.length = n) (a b : RawStr) (C : RawCoset) :
    (cosetChain (decStrN n a) (decStrN n b) ((top3Wins P).map (winSet n)) (decCoset n C)).run
      = Babai.strIso (decCoset n C) (decStrN n a) (decStrN n b) := by
  have h := run_topKernelReduction (n := n) P.1 hd
    ⟨decCoset n C, Set.univ, decStrN n a, decStrN n b⟩ rfl
  rw [topKernelReduction] at h
  rw [show ((top3Wins P).map (winSet n)) = ((topKernelWindows P.1).map (winSet n)) from rfl, h,
    Babai.SIInstance.answer, Babai.wIso_univ]

theorem decStrN_top3X (hd : dom.length = n) (x y : Fin n → ℕ) :
    decStrN n (top3X (top3Inst dom gens gdom imgs x y)) = x := by
  rw [top3X, top3Inst_dom, top3Inst_src, decStrN_fixStr hd, decStrN_encStrN]

theorem decStrN_top3Y (hd : dom.length = n) (x y : Fin n → ℕ) :
    decStrN n (top3Y (top3Inst dom gens gdom imgs x y)) = y := by
  rw [top3Y, top3Inst_dom, top3Inst_tgt, decStrN_fixStr hd, decStrN_encStrN]

theorem decCoset_top3Start (hd : dom.length = n) (hm : gdom.length = m)
    (hI : ImgsOf gens imgs ϕ) (x y : Fin n → ℕ) :
    decCoset n (top3Start (top3Inst dom gens gdom imgs x y))
      = (Babai.kerSubgroup ϕ : Set (Perm (Fin n))) := by
  have h1 : decPerm n (rawOne dom) = 1 := by rw [rawOne_eq, hd, decPerm_encPerm]
  rw [top3Start, top3Inst_dom, top3Inst_act, decCoset_some, decGroup_tidyGens hd,
    decGroup_topKernel hd hm hI, h1, one_smul]

/-- **The value of the round (Cor. 12.0.8).**  It is the value of
`Babai.topAction3Reduction`, the negative decision of item (i) read as the empty answer.

The route is the paper's: phase 0 is `Babai.giantAReduction` for the pair `(x, x)`, which
decides (i) and returns `Aut_{G₁}(x)`; phases 1 and 2 return `Iso_N(x, y)` and
`Iso_N(x, y^{τ⁻¹})`; and the hull of the product `Iso_N(x,y)·Aut_{G₁}(x)` is the paper's
`Babai.cosetUnion`, hence `Iso_{G₁}(x,y)`, because `Iso_{G₁}(x,y)` is already a coset. -/
theorem run_top3RoundReduction_eq_topAction3 (hd : dom.length = n) (hm : gdom.length = m)
    (hI : ImgsOf gens imgs ϕ) (hm3 : 3 ≤ m) (x y : Fin n → ℕ) (solve : RawWinSI → RawCoset) :
    (top3RoundReduction n solve (top3Inst dom gens gdom imgs x y, none)).run
      = ((Babai.topAction3Reduction ϕ x y).run).getD ∅ := by
  classical
  have hPa : (top3Inst dom gens gdom imgs x y).1
      = ((dom, gens.map (encPerm n)), (gdom, imgs.map (encPerm m))) := rfl
  set P : RawTop3 := top3Inst dom gens gdom imgs x y with hP
  have hd' : P.1.1.1.length = n := hd
  have hx : decStrN n (top3X P) = x := decStrN_top3X hd x y
  have hy : decStrN n (top3Y P) = y := decStrN_top3Y hd x y
  have hN : decCoset n (top3Start P) = (Babai.kerSubgroup ϕ : Set (Perm (Fin n))) :=
    decCoset_top3Start hd hm hI x y
  have h0 : (top2Tail n (top3Wins P) (top3Tests P) (some ∅)).run
      = ((Babai.giantAReduction (Babai.altHom ϕ) x x).run).getD ∅ :=
    run_top2RoundReduction_eq_giantA hd hm hI hm3 x x solve
  rw [Babai.run_giantAReduction hm3] at h0
  rw [Babai.run_topAction3Reduction hm3]
  show ((top2Tail n (top3Wins P) (top3Tests P) (some ∅)).bind (top3Enter n P)).run = _
  rw [SIReduction.run_bind, h0]
  by_cases hA : Babai.MapsOntoGiant ϕ x
  · rw [if_pos ((Babai.mapsOnto_altHom_self_iff ϕ x).2 hA), Option.getD_some, if_pos hA,
      Option.getD_some, top3Enter,
      if_neg (strIso_self_ne_empty (Babai.preimageAlt ϕ) x), top3Chain1,
      SIReduction.run_bind, run_top3Kernel hd', hx, hy, hN]
    by_cases hev : topAllEven P.1 = true
    · rw [hPa] at hev
      have hr := (topAllEven_spec dom gdom hI).1 hev
      rw [← hPa] at hev
      rw [if_pos hev, SIReduction.run_done, top3Final, if_pos hev, ← cosetUnion_eq_mul,
        Babai.cosetUnion_strIso_ker ϕ hA, cosetHull_strIso,
        Babai.preimageAlt_eq_of_range_le hr]
    · have hodd : ¬ ϕ.range ≤ alternatingGroup (Fin m) :=
        fun hc => hev ((topAllEven_spec dom gdom hI).2 hc)
      obtain ⟨σ, hσG, hlift, hsodd⟩ := topOddLift_spec hd hm hI hodd
      have hoddP : top3Odd P = encPerm n σ := by rw [top3Odd, hPa, hlift]; rfl
      have hy' : decStrN n (top3Y' P) = Babai.strAct y σ⁻¹ := by
        rw [top3Y', show P.1.1.1 = dom from rfl, show P.2.2 = encStrN y from rfl,
          decStrN_fixStr hd, hoddP, rawInv_encPerm, rawStrAct_encStrN, decStrN_encStrN]
      rw [if_neg hev, top3Chain2, SIReduction.run_bind, ← hN, run_top3Kernel hd', hx, hy', hN,
        SIReduction.run_done, top3Final, if_neg hev, hoddP, decPerm_encPerm,
        ← cosetUnion_eq_mul, ← cosetUnion_eq_mul, Babai.cosetUnion_strIso_ker ϕ hA,
        Babai.cosetUnion_strIso_ker ϕ hA, cosetHull_strIso, cosetHull_strIso,
        ← Babai.strIso_descent ϕ hσG hsodd x y, cosetHull_strIso]
  · rw [if_neg (fun hc => hA ((Babai.mapsOnto_altHom_self_iff ϕ x).1 hc)), if_neg hA,
      Option.getD_none, top3Enter, if_pos rfl, SIReduction.run_done]

/-! ## The calls

The calls split into the `3k` of phase 0 — the alternating branch of Cor. 12.0.6 for
`(x, x)` — and at most `k` for each of the two later phases, so at most `5k ≤ 6k`, the
bound printed in Cor. 12.0.8.  Every call has an orbit of `N` for its window, hence a window
of size `n/k`. -/

theorem top3Top_inst (x y : Fin n → ℕ) :
    top3Top (top3Inst dom gens gdom imgs x y)
      = (((dom, gens.map (encPerm n)), (gdom, imgs.map (encPerm m))),
        topAltGens gdom, encStrN x, encStrN x) := rfl

/-- The two later phases make at most `k` calls each. -/
theorem calls_length_top3Enter (P : RawTop3) (r0 : Set (Perm (Fin n))) :
    (top3Enter n P r0).calls.length ≤ 2 * (top3Wins P).length := by
  classical
  have hone : ∀ (a b : RawStr) (C : Set (Perm (Fin n))),
      (cosetChain (decStrN n a) (decStrN n b) ((top3Wins P).map (winSet n)) C).calls.length
        ≤ (top3Wins P).length := by
    intro a b C
    simpa using (calls_cosetChain (decStrN n a) (decStrN n b)
      ((top3Wins P).map (winSet n)) C).1
  rw [top3Enter]
  split_ifs with h
  · simp
  · rw [top3Chain1, SIReduction.calls_bind, List.length_append]
    have h1 := hone (top3X P) (top3Y P) (decCoset n (top3Start P))
    have h2 : (if topAllEven P.1 then
          (SIReduction.done (top3Final n P r0
            (cosetChain (decStrN n (top3X P)) (decStrN n (top3Y P))
              ((top3Wins P).map (winSet n)) (decCoset n (top3Start P))).run ∅) :
              SIReduction (Fin n) ℕ (Set (Perm (Fin n))))
        else top3Chain2 n P r0
          (cosetChain (decStrN n (top3X P)) (decStrN n (top3Y P))
            ((top3Wins P).map (winSet n)) (decCoset n (top3Start P))).run (top3Wins P)
            (decCoset n (top3Start P))).calls.length ≤ (top3Wins P).length := by
      split_ifs with hev
      · simp
      · rw [top3Chain2, SIReduction.calls_bind, List.length_append]
        have h3 := hone (top3X P) (top3Y' P) (decCoset n (top3Start P))
        simp only [SIReduction.calls_done, List.length_nil]
        omega
    omega

/-- Every call of the two later phases has an orbit of `N` for its window. -/
theorem calls_top3Enter_window (P : RawTop3) (r0 : Set (Perm (Fin n))) :
    ∀ I ∈ (top3Enter n P r0).calls, I.Δ ∈ (top3Wins P).map (winSet n) := by
  classical
  have hone : ∀ (a b : RawStr) (C : Set (Perm (Fin n))),
      ∀ I ∈ (cosetChain (decStrN n a) (decStrN n b) ((top3Wins P).map (winSet n)) C).calls,
        I.Δ ∈ (top3Wins P).map (winSet n) := fun a b C =>
    (calls_cosetChain (decStrN n a) (decStrN n b) ((top3Wins P).map (winSet n)) C).2
  rw [top3Enter]
  split_ifs with h
  · simp
  · rw [top3Chain1, SIReduction.calls_bind]
    intro I hI
    rcases List.mem_append.1 hI with hI | hI
    · exact hone _ _ _ I hI
    · revert hI
      split_ifs with hev
      · simp
      · rw [top3Chain2, SIReduction.calls_bind]
        intro hI
        rcases List.mem_append.1 hI with hI | hI
        · exact hone _ _ _ I hI
        · simp at hI

/-- **Cor. 12.0.8: the round makes at most `6k` calls.** -/
theorem calls_length_top3RoundReduction (hd : dom.length = n) (hm : gdom.length = m)
    (hI : ImgsOf gens imgs ϕ) (x y : Fin n → ℕ) (solve : RawWinSI → RawCoset) :
    (top3RoundReduction n solve (top3Inst dom gens gdom imgs x y, none)).calls.length
      ≤ 6 * Babai.orbCount ϕ := by
  have hk : (top3Wins (top3Inst dom gens gdom imgs x y)).length ≤ Babai.orbCount ϕ :=
    length_topKernelWindows_le hd hm hI
  have h0 : (top2Tail n (top3Wins (top3Inst dom gens gdom imgs x y))
      (top3Tests (top3Inst dom gens gdom imgs x y)) (some ∅)).calls.length
      ≤ 3 * Babai.orbCount ϕ :=
    calls_length_top2RoundReduction_three hd hm hI (encStrN x) (encStrN x) solve
  have h1 := calls_length_top3Enter (n := n) (top3Inst dom gens gdom imgs x y)
    (top2Tail n (top3Wins (top3Inst dom gens gdom imgs x y))
      (top3Tests (top3Inst dom gens gdom imgs x y)) (some ∅)).run
  show ((top2Tail n (top3Wins (top3Inst dom gens gdom imgs x y))
      (top3Tests (top3Inst dom gens gdom imgs x y)) (some ∅)).bind
        (top3Enter n (top3Inst dom gens gdom imgs x y))).calls.length ≤ _
  rw [SIReduction.calls_bind, List.length_append]
  omega

/-- **Cor. 12.0.8: every call has an orbit of `N` for its window.** -/
theorem calls_top3RoundReduction_window (hd : dom.length = n) (x y : Fin n → ℕ)
    (solve : RawWinSI → RawCoset) :
    ∀ I ∈ (top3RoundReduction n solve (top3Inst dom gens gdom imgs x y, none)).calls,
      I.Δ ∈ (topKernelWindows ((dom, gens.map (encPerm n)),
        (gdom, imgs.map (encPerm m)))).map (winSet n) := by
  have h0 := calls_top2RoundReduction_window
    (p := top3Top (top3Inst dom gens gdom imgs x y)) hd solve
  have h1 := calls_top3Enter_window (n := n) (top3Inst dom gens gdom imgs x y)
    (top2Tail n (top3Wins (top3Inst dom gens gdom imgs x y))
      (top3Tests (top3Inst dom gens gdom imgs x y)) (some ∅)).run
  show ∀ I ∈ ((top2Tail n (top3Wins (top3Inst dom gens gdom imgs x y))
      (top3Tests (top3Inst dom gens gdom imgs x y)) (some ∅)).bind
        (top3Enter n (top3Inst dom gens gdom imgs x y))).calls, _
  rw [SIReduction.calls_bind]
  intro I hI
  rcases List.mem_append.1 hI with hI | hI
  · exact h0 I hI
  · exact h1 I hI

/-- **Cor. 12.0.8: every call has a window of size `n/k`.** -/
theorem calls_top3RoundReduction_size (hd : dom.length = n) (hm : gdom.length = m)
    (hI : ImgsOf gens imgs ϕ) (x y : Fin n → ℕ) (solve : RawWinSI → RawCoset)
    (hG : Babai.IsTransitive (genGroup gens)) (hgiant : Babai.IsGiantRep ϕ)
    (hlarge : Babai.LargeK m (Nat.card (Fin n))) :
    ∀ I ∈ (top3RoundReduction n solve (top3Inst dom gens gdom imgs x y, none)).calls,
      Babai.orbCount ϕ * I.windowSize = n := by
  intro I hI'
  obtain ⟨w, hw, he⟩ := List.mem_map.1 (calls_top3RoundReduction_window hd x y solve I hI')
  rw [Babai.SIInstance.windowSize, ← he, mul_comm]
  exact topKernelWindows_size hd hm hI hw hG hgiant hlarge

end Value

/-! ## The running time of the four routines -/

section Cost

/-- The guard "the `t`-th job is a top test of phase 0", as a machine test. -/
def top3Lt (z : RawTop3 × ℕ) : Bool := decide (z.2 + 1 ≤ (top3Tests z.1).length)

/-- The guard "the `t`-th job is phase 1", as a machine test. -/
def top3Eq (z : RawTop3 × ℕ) : Bool := decide (z.2 = (top3Tests z.1).length)

theorem polyFun_top3Top : PolyFun top3Top := by
  have hg : PolyFun (fun P : RawTop3 => P.1.2.1) :=
    (polyFun_fst.comp polyFun_snd).comp polyFun_fst
  exact polyFun_fst.pair ((hg.comp polyFun_topAltGens).pair
    ((polyFun_snd.comp polyFun_fst).pair (polyFun_snd.comp polyFun_fst)))

theorem polyFun_top3Dom : PolyFun top3Dom :=
  (polyFun_fst.comp polyFun_fst).comp polyFun_fst

theorem polyFun_top3Tests : PolyFun top3Tests := polyFun_top3Top.comp polyFun_top2Tests

theorem polyFun_top3Wins : PolyFun top3Wins := polyFun_top3Top.comp polyFun_top2Wins

theorem polyFun_top3Test : PolyFun (fun z : RawTop3 × ℕ => top3Test z.1 z.2) :=
  ((polyFun_fst.comp polyFun_top3Top).pair polyFun_snd).comp polyFun_top2Test

theorem polyFun_top3Jobs : PolyFun top3Jobs :=
  (polyFun_top3Tests.comp polyFun_length).add (polyFun_const 2)

theorem polyFun_top3Lt : PolyFun top3Lt :=
  ((polyFun_snd.add (polyFun_const 1)).le
    ((polyFun_fst.comp polyFun_top3Tests).comp polyFun_length))

private theorem top3_band_eq (a b : ℕ) :
    (decide (a ≤ b) && decide (b ≤ a)) = decide (a = b) := by
  by_cases h : a ≤ b <;> by_cases h' : b ≤ a <;> simp [h, h'] <;> omega

theorem polyFun_top3Eq : PolyFun top3Eq := by
  have h1 : PolyFun (fun z : RawTop3 × ℕ => decide (z.2 ≤ (top3Tests z.1).length)) :=
    polyFun_snd.le ((polyFun_fst.comp polyFun_top3Tests).comp polyFun_length)
  have h2 : PolyFun (fun z : RawTop3 × ℕ => decide ((top3Tests z.1).length ≤ z.2)) :=
    ((polyFun_fst.comp polyFun_top3Tests).comp polyFun_length).le polyFun_snd
  exact (polyFun_band h1 h2).of_eq (fun z => top3_band_eq _ _)

theorem top3Lt_eq_true (z : RawTop3 × ℕ) :
    top3Lt z = true ↔ z.2 < (top3Tests z.1).length := by
  simp only [top3Lt, decide_eq_true_eq]; omega

theorem top3Eq_eq_true (z : RawTop3 × ℕ) :
    top3Eq z = true ↔ z.2 = (top3Tests z.1).length := by
  simp only [top3Eq, decide_eq_true_eq]

theorem polyFun_top3X : PolyFun top3X :=
  (polyFun_top3Dom.pair (polyFun_snd.comp polyFun_fst)).comp polyFun_fixStr

theorem polyFun_top3Y : PolyFun top3Y :=
  (polyFun_top3Dom.pair (polyFun_snd.comp polyFun_snd)).comp polyFun_fixStr

theorem polyFun_top3Odd : PolyFun top3Odd :=
  ((polyFun_fst.comp polyFun_topOddLift).pair (polyFun_top3Dom.comp polyFun_rawOne)).comp
    polyFun_optionGetD

theorem polyFun_top3Y' : PolyFun top3Y' :=
  (polyFun_top3Dom.pair
    (((polyFun_top3Odd.comp polyFun_rawInv).pair (polyFun_snd.comp polyFun_snd)).comp
      polyFun_rawStrAct)).comp polyFun_fixStr

theorem polyFun_top3Start : PolyFun top3Start :=
  ((polyFun_top3Dom.pair (polyFun_fst.comp polyFun_topKernel)).comp polyFun_tidyGens).pair
    (polyFun_top3Dom.comp polyFun_rawOne) |>.comp polyFun_some

set_option maxHeartbeats 1000000 in
theorem polyFun_top3Src : PolyFun (fun z : RawTop3 × ℕ => top3Src z.1 z.2) := by
  have h1 : PolyFun (fun z : RawTop3 × ℕ => topWinSrc (top3Test z.1 z.2)) :=
    polyFun_top3Test.comp polyFun_topWinSrc
  have h2 : PolyFun (fun z : RawTop3 × ℕ => top3X z.1) := polyFun_fst.comp polyFun_top3X
  exact (PolyFun.ite polyFun_top3Lt h1 h2).of_eq (fun z => by
    rw [top3Src]
    by_cases h : z.2 < (top3Tests z.1).length
    · rw [if_pos ((top3Lt_eq_true z).2 h), if_pos h]
    · rw [if_neg (fun hc => h ((top3Lt_eq_true z).1 hc)), if_neg h])

set_option maxHeartbeats 1000000 in
theorem polyFun_top3Tgt : PolyFun (fun z : RawTop3 × ℕ => top3Tgt z.1 z.2) := by
  have h1 : PolyFun (fun z : RawTop3 × ℕ => topWinTgt (top3Test z.1 z.2)) :=
    polyFun_top3Test.comp polyFun_topWinTgt
  have h2 : PolyFun (fun z : RawTop3 × ℕ => top3Y z.1) := polyFun_fst.comp polyFun_top3Y
  have h3 : PolyFun (fun z : RawTop3 × ℕ => top3Y' z.1) := polyFun_fst.comp polyFun_top3Y'
  exact (PolyFun.ite polyFun_top3Lt h1 (PolyFun.ite polyFun_top3Eq h2 h3)).of_eq (fun z => by
    rw [top3Tgt]
    by_cases h : z.2 < (top3Tests z.1).length
    · rw [if_pos ((top3Lt_eq_true z).2 h), if_pos h]
    · rw [if_neg (fun hc => h ((top3Lt_eq_true z).1 hc)), if_neg h]
      by_cases h' : z.2 = (top3Tests z.1).length
      · rw [if_pos ((top3Eq_eq_true z).2 h'), if_pos h']
      · rw [if_neg (fun hc => h' ((top3Eq_eq_true z).1 hc)), if_neg h'])

set_option maxHeartbeats 1000000 in
theorem polyFun_top3Begin : PolyFun (fun z : RawTop3 × ℕ => top3Begin z.1 z.2) := by
  have h1 : PolyFun (fun z : RawTop3 × ℕ => topWinStart (top3Test z.1 z.2)) :=
    polyFun_top3Test.comp polyFun_topWinStart
  have h2 : PolyFun (fun z : RawTop3 × ℕ => top3Start z.1) :=
    polyFun_fst.comp polyFun_top3Start
  exact (PolyFun.ite polyFun_top3Lt h1 h2).of_eq (fun z => by
    rw [top3Begin]
    by_cases h : z.2 < (top3Tests z.1).length
    · rw [if_pos ((top3Lt_eq_true z).2 h), if_pos h]
    · rw [if_neg (fun hc => h ((top3Lt_eq_true z).1 hc)), if_neg h])

set_option maxHeartbeats 1000000 in
theorem polyFun_top3Leaf :
    PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (RawGens × RawPerm) =>
      top3Leaf z.1.1 z.1.2.1 z.1.2.2 z.2) := by
  have hP : PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (RawGens × RawPerm) => z.1.1) :=
    polyFun_fst.comp polyFun_fst
  have ht : PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (RawGens × RawPerm) => z.1.2.1) :=
    (polyFun_fst.comp polyFun_snd).comp polyFun_fst
  have hi : PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (RawGens × RawPerm) => z.1.2.2) :=
    (polyFun_fst.comp polyFun_snd).comp polyFun_snd
  have hsrc : PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (RawGens × RawPerm) =>
      top3Src z.1.1 z.1.2.1) := (hP.pair ht).comp polyFun_top3Src
  have htgt : PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (RawGens × RawPerm) =>
      top3Tgt z.1.1 z.1.2.1) := (hP.pair ht).comp polyFun_top3Tgt
  have hwin : PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (RawGens × RawPerm) =>
      (top3Wins z.1.1).getD z.1.2.2 []) :=
    (((hP.comp polyFun_top3Wins).pair hi).pair (polyFun_const ([] : List ℕ))).comp
      polyFun_getD
  have hg : PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (RawGens × RawPerm) =>
      tidyGens (top3Src z.1.1 z.1.2.1, z.2.1)) :=
    (hsrc.pair (polyFun_snd.comp polyFun_fst)).comp polyFun_tidyGens
  have hr : PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (RawGens × RawPerm) =>
      normPerm (top3Src z.1.1 z.1.2.1, z.2.2)) :=
    (hsrc.pair (polyFun_snd.comp polyFun_snd)).comp polyFun_normPerm
  refine (hwin.pair (hg.pair (hr.pair (hsrc.pair htgt)))).of_eq (fun z => ?_)
  simp only [top3Leaf]

/-- The guard of the loop, as a machine test. -/
def top3Go (z : RawTop3Node × ℕ × Top3State) : Bool :=
  (decide (z.2.2.1 + 1 ≤ top3Jobs z.1.1) &&
    decide (z.2.2.2.1 + 1 ≤ (top3Wins z.1.1).length)) &&
      decide (z.2.1 + 1 ≤ top3Jobs z.1.1 * (top3Wins z.1.1).length)

theorem top3Go_eq_true (z : RawTop3Node × ℕ × Top3State) :
    top3Go z = true ↔
      (z.2.2.1 < top3Jobs z.1.1 ∧ z.2.2.2.1 < (top3Wins z.1.1).length ∧
        z.2.1 < top3Jobs z.1.1 * (top3Wins z.1.1).length) := by
  simp only [top3Go, Bool.and_eq_true, decide_eq_true_eq]
  omega

private theorem polyFun_topOf3 : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.1.1) :=
  polyFun_fst.comp polyFun_fst

theorem polyFun_top3Go : PolyFun top3Go := by
  have hp : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.1.1) := polyFun_topOf3
  have hT : PolyFun (fun z : RawTop3Node × ℕ × Top3State => top3Jobs z.1.1) :=
    hp.comp polyFun_top3Jobs
  have hK : PolyFun (fun z : RawTop3Node × ℕ × Top3State => (top3Wins z.1.1).length) :=
    (hp.comp polyFun_top3Wins).comp polyFun_length
  have ht : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.2.2.1) :=
    (polyFun_snd.comp polyFun_snd).comp polyFun_fst
  have hi : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.2.2.2.1) :=
    ((polyFun_snd.comp polyFun_snd).comp polyFun_snd).comp polyFun_fst
  have hj : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.2.1) :=
    polyFun_snd.comp polyFun_fst
  exact polyFun_band (polyFun_band ((ht.add (polyFun_const 1)).le hT)
    ((hi.add (polyFun_const 1)).le hK))
    ((hj.add (polyFun_const 1)).le (hT.mul hK))

set_option maxHeartbeats 1000000 in
theorem polyFun_top3Child : PolyFun top3Child := by
  have hp : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.1.1) := polyFun_topOf3
  have ht : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.2.2.1) :=
    (polyFun_snd.comp polyFun_snd).comp polyFun_fst
  have hi : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.2.2.2.1) :=
    ((polyFun_snd.comp polyFun_snd).comp polyFun_snd).comp polyFun_fst
  have hc : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.2.2.2.2.1) :=
    (((polyFun_snd.comp polyFun_snd).comp polyFun_snd).comp polyFun_snd).comp polyFun_fst
  have hsome : PolyFun (fun y : (RawGens × RawPerm) × (RawTop3Node × ℕ × Top3State) =>
      (some (y.2.1.1, some (top3Leaf y.2.1.1 y.2.2.2.1 y.2.2.2.2.1 y.1))
        : Option RawTop3Node)) := by
    have hp' : PolyFun (fun y : (RawGens × RawPerm) × (RawTop3Node × ℕ × Top3State) =>
        y.2.1.1) := polyFun_snd.comp hp
    have ht' : PolyFun (fun y : (RawGens × RawPerm) × (RawTop3Node × ℕ × Top3State) =>
        y.2.2.2.1) := polyFun_snd.comp ht
    have hi' : PolyFun (fun y : (RawGens × RawPerm) × (RawTop3Node × ℕ × Top3State) =>
        y.2.2.2.2.1) := polyFun_snd.comp hi
    have hleaf := ((hp'.pair (ht'.pair hi')).pair polyFun_fst).comp polyFun_top3Leaf
    exact (hp'.pair (hleaf.comp polyFun_some)).comp polyFun_some
  have hmap : PolyFun (fun z : RawTop3Node × ℕ × Top3State =>
      (z.2.2.2.2.1).map (fun c => (z.1.1, some (top3Leaf z.1.1 z.2.2.1 z.2.2.2.1 c)))) :=
    ((hc.pair polyFun_id).comp
      (PolyFun.optionElim (polyFun_const (none : Option RawTop3Node)) hsome)).of_eq
        (fun z => by cases hcz : z.2.2.2.2.1 <;> simp [hcz])
  have hbody : PolyFun (fun z : RawTop3Node × ℕ × Top3State =>
      if z.2.2.1 < top3Jobs z.1.1 ∧ z.2.2.2.1 < (top3Wins z.1.1).length ∧
          z.2.1 < top3Jobs z.1.1 * (top3Wins z.1.1).length then
        (z.2.2.2.2.1).map (fun c => (z.1.1, some (top3Leaf z.1.1 z.2.2.1 z.2.2.2.1 c)))
      else none) :=
    (PolyFun.ite polyFun_top3Go hmap (polyFun_const none)).of_eq (fun z => by
      by_cases h : z.2.2.1 < top3Jobs z.1.1 ∧ z.2.2.2.1 < (top3Wins z.1.1).length ∧
          z.2.1 < top3Jobs z.1.1 * (top3Wins z.1.1).length
      · rw [if_pos ((top3Go_eq_true z).2 h), if_pos h]
      · rw [if_neg (fun hcon => h ((top3Go_eq_true z).1 hcon)), if_neg h])
  have hleafcase : PolyFun (fun y : RawWinSI × (RawTop3Node × ℕ × Top3State) =>
      (none : Option RawTop3Node)) := polyFun_const none
  exact ((((polyFun_fst.comp polyFun_snd).pair polyFun_id).comp
    (PolyFun.optionElim hbody hleafcase))).of_eq (fun z => by
      cases hoz : z.1.2 <;> simp [top3Child, hoz])

set_option maxHeartbeats 1000000 in
/-- The unpacked adaptive step is a `RAM.PolyFun`. -/
theorem polyFun_top3Step :
    PolyFun (fun z : (RawTop3 × ℕ × ℕ) × (Top1State × RawCoset × RawCoset × RawCoset) =>
      top3Step z.1.1 z.1.2.1 z.1.2.2 z.2.1 z.2.2.1 z.2.2.2.1 z.2.2.2.2) := by
  set α := (RawTop3 × ℕ × ℕ) × (Top1State × RawCoset × RawCoset × RawCoset)
  have hP : PolyFun (fun z : α => z.1.1) := polyFun_fst.comp polyFun_fst
  have ht : PolyFun (fun z : α => z.1.2.1) := (polyFun_fst.comp polyFun_snd).comp polyFun_fst
  have hi : PolyFun (fun z : α => z.1.2.2) := (polyFun_fst.comp polyFun_snd).comp polyFun_snd
  have hacc : PolyFun (fun z : α => z.2.1) := polyFun_snd.comp polyFun_fst
  have hs1 : PolyFun (fun z : α => z.2.2.1) := (polyFun_snd.comp polyFun_snd).comp polyFun_fst
  have hs2 : PolyFun (fun z : α => z.2.2.2.1) :=
    ((polyFun_snd.comp polyFun_snd).comp polyFun_snd).comp polyFun_fst
  have ha : PolyFun (fun z : α => z.2.2.2.2) :=
    ((polyFun_snd.comp polyFun_snd).comp polyFun_snd).comp polyFun_snd
  have hdom : PolyFun (fun z : α => top3Dom z.1.1) := hP.comp polyFun_top3Dom
  have hTl : PolyFun (fun z : α => (top3Tests z.1.1).length) :=
    (hP.comp polyFun_top3Tests).comp polyFun_length
  have hKl : PolyFun (fun z : α => (top3Wins z.1.1).length) :=
    (hP.comp polyFun_top3Wins).comp polyFun_length
  have hJobs : PolyFun (fun z : α => top3Jobs z.1.1) := hP.comp polyFun_top3Jobs
  have hna : PolyFun (fun z : α => top2NormC (top3Dom z.1.1) z.2.2.2.2) :=
    (hdom.pair ha).comp polyFun_top2NormC
  have hn1 : PolyFun (fun z : α => top2NormC (top3Dom z.1.1) z.2.2.1) :=
    (hdom.pair hs1).comp polyFun_top2NormC
  have hn2 : PolyFun (fun z : α => top2NormC (top3Dom z.1.1) z.2.2.2.1) :=
    (hdom.pair hs2).comp polyFun_top2NormC
  have hnacc : PolyFun (fun z : α => top2NormS (top3Dom z.1.1) z.2.1) :=
    (hdom.pair hacc).comp polyFun_top2NormS
  have hjoin : PolyFun (fun z : α => top3Join z.1.1 z.1.2.1 z.2.1 z.2.2.2.2) := by
    have hprep : PolyFun (fun z : α => topLiftPrepare (top3Test z.1.1 z.1.2.1)) :=
      ((hP.pair ht).comp polyFun_top3Test).comp polyFun_topLiftPrepare
    have hfin : PolyFun (fun z : α =>
        topLiftFinish (top3Dom z.1.1, topLiftPrepare (top3Test z.1.1 z.1.2.1), z.2.2.2.2)) :=
      (hdom.pair (hprep.pair ha)).comp polyFun_topLiftFinish
    exact (hdom.pair ((hdom.pair (hacc.pair hfin)).comp polyFun_top1Join)).comp
      polyFun_top2NormS
  have hgo : PolyFun (fun z : α => (z.2.2.2.2.isSome && decide (z.1.2.2 + 1 + 1 ≤
      (top3Wins z.1.1).length) : Bool)) :=
    polyFun_band (ha.comp polyFun_isSome)
      (((hi.add (polyFun_const 1)).add (polyFun_const 1)).le hKl)
  have hA : PolyFun (fun z : α => ((min z.1.2.1 (top3Jobs z.1.1),
      min (z.1.2.2 + 1) (top3Wins z.1.1).length,
      top2NormC (top3Dom z.1.1) z.2.2.2.2, top2NormS (top3Dom z.1.1) z.2.1,
      top2NormC (top3Dom z.1.1) z.2.2.1, top2NormC (top3Dom z.1.1) z.2.2.2.1) : Top3State)) :=
    ((ht.pair hJobs).comp polyFun_min).pair
      ((((hi.add (polyFun_const 1)).pair hKl).comp polyFun_min).pair
        (hna.pair (hnacc.pair (hn1.pair hn2))))
  have hbegin : ∀ f : α → ℕ, PolyFun f →
      PolyFun (fun z : α => top3Begin z.1.1 (f z)) := fun f hf =>
    (hP.pair hf).comp polyFun_top3Begin
  have hB : PolyFun (fun z : α => ((z.1.2.1 + 1, 0, top3Begin z.1.1 (z.1.2.1 + 1),
      top3Join z.1.1 z.1.2.1 z.2.1 z.2.2.2.2, top2NormC (top3Dom z.1.1) z.2.2.1,
      top2NormC (top3Dom z.1.1) z.2.2.2.1) : Top3State)) :=
    (ht.add (polyFun_const 1)).pair ((polyFun_const 0).pair
      ((hbegin _ (ht.add (polyFun_const 1))).pair (hjoin.pair (hn1.pair hn2))))
  have hC : PolyFun (fun z : α =>
      (((if ((top3Join z.1.1 z.1.2.1 z.2.1 z.2.2.2.2).getD none).isSome then
          (top3Tests z.1.1).length else top3Jobs z.1.1), 0,
        top3Begin z.1.1 (top3Tests z.1.1).length,
        top3Join z.1.1 z.1.2.1 z.2.1 z.2.2.2.2, top2NormC (top3Dom z.1.1) z.2.2.1,
        top2NormC (top3Dom z.1.1) z.2.2.2.1) : Top3State)) := by
    have htest : PolyFun (fun z : α =>
        ((top3Join z.1.1 z.1.2.1 z.2.1 z.2.2.2.2).getD none).isSome) :=
      ((hjoin.pair (polyFun_const (none : RawCoset))).comp polyFun_optionGetD).comp
        polyFun_isSome
    exact (PolyFun.ite htest hTl hJobs).pair ((polyFun_const 0).pair
      ((hbegin _ hTl).pair (hjoin.pair (hn1.pair hn2))))
  have hD : PolyFun (fun z : α =>
      (((if topAllEven z.1.1.1 then top3Jobs z.1.1 else (top3Tests z.1.1).length + 1), 0,
        top3Begin z.1.1 ((top3Tests z.1.1).length + 1), top2NormS (top3Dom z.1.1) z.2.1,
        top2NormC (top3Dom z.1.1) z.2.2.2.2, top2NormC (top3Dom z.1.1) z.2.2.2.1)
          : Top3State)) := by
    have hev : PolyFun (fun z : α => topAllEven z.1.1.1) :=
      (hP.comp polyFun_fst).comp polyFun_topAllEven
    exact (PolyFun.ite hev hJobs (hTl.add (polyFun_const 1))).pair ((polyFun_const 0).pair
      ((hbegin _ (hTl.add (polyFun_const 1))).pair (hnacc.pair (hna.pair hn2))))
  have hE : PolyFun (fun z : α => ((top3Jobs z.1.1, 0, top3Begin z.1.1 (top3Jobs z.1.1),
      top2NormS (top3Dom z.1.1) z.2.1, top2NormC (top3Dom z.1.1) z.2.2.1,
      top2NormC (top3Dom z.1.1) z.2.2.2.2) : Top3State)) :=
    hJobs.pair ((polyFun_const 0).pair
      ((hbegin _ hJobs).pair (hnacc.pair (hn1.pair hna))))
  have hlt : PolyFun (fun z : α => decide (z.1.2.1 + 1 + 1 ≤ (top3Tests z.1.1).length)) :=
    ((ht.add (polyFun_const 1)).add (polyFun_const 1)).le hTl
  have heq : PolyFun (fun z : α => decide (z.1.2.1 + 1 = (top3Tests z.1.1).length)) := by
    have h1 : PolyFun (fun z : α => decide (z.1.2.1 + 1 ≤ (top3Tests z.1.1).length)) :=
      (ht.add (polyFun_const 1)).le hTl
    have h2 : PolyFun (fun z : α => decide ((top3Tests z.1.1).length ≤ z.1.2.1 + 1)) :=
      hTl.le (ht.add (polyFun_const 1))
    exact (polyFun_band h1 h2).of_eq (fun z => top3_band_eq _ _)
  have heq2 : PolyFun (fun z : α => decide (z.1.2.1 = (top3Tests z.1.1).length)) := by
    have h1 : PolyFun (fun z : α => decide (z.1.2.1 ≤ (top3Tests z.1.1).length)) :=
      ht.le hTl
    have h2 : PolyFun (fun z : α => decide ((top3Tests z.1.1).length ≤ z.1.2.1)) :=
      hTl.le ht
    exact (polyFun_band h1 h2).of_eq (fun z => top3_band_eq _ _)
  refine (PolyFun.ite hgo hA (PolyFun.ite hlt hB
    (PolyFun.ite heq hC (PolyFun.ite heq2 hD hE)))).of_eq (fun z => ?_)
  rw [top3Step]
  by_cases h0 : z.2.2.2.2.isSome = true ∧ z.1.2.2 + 1 < (top3Wins z.1.1).length
  · rw [if_pos h0, if_pos (by
      simp only [Bool.and_eq_true, decide_eq_true_eq]
      exact ⟨h0.1, by have := h0.2; omega⟩)]
  · have hgo' : ¬ ((z.2.2.2.2.isSome && decide (z.1.2.2 + 1 + 1 ≤
        (top3Wins z.1.1).length)) = true) := by
      simp only [Bool.and_eq_true, decide_eq_true_eq]
      intro hcon
      exact h0 ⟨hcon.1, by have := hcon.2; omega⟩
    rw [if_neg h0, if_neg hgo']
    by_cases h1 : z.1.2.1 + 1 < (top3Tests z.1.1).length
    · rw [if_pos h1, if_pos (by simp only [decide_eq_true_eq]; omega)]
    · rw [if_neg h1, if_neg (by simp only [decide_eq_true_eq]; omega)]
      by_cases h2 : z.1.2.1 + 1 = (top3Tests z.1.1).length
      · rw [if_pos h2, if_pos (by simp only [decide_eq_true_eq]; omega)]
      · rw [if_neg h2, if_neg (by simp only [decide_eq_true_eq]; omega)]
        by_cases h3 : z.1.2.1 = (top3Tests z.1.1).length
        · rw [if_pos h3, if_pos (by simp only [decide_eq_true_eq]; omega)]
        · rw [if_neg h3, if_neg (by simp only [decide_eq_true_eq]; omega)]

set_option maxHeartbeats 1000000 in
theorem polyFun_top3Combine : PolyFun top3Combine := by
  have hP : PolyFun (fun z : RawTop3Node × ℕ × Top3State => z.1.1) := polyFun_topOf3
  have ht : PolyFun (fun z : RawTop3Node × ℕ × Top3State × RawCoset => z.2.2.1.1) :=
    ((polyFun_snd.comp polyFun_snd).comp polyFun_fst).comp polyFun_fst
  have hP' : PolyFun (fun z : RawTop3Node × ℕ × Top3State × RawCoset => z.1.1) :=
    polyFun_fst.comp polyFun_fst
  have hi : PolyFun (fun z : RawTop3Node × ℕ × Top3State × RawCoset => z.2.2.1.2.1) :=
    (((polyFun_snd.comp polyFun_snd).comp polyFun_fst).comp polyFun_snd).comp polyFun_fst
  have hacc : PolyFun (fun z : RawTop3Node × ℕ × Top3State × RawCoset =>
      z.2.2.1.2.2.2.1) :=
    ((((polyFun_snd.comp polyFun_snd).comp polyFun_fst).comp polyFun_snd).comp
      polyFun_snd).comp polyFun_snd |>.comp polyFun_fst
  have hs1 : PolyFun (fun z : RawTop3Node × ℕ × Top3State × RawCoset =>
      z.2.2.1.2.2.2.2.1) :=
    (((((polyFun_snd.comp polyFun_snd).comp polyFun_fst).comp polyFun_snd).comp
      polyFun_snd).comp polyFun_snd).comp polyFun_snd |>.comp polyFun_fst
  have hs2 : PolyFun (fun z : RawTop3Node × ℕ × Top3State × RawCoset =>
      z.2.2.1.2.2.2.2.2) :=
    (((((polyFun_snd.comp polyFun_snd).comp polyFun_fst).comp polyFun_snd).comp
      polyFun_snd).comp polyFun_snd).comp polyFun_snd |>.comp polyFun_snd
  have ha : PolyFun (fun z : RawTop3Node × ℕ × Top3State × RawCoset => z.2.2.2) :=
    (polyFun_snd.comp polyFun_snd).comp polyFun_snd
  exact ((hP'.pair (ht.pair hi)).pair (hacc.pair (hs1.pair (hs2.pair ha)))).comp
    polyFun_top3Step

