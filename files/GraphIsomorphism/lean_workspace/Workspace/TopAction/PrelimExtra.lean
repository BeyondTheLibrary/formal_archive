/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

Material about Sections 2, 10 and 11 that Section 12 needs and that the corresponding
modules do not provide.
-/
import Workspace.TopAction.Defs
import Workspace.AltQuotients.MainStructure
import Workspace.Prelim.TwoGenAlt

/-!
# Helpers for Section 12

Three kinds of material.

* Small facts about `N = ker(ϕ)` and its orbits (Section 11 level): `N` is normal in `G`,
  and a finite list of orbit representatives of a subgroup.
* The **Chain Rule reduction** (`Babai.chainReduction`): the reduction, in the sense of
  `Babai.SIReduction`, of `Iso_N(x,y)` to one window-isomorphism instance per member of a
  list of `N`-invariant windows covering `Ω`.  This is Luks's Chain Rule (Prop. 11.1.7)
  packaged as a reduction; Section 11 proves the single step
  (`Babai.Proposition_11_1_7_chainRule`) but never assembles the steps, and Cor. 12.0.6
  uses the assembled form ("Luks's Chain Rule performs the desired reduction, calling `3k`
  instances of window size `n/k`").
* Textbook background that the paper uses as common knowledge, without a citation: the
  alternating group is generated by two elements (proof of Cor. 12.0.6, "with `S` a pair of
  generators of `H`").  As in `Workspace/AltQuotients/PrelimExtra.lean`, such a fact is
  **not** an axiom — the paper does not cite it to the literature — but a theorem, proved
  in `Workspace/Prelim/TwoGenAlt.lean` (`Babai.alternatingGroup_two_generated`).
-/

universe u v

namespace Babai

open MulAction Equiv Equiv.Perm
open scoped Pointwise

variable {Ω : Type u} {A : Type v}

/-! ### `N = ker(ϕ)` is normal in `G` -/

theorem isNormalIn_kerSubgroup {G : Subgroup (Equiv.Perm Ω)} {H : Type*} [Group H]
    (ϕ : G →* H) : IsNormalIn (kerSubgroup ϕ) G := by
  constructor
  · exact kerSubgroup_le ϕ
  · intro σ hσ τ hτ
    obtain ⟨hτG, hτϕ⟩ := mem_kerSubgroup.1 hτ
    have hmem : σ * τ * σ⁻¹ ∈ G := mul_mem (mul_mem hσ hτG) (inv_mem hσ)
    refine mem_kerSubgroup.2 ⟨hmem, ?_⟩
    have hsplit : (⟨σ * τ * σ⁻¹, hmem⟩ : G) = ⟨σ, hσ⟩ * ⟨τ, hτG⟩ * (⟨σ, hσ⟩)⁻¹ := rfl
    rw [hsplit, map_mul, map_mul, map_inv, hτϕ, mul_one, mul_inv_cancel]

/-! ### A finite list of orbit representatives -/

/-- A finite list of representatives of the orbits of `N`, one per orbit: its length is
the number of orbits and the orbits of its members cover `Ω`. -/
theorem exists_orbitReps [Fintype Ω] (N : Subgroup (Equiv.Perm Ω)) :
    ∃ us : List Ω, us.length = Nat.card (orbitRel.Quotient N Ω) ∧
      (⋃ u ∈ us, orbit N u) = Set.univ := by
  classical
  haveI : Fintype (orbitRel.Quotient N Ω) := Fintype.ofFinite _
  refine ⟨(Finset.univ : Finset (orbitRel.Quotient N Ω)).toList.map Quotient.out, ?_, ?_⟩
  · rw [List.length_map, Finset.length_toList, Finset.card_univ, Nat.card_eq_fintype_card]
  · ext w
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    refine Set.mem_iUnion₂.2 ⟨(Quotient.mk'' w : orbitRel.Quotient N Ω).out, ?_, ?_⟩
    · exact List.mem_map_of_mem (Finset.mem_toList.2 (Finset.mem_univ _))
    · have h1 : (Quotient.mk'' (Quotient.out (Quotient.mk'' w : orbitRel.Quotient N Ω)) :
          orbitRel.Quotient N Ω) = Quotient.mk'' w := Quotient.out_eq _
      exact orbitRel_apply.1 (Quotient.eq''.1 h1.symm)

/-- The empty window imposes no condition: `Iso^∅_K(x,y) = K`. -/
@[simp] theorem wIso_empty (K : Set (Equiv.Perm Ω)) (x y : Ω → A) :
    wIso (∅ : Set Ω) K x y = K := by
  ext τ; simp

/-! ### The list of orbits of `N`, and their common length -/

open Classical in
/-- The list of the orbits of `N` in `Ω`, one entry per orbit.  This is the list of
windows over which the Chain Rule of Cor. 12.0.6 runs ("Luks's Chain Rule performs the
desired reduction, calling `3k` instances of window size `n/k`", `k` = number of orbits). -/
noncomputable def orbitList [Fintype Ω] (N : Subgroup (Equiv.Perm Ω)) : List (Set Ω) :=
  letI : Fintype (orbitRel.Quotient N Ω) := Fintype.ofFinite _
  (Finset.univ : Finset (orbitRel.Quotient N Ω)).toList.map orbitRel.Quotient.orbit

theorem length_orbitList [Fintype Ω] (N : Subgroup (Equiv.Perm Ω)) :
    (orbitList N).length = Nat.card (orbitRel.Quotient N Ω) := by
  classical
  letI : Fintype (orbitRel.Quotient N Ω) := Fintype.ofFinite _
  rw [orbitList, List.length_map, Finset.length_toList, Finset.card_univ,
    Nat.card_eq_fintype_card]

theorem mem_orbitList [Fintype Ω] {N : Subgroup (Equiv.Perm Ω)} {Δ : Set Ω}
    (h : Δ ∈ orbitList N) : ∃ u : Ω, Δ = orbit N u := by
  classical
  letI : Fintype (orbitRel.Quotient N Ω) := Fintype.ofFinite _
  rw [orbitList, List.mem_map] at h
  obtain ⟨q, -, rfl⟩ := h
  exact ⟨q.out, orbitRel.Quotient.orbit_eq_orbit_out q Quotient.out_eq'⟩

theorem iUnion_orbitList [Fintype Ω] (N : Subgroup (Equiv.Perm Ω)) :
    (⋃ Δ ∈ orbitList N, Δ) = Set.univ := by
  classical
  letI : Fintype (orbitRel.Quotient N Ω) := Fintype.ofFinite _
  ext w
  refine ⟨fun _ => trivial, fun _ => ?_⟩
  refine Set.mem_iUnion₂.2 ⟨orbitRel.Quotient.orbit
    (Quotient.mk'' w : orbitRel.Quotient N Ω), ?_, ?_⟩
  · exact List.mem_map_of_mem (Finset.mem_toList.2 (Finset.mem_univ _))
  · exact (orbitRel.Quotient.mem_orbit (G := N)).2 rfl

/-- Each orbit is an `N`-invariant window (Procedure Reduce-to-Johnson, step 3). -/
theorem isInvariant_orbit' (N : Subgroup (Equiv.Perm Ω)) (u : Ω) :
    IsInvariant N (orbit N u) := by
  intro σ hσ
  ext w
  constructor
  · rintro ⟨v, hv, rfl⟩
    obtain ⟨n, rfl⟩ := hv
    exact ⟨(⟨σ, hσ⟩ : N) * n, by simp [mul_smul, Subgroup.smul_def]⟩
  · rintro ⟨n, rfl⟩
    refine ⟨((⟨σ, hσ⟩ : N)⁻¹ * n : N) • u, ⟨_, rfl⟩, ?_⟩
    simp [mul_smul, Subgroup.smul_def]

theorem isInvariant_of_mem_orbitList [Fintype Ω] {N : Subgroup (Equiv.Perm Ω)} {Δ : Set Ω}
    (h : Δ ∈ orbitList N) : IsInvariant N Δ := by
  obtain ⟨u, rfl⟩ := mem_orbitList h
  exact isInvariant_orbit' N u

/-- **The orbits partition the ground set**, so their sizes add up to `n`.  This is what
makes the Chain Rule over all the orbits a round of recurrence (i) of Sec. 11.4: the
windows of its calls add up to the window it started from. -/
theorem sum_ncard_orbitList [Fintype Ω] (N : Subgroup (Equiv.Perm Ω)) :
    ((orbitList N).map (fun S => S.ncard)).sum = Fintype.card Ω := by
  classical
  letI : Fintype (orbitRel.Quotient N Ω) := Fintype.ofFinite _
  have hfib : ∀ q : orbitRel.Quotient N Ω,
      (Finset.univ.filter (fun w : Ω => (Quotient.mk'' w : orbitRel.Quotient N Ω) = q)) =
        (orbitRel.Quotient.orbit q).toFinset := by
    intro q
    ext w
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Set.mem_toFinset]
    exact (orbitRel.Quotient.mem_orbit (G := N)).symm
  have hsum := Finset.card_eq_sum_card_fiberwise
    (f := fun w : Ω => (Quotient.mk'' w : orbitRel.Quotient N Ω))
    (s := (Finset.univ : Finset Ω)) (t := (Finset.univ : Finset (orbitRel.Quotient N Ω)))
    (fun w _ => Finset.mem_univ _)
  simp only [hfib, Finset.card_univ] at hsum
  rw [orbitList, List.map_map, Finset.sum_map_toList, hsum]
  refine Finset.sum_congr rfl fun q _ => ?_
  rw [Function.comp_apply, Set.ncard_eq_toFinset_card']

/-- The number of orbits of a subgroup is at most the number of points: the quotient map is
onto. -/
theorem length_orbitList_le [Fintype Ω] (N : Subgroup (Equiv.Perm Ω)) :
    (orbitList N).length ≤ Nat.card Ω := by
  rw [length_orbitList]
  exact Nat.card_le_card_of_surjective (fun u => (Quotient.mk'' u : orbitRel.Quotient N Ω))
    Quotient.mk''_surjective

/-- **An orbit is a proper part of the ground set** when the group is not transitive.  This
is the progress of the Chain Rule round of Procedure Reduce-to-Johnson, step 3. -/
theorem ncard_lt_of_mem_orbitList [Fintype Ω] {N : Subgroup (Equiv.Perm Ω)}
    (hN : ¬ IsTransitive N) {S : Set Ω} (hS : S ∈ orbitList N) :
    S.ncard < Fintype.card Ω := by
  obtain ⟨u, rfl⟩ := mem_orbitList hS
  have hne : orbit N u ≠ Set.univ := fun hc => hN ⟨u, hc⟩
  have hss : orbit N u ⊂ Set.univ :=
    ⟨Set.subset_univ _, fun hc => hne (Set.univ_subset_iff.1 hc)⟩
  have hlt := Set.ncard_lt_ncard hss (Set.toFinite _)
  have hcard : (Set.univ : Set Ω).ncard = Fintype.card Ω := by
    rw [Set.ncard_univ, Nat.card_eq_fintype_card]
  omega

/-- The orbits of a normal subgroup `N` of a transitive group `G` all have the same
length, and there are `Nat.card (orbitRel.Quotient N Ω)` of them, so the common length
times the number of orbits is `n` (Fact 11.1.8, made quantitative).

`Babai.orbit_ncard_mul_eq_card` gives the same statement with the number of orbits left
existential; Cor. 12.0.6 needs the witness, because the same `k` has to bound the number
of Chain Rule calls. -/
theorem orbit_ncard_mul_orbitCount [Fintype Ω] {G N : Subgroup (Equiv.Perm Ω)}
    (hG : IsTransitive G) (hN : IsNormalIn N G) (u : Ω) :
    (orbit N u).ncard * Nat.card (orbitRel.Quotient N Ω) = Fintype.card Ω := by
  classical
  letI : Fintype (orbitRel.Quotient N Ω) := Fintype.ofFinite _
  have hfib : ∀ q : orbitRel.Quotient N Ω,
      (Finset.univ.filter (fun w : Ω => (Quotient.mk'' w : orbitRel.Quotient N Ω) = q)) =
        (orbitRel.Quotient.orbit q).toFinset := by
    intro q
    ext w
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Set.mem_toFinset]
    exact (orbitRel.Quotient.mem_orbit (G := N)).symm
  have hcard : ∀ q : orbitRel.Quotient N Ω,
      (orbitRel.Quotient.orbit q).toFinset.card = (orbit N u).ncard := by
    intro q
    rw [← Set.ncard_eq_toFinset_card',
      orbitRel.Quotient.orbit_eq_orbit_out q Quotient.out_eq']
    exact Fact_11_1_8 hG hN _ u
  have hsum := Finset.card_eq_sum_card_fiberwise
    (f := fun w : Ω => (Quotient.mk'' w : orbitRel.Quotient N Ω))
    (s := (Finset.univ : Finset Ω)) (t := (Finset.univ : Finset (orbitRel.Quotient N Ω)))
    (fun w _ => Finset.mem_univ _)
  simp only [hfib, hcard, Finset.sum_const, smul_eq_mul, Finset.card_univ] at hsum
  rw [Nat.card_eq_fintype_card, mul_comm]
  exact hsum.symm

/-! ### The Chain Rule reduction -/

/-- The window automorphism group `Aut^Δ_N(x)`, defined without an invariance hypothesis
(as the subgroup *generated by* `Aut^Δ_N(x)`), so that it can appear in a recursive
definition.  When `Δ` is `N`-invariant the generated subgroup is `Aut^Δ_N(x)` itself
(`Babai.coe_autWindow`). -/
def autWindow (N : Subgroup (Equiv.Perm Ω)) (Δ : Set Ω) (x : Ω → A) :
    Subgroup (Equiv.Perm Ω) :=
  Subgroup.closure (wAut Δ (N : Set (Equiv.Perm Ω)) x)

theorem coe_autWindow {N : Subgroup (Equiv.Perm Ω)} {Δ : Set Ω} (h : IsInvariant N Δ)
    (x : Ω → A) :
    ((autWindow N Δ x : Subgroup (Equiv.Perm Ω)) : Set (Equiv.Perm Ω)) =
      wAut Δ (N : Set (Equiv.Perm Ω)) x := by
  rw [autWindow]
  have : Subgroup.closure ((wAutSubgroup N Δ h x : Subgroup (Equiv.Perm Ω)) :
      Set (Equiv.Perm Ω)) = wAutSubgroup N Δ h x := Subgroup.closure_eq _
  rw [coe_wAutSubgroup] at this
  rw [this, coe_wAutSubgroup]

/-- `Aut^Δ_M(x) = M ∩ Aut^Δ_N(x)` for `M ≤ N`: the group carried along the Chain Rule. -/
theorem wAut_eq_inf {N M : Subgroup (Equiv.Perm Ω)} {Δ : Set Ω} (hMN : M ≤ N)
    (h : IsInvariant N Δ) (x : Ω → A) :
    wAut Δ (M : Set (Equiv.Perm Ω)) x =
      ((M ⊓ autWindow N Δ x : Subgroup (Equiv.Perm Ω)) : Set (Equiv.Perm Ω)) := by
  ext τ
  rw [SetLike.mem_coe, Subgroup.mem_inf, mem_wAut]
  constructor
  · rintro ⟨hM, hτ⟩
    refine ⟨hM, ?_⟩
    have : τ ∈ wAut Δ (N : Set (Equiv.Perm Ω)) x := ⟨hMN hM, hτ⟩
    rw [← SetLike.mem_coe, coe_autWindow h x]
    exact this
  · rintro ⟨hM, hA⟩
    rw [← SetLike.mem_coe, coe_autWindow h x, mem_wAut] at hA
    exact ⟨hM, hA.2⟩

open Classical in
/-- Luks's **Chain Rule** as a reduction (Prop. 11.1.7, iterated): process the windows of
the list one after the other, shrinking the group at each round.  The state is the current
shift `σ` and the current group `M`, so that the answer for the windows processed so far is
the coset `σ • M`. -/
noncomputable def chainReduction (N : Subgroup (Equiv.Perm Ω)) (x y : Ω → A) :
    List (Set Ω) → Equiv.Perm Ω → Subgroup (Equiv.Perm Ω) →
      SIReduction Ω A (Set (Equiv.Perm Ω))
  | [], σ, M => .done (σ • (M : Set (Equiv.Perm Ω)))
  | Δ :: rest, σ, M =>
      .call ⟨(M : Set (Equiv.Perm Ω)), Δ, x, strAct y σ⁻¹⟩ fun ans =>
        if h : ans.Nonempty then
          chainReduction N x y rest (σ * h.some) (M ⊓ autWindow N Δ x)
        else .done ∅

theorem calls_chainReduction (N : Subgroup (Equiv.Perm Ω)) (x y : Ω → A)
    (Δs : List (Set Ω)) (σ : Equiv.Perm Ω) (M : Subgroup (Equiv.Perm Ω)) :
    (chainReduction N x y Δs σ M).calls.length ≤ Δs.length ∧
      ∀ I ∈ (chainReduction N x y Δs σ M).calls, I.Δ ∈ Δs := by
  induction Δs generalizing σ M with
  | nil => rw [chainReduction]; simp
  | cons Δ rest ih =>
    rw [chainReduction, SIReduction.calls_call]
    set ans := (SIInstance.answer
      (⟨(M : Set (Equiv.Perm Ω)), Δ, x, strAct y σ⁻¹⟩ : SIInstance Ω A)) with hans
    by_cases h : ans.Nonempty
    · rw [dif_pos h]
      obtain ⟨hlen, hmem⟩ := ih (σ * h.some) (M ⊓ autWindow N Δ x)
      refine ⟨by simpa using hlen, ?_⟩
      intro I hI
      rcases List.mem_cons.1 hI with rfl | hI
      · exact List.mem_cons_self
      · exact List.mem_cons_of_mem _ (hmem I hI)
    · rw [dif_neg h]
      refine ⟨by simp, ?_⟩
      intro I hI
      simp only [SIReduction.calls_done, List.mem_singleton] at hI
      rw [hI]
      exact List.mem_cons_self

/-- The Chain Rule reduction processes the windows of the list one after the other, so the
*total* window size of its executed calls is at most the total size of the list.  (The
reduction may stop early, at an unsolvable window; it never revisits a window.)  This is
what turns "the color classes partition `Ω`" into the bound "instances of total size
`≤ n`" of Cor. 12.0.10. -/
theorem sum_windowSize_calls_chainReduction (N : Subgroup (Equiv.Perm Ω)) (x y : Ω → A) :
    ∀ (Δs : List (Set Ω)) (σ : Equiv.Perm Ω) (M : Subgroup (Equiv.Perm Ω)),
      ((chainReduction N x y Δs σ M).calls.map SIInstance.windowSize).sum ≤
        (Δs.map (fun Δ => Δ.ncard)).sum := by
  intro Δs
  induction Δs with
  | nil => intro σ M; rw [chainReduction]; simp
  | cons Δ rest ih =>
    intro σ M
    rw [chainReduction, SIReduction.calls_call]
    have hw : (⟨(M : Set (Equiv.Perm Ω)), Δ, x, strAct y σ⁻¹⟩ :
        SIInstance Ω A).windowSize = Δ.ncard := rfl
    by_cases h : (SIInstance.answer
        (⟨(M : Set (Equiv.Perm Ω)), Δ, x, strAct y σ⁻¹⟩ : SIInstance Ω A)).Nonempty
    · rw [dif_pos h]
      simp only [List.map_cons, List.sum_cons, hw]
      exact Nat.add_le_add_left (ih (σ * h.some) (M ⊓ autWindow N Δ x)) _
    · rw [dif_neg h]
      simp only [SIReduction.calls_done, List.map_cons, List.map_nil, List.sum_cons,
        List.sum_nil, hw]
      omega

/-- Every call of the Chain Rule reduction has its candidate set inside the current group
`M` (the group only shrinks along the chain).  This is what lets the whole reduction be
transported to a window (`Workspace/Luks/Window.lean`). -/
theorem calls_chainReduction_K (N : Subgroup (Equiv.Perm Ω)) (x y : Ω → A) :
    ∀ (Δs : List (Set Ω)) (σ : Equiv.Perm Ω) (M : Subgroup (Equiv.Perm Ω)),
      ∀ I ∈ (chainReduction N x y Δs σ M).calls, I.K ⊆ (M : Set (Equiv.Perm Ω)) := by
  intro Δs
  induction Δs with
  | nil =>
    intro σ M I hI
    rw [chainReduction, SIReduction.calls_done] at hI
    exact absurd hI (List.not_mem_nil)
  | cons Δ rest ih =>
    intro σ M I hI
    rw [chainReduction, SIReduction.calls_call] at hI
    rcases List.mem_cons.1 hI with rfl | hI
    · exact le_rfl
    · by_cases h : (SIInstance.answer
          (⟨(M : Set (Equiv.Perm Ω)), Δ, x, strAct y σ⁻¹⟩ : SIInstance Ω A)).Nonempty
      · rw [dif_pos h] at hI
        exact le_trans (ih (σ * h.some) (M ⊓ autWindow N Δ x) I hI)
          (fun τ hτ => hτ.1)
      · rw [dif_neg h, SIReduction.calls_done] at hI
        exact absurd hI (List.not_mem_nil)

/-- The Chain Rule reduction is correct: starting from a state `(σ, M)` describing the
answer `Iso^{Δ₀}_N(x,y) = σ • M` for the windows processed so far, it computes
`Iso^{Δ₀ ∪ ⋃Δs}_N(x,y)`. -/
theorem run_chainReduction {N : Subgroup (Equiv.Perm Ω)} (x y : Ω → A) :
    ∀ (Δs : List (Set Ω)) (Δ₀ : Set Ω) (σ : Equiv.Perm Ω) (M : Subgroup (Equiv.Perm Ω)),
      (∀ Δ ∈ Δs, IsInvariant N Δ) → IsInvariant N Δ₀ → M ≤ N → σ ∈ N →
      wIso Δ₀ (N : Set (Equiv.Perm Ω)) x y = σ • (M : Set (Equiv.Perm Ω)) →
      (chainReduction N x y Δs σ M).run =
        wIso (Δ₀ ∪ ⋃ Δ ∈ Δs, Δ) (N : Set (Equiv.Perm Ω)) x y := by
  intro Δs
  induction Δs with
  | nil =>
    intro Δ₀ σ M _ _ _ _ hinv
    rw [chainReduction, SIReduction.run_done]
    simp only [List.not_mem_nil, Set.iUnion_of_empty, Set.iUnion_empty, Set.union_empty]
    exact hinv.symm
  | cons Δ rest ih =>
    intro Δ₀ σ M hΔs hΔ₀ hMN hσ hinv
    have hΔN : IsInvariant N Δ := hΔs Δ List.mem_cons_self
    have hstep := Proposition_11_1_7_chainRule (G := N) (G₁ := M) (Δ₁ := Δ₀) (Δ₂ := Δ)
      hΔ₀ hΔN hMN hσ (x := x) (y := y) hinv
    have hkey : wIso (Δ₀ ∪ Δ) (N : Set (Equiv.Perm Ω)) x y =
        σ • wIso Δ (M : Set (Equiv.Perm Ω)) x (strAct y σ⁻¹) := hstep.1.trans hstep.2
    have hunion : Δ₀ ∪ ⋃ Δ' ∈ (Δ :: rest), Δ' = (Δ₀ ∪ Δ) ∪ ⋃ Δ' ∈ rest, Δ' := by
      ext u
      simp only [Set.mem_union, Set.mem_iUnion, List.mem_cons, exists_prop]
      constructor
      · rintro (h | ⟨Δ', (rfl | hΔ'), hu⟩)
        · exact Or.inl (Or.inl h)
        · exact Or.inl (Or.inr hu)
        · exact Or.inr ⟨Δ', hΔ', hu⟩
      · rintro ((h | h) | ⟨Δ', hΔ', hu⟩)
        · exact Or.inl h
        · exact Or.inr ⟨Δ, Or.inl rfl, h⟩
        · exact Or.inr ⟨Δ', Or.inr hΔ', hu⟩
    rw [chainReduction, SIReduction.run_call, hunion]
    by_cases h : (SIInstance.answer
        (⟨(M : Set (Equiv.Perm Ω)), Δ, x, strAct y σ⁻¹⟩ : SIInstance Ω A)).Nonempty
    · rw [dif_pos h]
      have hρmem : h.some ∈ wIso Δ (M : Set (Equiv.Perm Ω)) x (strAct y σ⁻¹) := h.some_mem
      have hMΔ : IsInvariant M Δ := fun τ hτ => hΔN τ (hMN hτ)
      have hcoset := wIso_eq_smul_wAut_one (G := M) (Δ := Δ) hMΔ
        (x := x) (y := strAct y σ⁻¹) (σ := h.some) hρmem
      have hnew : wIso (Δ₀ ∪ Δ) (N : Set (Equiv.Perm Ω)) x y =
          (σ * h.some) • ((M ⊓ autWindow N Δ x : Subgroup (Equiv.Perm Ω)) :
            Set (Equiv.Perm Ω)) := by
        rw [hkey, hcoset, smul_smul, ← wAut_eq_inf hMN hΔN x]
      refine ih (Δ₀ ∪ Δ) (σ * h.some) (M ⊓ autWindow N Δ x)
        (fun Δ' hΔ' => hΔs Δ' (List.mem_cons_of_mem _ hΔ')) ?_ (le_trans inf_le_left hMN)
        (mul_mem hσ (hMN hρmem.1)) hnew
      intro τ hτ
      have h1 := hΔ₀ τ hτ
      have h2 := hΔN τ hτ
      rw [Set.image_union, h1, h2]
    · rw [dif_neg h, SIReduction.run_done]
      have hE : wIso Δ (M : Set (Equiv.Perm Ω)) x (strAct y σ⁻¹) = ∅ :=
        Set.not_nonempty_iff_eq_empty.1 h
      have hempty : wIso (Δ₀ ∪ Δ) (N : Set (Equiv.Perm Ω)) x y = ∅ := by
        rw [hkey, hE, Set.smul_set_empty]
      symm
      rw [Set.eq_empty_iff_forall_notMem]
      intro τ hτ
      have hmem : τ ∈ wIso (Δ₀ ∪ Δ) (N : Set (Equiv.Perm Ω)) x y := by
        refine ⟨hτ.1, fun u hu => hτ.2 u ?_⟩
        exact Set.mem_union_left _ hu
      rw [hempty] at hmem
      exact hmem

/-! ### Textbook background: two generators of the alternating group -/

/- `Babai.alternatingGroup_two_generated` (the alternating group on `k ≥ 3` letters is
generated by two elements) is proved in `Workspace/Prelim/TwoGenAlt.lean`. -/

/-- Two generators of `A(Γ)` *inside the group `A(Γ)`*: Prop. 12.0.5 is applied with
`H := A(Γ)` as the ambient group, so the generating set has to generate the whole of
`↥A(Γ)`. -/
theorem exists_altGens (k : ℕ) (hk : 3 ≤ k) :
    ∃ S : List (alternatingGroup (Fin k)), S.length = 2 ∧
      Subgroup.closure {σ : alternatingGroup (Fin k) | σ ∈ S} = ⊤ := by
  obtain ⟨a, b, hab⟩ := alternatingGroup_two_generated k hk
  have ha : a ∈ alternatingGroup (Fin k) := by
    rw [← hab]; exact Subgroup.subset_closure (Set.mem_insert _ _)
  have hb : b ∈ alternatingGroup (Fin k) := by
    rw [← hab]
    exact Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
  refine ⟨[⟨a, ha⟩, ⟨b, hb⟩], rfl, ?_⟩
  have hset : {σ : alternatingGroup (Fin k) | σ ∈ [(⟨a, ha⟩ : alternatingGroup (Fin k)),
      ⟨b, hb⟩]} = {(⟨a, ha⟩ : alternatingGroup (Fin k)), ⟨b, hb⟩} := by
    ext σ; simp
  rw [hset]
  refine Subgroup.map_injective (alternatingGroup (Fin k)).subtype_injective ?_
  rw [MonoidHom.map_closure]
  have himg : (alternatingGroup (Fin k)).subtype ''
      ({(⟨a, ha⟩ : alternatingGroup (Fin k)), ⟨b, hb⟩} : Set (alternatingGroup (Fin k)))
      = ({a, b} : Set (Equiv.Perm (Fin k))) := by
    ext c; simp [eq_comm]
  rw [himg, hab, ← MonoidHom.range_eq_map, Subgroup.subtype_range]

open Classical in
/-- A choice of two generators of `↥A(Γ)` (`Babai.exists_altGens`). -/
noncomputable def altGens (k : ℕ) : List (alternatingGroup (Fin k)) :=
  if h : ∃ S : List (alternatingGroup (Fin k)), S.length = 2 ∧
      Subgroup.closure {σ : alternatingGroup (Fin k) | σ ∈ S} = ⊤ then h.choose else []

theorem altGens_spec (k : ℕ) (hk : 3 ≤ k) :
    (altGens k).length = 2 ∧
      Subgroup.closure {σ : alternatingGroup (Fin k) | σ ∈ altGens k} = ⊤ := by
  classical
  have h := exists_altGens k hk
  rw [altGens, dif_pos h]
  exact h.choose_spec

/-! ### The Chain Rule expansion of an `N`-instance

Cor. 12.0.6 substitutes, for each of the `|S| + 1` instances "with respect to `N`"
produced by Prop. 12.0.5, the Chain Rule reduction over the orbits of `N`.  This is
`Babai.SIReduction.expand` applied to `Babai.chainOverOrbits`. -/

/-- The Chain Rule reduction of the instance `I` over the orbits of `N`.  Correct for the
instances with respect to `N` and window `Ω` (`Babai.run_chainOverOrbits`). -/
noncomputable def chainOverOrbits [Fintype Ω] (N : Subgroup (Equiv.Perm Ω))
    (I : SIInstance Ω A) : SIReduction Ω A (Set (Equiv.Perm Ω)) :=
  chainReduction N I.x I.y (orbitList N) 1 N

/-- `Babai.chainOverOrbits` answers correctly every instance with respect to `N` whose
window is all of `Ω`. -/
theorem run_chainOverOrbits [Fintype Ω] {N : Subgroup (Equiv.Perm Ω)} {I : SIInstance Ω A}
    (hK : I.K = (N : Set (Equiv.Perm Ω))) (hΔ : I.Δ = Set.univ) :
    (chainOverOrbits N I).run = I.answer := by
  have hrun := run_chainReduction (N := N) I.x I.y (orbitList N) ∅ 1 N
    (fun Δ hΔ' => isInvariant_of_mem_orbitList hΔ') (by intro σ _; simp) le_rfl (one_mem _)
    (by rw [wIso_empty, one_smul])
  rw [chainOverOrbits, hrun, iUnion_orbitList, Set.empty_union, wIso_univ,
    SIInstance.answer, hK, hΔ, wIso_univ]

/-- `Babai.chainOverOrbits` makes at most one call per orbit of `N`. -/
theorem calls_length_chainOverOrbits [Fintype Ω] (N : Subgroup (Equiv.Perm Ω))
    (I : SIInstance Ω A) :
    (chainOverOrbits N I).calls.length ≤ (orbitList N).length :=
  (calls_chainReduction N I.x I.y (orbitList N) 1 N).1

/-- Every call of `Babai.chainOverOrbits` has an orbit of `N` for its window. -/
theorem calls_chainOverOrbits_window [Fintype Ω] (N : Subgroup (Equiv.Perm Ω))
    (I : SIInstance Ω A) :
    ∀ J ∈ (chainOverOrbits N I).calls, J.Δ ∈ orbitList N :=
  (calls_chainReduction N I.x I.y (orbitList N) 1 N).2

/-- Every call of `Babai.chainOverOrbits` has its candidate set inside `N`. -/
theorem calls_chainOverOrbits_K [Fintype Ω] (N : Subgroup (Equiv.Perm Ω))
    (I : SIInstance Ω A) :
    ∀ J ∈ (chainOverOrbits N I).calls, J.K ⊆ (N : Set (Equiv.Perm Ω)) :=
  calls_chainReduction_K N I.x I.y (orbitList N) 1 N

/-! ### Even permutations carrying one set onto another

`Babai.exists_mem_image_eq_of_ncard_eq` (`Workspace/AltQuotients/SmallIndex.lean`) moves an
`s`-subset to an `s`-subset by a group containing `A(Ω)`, but only for `s + 2 ≤ n`.  The
two lemmas here remove that restriction (`n ≥ 3` is enough, by passing to complements) and
add the version with a prescribed pointwise-fixed set, which is what the transitivity
argument of Cor. 12.0.10 needs. -/

/-- `A(Δ)` is transitive on the subsets of `Δ` of any given size, as soon as `|Δ| ≥ 3`.

For `s + 2 ≤ |Δ|` this is `Babai.exists_mem_image_eq_of_ncard_eq`.  Otherwise
`s ≥ |Δ| − 1 ≥ 2`, and the complements have size `|Δ| − s ≤ 1`, so the same lemma applies
to them; an even permutation carries `C` onto `D` exactly when it carries `Cᶜ` onto
`Dᶜ`. -/
theorem exists_alternating_image_eq {Δ : Type*} [Fintype Δ] [DecidableEq Δ]
    (hΔ : 3 ≤ Nat.card Δ) {C D : Set Δ} (h : C.ncard = D.ncard) :
    ∃ α ∈ alternatingGroup Δ, (α : Equiv.Perm Δ) '' C = D := by
  classical
  by_cases hc : C.ncard + 2 ≤ Nat.card Δ
  · exact exists_mem_image_eq_of_ncard_eq (K := alternatingGroup Δ) le_rfl rfl h.symm hc
  · push_neg at hc
    have hCc := Set.ncard_add_ncard_compl C
    have hDc := Set.ncard_add_ncard_compl D
    have hcompl : (Cᶜ : Set Δ).ncard = (Dᶜ : Set Δ).ncard := by
      rw [Nat.card_eq_fintype_card] at hCc hDc; omega
    have hsmall : (Cᶜ : Set Δ).ncard + 2 ≤ Nat.card Δ := by
      rw [Nat.card_eq_fintype_card] at hCc ⊢
      rw [Nat.card_eq_fintype_card] at hc
      omega
    obtain ⟨α, hα, himg⟩ := exists_mem_image_eq_of_ncard_eq (K := alternatingGroup Δ)
      le_rfl (T := Cᶜ) (U := Dᶜ) rfl hcompl.symm hsmall
    refine ⟨α, hα, ?_⟩
    have hbij : Function.Bijective (α : Equiv.Perm Δ) := α.bijective
    have : ((α : Equiv.Perm Δ) '' C)ᶜ = Dᶜ := by
      rw [← Set.image_compl_eq hbij]; exact himg
    exact compl_injective this

/-- The form used in the proof of Cor. 12.0.10: an **even** permutation of `Γ` that **fixes
`T` pointwise** and carries `C` onto `D`, for two sets `C`, `D` of the same size that both
contain `T`.

It exists as soon as `|Γ ∖ T| ≥ 3`: apply `Babai.exists_alternating_image_eq` inside
`Γ ∖ T` to the sets `C ∖ T` and `D ∖ T` (which have the same size `|C| − |T|`), and extend
the resulting even permutation by the identity on `T` (`Equiv.Perm.ofSubtype`, which
preserves the sign). -/
theorem exists_alternating_fixing_image_eq {Γ : Type*} [Fintype Γ] [DecidableEq Γ]
    {T C D : Set Γ} (hTC : T ⊆ C) (hTD : T ⊆ D) (hCD : C.ncard = D.ncard)
    (hΓ : 3 ≤ (Tᶜ : Set Γ).ncard) :
    ∃ α ∈ alternatingGroup Γ, (∀ γ ∈ T, (α : Equiv.Perm Γ) γ = γ) ∧
      (α : Equiv.Perm Γ) '' C = D := by
  classical
  -- the two sets seen inside the subtype `Γ ∖ T`
  set p : Γ → Prop := fun γ => γ ∉ T with hp
  set C' : Set (Subtype p) := {z | (z : Γ) ∈ C} with hC'
  set D' : Set (Subtype p) := {z | (z : Γ) ∈ D} with hD'
  have hcard : ∀ S : Set Γ, T ⊆ S →
      ({z : Subtype p | (z : Γ) ∈ S}).ncard + T.ncard = S.ncard := by
    intro S hTS
    have himg : (Subtype.val '' {z : Subtype p | (z : Γ) ∈ S}) = S \ T := by
      ext γ
      constructor
      · rintro ⟨z, hz, rfl⟩; exact ⟨hz, z.2⟩
      · rintro ⟨hγS, hγT⟩; exact ⟨⟨γ, hγT⟩, hγS, rfl⟩
    have h1 : ({z : Subtype p | (z : Γ) ∈ S}).ncard = (S \ T).ncard := by
      rw [← himg, Set.ncard_image_of_injective _ Subtype.val_injective]
    have h2 := Set.ncard_inter_add_ncard_diff_eq_ncard S T (Set.toFinite _)
    rw [Set.inter_eq_self_of_subset_right hTS] at h2
    rw [h1]; omega
  have hCD' : C'.ncard = D'.ncard := by
    have h1 := hcard C hTC
    have h2 := hcard D hTD
    rw [hC', hD']; omega
  have hcardsub : 3 ≤ Nat.card (Subtype p) := by
    have : Nat.card (Subtype p) = (Tᶜ : Set Γ).ncard := by
      rw [← Nat.card_coe_set_eq]; rfl
    omega
  obtain ⟨β, hβ, hβimg⟩ := exists_alternating_image_eq (Δ := Subtype p) hcardsub hCD'
  refine ⟨Equiv.Perm.ofSubtype β, ?_, ?_, ?_⟩
  · rw [Equiv.Perm.mem_alternatingGroup, Equiv.Perm.sign_ofSubtype]
    exact hβ
  · intro γ hγ
    exact Equiv.Perm.ofSubtype_apply_of_not_mem β (by simpa [hp] using hγ)
  · ext δ
    constructor
    · rintro ⟨γ, hγC, rfl⟩
      by_cases hγT : γ ∈ T
      · rw [Equiv.Perm.ofSubtype_apply_of_not_mem β (by simpa [hp] using hγT)]
        exact hTD hγT
      · have hpγ : p γ := hγT
        rw [Equiv.Perm.ofSubtype_apply_of_mem β hpγ]
        have : β ⟨γ, hpγ⟩ ∈ D' := by rw [← hβimg]; exact ⟨⟨γ, hpγ⟩, hγC, rfl⟩
        exact this
    · intro hδD
      by_cases hδT : δ ∈ T
      · exact ⟨δ, hTC hδT,
          Equiv.Perm.ofSubtype_apply_of_not_mem β (by simpa [hp] using hδT)⟩
      · have hpδ : p δ := hδT
        have : (⟨δ, hpδ⟩ : Subtype p) ∈ D' := hδD
        rw [← hβimg] at this
        obtain ⟨z, hzC, hzδ⟩ := this
        refine ⟨(z : Γ), hzC, ?_⟩
        rw [Equiv.Perm.ofSubtype_apply_of_mem β z.2]
        exact congrArg Subtype.val hzδ

end Babai
