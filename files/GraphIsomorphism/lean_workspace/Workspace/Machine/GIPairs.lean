import Workspace.Luks.GraphToString
import Workspace.Machine.Targets
import Mathlib.GroupTheory.Perm.Fin
import Mathlib.GroupTheory.Perm.Closure
import Mathlib.Data.List.NodupEquivFin
import Mathlib.Data.List.Nodup
import Mathlib.Data.List.ProdSigma

/-!
# Numbering unordered pairs

We list pairs `(i,j)` with `i < j < n` in row order. This list gives an explicit
numbering of the domain of the GI reduction. The induced symmetric group is
generated by the images of a cycle and an adjacent transposition.
-/

namespace Babai.GraphToString

open Equiv

/-- The row order on unordered pairs. -/
def pairList (n : ℕ) : List (ℕ × ℕ) :=
  ((List.range n).product (List.range n)).filter fun p => decide (p.1 < p.2)

@[simp] theorem mem_pairList {n : ℕ} {p : ℕ × ℕ} :
    p ∈ pairList n ↔ p.1 < n ∧ p.2 < n ∧ p.1 < p.2 := by
  rcases p with ⟨i, j⟩
  simp [pairList, List.product, List.mem_flatMap, and_assoc, and_left_comm]

theorem pairList_nodup (n : ℕ) : (pairList n).Nodup :=
  (List.Nodup.product (List.nodup_range (n := n)) List.nodup_range).filter _

/-- Turn a listed pair into the corresponding two-element set. -/
def listedPair {n : ℕ} (p : {p // p ∈ pairList n}) : Pairs n :=
  pair ⟨p.val.1, (mem_pairList.mp p.property).1⟩
    ⟨p.val.2, (mem_pairList.mp p.property).2.1⟩
    (fun h => (Nat.ne_of_lt (mem_pairList.mp p.property).2.2) (congrArg Fin.val h))

theorem listedPair_injective {n : ℕ} : Function.Injective (@listedPair n) := by
  intro p q h
  have heq := congrArg Subtype.val h
  change ({⟨p.val.1, _⟩, ⟨p.val.2, _⟩} : Finset (Fin n)) = {⟨q.val.1, (mem_pairList.mp q.property).1⟩, ⟨q.val.2, (mem_pairList.mp q.property).2.1⟩} at heq
  have h1 : p.val.1 = q.val.1 ∨ p.val.1 = q.val.2 := by
    have hm : (⟨p.val.1, (mem_pairList.mp p.property).1⟩ : Fin n) ∈
        ({⟨q.val.1, (mem_pairList.mp q.property).1⟩, ⟨q.val.2, (mem_pairList.mp q.property).2.1⟩} : Finset (Fin n)) := by rw [← heq]; simp
    simpa only [Finset.mem_insert, Finset.mem_singleton, Fin.mk.injEq] using hm
  have h2 : p.val.2 = q.val.1 ∨ p.val.2 = q.val.2 := by
    have hm : (⟨p.val.2, (mem_pairList.mp p.property).2.1⟩ : Fin n) ∈
        ({⟨q.val.1, (mem_pairList.mp q.property).1⟩, ⟨q.val.2, (mem_pairList.mp q.property).2.1⟩} : Finset (Fin n)) := by rw [← heq]; simp
    simpa only [Finset.mem_insert, Finset.mem_singleton, Fin.mk.injEq] using hm
  have hp := (mem_pairList.mp p.property).2.2
  have hq := (mem_pairList.mp q.property).2.2
  apply Subtype.ext
  apply Prod.ext <;> omega

theorem listedPair_surjective {n : ℕ} : Function.Surjective (@listedPair n) := by
  intro p
  obtain ⟨u, v, huv, hp⟩ := Finset.card_eq_two.mp p.property
  have huv' : u.val ≠ v.val := fun h => huv (Fin.ext h)
  rcases lt_or_gt_of_ne huv' with h | h
  · refine ⟨⟨(u.val, v.val), mem_pairList.mpr ⟨u.isLt, v.isLt, h⟩⟩, ?_⟩
    exact Subtype.ext hp.symm
  · refine ⟨⟨(v.val, u.val), mem_pairList.mpr ⟨v.isLt, u.isLt, h⟩⟩, ?_⟩
    apply Subtype.ext
    simpa [listedPair, pair, Finset.pair_comm] using hp.symm

/-- The explicit numbering map goes from list positions to unordered pairs. -/
noncomputable def pairEnum (n : ℕ) : Fin (pairList n).length ≃ Pairs n :=
  ((pairList_nodup n).getEquiv (pairList n)).trans
    (Equiv.ofBijective listedPair ⟨listedPair_injective, listedPair_surjective⟩)

theorem pairList_length (n : ℕ) : (pairList n).length = n.choose 2 := by
  have := Nat.card_congr (pairEnum n)
  simpa [card_pairs] using this

/-- The action on the numbered domain. -/
noncomputable def numberedAction (n : ℕ) :
    Perm (Fin n) →* Perm (Fin (pairList n).length) :=
  (pairEnum n).symm.permCongrHom.toMonoidHom.comp (tAction 2)

/-- Two vertex generators. Below degree two the symmetric group is trivial. -/
def vertexGens (n : ℕ) : List (Perm (Fin n)) :=
  if h : 2 ≤ n then
    [finRotate n, Equiv.swap ⟨0, by omega⟩ (finRotate n ⟨0, by omega⟩)]
  else []

theorem vertexGens_generate (n : ℕ) : RAM.Targets.genGroup (vertexGens n) = ⊤ := by
  by_cases hn : 2 ≤ n
  · simpa [vertexGens, hn, RAM.Targets.genGroup] using
      Perm.closure_cycle_adjacent_swap (isCycle_finRotate_of_le hn)
        (support_finRotate_of_le hn) (⟨0, by omega⟩ : Fin n)
  · apply top_unique
    intro σ _
    have hσ : σ = 1 := by
      apply Equiv.ext
      intro u
      apply Fin.ext
      have := (σ u).isLt
      have := u.isLt
      omega
    rw [hσ]
    exact Subgroup.one_mem _

/-- The two induced permutations used in the SI instance. -/
noncomputable def pairGens (n : ℕ) : List (Perm (Fin (pairList n).length)) :=
  (vertexGens n).map (numberedAction n)

theorem pairGens_generate (n : ℕ) :
    RAM.Targets.genGroup (pairGens n) = (numberedAction n).range := by
  have hm : RAM.Targets.genGroup (pairGens n) =
      (RAM.Targets.genGroup (vertexGens n)).map (numberedAction n) := by
    simp only [RAM.Targets.genGroup, pairGens, MonoidHom.map_closure]
    congr 1
    ext π
    simp
  rw [hm, vertexGens_generate, MonoidHom.range_eq_map]

/-- The typed SI instance under the explicit pair numbering. -/
noncomputable def siInput {n : ℕ} (X Y : SimpleGraph (Fin n)) :
    RAM.Targets.SIInput (pairList n).length 2 :=
  (pairGens n, edgeString X ∘ pairEnum n, edgeString Y ∘ pairEnum n)

theorem siInput_correct {n : ℕ} (X Y : SimpleGraph (Fin n)) :
    (RAM.Targets.IsoSet (siInput X Y).1 (siInput X Y).2.1 (siInput X Y).2.2).Nonempty ↔
      (Iso X Y).Nonempty := by
  constructor
  · rintro ⟨π, hπ, hstr⟩
    rw [show (siInput X Y).1 = pairGens n from rfl, pairGens_generate] at hπ
    obtain ⟨σ, rfl⟩ := hπ
    refine ⟨σ, (iso_iff_preserves_string X Y σ).mpr fun p => ?_⟩
    simpa [siInput, numberedAction, Function.comp_def] using hstr ((pairEnum n).symm p)
  · rintro ⟨σ, hσ⟩
    refine ⟨numberedAction n σ, ?_, fun i => ?_⟩
    · change numberedAction n σ ∈ RAM.Targets.genGroup (pairGens n)
      rw [pairGens_generate]
      exact ⟨σ, rfl⟩
    · simpa [siInput, numberedAction, Function.comp_def] using
        (iso_iff_preserves_string X Y σ).mp hσ (pairEnum n i)

end Babai.GraphToString
