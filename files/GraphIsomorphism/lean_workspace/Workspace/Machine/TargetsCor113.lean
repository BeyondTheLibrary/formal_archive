import Workspace.Machine.TargetsGI
import Mathlib.GroupTheory.GroupAction.Basic

/-!
# The targets of Corollaries 1.1.3 and 1.1.4

Statements only, like `Workspace/Machine/Targets.lean`. Both corollaries bound the running
time by a polynomial in one parameter times a quasipolynomial in a second one:

> **Corollary 1.1.3.** The SI problem can be solved in time, polynomial in `n` (the length of
> the strings) and quasipolynomial in `n₀(G)`, the length of the largest orbit of `G`.
>
> **Corollary 1.1.4.** The GI problem for vertex-colored graphs can be solved in time,
> polynomial in `n` (the number of vertices) and quasipolynomial in the largest color
> multiplicity.

"Polynomial in `N` and quasipolynomial in `M`" is read as a bound
`(N + 1)^c · 2^((log₂ M + 2)^c)` for one constant `c`, the product form of
`RAM.PolyBound` and `RAM.QuasiPolyBound` (`Workspace/Machine/TimeClasses.lean`).

**Which `n` for Corollary 1.1.3.** An SI input is a list of generators and two strings; its
encoding is not bounded by a function of `n` (the list of generators can be as long as one
likes, and the letters as large). A program must read its input, so no bound polynomial in `n`
alone holds for all inputs. As in `RAM.Targets.Theorem_1_1_1_statement`, where the
quasipolynomial bound is in the input size, the polynomial factor is taken in the input
size, which is at least `n`. For graphs the input (two adjacency matrices and two colorings by
at most `n` colors) has size polynomial in `n`, and Corollary 1.1.4 is stated in `n` itself.
-/

namespace RAM
namespace Targets

open Equiv Classical

/-- `n₀(G)`, the length of the largest orbit of the group generated by `gens` (`0` when the
domain is empty). -/
noncomputable def maxOrbitLength {n : ℕ} (gens : List (Perm (Fin n))) : ℕ :=
  Finset.univ.sup fun u : Fin n => (MulAction.orbit (genGroup gens) u).ncard

/-- The bound "polynomial in `N`, quasipolynomial in `M`", with one constant `c`. -/
def polyQuasiBound (c N M : ℕ) : ℕ := (N + 1) ^ c * 2 ^ ((Nat.log 2 M + 2) ^ c)

/-- **Corollary 1.1.3, Sec. 1.1.**  One RAM program solves String Isomorphism (in the search
form of Def. 11.1.2, as in Theorem 1.1.1) within a time polynomial in the input size and
quasipolynomial in the length of the largest orbit of `G`, uniformly in the domain size and the
alphabet. -/
def Corollary_1_1_3_statement : Prop :=
  ∃ (P : Program) (c : ℕ), ∀ (n s : ℕ) (a : SIInput n s),
    ∃ b, SIRel n s a b ∧
      ∃ k ≤ polyQuasiBound c (Enc.size a) (maxOrbitLength a.1),
        Halted P (run P (Config.init (Enc.encode a)) k) ∧
          OutputAt (run P (Config.init (Enc.encode a)) k).mem (Enc.encode b)

/-- An input of vertex-colored Graph Isomorphism: two graphs on `Fin n`, each with a coloring
of its vertices. At most `n` colors are ever used, so colors are named by `Fin n`. -/
structure ColGIInput (n : ℕ) where
  X : SimpleGraph (Fin n)
  Y : SimpleGraph (Fin n)
  cX : Fin n → Fin n
  cY : Fin n → Fin n

/-- What the machine reads: the two adjacency matrices and the two color arrays. -/
noncomputable def ColGIInput.raw {n : ℕ} (a : ColGIInput n) :
    List (List ℕ) × List (List ℕ) × List ℕ × List ℕ :=
  (graphMatrix a.X, graphMatrix a.Y, List.ofFn fun u => (a.cX u : ℕ),
    List.ofFn fun u => (a.cY u : ℕ))

noncomputable instance {n : ℕ} : Enc (ColGIInput n) where
  encode a := Enc.encode a.raw
  encode_injective := by
    intro a b h
    have h' : a.raw = b.raw := Enc.encode_injective h
    simp only [ColGIInput.raw, Prod.mk.injEq] at h'
    obtain ⟨hX, hY, hcX, hcY⟩ := h'
    have hX' := graphMatrix_injective hX
    have hY' := graphMatrix_injective hY
    have hcX' : a.cX = b.cX := by
      funext u; exact Fin.ext (congrFun (List.ofFn_injective hcX) u)
    have hcY' : a.cY = b.cY := by
      funext u; exact Fin.ext (congrFun (List.ofFn_injective hcY) u)
    cases a; cases b
    simp_all

/-- The isomorphisms of vertex-colored graphs: graph isomorphisms `X → Y` that send each
vertex to a vertex of the same color ("isomorphisms preserve color by definition"). -/
def ColIso {n : ℕ} (a : ColGIInput n) : Set (Perm (Fin n)) :=
  {σ | σ ∈ Babai.GraphToString.Iso a.X a.Y ∧ ∀ u, a.cY (σ u) = a.cX u}

/-- The largest color multiplicity: the largest number of vertices of one color, in either
graph. -/
noncomputable def maxColorMultiplicity {n : ℕ} (a : ColGIInput n) : ℕ :=
  Finset.univ.sup fun c : Fin n =>
    max (Finset.univ.filter fun u => a.cX u = c).card (Finset.univ.filter fun u => a.cY u = c).card

/-- **Corollary 1.1.4, Sec. 1.1.**  One RAM program decides isomorphism of vertex-colored
graphs within a time polynomial in the number of vertices and quasipolynomial in the largest
color multiplicity, uniformly in the number of vertices. -/
def Corollary_1_1_4_statement : Prop :=
  ∃ (P : Program) (c : ℕ), ∀ n : ℕ, ∃ f : ColGIInput n → Bool,
    (∀ a, f a = true ↔ (ColIso a).Nonempty) ∧
      ∀ a, ∃ k ≤ polyQuasiBound c n (maxColorMultiplicity a),
        Halted P (run P (Config.init (Enc.encode a)) k) ∧
          OutputAt (run P (Config.init (Enc.encode a)) k).mem (Enc.encode (f a))

end Targets
end RAM
