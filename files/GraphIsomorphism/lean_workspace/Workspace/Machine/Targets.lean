import Workspace.Machine.TimeClasses
import Mathlib.Algebra.Group.Subgroup.Basic

/-!
# What the main theorem will say in this model

Statements only: this file fixes, in terms of the RAM of `RAM.lean` and the time classes of
`TimeClasses.lean`, what is to be proved.  Nothing here is proved, and nothing here is an
axiom: every declaration is a `def ... : Prop`.  The file is self-contained (isomorphism is
defined inline from Mathlib notions) so that it does not depend on the other tracks of the
formalization.  The proofs are elsewhere: Theorem 1.1.1 is `Algo.theorem_1_1_1`,
its decision form `Algo.theorem_1_1_1_decision`, and Corollary 1.1.2 `Algo.corollary_1_1_2`
(`Workspace/Algo/TopMasterClose.lean`).

* `RAM.Targets.SIRel` is the input/output specification of the String Isomorphism problem,
  Definition 11.1.2 of the paper (Sec. 11.1): given `Ω`, an alphabet, two strings and a
  permutation group by a list of generators, output `Iso_G(x,y)`, represented, when nonempty,
  by a list of generators of `Aut_G(x)` together with one `σ ∈ Iso_G(x,y)`.
* `RAM.Targets.Theorem_1_1_1_statement` is Theorem 1.1.1: one program, one quasipolynomial
  bound, working for every domain size and every alphabet size.

Following (58) of Sec. 11.1, `τ` is an isomorphism from `x` to `y` when `x u = y (τ u)` for
every point `u`.
-/

namespace RAM
namespace Targets

open Equiv

/-- The input of String Isomorphism on the domain `Ω = Fin n` over the alphabet `Fin s`: a
list of generators of `G ≤ S(Ω)`, and two strings. -/
abbrev SIInput (n s : ℕ) :=
  List (Perm (Fin n)) × (Fin n → Fin s) × (Fin n → Fin s)

/-- The group generated by a list of permutations. -/
def genGroup {n : ℕ} (gens : List (Perm (Fin n))) : Subgroup (Perm (Fin n)) :=
  Subgroup.closure {g | g ∈ gens}

/-- `Iso_G(x, y)`, Def. 11.1.2 and (58) of Sec. 11.1: the set of `τ ∈ G` with
`x u = y (τ u)` for all `u`. -/
def IsoSet {n s : ℕ} (gens : List (Perm (Fin n))) (x y : Fin n → Fin s) :
    Set (Perm (Fin n)) :=
  {τ | τ ∈ genGroup gens ∧ ∀ u, x u = y (τ u)}

/-- `Aut_G(x) = Iso_G(x, x)`. -/
def AutSet {n s : ℕ} (gens : List (Perm (Fin n))) (x : Fin n → Fin s) : Set (Perm (Fin n)) :=
  IsoSet gens x x

/-- **Definition 11.1.2 (String Isomorphism Problem), Sec. 11.1.**  The input/output relation:
the output is `none` when `Iso_G(x,y)` is empty, and otherwise a list of generators of
`Aut_G(x)` together with a coset representative `σ ∈ Iso_G(x,y)`.  The output is not unique,
which is why this is a relation and the time class used is `SolvesInTime`. -/
def SIRel (n s : ℕ) :
    SIInput n s → Option (List (Perm (Fin n)) × Perm (Fin n)) → Prop
  | (gens, x, y), none => IsoSet gens x y = ∅
  | (gens, x, y), some (aut, σ) =>
      σ ∈ IsoSet gens x y ∧ (genGroup aut : Set (Perm (Fin n))) = AutSet gens x

/-- **Theorem 1.1.1, Sec. 1.1.**  The String Isomorphism problem is solved by a single RAM
program within a single quasipolynomial time bound, uniformly in the size of the domain and of
the alphabet. -/
def Theorem_1_1_1_statement : Prop :=
  ∃ (P : Program) (T : ℕ → ℕ), QuasiPolyBound T ∧ ∀ n s : ℕ, SolvesInTime P (SIRel n s) T

/-- The decision version stated in the Introduction ("is `Iso_G(x,y)` nonempty?"), which
Sec. 11.1 notes is polynomial-time equivalent to the computation version. -/
def Theorem_1_1_1_decision_statement : Prop :=
  ∃ (P : Program) (T : ℕ → ℕ), QuasiPolyBound T ∧ ∀ n s : ℕ,
    ∃ f : SIInput n s → Bool,
      (∀ inp, f inp = true ↔ (IsoSet inp.1 inp.2.1 inp.2.2).Nonempty) ∧
        ComputesInTime P f T

end Targets
end RAM
