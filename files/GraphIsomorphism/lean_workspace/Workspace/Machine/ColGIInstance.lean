import Workspace.Machine.TargetsCor113
import Workspace.Machine.CIInstance
import Mathlib.GroupTheory.Perm.Support

/-!
# Corollary 1.1.4: vertex-colored Graph Isomorphism as String Isomorphism

The paper derives Corollary 1.1.4 from Corollary 1.1.3 without spelling out the reduction.
The reduction used here keeps the orbits short, which is all Corollary 1.1.3 needs.

The two colored graphs `(X, c_X)` and `(Y, c_Y)` on `Fin n` are put side by side on
`Fin (n + n)`: the first copy of `Fin n` carries `X` and `c_X`, the second `Y` and `c_Y`. The
group `G` is the group of all permutations of `Fin (n + n)` that preserve the combined coloring;
it is generated by the transpositions of equally colored points. `G` acts on ordered pairs, and
the two strings on ordered pairs are the same except on the diagonal:

* off the diagonal, a pair inside the first copy carries the edge bit of `X`, a pair inside the
  second copy the edge bit of `Y`, and a mixed pair `0`;
* on the diagonal, the first string marks the first copy with `2` and the second copy with `3`,
  and the second string the other way round.

An element of `G` carrying the first string to the second must exchange the two copies (the
diagonal marks), and its restriction to the first copy is then a color-preserving isomorphism
`X → Y`; conversely such an isomorphism `σ` gives the element `σ` on the first copy and `σ⁻¹`
on the second (`RAM.ColGIReduction.instanceSI_correct`).

Every orbit of `G` on `Fin (n + n)` lies in one combined color class, which has at most `2k`
points for the largest color multiplicity `k`, so every orbit on pairs has at most `(2k)²` points
(`RAM.ColGIReduction.maxOrbitLength_instanceSI_le`).
-/

namespace RAM.ColGIReduction

open Targets Equiv Babai Classical

variable {n : ℕ}

/-- The combined coloring of `Fin (n + n)`. -/
def col (a : ColGIInput n) : Fin (n + n) → Fin n := Fin.append a.cX a.cY

/-- The transposition of two points of the same color, and the identity otherwise. -/
def swp (a : ColGIInput n) (u v : Fin (n + n)) : Perm (Fin (n + n)) :=
  if col a u = col a v then swap u v else 1

/-- The generators of `G`: one for each ordered pair of points, numbered as in
`RAM.CIReduction.action`. -/
def vertexGens (a : ColGIInput n) : List (Perm (Fin (n + n))) :=
  List.ofFn fun i : Fin ((n + n) * (n + n)) =>
    swp a (finProdFinEquiv.symm i).1 (finProdFinEquiv.symm i).2

/-- The action on ordered pairs. -/
def pairHom : Perm (Fin (n + n)) →* Perm (Fin ((n + n) * (n + n))) :=
  (CIReduction.action (n + n)).comp ((MonoidHom.id _).prod (MonoidHom.id _))

theorem pairHom_apply (g : Perm (Fin (n + n))) (i : Fin ((n + n) * (n + n))) :
    pairHom g i = finProdFinEquiv ((g (finProdFinEquiv.symm i).1, g (finProdFinEquiv.symm i).2)) :=
  rfl

/-- The side of a point: `inl` for the first copy, `inr` for the second. -/
def side (ω : Fin (n + n)) : Fin n ⊕ Fin n := finSumFinEquiv.symm ω

/-- The letter at an ordered pair of points, given by their sides. `mark` chooses the diagonal
marks: `2` for the first copy and `3` for the second when it is `true`, the other way round
otherwise. -/
noncomputable def letter (X Y : SimpleGraph (Fin n)) (mark : Bool) : Fin n ⊕ Fin n → Fin n ⊕ Fin n → Fin 4
  | .inl u, .inl v => if u = v then (if mark then 2 else 3) else if X.Adj u v then 1 else 0
  | .inr u, .inr v => if u = v then (if mark then 3 else 2) else if Y.Adj u v then 1 else 0
  | _, _ => 0

/-- The string on ordered pairs. -/
noncomputable def pairStr (a : ColGIInput n) (mark : Bool) : Fin ((n + n) * (n + n)) → Fin 4 := fun i =>
  letter a.X a.Y mark (side (finProdFinEquiv.symm i).1) (side (finProdFinEquiv.symm i).2)

/-- **The SI instance of a colored GI instance.** -/
noncomputable def instanceSI (a : ColGIInput n) : SIInput ((n + n) * (n + n)) 4 :=
  ((vertexGens a).map pairHom, pairStr a true, pairStr a false)

/-! ## The group -/

/-- The permutations preserving the combined coloring. -/
def colStab (a : ColGIInput n) : Subgroup (Perm (Fin (n + n))) where
  carrier := {g | ∀ ω, col a (g ω) = col a ω}
  mul_mem' := by
    intro g h hg hh ω
    exact (hg (h ω)).trans (hh ω)
  one_mem' := fun _ => rfl
  inv_mem' := by
    intro g hg ω
    have := hg (g⁻¹ ω)
    rw [show g (g⁻¹ ω) = ω from Equiv.apply_symm_apply g ω] at this
    exact this.symm

theorem swp_mem (a : ColGIInput n) (u v : Fin (n + n)) : swp a u v ∈ colStab a := by
  unfold swp
  split_ifs with h
  · intro ω
    rw [swap_apply_def]
    split_ifs with h1 h2
    · rw [h1]; exact h.symm
    · rw [h2]; exact h
    · rfl
  · exact (colStab a).one_mem

theorem genGroup_vertexGens_le (a : ColGIInput n) : genGroup (vertexGens a) ≤ colStab a := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hg
  exact swp_mem a _ _

theorem swap_mem_genGroup (a : ColGIInput n) {u v : Fin (n + n)} (h : col a u = col a v) :
    swap u v ∈ genGroup (vertexGens a) := by
  apply Subgroup.subset_closure
  show swap u v ∈ vertexGens a
  refine List.mem_ofFn.mpr ⟨finProdFinEquiv (u, v), ?_⟩
  simp only [Equiv.symm_apply_apply, swp, h, if_true]

/-- **`G` is the group of color-preserving permutations**: every one of them is a product of
transpositions of equally colored points. -/
theorem colStab_le_genGroup (a : ColGIInput n) : colStab a ≤ genGroup (vertexGens a) := by
  intro g hg
  induction h : g.support.card using Nat.strong_induction_on generalizing g with
  | _ k ih =>
    by_cases h1 : g = 1
    · rw [h1]; exact one_mem _
    · obtain ⟨x, hx⟩ : ∃ x, g x ≠ x := by
        by_contra hne
        push Not at hne
        exact h1 (Equiv.ext hne)
      have hcol : col a x = col a (g x) := (hg x).symm
      have hlt := Perm.card_support_swap_mul hx
      have hsw : swap x (g x) ∈ colStab a := by
        have := swp_mem a x (g x)
        unfold swp at this
        rwa [if_pos hcol] at this
      have hmem : swap x (g x) * g ∈ colStab a := (colStab a).mul_mem hsw hg
      have hrest := ih _ (by rw [← h]; exact hlt) hmem rfl
      have hs := swap_mem_genGroup a hcol
      have := mul_mem hs hrest
      rwa [← mul_assoc, swap_mul_self, one_mul] at this

theorem genGroup_vertexGens (a : ColGIInput n) : genGroup (vertexGens a) = colStab a :=
  le_antisymm (genGroup_vertexGens_le a) (colStab_le_genGroup a)

theorem genGroup_map (a : ColGIInput n) :
    genGroup ((vertexGens a).map pairHom) = (colStab a).map pairHom := by
  rw [← genGroup_vertexGens, genGroup, genGroup, MonoidHom.map_closure]
  congr 1
  ext π
  simp [List.mem_map]

/-! ## Correctness -/

theorem col_castAdd (a : ColGIInput n) (u : Fin n) : col a (Fin.castAdd n u) = a.cX u :=
  Fin.append_left _ _ _

theorem col_natAdd (a : ColGIInput n) (v : Fin n) : col a (Fin.natAdd n v) = a.cY v :=
  Fin.append_right _ _ _

/-- The string condition, read on the sides of the two points. -/
theorem mem_isoSet_iff (a : ColGIInput n) (g : Perm (Fin (n + n))) :
    (∀ i, pairStr a true i = pairStr a false (pairHom g i)) ↔
      ∀ p q, letter a.X a.Y true p q =
        letter a.X a.Y false (side (g (finSumFinEquiv p))) (side (g (finSumFinEquiv q))) := by
  constructor
  · intro h p q
    have := h (finProdFinEquiv (finSumFinEquiv p, finSumFinEquiv q))
    simpa [pairStr, pairHom_apply, side] using this
  · intro h i
    have := h (side (finProdFinEquiv.symm i).1) (side (finProdFinEquiv.symm i).2)
    simpa [pairStr, pairHom_apply, side] using this

/-- **The reduction is correct**: the SI instance has an isomorphism exactly when the colored
graphs are isomorphic. -/
theorem instanceSI_correct (a : ColGIInput n) :
    (IsoSet (instanceSI a).1 (instanceSI a).2.1 (instanceSI a).2.2).Nonempty ↔
      (ColIso a).Nonempty := by
  constructor
  · rintro ⟨π, hπ, hstr⟩
    change π ∈ genGroup ((vertexGens a).map pairHom) at hπ
    rw [genGroup_map] at hπ
    obtain ⟨g, hg, rfl⟩ := hπ
    have hs := (mem_isoSet_iff a g).mp hstr
    -- the first copy goes to the second
    have hright : ∀ u : Fin n, ∃ v : Fin n, side (g (finSumFinEquiv (.inl u))) = .inr v := by
      intro u
      have := hs (.inl u) (.inl u)
      rcases hq : side (g (finSumFinEquiv (.inl u))) with w | w
      · rw [hq] at this; simp [letter] at this
      · exact ⟨w, rfl⟩
    choose σf hσf using hright
    have hinj : Function.Injective σf := by
      intro u v huv
      have h1 := hσf u
      have h2 := hσf v
      rw [huv, ← h2] at h1
      have := g.injective (finSumFinEquiv.symm.injective h1)
      exact Sum.inl_injective (finSumFinEquiv.injective this)
    have hbij : Function.Bijective σf := Finite.injective_iff_bijective.mp hinj
    let σ : Perm (Fin n) := Equiv.ofBijective σf hbij
    have hσ : ∀ u, g (Fin.castAdd n u) = Fin.natAdd n (σ u) := by
      intro u
      have := hσf u
      have h' := congrArg finSumFinEquiv this
      simp only [side, Equiv.apply_symm_apply, finSumFinEquiv_apply_left,
        finSumFinEquiv_apply_right] at h'
      exact h'
    refine ⟨σ, ⟨fun u v => ?_, fun u => ?_⟩⟩
    · by_cases huv : u = v
      · subst huv; simp
      · have := hs (.inl u) (.inl v)
        have hne : σ u ≠ σ v := fun h => huv (σ.injective h)
        simp only [finSumFinEquiv_apply_left, hσ, side, finSumFinEquiv_symm_apply_natAdd,
          letter, huv, hne, if_false] at this
        by_cases hX : a.X.Adj u v <;> by_cases hY : a.Y.Adj (σ u) (σ v) <;>
          simp_all
    · have := hg (Fin.castAdd n u)
      rw [hσ, col_natAdd, col_castAdd] at this
      exact this
  · rintro ⟨σ, hiso, hcol⟩
    let τ : Perm (Fin n ⊕ Fin n) := (Equiv.sumCongr σ σ⁻¹).trans (Equiv.sumComm _ _)
    let g : Perm (Fin (n + n)) := finSumFinEquiv.permCongr τ
    have hgl : ∀ u, g (Fin.castAdd n u) = Fin.natAdd n (σ u) := by
      intro u
      simp only [g, Equiv.permCongr_apply, finSumFinEquiv_symm_apply_castAdd]
      exact finSumFinEquiv_apply_right (σ u)
    have hgr : ∀ v, g (Fin.natAdd n v) = Fin.castAdd n (σ.symm v) := by
      intro v
      simp only [g, Equiv.permCongr_apply, finSumFinEquiv_symm_apply_natAdd]
      exact finSumFinEquiv_apply_left (σ.symm v)
    have hgcol : g ∈ colStab a := by
      intro ω
      refine Fin.addCases (fun u => ?_) (fun v => ?_) ω
      · rw [hgl, col_natAdd, col_castAdd, hcol]
      · rw [hgr, col_castAdd, col_natAdd, ← hcol (σ.symm v), Equiv.apply_symm_apply]
    refine ⟨pairHom g, ?_, (mem_isoSet_iff a g).mpr fun p q => ?_⟩
    · change pairHom g ∈ genGroup ((vertexGens a).map pairHom)
      rw [genGroup_map]
      exact ⟨g, hgcol, rfl⟩
    · have hiso' : ∀ u v, a.X.Adj (σ.symm u) (σ.symm v) ↔ a.Y.Adj u v := by
        intro u v
        have := hiso (σ.symm u) (σ.symm v)
        simpa using this
      rcases p with u | u <;> rcases q with v | v
      · simp only [finSumFinEquiv_apply_left, hgl, side, finSumFinEquiv_symm_apply_natAdd,
          letter, σ.injective.eq_iff]
        by_cases huv : u = v
        · simp [huv]
        · simp only [huv, if_false]
          by_cases hX : a.X.Adj u v
          · simp [hX, (hiso u v).mp hX]
          · have : ¬ a.Y.Adj (σ u) (σ v) := fun h => hX ((hiso u v).mpr h)
            simp [hX, this]
      · simp only [finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, hgl, hgr, side,
          finSumFinEquiv_symm_apply_castAdd, finSumFinEquiv_symm_apply_natAdd]
        rfl
      · simp only [finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, hgl, hgr, side,
          finSumFinEquiv_symm_apply_castAdd, finSumFinEquiv_symm_apply_natAdd]
        rfl
      · simp only [finSumFinEquiv_apply_right, hgr, side, finSumFinEquiv_symm_apply_castAdd,
          letter, σ.symm.injective.eq_iff]
        by_cases huv : u = v
        · simp [huv]
        · simp only [huv, if_false]
          by_cases hY : a.Y.Adj u v
          · simp [hY, (hiso' u v).mpr hY]
          · have : ¬ a.X.Adj (σ.symm u) (σ.symm v) := fun h => hY ((hiso' u v).mp h)
            simp [hY, this]

/-! ## The orbits are short -/

/-- The points of one combined color. -/
def colClass (a : ColGIInput n) (ω : Fin (n + n)) : Finset (Fin (n + n)) :=
  Finset.univ.filter fun ω' => col a ω' = col a ω

theorem card_colClass_le (a : ColGIInput n) (ω : Fin (n + n)) :
    (colClass a ω).card ≤ 2 * maxColorMultiplicity a := by
  set c := col a ω
  have hsub : colClass a ω ⊆
      (Finset.univ.filter fun u => a.cX u = c).map (Fin.castAddEmb n) ∪
        (Finset.univ.filter fun v => a.cY v = c).map (Fin.natAddEmb n) := by
    intro ω' hω'
    have hc : col a ω' = c := (Finset.mem_filter.mp hω').2
    revert hc
    refine Fin.addCases (fun u => ?_) (fun v => ?_) ω'
    · intro hc
      rw [col_castAdd] at hc
      exact Finset.mem_union_left _ (Finset.mem_map.mpr ⟨u, by simp [hc], rfl⟩)
    · intro hc
      rw [col_natAdd] at hc
      exact Finset.mem_union_right _ (Finset.mem_map.mpr ⟨v, by simp [hc], rfl⟩)
  have hk : max (Finset.univ.filter fun u => a.cX u = c).card
      (Finset.univ.filter fun u => a.cY u = c).card ≤ maxColorMultiplicity a :=
    Finset.le_sup (f := fun c : Fin n => max (Finset.univ.filter fun u => a.cX u = c).card
      (Finset.univ.filter fun u => a.cY u = c).card) (Finset.mem_univ c)
  calc (colClass a ω).card ≤ _ := Finset.card_le_card hsub
    _ ≤ _ := Finset.card_union_le _ _
    _ = (Finset.univ.filter fun u => a.cX u = c).card +
        (Finset.univ.filter fun v => a.cY v = c).card := by simp
    _ ≤ 2 * maxColorMultiplicity a := by omega

/-- **Every orbit on pairs has at most `(2k)²` points.** -/
theorem maxOrbitLength_instanceSI_le (a : ColGIInput n) :
    maxOrbitLength (instanceSI a).1 ≤ (2 * maxColorMultiplicity a) ^ 2 := by
  apply Finset.sup_le
  intro i _
  set p := finProdFinEquiv.symm i
  have hsub : MulAction.orbit (genGroup (instanceSI a).1) i ⊆
      ((colClass a p.1 ×ˢ colClass a p.2).map finProdFinEquiv.toEmbedding : Set _) := by
    rintro j ⟨⟨π, hπ⟩, rfl⟩
    change π ∈ genGroup ((vertexGens a).map pairHom) at hπ
    rw [genGroup_map] at hπ
    obtain ⟨g, hg, rfl⟩ := hπ
    change pairHom g i ∈ _
    rw [pairHom_apply]
    simp only [Finset.coe_map, Equiv.coe_toEmbedding, Set.mem_image, Finset.mem_coe,
      Finset.mem_product]
    exact ⟨_, ⟨Finset.mem_filter.mpr ⟨Finset.mem_univ _, hg _⟩,
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hg _⟩⟩, rfl⟩
  calc (MulAction.orbit (genGroup (instanceSI a).1) i).ncard
      ≤ (((colClass a p.1 ×ˢ colClass a p.2).map finProdFinEquiv.toEmbedding :
          Finset _) : Set _).ncard := Set.ncard_le_ncard hsub (Finset.finite_toSet _)
    _ = (colClass a p.1).card * (colClass a p.2).card := by
        rw [Set.ncard_coe_finset, Finset.card_map, Finset.card_product]
    _ ≤ (2 * maxColorMultiplicity a) * (2 * maxColorMultiplicity a) :=
        Nat.mul_le_mul (card_colClass_le a _) (card_colClass_le a _)
    _ = (2 * maxColorMultiplicity a) ^ 2 := by ring

end RAM.ColGIReduction
