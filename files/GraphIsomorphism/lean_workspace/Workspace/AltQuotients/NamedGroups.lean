/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

The named groups occurring in the exceptional cases of the cited theorems
[DiM, Thm. 5.2A] and [DiM, Thm. 5.2B] (Dixon–Mortimer, *Permutation Groups*, GTM 163,
Springer 1996, pp. 147 and 150–151).
-/
import Mathlib.GroupTheory.SpecificGroups.Dihedral
import Mathlib.LinearAlgebra.Matrix.ProjectiveSpecialLinearGroup
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
import Mathlib.LinearAlgebra.Projectivization.Basic
import Mathlib.FieldTheory.Finite.GaloisField
import Mathlib.Data.ZMod.Basic
import Mathlib.GroupTheory.Perm.Basic
import Mathlib.Tactic.NormNum.Prime

/-!
# Named groups of the exceptional cases of [DiM, Thm. 5.2A,B]

Theorems 5.2A and 5.2B of Dixon–Mortimer list six exceptional cases each, in which the
subgroup `G` of small index is named:

| case | group | order |
|---|---|---|
| `(5, 2, 6, 5:2)` (5.2A) | the dihedral group of order `10` | `10` |
| `(5, 2, 6, 5:4)` (5.2B) | the Frobenius group `AGL(1,5)` | `20` |
| `(6, 2, 6, PSL₂(5))`, `(6, 2, 12, PSL₂(5))` | `PSL(2,5)` | `60` |
| `(6, 2, 6, PGL₂(5))` (5.2B) | `PGL(2,5)` | `120` |
| `(7, 2, 15, PSL₃(2))`, `(7, 3, 30, PSL₃(2))` | `PSL(3,2)` | `168` |
| `(8, 2, 15, AGL₃(2))`, `(8, 3, 30, AGL₃(2))` | `AGL(3,2)` | `1344` |
| `(9, 4, 120, PΓL₂(8))` (5.2A) | `PΓL(2,8)` | `1512` |

`PSL(n, R)` is Mathlib's `Matrix.ProjectiveSpecialLinearGroup`, `SL(n,R)/Z`.  The other
four are defined here:

* `Babai.PGL n R`, the projective general linear group `GL(n,R)/Z(GL(n,R))`;
* `Babai.AGL K V`, the affine group of the `K`-vector space `V`: the group of permutations
  of `V` generated by the translations and the `K`-linear automorphisms.  (The affine
  group is exactly this group: an affine bijection is a translation composed with a linear
  one.)
* `Babai.PGammaL K V`, the projective semilinear group: the group of permutations of the
  projective space `ℙ K V` induced by the semilinear bijections of `V`, i.e. by the
  additive bijections `f` for which there is a field automorphism `σ` with
  `f (c • v) = σ c • f v`.  (The `K`-linear ones give `PGL`; over `F_8` the field
  automorphisms are the three powers of the Frobenius, whence `|PΓL(2,8)| = 3·|PGL(2,8)|
  = 3·504 = 1512`.)  Note that a semilinear bijection maps lines to lines, so it does
  induce a permutation of `ℙ K V`; the generating set below says exactly that `π` is the
  induced permutation.

The Dixon–Mortimer notation `5:2` and `5:4` is for the Frobenius groups `ℤ₅ ⋊ ℤ₂` and
`ℤ₅ ⋊ ℤ₄` acting on five points, i.e. the dihedral group of order `10` and the affine
group `AGL(1,5)` of order `20`; both are subgroups of `AGL(1,5) = ℤ₅ ⋊ ℤ₄`.

These groups occur in the statements of `Babai.dixonMortimer_5_2A` and
`Babai.dixonMortimer_5_2B`, as the target of an isomorphism.  The two theorems were cited
axioms; they are now proved (`Workspace/AltQuotients/DM52/Main52A.lean`,
`.../Main52B.lean`), and the facts about the named groups that those proofs need are proved
in `Workspace/AltQuotients/DM52/`.
-/

universe u v

namespace Babai

open scoped MatrixGroups

/-- `ZMod 2` is a field. -/
instance fact_prime_two : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

/-- `ZMod 5` is a field. -/
instance fact_prime_five : Fact (Nat.Prime 5) := ⟨by decide⟩

/-! ### The projective general linear group -/

/-- `PGL(n, R) = GL(n, R) / Z(GL(n, R))`, the projective general linear group.  (Mathlib
has `PSL`, `Matrix.ProjectiveSpecialLinearGroup`, but not `PGL`.) -/
abbrev PGL (n : Type u) [DecidableEq n] [Fintype n] (R : Type v) [CommRing R] : Type _ :=
  Matrix.GeneralLinearGroup n R ⧸ Subgroup.center (Matrix.GeneralLinearGroup n R)

/-! ### The affine group -/

/-- `AGL(V)`, the affine group of a vector space `V` over `K`, as a group of permutations
of `V`: the group generated by the translations `v ↦ v + w` and the `K`-linear
automorphisms of `V`.

This is the affine group: every affine bijection of `V` is a linear automorphism followed
by a translation, and conversely. -/
def AGL (K : Type u) (V : Type v) [Field K] [AddCommGroup V] [Module K V] :
    Subgroup (Equiv.Perm V) :=
  Subgroup.closure
    ({π : Equiv.Perm V | ∃ w : V, ∀ v : V, π v = v + w} ∪
      {π : Equiv.Perm V | ∃ f : V ≃ₗ[K] V, ∀ v : V, π v = f v})

/-- `AGL(1, 5) = ℤ₅ ⋊ ℤ₄`, the Frobenius group of order `20`, which Dixon–Mortimer write
`5:4` (case `(5, 2, 6, 5:4)` of Theorem 5.2B). -/
abbrev AGL_1_5 : Subgroup (Equiv.Perm (ZMod 5)) := AGL (ZMod 5) (ZMod 5)

/-- `AGL(3, 2)`, the affine group of the three-dimensional space over `F₂`, of order
`8 · 168 = 1344` (cases `(8, 2, 15, AGL₃(2))` of Theorem 5.2A and `(8, 3, 30, AGL₃(2))` of
Theorem 5.2B). -/
abbrev AGL_3_2 : Subgroup (Equiv.Perm (Fin 3 → ZMod 2)) := AGL (ZMod 2) (Fin 3 → ZMod 2)

/-! ### The projective semilinear group -/

open Projectivization in
/-- `PΓL(V)`, the projective semilinear group of `V` over `K`: the group of permutations
of the projective space `ℙ K V` induced by the semilinear bijections of `V`.

A *semilinear bijection* is an additive bijection `f : V ≃+ V` together with a field
automorphism `σ : K ≃+* K` such that `f (c • v) = σ c • f v` for all `c`, `v`; such an `f`
maps lines through the origin to lines through the origin, so it induces a permutation of
`ℙ K V`, and the generating set below consists of exactly those induced permutations.
`PΓL` is generated by (indeed equal to) this set. -/
def PGammaL (K : Type u) (V : Type v) [Field K] [AddCommGroup V] [Module K V] :
    Subgroup (Equiv.Perm (Projectivization K V)) :=
  Subgroup.closure
    {π : Equiv.Perm (Projectivization K V) |
      ∃ (σ : K ≃+* K) (f : V ≃+ V), (∀ (c : K) (v : V), f (c • v) = σ c • f v) ∧
        ∀ (v : V) (hv : v ≠ 0) (hfv : f v ≠ 0),
          π (Projectivization.mk K v hv) = Projectivization.mk K (f v) hfv}

/-- The field with eight elements, `F₈`. -/
abbrev F8 : Type := GaloisField 2 3

/-- `PΓL(2, 8)`, of order `1512 = 3 · 504`: the projective semilinear group of the
projective line over `F₈`, acting on its nine points (case `(9, 4, 120, PΓL₂(8))` of
Theorem 5.2A). -/
noncomputable abbrev PGammaL_2_8 : Subgroup (Equiv.Perm (Projectivization F8 (Fin 2 → F8))) :=
  PGammaL F8 (Fin 2 → F8)

/-! ### The dihedral group of order 10 -/

/-- `5:2`, the Frobenius group `ℤ₅ ⋊ ℤ₂` of order `10`, i.e. the dihedral group of order
`10` in its action on five points (case `(5, 2, 6, 5:2)` of Theorem 5.2A). -/
abbrev Frob_5_2 : Type := DihedralGroup 5

end Babai
