/-
Formalization of

  László Babai, *Graph Isomorphism in Quasipolynomial Time*,
  Version 2.5 (2 November 2018).

Tools for the proof of [DiM, Thm. 5.2A,B]: the affine groups `AGL(1,5)` and `AGL(3,2)`.
-/
import Workspace.AltQuotients.NamedGroups
import Workspace.AltQuotients.DM52.Recog
import Mathlib.Algebra.Module.ZMod

/-!
# The affine group

`Babai.AGL K V` is defined as the group generated by the translations and the linear
automorphisms.  Its elements are exactly the maps `v ↦ f v + w` with `f` a linear
automorphism (`Babai.DM52.mem_AGL_iff`).  Over `ℤ/5` the linear automorphisms of the line
are the multiplications by nonzero scalars, and over `F₂` the linear maps are the additive
maps; this gives decidable descriptions of `AGL(1,5)` and `AGL(3,2)`.
-/

namespace Babai.DM52

open Equiv Equiv.Perm

variable {K : Type*} {V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- The elements of `AGL(V)` are the maps `v ↦ f v + w` with `f ∈ GL(V)`. -/
theorem mem_AGL_iff (π : Perm V) :
    π ∈ AGL K V ↔ ∃ (f : V ≃ₗ[K] V) (w : V), ∀ v, π v = f v + w := by
  constructor
  · intro h
    induction h using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with ⟨w, hw⟩ | ⟨f, hf⟩
      · exact ⟨LinearEquiv.refl K V, w, fun v => by simp [hw]⟩
      · exact ⟨f, 0, fun v => by simp [hf]⟩
    | one => exact ⟨LinearEquiv.refl K V, 0, fun v => by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨f, w, hf⟩ := hx
      obtain ⟨g, u, hg⟩ := hy
      refine ⟨g.trans f, f u + w, fun v => ?_⟩
      simp [Perm.mul_apply, hf, hg, add_assoc]
    | inv x _ hx =>
      obtain ⟨f, w, hf⟩ := hx
      refine ⟨f.symm, -f.symm w, fun v => ?_⟩
      rw [Perm.inv_eq_iff_eq, hf]
      simp
  · rintro ⟨f, w, hf⟩
    let t : Perm V := Equiv.addRight w
    let m : Perm V := f.toEquiv
    have hπ : π = t * m := by
      ext v; simp [t, m, hf, Perm.mul_apply]
    rw [hπ]
    exact mul_mem (Subgroup.subset_closure (Or.inl ⟨w, fun v => rfl⟩))
      (Subgroup.subset_closure (Or.inr ⟨f, fun v => rfl⟩))

/-! ### `AGL(1,5)` -/

/-- The affine permutations `x ↦ a x + b` (`a ≠ 0`) of `ℤ/5`. -/
def IsAff5 (π : Perm (ZMod 5)) : Prop := ∃ a b : ZMod 5, a ≠ 0 ∧ ∀ x, π x = a * x + b

instance : DecidablePred IsAff5 := fun π => by unfold IsAff5; infer_instance

theorem mem_AGL_1_5_iff (π : Perm (ZMod 5)) : π ∈ AGL_1_5 ↔ IsAff5 π := by
  rw [mem_AGL_iff]
  constructor
  · rintro ⟨f, w, hf⟩
    refine ⟨f 1, w, fun h => ?_, fun x => ?_⟩
    · have : f 1 = f 0 := by rw [h, map_zero]
      exact one_ne_zero (f.injective this)
    · rw [hf, show x = x • (1 : ZMod 5) by simp, map_smul, smul_eq_mul]
      simp [mul_comm]
  · rintro ⟨a, b, ha, h⟩
    exact ⟨LinearEquiv.smulOfNeZero (ZMod 5) (ZMod 5) a ha, b, fun x => by simp [h]⟩

theorem card_AGL_1_5 : Nat.card AGL_1_5 = 20 := by
  rw [← Nat.card_congr (Equiv.subtypeEquivRight (fun π => (mem_AGL_1_5_iff π).symm)),
    Nat.card_eq_fintype_card, Fintype.card_subtype]
  decide

/-! ### `AGL(3,2)` -/

/-- Over `F₂`, a permutation `π` of `F₂³` is affine iff `π (u + v) + π 0 = π u + π v`. -/
def IsAff32 (π : Perm (Fin 3 → ZMod 2)) : Prop := ∀ u v, π (u + v) + π 0 = π u + π v

instance : DecidablePred IsAff32 := fun π => by unfold IsAff32; infer_instance

theorem mem_AGL_3_2_iff (π : Perm (Fin 3 → ZMod 2)) : π ∈ AGL_3_2 ↔ IsAff32 π := by
  rw [mem_AGL_iff]
  constructor
  · rintro ⟨f, w, hf⟩ u v
    rw [hf, hf, hf, hf, map_add, map_zero]
    abel
  · intro h
    -- `v ↦ π v - π 0` is additive, hence `F₂`-linear
    let g : (Fin 3 → ZMod 2) →+ (Fin 3 → ZMod 2) :=
      { toFun := fun v => π v - π 0
        map_zero' := by simp
        map_add' := fun u v => by
          have := h u v
          rw [← eq_sub_iff_add_eq] at this
          show π (u + v) - π 0 = (π u - π 0) + (π v - π 0)
          rw [this]; abel }
    have hginj : Function.Injective g := by
      intro u v huv
      have : π u - π 0 = π v - π 0 := huv
      exact π.injective (sub_left_injective this)
    let gl : (Fin 3 → ZMod 2) →ₗ[ZMod 2] (Fin 3 → ZMod 2) := g.toZModLinearMap 2
    have hglinj : Function.Injective gl := hginj
    let f := LinearEquiv.ofInjectiveEndo gl hglinj
    refine ⟨f, π 0, fun v => ?_⟩
    show π v = (π v - π 0) + π 0
    abel

end Babai.DM52
