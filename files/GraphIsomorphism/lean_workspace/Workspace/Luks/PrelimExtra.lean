-/
import Workspace.Prelim.PermGroups

/-!
# Section 11 preliminaries

Small general facts that Section 11 needs and that the Section 2 files do not provide.
The Section 2 files are owned by another track, so these live here; see the report.
-/

namespace Babai

open MulAction Equiv Equiv.Perm

variable {Ω : Type*}

/-! ### Invariant sets -/

/-- A `G`-invariant set is closed under the elements of `G`. -/
theorem IsInvariant.mem_of_mem {G : Subgroup (Equiv.Perm Ω)} {Δ : Set Ω}
    (h : IsInvariant G Δ) {σ : Equiv.Perm Ω} (hσ : σ ∈ G) {u : Ω} (hu : u ∈ Δ) : σ u ∈ Δ :=
  ((isInvariant_iff_mem G Δ).1 h σ hσ u).1 hu

/-- Membership in a `G`-invariant set is unchanged by the elements of `G`. -/
theorem IsInvariant.mem_iff {G : Subgroup (Equiv.Perm Ω)} {Δ : Set Ω}
    (h : IsInvariant G Δ) {σ : Equiv.Perm Ω} (hσ : σ ∈ G) (u : Ω) : u ∈ Δ ↔ σ u ∈ Δ :=
  (isInvariant_iff_mem G Δ).1 h σ hσ u

/-! ### Relative index and order -/

/-- Lagrange's theorem in relative form: for `H ≤ K` in a group, `|K| = |K : H| · |H|`. -/
theorem relIndex_mul_card_of_le {G : Type*} [Group G] {H K : Subgroup G} (h : H ≤ K) :
    H.relIndex K * Nat.card H = Nat.card K := by
  have hcard : Nat.card (H.subgroupOf K) = Nat.card H :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe h).toEquiv
  have := Subgroup.index_mul_card (H.subgroupOf K)
  rwa [hcard] at this

/-! ### Normality between two permutation groups

The paper writes `N ◁ G` for subgroups `N, G ≤ S(Ω)` (Fact 11.1.8, Theorem 11.1.9).  In
Mathlib this is `(N.subgroupOf G).Normal`; we spell it out, and give the bridge. -/

/-- `N ◁ G` for two subgroups of `S(Ω)`: `N ≤ G` and `N` is closed under conjugation by
the elements of `G`. -/
structure IsNormalIn (N G : Subgroup (Equiv.Perm Ω)) : Prop where
  le : N ≤ G
  conj_mem : ∀ g ∈ G, ∀ n ∈ N, g * n * g⁻¹ ∈ N

/-- Bridge: `Babai.IsNormalIn N G` is `(N.subgroupOf G).Normal` together with `N ≤ G`. -/
theorem IsNormalIn.subgroupOf_normal {N G : Subgroup (Equiv.Perm Ω)} (h : IsNormalIn N G) :
    (N.subgroupOf G).Normal := by
  refine ⟨fun n hn g => ?_⟩
  simp only [Subgroup.mem_subgroupOf] at hn ⊢
  exact h.conj_mem g g.2 n hn

/-! ### Transporting permutation groups along a bijection

`Equiv.permCongr` as a group isomorphism `S(α) ≃* S(β)` is Mathlib's
`Equiv.permCongrHom`.  This is how the paper's phrases "`G` acts on `ℬ` as the Johnson
group `A_k^(t)`" are made precise: the image of the action under this isomorphism is
literally the Johnson group.

### Generating a preimage subgroup

Observation 11.1.11 uses: a set of generators of `φ⁻¹(K)` is obtained from a set `S` whose
image generates `K` by *adding a set of generators of the kernel*. -/

/-- If `φ '' S` generates `K`, then `φ⁻¹(K)` is generated by `S` together with the kernel
of `φ`. -/
theorem comap_eq_closure_union_ker {G H : Type*} [Group G] [Group H] (φ : G →* H)
    (S : Set G) (K : Subgroup H) (hS : Subgroup.closure (φ '' S) = K) :
    K.comap φ = Subgroup.closure (S ∪ (φ.ker : Set G)) := by
  apply le_antisymm
  · intro g hg
    simp only [Subgroup.mem_comap] at hg
    rw [← hS, ← MonoidHom.map_closure] at hg
    obtain ⟨s, hs, hsg⟩ := hg
    have hker : s⁻¹ * g ∈ φ.ker := by
      simp [MonoidHom.mem_ker, hsg]
    have h1 : s ∈ Subgroup.closure (S ∪ (φ.ker : Set G)) :=
      Subgroup.closure_mono Set.subset_union_left hs
    have h2 : s⁻¹ * g ∈ Subgroup.closure (S ∪ (φ.ker : Set G)) :=
      Subgroup.subset_closure (Or.inr hker)
    have := mul_mem h1 h2
    simpa using this
  · rw [Subgroup.closure_le]
    rintro g (hg | hg)
    · simp only [SetLike.mem_coe, Subgroup.mem_comap, ← hS]
      exact Subgroup.subset_closure ⟨g, hg, rfl⟩
    · simp only [SetLike.mem_coe, Subgroup.mem_comap]
      rw [MonoidHom.mem_ker.1 hg]
      exact one_mem K

end Babai
